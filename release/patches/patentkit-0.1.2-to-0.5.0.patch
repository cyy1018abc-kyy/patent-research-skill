+"""Manuscript registry and `attested` evidence-level maintenance.
+
+Background (decisions Q1 / R1)
+------------------------------
+* Under Q1 the drafting text **stays outside the repo** (unpublished technical solutions are not placed on third-party hosting);
+* Only the "path registration + sha256 binding" is kept in the repo;
+* Therefore gates such as `G-D-01` / `G-D-03` **structurally can only reach `attested`** — in-repo tools can
+  prove "the reviewed file is that one file" (identity), but cannot prove content quality.
+  This must be stated honestly rather than pretending it is `verified`.
+
+This tool does two things
+-------------------------
+1. **Manuscript registry** (default): reads `07_drafting/manuscript_registry.yml`, computes sha256 for each draft,
+   compares against the registered value, and reports "bound / consistent / **drift** / unreachable path".
+2. **Candidate attestation** (`--candidate`): marks a candidate as `attested`, binding the
+   external artifact path and its sha256.
+
+Dry-run by default; only `--apply` writes to disk; `--check` only validates and exits 1 on drift (for CI).
+
+Usage
+-----
+    python -m patentkit.attest                       # preview drift
+    python -m patentkit.attest --apply               # refresh sha256
+    python -m patentkit.attest --check               # CI: fail on drift
+    python -m patentkit.attest --candidate P-004 --path 'D:\\pdf\\us1111111.pdf' --apply
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from .model import load_candidates, sha256_file
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+
+REGISTRY_REL = Path("07_drafting") / "manuscript_registry.yml"
+
+#: draft status values
+DRAFT_STATUS = ("current", "superseded", "missing")
+
+
+@dataclass
+class DraftReport:
+    role: str
+    path: str
+    state: str  # bound | ok | drift | unreachable
+    registered: str | None
+    actual: str | None
+
+    @property
+    def is_problem(self) -> bool:
+        return self.state == "drift"
+
+
+def load_draft_registry(path: Path) -> dict[str, Any]:
+    if not path.is_file():
+        raise FileNotFoundError(f"draft registry not found: {path}")
+    data = yaml.safe_load(path.read_text(encoding="utf-8"))
+    if not isinstance(data, dict):
+        raise ValueError(f"the draft registry top level must be a mapping: {path}")
+    return data
+
+
+def dump_draft_registry(path: Path, data: dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        yaml.safe_dump(data, allow_unicode=True, sort_keys=False, width=100),
+        encoding="utf-8",
+    )
+
+
+def inspect_drafts(data: dict[str, Any]) -> list[DraftReport]:
+    out: list[DraftReport] = []
+    for draft in data.get("drafts") or []:
+        if not isinstance(draft, dict):
+            continue
+        role = str(draft.get("role") or "?")
+        raw_path = str(draft.get("path") or "")
+        registered = draft.get("sha256")
+        registered = str(registered) if registered else None
+
+        if not raw_path:
+            out.append(DraftReport(role, "", "unreachable", registered, None))
+            continue
+
+        p = Path(raw_path)
+        if not p.is_file():
+            out.append(DraftReport(role, raw_path, "unreachable", registered, None))
+            continue
+
+        actual = sha256_file(p)
+        if registered is None:
+            state = "bound"
+        elif registered == actual:
+            state = "ok"
+        else:
+            state = "drift"
+        out.append(DraftReport(role, raw_path, state, registered, actual))
+    return out
+
+
+def apply_refresh(data: dict[str, Any], reports: list[DraftReport]) -> dict[str, Any]:
+    """Write the sha256 of reachable drafts back to the registry; keep the original value for unreachable ones (do not erase an existing binding)."""
+    now = datetime.now().astimezone().isoformat(timespec="seconds")
+    by_role = {r.role: r for r in reports}
+
+    for draft in data.get("drafts") or []:
+        if not isinstance(draft, dict):
+            continue
+        r = by_role.get(str(draft.get("role") or "?"))
+        if r is None:
+            continue
+        if r.state == "unreachable":
+            # Unreachable path: keep the original sha256 and only mark the status, so that
+            # "temporarily unreachable" is not mistaken for "the file is unchanged"
+            draft["status"] = "missing"
+            draft["checked_at"] = now
+            continue
+        draft["sha256"] = r.actual
+        draft["status"] = "current"
+        draft["checked_at"] = now
+        draft["evidence_level"] = "attested"
+    data["updated"] = now[:10]
+    data["last_attested_at"] = now
+    return data
+
+
+STATE_LABEL = {
+    "bound": "🆕 bound",
+    "ok": "✅ match",
+    "drift": "❗ drift",
+    "unreachable": "⚠️ unreachable",
+}
+
+
+def run_drafts(root: Path, apply: bool, check: bool, as_json: bool) -> int:
+    reg_path = root / REGISTRY_REL
+    try:
+        data = load_draft_registry(reg_path)
+    except (FileNotFoundError, ValueError) as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    reports = inspect_drafts(data)
+    drift = [r for r in reports if r.state == "drift"]
+    unreachable = [r for r in reports if r.state == "unreachable"]
+
+    if as_json:
+        print(
+            json.dumps(
+                {
+                    "registry": str(reg_path.relative_to(root).as_posix()),
+                    "target": data.get("target"),
+                    "drafts": [
+                        {
+                            "role": r.role,
+                            "path": r.path,
+                            "state": r.state,
+                            "registered": r.registered,
+                            "actual": r.actual,
+                        }
+                        for r in reports
+                    ],
+                    "drift": len(drift),
+                    "unreachable": len(unreachable),
+                },
+                ensure_ascii=False,
+                indent=2,
+            )
+        )
+    else:
+        print(f"Draft registry : {REGISTRY_REL.as_posix()}")
+        print(f"Target         : {data.get('target')}")
+        print(f"Drafts         : {len(reports)}")
+        print()
+        for r in reports:
+            print(f"  {STATE_LABEL.get(r.state, r.state):<12} {r.role}")
+            print(f"      {r.path}")
+            if r.state == "drift":
+                print(f"      registered {str(r.registered)[:16]}… → actual {str(r.actual)[:16]}…")
+            elif r.state == "bound":
+                print(f"      bound sha256 {str(r.actual)[:16]}…")
+        print()
+
+    if drift:
+        print(
+            f"❗ {len(drift)} drafts have **changed content** (sha256 drift) — "
+            f"this means the revision registered in the repo no longer corresponds to the external file.",
+            file=sys.stderr,
+        )
+        for r in drift:
+            print(f"    {r.role}: {r.path}", file=sys.stderr)
+        print(
+            "  Action: after confirming the new content, run --apply to re-bind, and update revision_ledger.md as well",
+            file=sys.stderr,
+        )
+
+    if unreachable:
+        print(
+            f"⚠️ {len(unreachable)} draft paths are currently unreachable (this does not affect existing bindings)",
+            file=sys.stderr,
+        )
+
+    if check:
+        return 1 if drift else 0
+
+    if not apply:
+        # With --json, nothing further may be written to stdout, otherwise the JSON is polluted
+        if not as_json:
+            print("Not written. Add --apply once confirmed")
+        return 0
+
+    dump_draft_registry(reg_path, apply_refresh(data, reports))
+    print(f"Written {REGISTRY_REL.as_posix()}")
+    return 0
+
+
+def run_candidate(root: Path, cid: str, ext_path: Path, apply: bool) -> int:
+    cands = {c.id: c for c in load_candidates(root)}
+    cand = cands.get(cid)
+    if cand is None:
+        print(f"[FATAL] candidate '{cid}' does not exist", file=sys.stderr)
+        return 2
+    if not ext_path.is_file():
+        print(f"[FATAL] external artifact does not exist: {ext_path}", file=sys.stderr)
+        return 2
+
+    digest = sha256_file(ext_path)
+    if not digest:
+        print(f"[FATAL] cannot compute sha256: {ext_path}", file=sys.stderr)
+        return 2
+
+    print(f"Candidate : {cid}")
+    print(f"Title     : {cand.title[:70]}")
+    print(f"Current   : evidence_level={cand.declared_level.value}")
+    print(f"External artifact: {ext_path}")
+    print(f"sha256 : {digest}")
+    print()
+
+    if not apply:
+        print("Not written. Add --apply once confirmed")
+        return 0
+
+    data = dict(cand.data)
+    data["evidence_level"] = "attested"
+    data["evidence_ref"] = str(ext_path)
+    data["evidence_sha256"] = digest
+
+    # Keep the key order stable
+    from .model import Candidate as _C  # noqa: F401  (for readability only)
+
+    ordered = {k: data[k] for k in cand.data if k in data}
+    for k, v in data.items():
+        if k not in ordered:
+            ordered[k] = v
+
+    cand.path.write_text(
+        json.dumps(ordered, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+    )
+    print(f"Written {cand.path.relative_to(root).as_posix()}")
+    print("Note: attested **proves identity only**, not content quality (see evidence_levels in the glossary)")
+    return 0
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.attest",
+        description="Manuscript registry / candidate attested-level maintenance (dry-run by default)",
+    )
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--apply", action="store_true", help="write to disk")
+    ap.add_argument("--check", action="store_true", help="validate only; exit 1 on drift")
+    ap.add_argument("--json", action="store_true")
+    ap.add_argument("--candidate", help="attest one candidate instead (requires --path)")
+    ap.add_argument("--path", type=Path, help="absolute path of the external artifact")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+
+    try:
+        load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    if args.candidate:
+        if not args.path:
+            print("[FATAL] --candidate also requires --path", file=sys.stderr)
+            return 64
+        return run_candidate(root, args.candidate, args.path, args.apply)
+
+    return run_drafts(root, args.apply, args.check, args.json)
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
