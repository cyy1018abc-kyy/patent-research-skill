+    argv = _root_args(root)
+    if target:
+        argv += ["--target", target]
+    if apply:
+        argv.append("--apply")
+    return _capture(bibsync_mod.main, argv)
+
+
+def fetch_cnipa(
+    ws: str | Path | None = None,
+    axis: str = "",
+    target: str = "",
+    abstract: str = "",
+    title: str = "",
+    class_code: str = "",
+    inventor: str = "",
+    applicant: list[str] | None = None,
+    patent_type: str = "all",
+    max_pages: int = 1,
+    complete: bool = False,
+    headed: bool = True,
+    waf_wait: int = cnipa_mod.DEFAULT_WAF_WAIT_SEC,
+    actor: str = "",
+    tool: str | None = None,
+    write: bool = True,
+) -> dict[str, Any]:
+    """Fetch CNIPA publication/grant search results and archive them as compliant `raw/` + logs.
+
+    **Unlike other write operations, this function really makes network requests by default** (`write=True` writes to disk).
+    The reason is that fetching itself is expensive; re-running just for a "preview" would add pointless load to the CNIPA site.
+
+    Args:
+        axis: axis ID (`N1` or `N1@TGT-0001`); determines log and artifact file names.
+        abstract: abstract query; use only and / or / not (spaces required around the operators).
+        class_code: IPC/LOC prefix, e.g. `H01M8`.
+        max_pages: maximum number of pages (3 records per page).
+        headed: headed browser. **Headless is almost always blocked by the WAF**; keep True unless you know otherwise.
+        write: whether to write to disk; False only returns the fetched content.
+    """
+    root = workspace(ws)
+    term = load_registry(root)
+    target = target or term.active_target
+    if axis and "@" not in axis:
+        axis = f"{axis}@{target}"
+
+    if not any([abstract, title, inventor, applicant, class_code]):
+        return {
+            "ok": False,
+            "error": "at least one search field is required (abstract / title / inventor / applicant / class_code)",
+        }
+
+    try:
+        outcome = cnipa_mod.run_search(
+            tool=tool,
+            abstract=abstract,
+            title=title,
+            inventor=inventor,
+            applicants=applicant,
+            class_code=class_code,
+            patent_type=patent_type,
+            max_pages=max_pages,
+            complete=complete,
+            headed=headed,
+            waf_wait=waf_wait,
+        )
+    except cnipa_mod.CnipaError as exc:
+        return {"ok": False, "error": str(exc)}
+
+    query_text = _describe_cnipa_query(abstract, title, inventor, applicant, class_code, patent_type)
+
+    summary: dict[str, Any] = {
+        "ok": True,
+        "axis": axis,
+        "target": target,
+        "query_text": query_text,
+        "hit_total": outcome.hit_total,
+        "captured_count": outcome.captured_count,
+        # Use the number of pages that actually had data; pages_attempted is the upstream tool's self-reported value
+        "effective_pages": outcome.effective_pages,
+        "pages_attempted": outcome.claimed_pages,
+        "pagination_mismatch": outcome.pagination_mismatch,
+        "complete": outcome.complete,
+        "note": outcome.note,
+        "incomplete": outcome.incomplete,
+        "report_md": str(outcome.report_md) if outcome.report_md else None,
+        "hits_preview": [
+            {
+                "pub_number": h.get("pub_number"),
+                "title": h.get("title"),
+                "applicant": h.get("applicant"),
+                "publication_date": h.get("publication_date"),
+            }
+            for h in outcome.hits[:10]
+        ],
+        "written": False,
+    }
+    if outcome.pagination_mismatch:
+        summary["warning"] = (
+            f"Upstream pagination anomaly: the tool claims {outcome.claimed_pages} page turns, "
+            f"but only {outcome.effective_pages} pages of data were actually received. "
+            f"The hit subtotal for this query has an **upper bound of only {outcome.captured_count} records**."
+        )
+
+    if not write:
+        return summary
+
+    try:
+        log_path, raw_path = cnipa_mod.write_artifacts(
+            root,
+            outcome=outcome,
+            target=target,
+            axis=axis,
+            query_text=query_text,
+            class_code=class_code,
+            max_pages=max_pages,
+            actor=actor,
+        )
+    except cnipa_mod.CnipaError as exc:
+        summary["ok"] = False
+        summary["error"] = str(exc)
+        return summary
+
+    summary["written"] = True
+    summary["log"] = log_path.relative_to(root).as_posix()
+    summary["raw"] = raw_path.relative_to(root).as_posix()
+    summary["next"] = (
+        f"python -m patentkit ingest --log {log_path.name} "
+        f"--tag {axis} --apply --now <ISO8601>"
+    )
+    return summary
+
+
+def cnipa_batch_plan(
+    ws: str | Path | None = None, axis: str = ""
+) -> dict[str, Any]:
+    """Read the CNIPA sub-query set (`cnipa_batches`) registered in the query library.
+
+    Without axis, returns an overview of sub-query counts per axis.
+    """
+    root = workspace(ws)
+    term = load_registry(root)
+    lib = _query_library(root)
+    batches = lib.get("cnipa_batches") or {}
+
+    if not batches:
+        return {"ok": False, "error": "the query library has no cnipa_batches section"}
+
+    if not axis:
+        return {
+            "ok": True,
+            "workspace": str(root),
+            "axes": {k: len(v) for k, v in sorted(batches.items())},
+        }
+
+    key = axis if "@" in axis else f"{axis}@{term.active_target}"
+    subs = batches.get(key)
+    if subs is None:
+        return {
+            "ok": False,
+            "error": f"the query library has no cnipa_batches for {key}",
+            "available": sorted(batches),
+        }
+    return {"ok": True, "axis": key, "count": len(subs), "subqueries": subs}
+
+
+def fetch_cnipa_batch(
+    ws: str | Path | None = None,
+    axis: str = "",
+    target: str = "",
+    delay_sec: float | None = None,
+    max_pages: int = 1,
+    actor: str = "",
+    write: bool = True,
+    max_consecutive_failures: int = 2,
+    only: list[int] | None = None,
+) -> dict[str, Any]:
+    """Run the **set of sub-queries** registered for an axis in the query library in sequence, archiving each one.
+
+    Why batching is needed: the CNIPA publication site returns at most 3 records per query, and programmatic
+    paging is measured to be ineffective. Results can only accumulate through narrow queries from multiple angles —
+    the site sorts by relevance, so Top-3 from narrow queries is actually more accurate.
+
+    The default interval between adjacent queries is 25 s (measured: consecutive requests trigger the WAF);
+    after `max_consecutive_failures` consecutive failures it stops, to avoid getting the IP banned.
+
+    `only` gives 1-based sub-query indices, running only those (to re-run one that the WAF rejected).
+    The index is carried into the file name verbatim, so re-running the 3rd entry still writes `-3` and will not collide with the 1st.
+    """
+    root = workspace(ws)
+    term = load_registry(root)
+    target = target or term.active_target
+    if axis and "@" not in axis:
+        axis = f"{axis}@{target}"
+
+    plan = cnipa_batch_plan(root, axis)
+    if not plan.get("ok"):
+        return plan
+
+    raw_subs = plan["subqueries"]
+    indexed = list(enumerate(raw_subs, 1))
+    if only:
+        wanted = {int(n) for n in only}
+        out_of_range = sorted(n for n in wanted if not 1 <= n <= len(raw_subs))
+        if out_of_range:
+            return {
+                "ok": False,
+                "error": f"sub-query index out of range: {out_of_range} ({axis} has {len(raw_subs)} entries)",
+            }
+        indexed = [(i, s) for i, s in indexed if i in wanted]
+
+    subs = [
+        cnipa_mod.SubQuery(
+            abstract=str(s.get("abstract") or ""),
+            class_code=str(s.get("class") or ""),
+            label=str(s.get("label") or ""),
+            title=str(s.get("title") or ""),
+            inventor=str(s.get("inventor") or ""),
+            applicant=list(s.get("applicant") or []),
+            index=i,  # keep the real index within the whole sub-query set, for the file name
+        )
+        for i, s in indexed
+    ]
+    if not subs:
+        return {"ok": False, "error": f"the sub-query set for {axis} is empty (only={only})"}
+
+    delay = (
+        cnipa_mod.DEFAULT_BATCH_DELAY_SEC if delay_sec is None else float(delay_sec)
+    )
+    batch = cnipa_mod.run_batch(
+        root,
+        axis=axis,
+        target=target,
+        subqueries=subs,
+        actor=actor,
+        max_pages=max_pages,
+        delay_sec=delay,
+        write=write,
+        max_consecutive_failures=max_consecutive_failures,
+    )
+
+    return {
+        "ok": True,
+        "axis": axis,
+        "target": target,
+        "delay_sec": delay,
+        "planned": len(subs),
+        "succeeded": batch.succeeded,
+        "failed": batch.failed,
+        "captured": batch.captured,
+        "unique_docs": batch.unique_docs,
+        "unique_pub_numbers": batch.unique_pub_numbers,
+        "stopped_early": batch.stopped_early,
+        "runs": batch.runs,
+        "next": (
+            f"python -m patentkit ingest --log <each log> --tag {axis} --apply --now <ISO8601>"
+            if batch.succeeded
+            else ""
+        ),
+    }
+
+
+def _describe_cnipa_query(
+    abstract: str,
+    title: str,
+    inventor: str,
+    applicant: list[str] | None,
+    class_code: str,
+    patent_type: str,
+) -> str:
+    """Join the search fields into a human-readable query description, written into the log's query.text."""
+    bits: list[str] = []
+    if abstract:
+        bits.append(f"abstract=({abstract})")
+    if title:
+        bits.append(f"title=({title})")
+    if inventor:
+        bits.append(f"inventor=({inventor})")
+    for a in applicant or []:
+        bits.append(f"applicant=({a})")
+    if class_code:
+        bits.append(f"class={class_code}")
+    if patent_type and patent_type != "all":
+        bits.append(f"type={patent_type}")
+    return " AND ".join(bits) if bits else "(empty query)"
+
+
+def attest(
+    ws: str | Path | None = None,
+    mode: str = "check",
+    candidate: str | None = None,
+    path: str | None = None,
+) -> dict[str, Any]:
+    """Manuscript sha256 binding.
+
+    mode: `check` (fail on drift) / `apply` (re-bind) / `status` (read-only preview).
+    """
+    root = workspace(ws)
+    argv = _root_args(root)
+    if candidate:
+        argv += ["--candidate", candidate]
+        if path:
+            argv += ["--path", str(path)]
+        if mode == "apply":
+            argv.append("--apply")
+    else:
+        if mode == "check":
+            argv.append("--check")
+        elif mode == "apply":
+            argv.append("--apply")
+        argv.append("--json")
+    return _capture(attest_mod.main, argv)
+
+
+def index(ws: str | Path | None = None, write: bool = False) -> dict[str, Any]:
+    """Generate INDEX.md (write=False only previews)."""
+    root = workspace(ws)
+    argv = _root_args(root)
+    if write:
+        argv.append("--write")
+    return _capture(index_mod.main, argv)
+
+
+def review_progress(
+    ws: str | Path | None = None, target: str = ""
+) -> dict[str, Any]:
+    """Relevance review progress per axis.
+
+    `relevance==3` is treated as **not judged** (ingest's default is 3).
+    G-S-02 counts only relevance≥4, so `ge4` here is that axis's gate count.
+    """
+    from . import review as review_mod
+
+    root = workspace(ws)
+    term = load_registry(root)
+    target = target or term.active_target
+    rows = review_mod.review_progress(root, term, target)
+    return {
+        "ok": True,
+        "workspace": str(root),
+        "target": target,
+        "axes": rows,
+        "total": sum(r["total"] for r in rows),
+        "judged": sum(r["judged"] for r in rows),
+        "ge4": sum(r["ge4"] for r in rows),
+    }
+
+
+def review_export(
+    ws: str | Path | None = None,
+    out: str = "",
+    axis: str = "",
+    with_abstract: bool = False,
+    unreviewed: bool = False,
+    limit: int = 0,
+    target: str = "",
+) -> dict[str, Any]:
+    """Export a CSV worksheet for manual review (contains all candidates by default)."""
+    root = workspace(ws)
+    argv = _root_args(root)
+    if target:
+        argv += ["--target", target]
+    if axis:
+        argv += ["--axis", axis]
+    if with_abstract:
+        argv.append("--with-abstract")
+    if unreviewed:
+        argv.append("--unreviewed")
+    if limit:
+        argv += ["--limit", str(limit)]
+    argv += ["--out", out or "review.csv"]
+    from . import review as review_mod
+
+    return _capture(review_mod.main, ["export", *argv])
+
+
+def review_apply(
+    ws: str | Path | None = None, sheet: str = "", apply: bool = False, by: str = "", target: str = ""
+) -> dict[str, Any]:
+    """Write the determinations filled into the worksheet back to the candidate JSON (dry-run by default)."""
+    root = workspace(ws)
+    from . import review as review_mod
+
+    argv = ["apply", *_root_args(root), sheet]
+    if by:
+        argv += ["--by", by]
+    if target:
+        argv += ["--target", target]
+    if apply:
+        argv.append("--apply")
+    return _capture(review_mod.main, argv)
+
+
+def review_assess(ws=None, rows=None, *, actor, by, apply=False, target=""):
+    """导入具备双维原文依据的判断；AI 不覆盖人工判断。"""
+    from .assessment import assess_batch
+    return assess_batch(workspace(ws), rows, actor=actor, by=by, apply=apply, target=target)
+
+
+def review_confirm(ws=None, rows=None, *, by, apply=False, target=""):
+    """人工确认明确名单，逐篇绑定判断指纹。"""
+    from .assessment import confirm_batch
+    return confirm_batch(workspace(ws), rows, by=by, apply=apply, target=target)
+
+
+def review_migrate(ws=None, *, apply=False):
+    """迁移结构，不补造来源等级、人工身份或确认。"""
+    from .assessment import migrate_workspace
+    return migrate_workspace(workspace(ws), apply=apply)
+
+
+def report(
+    ws: str | Path | None = None, target: str = "", argv_extra: list[str] | None = None
+) -> dict[str, Any]:
+    """Generate the 04_comparative_analysis/runs/ report skeleton."""
+    root = workspace(ws)
+    argv = _root_args(root)
+    if target:
+        argv.append(target)
+    argv += list(argv_extra or [])
+    return _capture(report_mod.main, argv)
+
+
+# ── Smoke test ────────────────────────────────────────────────────────
+
+
+def doctor(ws: str | Path | None = None) -> dict[str, Any]:
+    """Self-check: whether the workspace parses, whether dependencies are complete, whether results can be computed. For troubleshooting."""
+    checks: list[dict[str, Any]] = []
+
+    def add(name: str, ok: bool, detail: str = "") -> None:
+        checks.append({"name": name, "ok": ok, "detail": detail})
+
+    try:
+        root = workspace(ws)
+        add("Workspace location", True, str(root))
+    except WorkspaceError as exc:
+        add("Workspace location", False, str(exc))
+        return {"ok": False, "checks": checks}
+
+    add("workspace.yml", (root / "workspace.yml").is_file())
+    add("Glossary", (root / "00_methodology" / "glossary.yml").is_file())
+
+    try:
+        term = load_registry(root)
+        add("Glossary parsing", True, f"active_target={term.active_target}, axes={len(term.axes)}")
+    except TerminologyError as exc:
+        add("Glossary parsing", False, str(exc))
+        return {"ok": False, "checks": checks}
+
+    try:
+        v = validate_mod.summarize(validate_mod.validate_all(root, term))
+        add("Validation runnable", True, f"error={v['errors']} warn={v['warnings']}")
+    except Exception as exc:  # noqa: BLE001
+        add("Validation runnable", False, f"{type(exc).__name__}: {exc}")
+
+    try:
+        r = gates_mod.compute_all(root, term, term.active_target)
+        add("Gates computable", True, ", ".join(f"{g.gate_id}={g.status}" for g in r.results))
+    except Exception as exc:  # noqa: BLE001
+        add("Gates computable", False, f"{type(exc).__name__}: {exc}")
+
+    add("Query library", (root / "01_search_plan" / "query_library.yml").is_file())
+
+    try:
+        import mcp  # noqa: F401
+
+        add("mcp dependency", True, "installed; patentkit mcp is available")
+    except ImportError:
+        add("mcp dependency", False, "not installed — the MCP adapter is unavailable; pip install patentkit[mcp]")
+
+    # CNIPA search: tool and browser dependencies (optional feature; not installing them does not affect other capabilities)
+    try:
+        tool_path = cnipa_mod.find_tool()
+        add("CNIPA tool", True, f"found {tool_path.name}")
+        dep = cnipa_mod.check_dependency(tool_path)
+        add("CNIPA dependency", not dep, dep or "playwright is installed and the browser is available")
+    except cnipa_mod.CnipaError:
+        add("CNIPA tool", False, "cnipa_search.py not found — fetch-cnipa is unavailable")
+
+    optional = {"mcp dependency", "CNIPA tool", "CNIPA dependency"}
+    return {
+        "ok": all(c["ok"] or c["name"] in optional for c in checks),
+        "checks": checks,
+    }
diff --git a/b/patentkit/assessment.py b/patentkit/assessment.py
new file mode 100644
index 0000000..ce1d5a8
--- /dev/null
+++ b/patentkit/assessment.py
@@ -0,0 +1,349 @@
+"""独立于来源等级的判断协议：原文依据、人工确认、冲突建议和历史。"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import os
+import re
+import tempfile
+from datetime import datetime
+from pathlib import Path
+
+from .model import Candidate, load_candidates
+from .registry import load_registry
+
+PROTOCOL_VERSION = 1
+DECISION_FIELDS = (
+    "id", "kind", "url_or_doc_number", "target", "tags", "relevance",
+    "relevance_problem", "relevance_means", "role", "novelty_check", "review_note",
+    "feature_mapping",
+)
+EDIT_FIELDS = ("relevance_problem", "relevance_means", "role", "novelty_check", "review_note", "feature_mapping")
+
+
+def _now():
+    return datetime.now().astimezone().isoformat(timespec="seconds")
+
+
+def _timestamp(value):
+    try:
+        return bool(datetime.fromisoformat(value).utcoffset() is not None)
+    except (TypeError, ValueError):
+        return False
+
+
+def _required_text(value, name):
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"{name}: non-empty text required")
+    return value
+
+
+def validate_data(data):
+    """写入前按发行模板校验完整记录，避免先写坏数据再等待 validate 报错。"""
+    from jsonschema import Draft7Validator
+    schema = json.loads((Path(__file__).parent / "templates/workspace/03_candidates/candidates_schema.json").read_text(encoding="utf-8"))
+    error = next(Draft7Validator(schema).iter_errors(data), None)
+    if error:
+        raise ValueError(f"candidate schema: {error.message}")
+
+
+def passage(root: Path, citation: dict) -> str:
+    """只读取工作区内明确定位的原文，引用和解释不可留空。"""
+    if not isinstance(citation, dict):
+        raise ValueError("citation must be an object")
+    ref = _required_text(citation.get("ref"), "ref")
+    location = _required_text(citation.get("locator"), "locator")
+    quote = _required_text(citation.get("quote"), "quote")
+    _required_text(citation.get("rationale"), "rationale")
+    path = (root / ref).resolve()
+    if not path.is_relative_to(root.resolve()):
+        raise ValueError("citation must stay within the workspace")
+    try:
+        text = path.read_text(encoding="utf-8")
+        if path.suffix.lower() == ".json":
+            if not location.startswith("/"):
+                raise ValueError("JSON locator must be a JSON Pointer")
+            value = json.loads(text)
+            for token in location[1:].split("/"):
+                if re.search(r"~(?![01])", token):
+                    raise ValueError("invalid JSON Pointer escape")
+                token = token.replace("~1", "/").replace("~0", "~")
+                if isinstance(value, list):
+                    if not re.fullmatch(r"0|[1-9]\d*", token):
+                        raise ValueError("invalid JSON Pointer array index")
+                    value = value[int(token)]
+                else:
+                    value = value[token]
+            if not isinstance(value, str):
+                raise ValueError("JSON Pointer must identify original text")
+            text = value
+        else:
+            match = re.fullmatch(r"L([1-9]\d*)(?:-L?([1-9]\d*))?", location)
+            if not match:
+                raise ValueError("text locator must be L1 or L1-L5")
+            first, last = int(match[1]), int(match[2] or match[1])
+            lines = text.splitlines()
+            if first > last or last > len(lines):
+                raise ValueError("text locator out of range")
+            text = "\n".join(lines[first - 1:last])
+    except (OSError, UnicodeError, KeyError, IndexError, TypeError, json.JSONDecodeError) as exc:
+        raise ValueError(f"cannot locate citation {ref}#{location}: {exc}") from exc
+    if quote not in text:
+        raise ValueError(f"quote not found at {ref}#{location}")
+    return text
+
+
+def _materials(cand: Candidate, root: Path):
+    basis = (cand.data.get("assessment") or {}).get("basis") or {}
+    if not isinstance(basis, dict):
+        raise ValueError("basis must be an axis-keyed object")
+    materials = {}
+    for axis, dimensions in basis.items():
+        if axis not in cand.tags or not axis.endswith("@" + cand.target):
+            raise ValueError(f"basis axis does not match candidate: {axis}")
+        if not isinstance(dimensions, dict) or set(dimensions) != {"problem", "means"}:
+            raise ValueError(f"both problem and means citations required: {axis}")
+        materials[axis] = {key: passage(root, dimensions[key]) for key in ("problem", "means")}
+    return materials
+
+
+def fingerprint(cand: Candidate, root: Path) -> str:
+    """仅绑定判断与引用段落，无关元数据变化不撤销确认。"""
+    record = cand.data.get("assessment") or {}
+    if not isinstance(record, dict):
+        record = {"invalid": record}
+    try:
+        materials = _materials(cand, root)
+    except (ValueError, AttributeError, TypeError) as exc:
+        materials = {"unavailable": str(exc)}
+    view = {key: cand.data.get(key) for key in DECISION_FIELDS}
+    view["assessment"] = {k: v for k, v in record.items() if k not in {"fingerprint", "at"}}
+    view["located_materials"] = materials
+    return hashlib.sha256(json.dumps(view, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()
+
+
+def assessment_errors(cand: Candidate, root: Path) -> list[str]:
+    record = cand.data.get("assessment")
+    if not isinstance(record, dict) or not isinstance(record.get("actor"), str) or record.get("actor") not in {"ai", "human"}:
+        return ["assessment actor is unknown; re-assessment required"]
+    try:
+        _required_text(record.get("by"), "assessment.by")
+        if not _timestamp(record.get("at")):
+            raise ValueError("assessment.at must include timezone")
+        dims = [cand.data.get(key) for key in ("relevance_problem", "relevance_means")]
+        if any(type(v) is not int or not 1 <= v <= 5 for v in dims):
+            raise ValueError("both relevance dimensions must be integers 1..5")
+        if cand.relevance != min(dims):
+            raise ValueError("relevance must equal min(problem, means)")
+        _required_text(cand.data.get("review_note"), "review_note")
+        if not _materials(cand, root):
+            raise ValueError("at least one axis requires problem and means citations")
+        if record.get("fingerprint") != fingerprint(cand, root):
+            raise ValueError("assessment fingerprint is stale")
+    except (ValueError, TypeError, AttributeError) as exc:
+        return [str(exc)]
+    return []
+
+
+def eligible_axis(cand: Candidate, root: Path, axis: str) -> bool:
+    return (cand.relevance >= 4 and cand.data.get("role") != "excluded"
+            and not assessment_errors(cand, root)
+            and axis in cand.data["assessment"]["basis"])
+
+
+def confirmation_valid(cand: Candidate, root: Path) -> bool:
+    confirmation = cand.data.get("human_confirmation")
+    return bool(isinstance(confirmation, dict) and cand.data.get("role") == "near_prior_art"
+                and isinstance(confirmation.get("by"), str) and confirmation["by"].strip()
+                and _timestamp(confirmation.get("at")) and not assessment_errors(cand, root)
+                and confirmation.get("fingerprint") == fingerprint(cand, root))
+
+
+def human_priority(cand: Candidate) -> bool:
+    """失效的人工确认仍代表人工曾作出判断，AI 不得借失效覆盖。"""
+    record = cand.data.get("assessment") or {}
+    if not isinstance(record, dict):
+        return True
+    if record.get("actor") == "human" or cand.data.get("human_confirmation"):
+        return True
+    for event in cand.data.get("review_history") or []:
+        if not isinstance(event, dict):
+            return True
+        before = event.get("before") or {}
+        if not isinstance(before, dict):
+            return True
+        prior = before.get("assessment") or {}
+        if not isinstance(prior, dict):
+            return True
+        if prior.get("actor") == "human" or before.get("human_confirmation"):
+            return True
+    # 旧记录不推定为人工确认，但有审阅痕迹或排除标记时禁止静默覆盖。
+    return record.get("actor", "unknown") == "unknown" and bool(cand.data.get("reviewed_at") or cand.data.get("role") == "excluded")
+
+
+def state(cand: Candidate, root: Path) -> str:
+    record = cand.data.get("assessment")
+    if not isinstance(record, dict) or record.get("actor") not in ("ai", "human"):
+        return "unknown"
+    if assessment_errors(cand, root):
+        return "needs_review"
+    if confirmation_valid(cand, root):
+        return "human_confirmed"
+    return record["actor"] + "_assessed"
+
+
+def with_history(cand: Candidate, updated: dict, action: str) -> dict:
+    data = copy.deepcopy(updated)
+    before = {key: copy.deepcopy(cand.data.get(key)) for key in (*DECISION_FIELDS, "assessment", "human_confirmation", "reviewed_at")}
+    data["review_history"] = [*cand.data.get("review_history", []), {"at": _now(), "action": action, "before": before}]
+    return data
+
+
+def commit_batch(updates: list[tuple[Path, dict, dict]], apply: bool):
+    """先校验并准备所有文件；失败时回滚已替换文件，避免普通 IO 异常留下半批。"""
+    if not apply:
+        return
+    originals, staged, replaced = {}, {}, []
+    try:
+        for path, old, new in updates:
+            original = path.read_bytes()
+            if json.loads(original.decode("utf-8")) != old:
+                raise ValueError(f"concurrent change detected: {path.name}")
+            originals[path] = original
+            payload = (json.dumps(new, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
+            fd, name = tempfile.mkstemp(prefix=".assessment-", suffix=".tmp", dir=path.parent)
+            staged[path] = Path(name)
+            with os.fdopen(fd, "wb") as stream:
+                stream.write(payload)
+                stream.flush()
+                os.fsync(stream.fileno())
+        for path, tmp in staged.items():
+            os.replace(tmp, path)
+            replaced.append(path)
+    except BaseException:
+        for path in reversed(replaced):
+            path.write_bytes(originals[path])
+        raise
+    finally:
+        for tmp in staged.values():
+            tmp.unlink(missing_ok=True)
+
+
+def _batch(root, rows, target):
+    term = load_registry(root)
+    target = target or term.active_target
+    if target not in term.targets:
+        raise ValueError(f"unregistered target: {target}")
+    if not isinstance(rows, list) or not rows:
+        raise ValueError("a non-empty explicit candidate list is required")
+    candidates = load_candidates(root)
+    by_id = {c.id: c for c in candidates}
+    if len(by_id) != len(candidates):
+        raise ValueError("duplicate candidate IDs in workspace")
+    seen, selected = set(), []
+    for row in rows:
+        if not isinstance(row, dict):
+            raise ValueError("batch row must be an object")
+        cid = row.get("candidate_id")
+        if not isinstance(cid, str) or cid in seen or cid not in by_id:
+            raise ValueError(f"unknown or duplicate candidate ID: {cid}")
+        seen.add(cid)
+        cand = by_id[cid]
+        for field in ("review_history", "assessment_proposals"):
+            if field in cand.data and not isinstance(cand.data[field], list):
+                raise ValueError(f"invalid {field}: {cid}")
+        if cand.target != target:
+            raise ValueError(f"candidate belongs to another target: {cid}")
+        if row.get("expected_fingerprint") != fingerprint(cand, root):
+            raise ValueError(f"stale or missing expected_fingerprint: {cid}")
+        selected.append((cand, row))
+    return term, selected
+
+
+def assess_batch(root: Path, rows: list, *, actor: str, by: str, apply: bool = False, target: str = "") -> dict:
+    if actor not in {"ai", "human"}:
+        raise ValueError("actor must be ai or human")
+    _required_text(by, "by")
+    term, selected = _batch(root, rows, target)
+    updates, proposed = [], 0
+    for cand, row in selected:
+        allowed = {"candidate_id", "expected_fingerprint", "basis", *EDIT_FIELDS}
+        if set(row) - allowed:
+            raise ValueError(f"unknown assessment fields: {sorted(set(row) - allowed)}")
+        for key in ("relevance_problem", "relevance_means"):
+            if type(row.get(key)) is not int or not 1 <= row[key] <= 5:
+                raise ValueError(f"{key}: both dimensions required, 1..5")
+        data = copy.deepcopy(cand.data)
+        data.update({k: row[k] for k in EDIT_FIELDS if k in row})
+        if not isinstance(data.get("role"), str) or not isinstance(data.get("novelty_check"), str) or data["role"] not in term.roles or data["novelty_check"] not in term.novelty_states:
+            raise ValueError("unregistered role or novelty_check")
+        data["relevance"] = min(data["relevance_problem"], data["relevance_means"])
+        data["assessment"] = {"actor": actor, "by": by, "at": _now(), "basis": copy.deepcopy(row.get("basis"))}
+        new = Candidate(data, cand.path)
+        materials = _materials(new, root)
+        if not materials or any(axis not in term.axes_for(cand.target) for axis in materials):
+            raise ValueError("registered axis basis required")
+        data["assessment"]["materials"] = materials
+        data["assessment"]["fingerprint"] = fingerprint(new, root)
+        errors = assessment_errors(new, root)
+        if errors:
+            raise ValueError(f"{cand.id}: {'; '.join(errors)}")
+        if fingerprint(new, root) == fingerprint(cand, root):
+            continue
+        if actor == "ai" and human_priority(cand):
+            suggestion = {"at": _now(), "by": by, "changes": {k: data.get(k) for k in (*EDIT_FIELDS, "relevance")}, "assessment": data["assessment"]}
+            data = copy.deepcopy(cand.data)
+            data["assessment_proposals"] = [*data.get("assessment_proposals", []), suggestion]
+            proposed += 1
+        else:
+            data["reviewed_at"] = data["assessment"]["at"]
+            data = with_history(cand, data, "assess:" + actor)
+        validate_data(data)
+        updates.append((cand.path, cand.data, data))
+    commit_batch(updates, apply)
+    return {"ok": True, "changed": len(updates), "proposed": proposed, "written": len(updates) if apply else 0}
+
+
+def confirm_batch(root: Path, rows: list, *, by: str, apply: bool = False, target: str = "") -> dict:
+    _required_text(by, "by")
+    _, selected = _batch(root, rows, target)
+    updates = []
+    for cand, row in selected:
+        if set(row) != {"candidate_id", "expected_fingerprint"}:
+            raise ValueError("confirmation rows require only candidate_id and expected_fingerprint")
+        if cand.data.get("role") != "near_prior_art" or assessment_errors(cand, root):
+            raise ValueError(f"{cand.id}: current supported near_prior_art assessment required")
+        if confirmation_valid(cand, root) and cand.data["human_confirmation"]["by"] == by:
+            continue
+        data = copy.deepcopy(cand.data)
+        data["human_confirmation"] = {"by": by, "at": _now(), "fingerprint": fingerprint(cand, root)}
+        data = with_history(cand, data, "confirm:human")
+        validate_data(data)
+        updates.append((cand.path, cand.data, data))
+    commit_batch(updates, apply)
+    return {"ok": True, "changed": len(updates), "written": len(updates) if apply else 0}
+
+
+def schema_properties() -> dict:
+    """由内核模板提供同一份结构，迁移不复制另一套定义。"""
+    schema = json.loads((Path(__file__).parent / "templates/workspace/03_candidates/candidates_schema.json").read_text(encoding="utf-8"))
+    return {key: schema["properties"][key] for key in ("assessment", "human_confirmation", "review_history", "assessment_proposals", "feature_mapping")}
+
+
+def migrate_workspace(root: Path, *, apply: bool = False) -> dict:
+    updates = []
+    for cand in load_candidates(root):
+        if "assessment" not in cand.data:
+            data = copy.deepcopy(cand.data)
+            data["assessment"] = {"actor": "unknown", "by": "", "at": None, "basis": {}, "fingerprint": None}
+            updates.append((cand.path, cand.data, data))
+    path = root / "03_candidates/candidates_schema.json"
+    old = json.loads(path.read_text(encoding="utf-8"))
+    new = copy.deepcopy(old)
+    new.setdefault("properties", {}).update(schema_properties())
+    if new != old:
+        updates.append((path, old, new))
+    commit_batch(updates, apply)
+    return {"ok": True, "changed": len(updates), "written": len(updates) if apply else 0}
diff --git a/patentkit/attest.py b/patentkit/attest.py
index 14ce0b4..d41d556 100644
--- a/patentkit/attest.py
+++ b/patentkit/attest.py
@@ -1,307 +1,310 @@
-"""Manuscript registry and `attested` evidence-level maintenance.
-
-Background (decisions Q1 / R1)
-------------------------------
-* Under Q1 the drafting text **stays outside the repo** (unpublished technical solutions are not placed on third-party hosting);
-* Only the "path registration + sha256 binding" is kept in the repo;
-* Therefore gates such as `G-D-01` / `G-D-03` **structurally can only reach `attested`** — in-repo tools can
-  prove "the reviewed file is that one file" (identity), but cannot prove content quality.
-  This must be stated honestly rather than pretending it is `verified`.
-
-This tool does two things
--------------------------
-1. **Manuscript registry** (default): reads `07_drafting/manuscript_registry.yml`, computes sha256 for each draft,
-   compares against the registered value, and reports "bound / consistent / **drift** / unreachable path".
-2. **Candidate attestation** (`--candidate`): marks a candidate as `attested`, binding the
-   external artifact path and its sha256.
-
