-def _capture(func: Callable[[list[str]], int], argv: list[str]) -> dict[str, Any]:
-    """Run a CLI main(), capture stdout/stderr, and return a structured result.
-
-    Why capture output instead of rewriting: these modules are already mature and covered by tests;
-    rewriting them as "pure functions" has limited benefit and no small regression risk. Captured text +
-    exit code are enough for the MCP caller to judge success and read the details.
-    """
-    out, err = io.StringIO(), io.StringIO()
-    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
-        code = func(argv)
-    return {
-        "ok": code == 0,
-        "exit_code": code,
-        "stdout": out.getvalue().strip(),
-        "stderr": err.getvalue().strip(),
-    }
