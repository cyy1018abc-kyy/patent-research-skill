+
+    parts.append("</body></html>")
+    return "\n".join(parts)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.chain",
+        description="Render the full evidence chain (logs → candidates → runs → ledger → gates) as one offline HTML page",
+    )
+    ap.add_argument("target_id", nargs="?", default=None, help="target ID (default: active)")
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--out", type=Path, default=None,
+                    help="output .html (default: 04_comparative_analysis/<date>_<target>_chain.html)")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+    target = args.target_id or term.active_target
+    if target not in term.targets:
+        print(f"[FATAL] target not registered: {target}", file=sys.stderr)
+        return 2
+
+    payload = build_html(root, target, term)
+    out = args.out or (
+        root / "04_comparative_analysis"
+        / f"{datetime.now().astimezone().date().isoformat()}_{target}_chain.html"
+    )
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(payload, encoding="utf-8")
+    print(f"[WRITE] {out}")
+    print("离线静态页面：无外链、无脚本依赖；含真实检索数据，请勿外发")
+    return 0
