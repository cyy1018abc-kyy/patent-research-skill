+    if concl:
+        parts.append("<table><tr><th>结论文件</th><th>引用 ID</th><th>账本核验</th></tr>")
+        for p, cited, ok in concl:
+            mark = "<span class='ok'>✓ 全部在账本</span>" if ok else "<span class='bad'>✗ 引用了账本外的编号</span>"
+            parts.append(f"<tr><td>{_esc(p.name)}</td><td>{_esc(', '.join(cited) or '—')}</td><td>{mark}</td></tr>")
+        parts.append("</table>")
+    else:
+        parts.append("<p class='note'>（05_novelty_conclusions/ 暂无结论文件）</p>")
+
+    # ── 证据账本 ──
+    parts.append("<h2>⑥ 证据账本（结论唯一可引用的清单）</h2>")
+    if entries:
+        parts.append("<table><tr><th>ID</th><th>文献号</th><th>角色</th><th>分级</th><th>判定状态</th><th>人工确认</th></tr>")
+        for e in entries:
+            parts.append(
+                f"<tr><td>{_esc(e['id'])}</td><td>{_esc(e['doc_number'])}</td><td>{_esc(e['role'])}</td>"
+                f"<td>{_esc(e['evidence_level'])}</td>"
+                f"<td class=\"{'warn' if e['assessment_state'] in ('unknown', 'needs_review') else ''}\">{_esc(e['assessment_state'])}</td>"
+                f"<td>{'✅' if e['human_confirmed'] else '—'}</td></tr>"
+            )
