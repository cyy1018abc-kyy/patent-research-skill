+"""Raw response → candidate list skeleton importer.
+
+Converts export files under `02_search_logs/raw/` into skeleton `03_candidates/*.json`,
+saving the manual labor of "copying hundreds of hits by hand".
+
+Supported raw formats
+---------------------
+* `.json` — Google Patents XHR responses (output of `fetch_googlepatents.py`)
+* `.csv` / `.tsv` — Espacenet / WIPO / IEEE exports, with **automatic column-name detection**
+* `.xml` — not supported yet (CNIPA export); gives a clear message
+
+Design stance
+-------------
+* **Look at the format only, never guess content**: when column names cannot be recognized, raise
+  an error and print the actual headers so the user can specify them explicitly with `--map`;
+  never fill silently wrong.
+* **Dry-run by default**: only `--apply` writes to disk.
+* **Deduplication**: by normalized publication number, against both existing candidates and the current batch.
+* **No overreach in determination**: `relevance` defaults to 3, `novelty_check` to `untouched`,
+  `role` to `pool` — these must be reviewed manually; the tool only builds the skeleton.
+
+Usage
+-----
+    python -m patentkit.ingest --log espacenet_2026-10-15_N1_237.log.json
+    python -m patentkit.ingest --log <log> --raw raw/<file>.csv --apply
+    python -m patentkit.ingest --log <log> --map doc_number='Publication Number' --map title='Title'
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import io
+import json
+import re
+import sys
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from .model import load_candidates, read_json
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+
+#: Candidate ID prefixes
+KIND_PREFIX = {"patent": "P", "paper": "L"}
+
+#: The log's db field → the candidate schema's source_db enum
+DB_ENUM: dict[str, str] = {
+    "espacenet": "Espacenet",
+    "cnipa": "CNIPA",
+    "wipo": "WIPO",
+    "googlepatents": "GooglePatents",
+    "crossref": "Crossref",
+    "cnki": "CNKI",
+    "wanfang": "Wanfang",
+    "vip": "VIP",
+    "ieee": "IEEE",
+    "elsevier": "Elsevier",
+    "springer": "Springer",
+    "wiley": "Wiley",
+    "aiaa": "AIAA",
+    "other": "Other",
+}
+
+#: Separator for multiple values inside one cell (Espacenet squeezes family publication numbers into one
+#: cell, newline-separated)
+# NOTE: data literal, intentionally untranslated: the full-width CJK punctuation in the character class
+# separates values in Chinese data exports and must stay byte-identical.
+MULTI_VALUE_RE = re.compile(r"[\r\n;；,，|]+")
+
+#: Column-name alias table (compared after normalization).
+# NOTE: data literal, intentionally untranslated: the Chinese entries match headers in Chinese data
+# exports (CNIPA / Espacenet zh) and must stay byte-identical.
+COLUMN_ALIASES: dict[str, tuple[str, ...]] = {
+    "doc_number": (
+        "publicationnumber",
+        "publicationnumberoriginal",
+        "docdb",
+        "documentnumber",
+        "number",
+        "publicationnumberdocdb",
+        "公开号",
+        "公开公告号",
+        "公告号",
+        "专利号",
+        "文献号",
+        "申请号",
+    ),
+    "title": ("title", "patenttitle", "标题", "发明名称", "专利名称", "题目"),
+    "applicants": (
+        "applicant",
+        "applicants",
+        "assignee",
+        "assignees",
+        "currentassignee",
+        "originalassignee",
+        "申请人",
+        "专利权人",
+        "作者",
+        "第一作者",
+    ),
+    "date": (
+        "publicationdate",
+        "publicationdateplain",
+        "prioritydate",
+        "filingdate",
+        "公开日",
+        "公开公告日",
+        "公告日",
+        "申请日",
+        "日期",
+        "year",
+        "年",
+    ),
+    "snippet": ("snippet", "abstract", "摘要", "abstracttext", "描述"),
+    "url": ("url", "link", "链接", "详情链接"),
+}
+
+_NORM_RE = re.compile(r"[^0-9a-z\u4e00-\u9fff]+")
+
+
+def norm_header(value: str) -> str:
+    return _NORM_RE.sub("", (value or "").lower())
+
+
+def norm_doc(value: str) -> str:
+    return re.sub(r"[^0-9A-Za-z]", "", (value or "").upper())
+
+
+def extract_year(value: str) -> int | None:
+    m = re.search(r"(19|20)\d{2}", value or "")
+    return int(m.group(0)) if m else None
+
+
+@dataclass
+class RawRecord:
+    doc_number: str
+    title: str
+    applicants: list[str] = field(default_factory=list)
+    date: str = ""
+    snippet: str = ""
+    url: str = ""
+    family: list[str] = field(default_factory=list)
+
+
+# ── Parsing ───────────────────────────────────────────────────────────
+
+
+def parse_googlepatents_json(path: Path) -> list[RawRecord]:
+    data, err = read_json(path)
+    if err is not None or not isinstance(data, dict):
+        raise ValueError(f"cannot parse Google Patents JSON: {err}")
+
+    out: list[RawRecord] = []
+    for cluster in data.get("results", {}).get("cluster") or []:
+        for item in cluster.get("result") or []:
+            p = item.get("patent") or {}
+            doc = str(p.get("publication_number") or "")
+            if not doc:
+                continue
+            title = re.sub(r"</?b>", "", str(p.get("title") or "")).strip()
+            snippet = re.sub(r"</?b>", "", str(p.get("snippet") or "")).strip()
+            assignee = p.get("assignee")
+            applicants = [assignee] if isinstance(assignee, str) and assignee else []
+            out.append(
+                RawRecord(
+                    doc_number=doc,
+                    title=title,
+                    applicants=applicants,
+                    date=str(p.get("publication_date") or p.get("priority_date") or ""),
+                    snippet=snippet,
+                    url=f"https://patents.google.com/patent/{doc}/en",
+                )
+            )
+    return out
+
+
+def detect_columns(headers: list[str]) -> dict[str, str]:
+    """Map actual headers to field names. Only the recognized ones are returned."""
+    mapping: dict[str, str] = {}
+    normalized = {h: norm_header(h) for h in headers}
+    for field_name, aliases in COLUMN_ALIASES.items():
+        for header, nrm in normalized.items():
+            if not nrm:
+                continue
+            if nrm in aliases:
+                mapping[field_name] = header
+                break
+        else:
+            # Fallback: substring match (e.g. "Publication Number (docdb)")
+            for header, nrm in normalized.items():
+                if nrm and any(a in nrm for a in aliases):
+                    mapping[field_name] = header
+                    break
+    return mapping
+
+
+def find_header_row(rows: list[list[str]], scan: int = 30) -> int:
+    """Find the **real header row** among the first few rows.
+
+    Espacenet's CSV has metadata in the first few rows ("Espacenet" / "Patent search" /
+    "237 results found for ..." / "Results 1 to 20 displayed" / blank lines); taking row 0 as the
+    header would yield a pile of garbage column names.
+
+    Strategy: score each row by "how many known column names it hits" and take the best one;
+    fall back to row 0 when fewer than 2 are hit.
+    """
+    best_idx, best_score = 0, -1
+    for i, row in enumerate(rows[:scan]):
+        score = len(detect_columns([c.strip() for c in row]))
+        if score > best_score:
+            best_idx, best_score = i, score
+    return best_idx if best_score >= 2 else 0
+
+
+def read_csv_rows(path: Path) -> tuple[list[dict[str, str]], list[str]]:
+    """Read CSV, trying common encodings one by one (CNIPA exports are often GBK / UTF-8-BOM).
+
+    Uses `csv.reader` + `StringIO` rather than `text.splitlines()` —
+    the latter would cut multi-line fields inside quotes (Espacenet applicants are often multi-line).
+    """
+    last_exc: Exception | None = None
+    text = ""
+    for enc in ("utf-8-sig", "utf-8", "gb18030", "gbk", "latin-1"):
+        try:
+            text = path.read_text(encoding=enc)
+            break
+        except (UnicodeDecodeError, LookupError) as exc:
+            last_exc = exc
+    else:  # pragma: no cover
+        raise ValueError(f"cannot decode {path.name}: {last_exc}")
+
+    sample = text[:8192]
+    try:
+        dialect = csv.Sniffer().sniff(sample, delimiters=",;\t|")
+    except csv.Error:
+        dialect = csv.excel
+
+    all_rows = [row for row in csv.reader(io.StringIO(text), dialect)]
+    if not all_rows:
+        return [], []
+
+    header_idx = find_header_row(all_rows)
+    headers = [h.strip() for h in all_rows[header_idx]]
+
+    out: list[dict[str, str]] = []
+    for row in all_rows[header_idx + 1:]:
+        if not any(c.strip() for c in row):
+            continue
+        padded = list(row) + [""] * max(0, len(headers) - len(row))
+        out.append({headers[i]: padded[i] for i in range(len(headers))})
+    return out, headers
+
+
+def parse_csv(path: Path, overrides: dict[str, str]) -> list[RawRecord]:
+    rows, headers = read_csv_rows(path)
+    mapping = detect_columns(headers)
+    mapping.update(overrides)
+
+    missing = [f for f in ("doc_number", "title") if f not in mapping]
+    if missing:
+        raise ValueError(
+            f"could not recognize required columns {missing}.\n"
+            f"  Actual headers: {headers}\n"
+            f"  Recognized: {mapping}\n"
+            f"  Specify explicitly with --map {missing[0]}='<column name>'"
+        )
+
+    out: list[RawRecord] = []
+    for row in rows:
+        # A publication-number cell often squeezes several family numbers (newline-separated) —
+        # take the first as the main number and put the rest into family
+        doc_cell = (row.get(mapping["doc_number"]) or "").strip()
+        parts = [p.strip() for p in MULTI_VALUE_RE.split(doc_cell) if p.strip()]
+        if not parts:
+            continue
+
+        raw_applicants = (row.get(mapping.get("applicants", "")) or "").strip()
+        # Applicants are often multi-line cells inside quotes (Espacenet does this), so newlines also count as separators
+        applicants = [a.strip() for a in MULTI_VALUE_RE.split(raw_applicants) if a.strip()]
+
+        out.append(
+            RawRecord(
+                doc_number=parts[0],
+                title=(row.get(mapping["title"]) or "").strip(),
+                applicants=applicants,
+                date=(row.get(mapping.get("date", "")) or "").strip(),
+                snippet=(row.get(mapping.get("snippet", "")) or "").strip(),
+                url=(row.get(mapping.get("url", "")) or "").strip(),
+                family=parts[1:],
+            )
+        )
+    return out
+
+
+def parse_cnipa_json(path: Path) -> list[RawRecord]:
+    """CNIPA publication/grant search response (output of `patentkit.cnipa`).
+
+    Response shape: `{"hits": [{pub_number, title, applicant, inventors, abstract,
+    publication_date, link, ipc_codes, ...}]}`
+
+    Note that titles carry a bracketed type prefix (e.g. an invention-publication or
+    utility-model marker) — strip it. The patent type is already encoded by the publication
+    number (CN1…A invention / CN2…U utility model / CN3…S design).
+    """
+    data, err = read_json(path)
+    if err is not None or not isinstance(data, dict):
+        raise ValueError(f"cannot parse CNIPA JSON: {err}")
+
+    hits = data.get("hits")
+    if not isinstance(hits, list):
+        raise ValueError("CNIPA JSON is missing the hits array")
+
+    out: list[RawRecord] = []
+    for h in hits:
+        if not isinstance(h, dict):
+            continue
+        doc = str(h.get("pub_number") or "").strip()
+        if not doc:
+            continue
+        # NOTE: data literal, intentionally untranslated: the CJK bracket characters in the pattern
+        # match title type prefixes in CNIPA data and must stay byte-identical.
+        title = re.sub(
+            r"^\s*[\[【][^\]】]{1,12}[\]】]\s*", "", str(h.get("title") or "")
+        ).strip()
+        applicant = str(h.get("applicant") or "").strip()
+        out.append(
+            RawRecord(
+                doc_number=doc,
+                title=title or doc,
+                applicants=[applicant] if applicant else [],
+                date=str(h.get("publication_date") or h.get("filing_date") or ""),
+                snippet=str(h.get("abstract") or "").strip(),
+                url=str(h.get("link") or ""),
+            )
+        )
+    return out
+
+
+def parse_crossref_json(path: Path) -> list[RawRecord]:
+    """Crossref works response (output of `patentkit.fetch_crossref`).
+
+    Response shape: `{"message": {"total-results": N, "items": [{DOI, title[], author[],
+    issued{date-parts[[y,m,d]]}, container-title[], abstract, type, ...}]}}`
+
+    Key points:
+    * `title` / `container-title` are **arrays**; take the first non-empty element
+    * `author` is an array of objects → join as `Family, Given`
+    * `abstract` often carries JATS tags (`<jats:p>`); strip the tags and use it as the summary
+    * The document number is the **DOI** — a resolvable, replayable stable identifier
+    """
+    data, err = read_json(path)
+    if err is not None or not isinstance(data, dict):
+        raise ValueError(f"cannot parse Crossref JSON: {err}")
+
+    msg = data.get("message")
+    if not isinstance(msg, dict):
+        raise ValueError("Crossref JSON is missing the message object")
+    items = msg.get("items")
+    if not isinstance(items, list):
+        raise ValueError("Crossref JSON is missing the message.items array")
+
+    out: list[RawRecord] = []
+    for it in items:
+        if not isinstance(it, dict):
+            continue
+        doi = str(it.get("DOI") or "").strip()
+        if not doi:
+            continue
+        titles = it.get("title") or []
+        title = str(titles[0]).strip() if titles else ""
+        title = re.sub(r"<[^>]+>", "", title).strip() or doi
+
+        authors: list[str] = []
+        for a in it.get("author") or []:
+            if not isinstance(a, dict):
+                continue
+            fam = str(a.get("family") or "").strip()
+            giv = str(a.get("given") or "").strip()
+            if fam and giv:
+                authors.append(f"{fam}, {giv}")
+            elif fam or giv:
+                authors.append(fam or giv)
+
+        year = ""
+        parts = (it.get("issued") or {}).get("date-parts") or []
+        if parts and isinstance(parts[0], list) and parts[0]:
+            year = str(parts[0][0])
+
+        abstract = str(it.get("abstract") or "")
+        abstract = re.sub(r"<[^>]+>", " ", abstract)
+        abstract = re.sub(r"\s+", " ", abstract).strip()
+
+        out.append(
+            RawRecord(
+                doc_number=doi,
+                title=title,
+                applicants=authors,
+                date=year,
+                snippet=abstract,
+                url=f"https://doi.org/{doi}",
+            )
+        )
+    return out
+
+
+def parse_ops_xml(path: Path) -> list[RawRecord]:
+    """OPS (Espacenet OPS API) exchange-document XML export.
+
+    Shape: `<ops:world-patent-data><ops:exchange-documents><ops:exchange-document …>`
+    with `ex:bibliographic-data` carrying publication-reference / invention-title /
+    applicants / abstract. Namespace prefixes vary between OPS versions, so matching is
+    **localname-based** (`{any}exchange-document`), never prefix-based.
+
+    Conservative choices (this parser feeds candidate skeletons — missing data stays
+    missing rather than being guessed):
+    * doc number = `country doc-number kind` (spaced form, consistent with the rest of
+      the repo); documents without a publication-reference doc-number are skipped;
+    * title / abstract prefer `lang` starting with `zh`, falling back to the first entry;
+    * applicants = the applicant `name` list; family data is NOT taken from OPS XML here
+      (the G-S-04 census artifact via `fetch-bigquery --fill` is the authoritative path).
+    """
+    import xml.etree.ElementTree as ET
+
+    try:
+        root = ET.parse(path).getroot()
+    except ET.ParseError as exc:
+        raise ValueError(f"cannot parse OPS XML: {exc}")
+
+    def local(tag: str) -> str:
+        return tag.rsplit("}", 1)[-1]
+
+    def find_first(element: ET.Element, name: str) -> ET.Element | None:
+        for child in element.iter():
+            if local(child.tag) == name:
+                return child
+        return None
+
+    def text_of(element: ET.Element | None) -> str:
+        if element is None:
+            return ""
+        return " ".join("".join(element.itertext()).split())
+
+    def pick_lang(parent: ET.Element, name: str) -> ET.Element | None:
+        hits = [e for e in parent.iter() if local(e.tag) == name]
+        if not hits:
+            return None
+        for e in hits:
+            if str(e.get("lang") or "").lower().startswith("zh"):
+                return e
+        return hits[0]
+
+    out: list[RawRecord] = []
+    for doc in root.iter():
+        if local(doc.tag) != "exchange-document":
+            continue
+        country = str(doc.get("country") or "")
+        number = str(doc.get("doc-number") or "")
+        kind = str(doc.get("kind") or "")
+        if not (country and number):
+            continue
+        doc_number = f"{country} {number} {kind}".strip()
+
+        pub_ref = find_first(doc, "publication-reference")
+        date_el = find_first(pub_ref, "date") if pub_ref is not None else None
+        date = text_of(date_el)
+
+        title = text_of(pick_lang(doc, "invention-title"))
+        abstract = text_of(pick_lang(doc, "abstract"))
+
+        applicants: list[str] = []
+        for applicant in (e for e in doc.iter() if local(e.tag) == "applicant"):
+            value = text_of(find_first(applicant, "name"))
+            if value:
+                applicants.append(value)
+
+        out.append(RawRecord(
+            doc_number=doc_number,
+            title=title,
+            applicants=applicants,
+            date=date,
+            snippet=abstract,
+        ))
+    if not out:
+        raise ValueError(
+            f"no exchange-document with a usable publication reference in {path.name} — "
+            "is this really an OPS export?"
+        )
+    return out
+
+
+def read_raw(path: Path, overrides: dict[str, str]) -> list[RawRecord]:
+    """Dispatch the JSON parser **by content**.
+
+    The three .json outputs are distinguished by shape, not by file name:
+      CNIPA      `{"hits": [...]}`
+      Crossref   `{"message": {"items": [...]}}`
+      GooglePat  `{"results": {"cluster": [...]}}` (fallback)
+    """
+    suffix = path.suffix.lower()
+    if suffix == ".json":
+        data, _ = read_json(path)
+        if isinstance(data, dict) and "hits" in data:
+            return parse_cnipa_json(path)
+        if isinstance(data, dict) and isinstance(data.get("message"), dict):
+            return parse_crossref_json(path)
+        return parse_googlepatents_json(path)
+    if suffix in {".csv", ".tsv", ".txt"}:
+        return parse_csv(path, overrides)
+    if suffix == ".xml":
+        return parse_ops_xml(path)
+    raise ValueError(
+        f"format {suffix} is not supported yet ({path.name}). "
+        f"Currently supported: .json (CNIPA / Crossref / Google Patents), "
+        f".csv/.tsv (Espacenet / WIPO / IEEE etc.) and .xml (OPS export)."
+    )
+
+
+# ── Assembling candidates ─────────────────────────────────────────────
+
+
+def next_id(prefix: str, used: set[str]) -> str:
+    n = 1
+    while True:
+        candidate = f"{prefix}-{n:03d}"
+        if candidate not in used:
+            used.add(candidate)
+            return candidate
+        n += 1
+
+
+def make_bibtex_key(record: RawRecord) -> str:
+    core = re.sub(r"[^0-9a-z]", "", record.doc_number.lower())
+    year = extract_year(record.date)
+    return f"{core}{year}" if year else core
+
+
+def build_candidate(
+    record: RawRecord,
+    cid: str,
+    kind: str,
+    target: str,
+    tags: list[str],
+    raw_ref: str,
+    source_log: str,
+    source_db: str = "Other",
+) -> dict[str, Any]:
+    year = extract_year(record.date) or 1900
+    return {
+        "id": cid,
+        "kind": kind,
+        "target": target,
+        "title": record.title or record.doc_number,
+        "authors_or_applicants": record.applicants or ["(unknown)"],
+        "year": year,
+        "source_db": source_db,
+        "url_or_doc_number": record.doc_number,
+        "summary_zh": (record.snippet[:190] if record.snippet else ""),
+        "relevance": 3,
+        "novelty_check": "untouched",
+        "role": "pool",
+        "evidence_level": "verified",
+        "evidence_ref": raw_ref,
+        "evidence_sha256": None,
+        "tags": tags,
+        "logged_at": "",
+        "source_log": source_log,
+        "family": list(record.family),
+        "cited_by": [],
+        "pdf_path": None,
+        "bibtex_key": make_bibtex_key(record),
+    }
+
+
+# ── Main flow ─────────────────────────────────────────────────────────
+
+
+def resolve_raw_files(root: Path, log_path: Path, explicit: Path | None) -> list[Path]:
+    if explicit:
+        return [explicit if explicit.is_absolute() else (root / explicit)]
+
+    data, err = read_json(log_path)
+    if err is not None or not isinstance(data, dict):
+        raise ValueError(f"cannot parse log {log_path.name}: {err}")
+
+    ref = (data.get("result") or {}).get("raw_export")
+    if not ref:
+        raise ValueError(f"{log_path.name} has no result.raw_export; specify it with --raw")
+
+    first = (log_path.parent / ref).resolve()
+    if not first.is_file():
+        raise FileNotFoundError(
+            f"raw artifact does not exist: {ref}\n"
+            f"  expected path: {first}\n"
+            f"  put the export file there first, or specify it with --raw"
+        )
+
+    # Multiple pages: collect page-2, page-3 … by the same prefix
+    stem = first.stem
+    suffix = first.suffix
+    out = [first]
+    n = 2
+    while True:
+        nxt = first.with_name(f"{stem.rsplit('_page-', 1)[0]}_page-{n}{suffix}")
+        if nxt.is_file():
+            out.append(nxt)
+            n += 1
+        else:
+            break
+    return out
+
+
+def run(args: argparse.Namespace) -> int:
+    root = (args.root or workspace_or_exit()).resolve()
+
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    log_path = (root / "02_search_logs" / args.log)
+    if not log_path.is_file():
+        print(f"[FATAL] log does not exist: {log_path}", file=sys.stderr)
+        return 2
+
+    log_data, _ = read_json(log_path)
+    target = str((log_data or {}).get("target") or "")
+    axis = str(((log_data or {}).get("query") or {}).get("id") or "").split("@")[0]
+    if not target:
+        print("[FATAL] the log is missing the target field", file=sys.stderr)
+        return 2
+
+    # tags: defaults to [axis@target]; for cross axes, give them explicitly with --tag
+    if args.tag:
+        tags = list(args.tag)
+    else:
+        tags = [f"{axis}@{target}"]
+
+    for t in tags:
+        if t not in term.axes:
+            print(
+                f"[FATAL] tag '{t}' is not registered in the glossary. Registered: {sorted(term.axes)}\n"
+                f"        for cross axes (C1/C2/C3), specify their component axes with --tag, e.g. "
+                f"--tag N1@{target} --tag N5@{target}",
+                file=sys.stderr,
+            )
+            return 2
+
+    overrides = dict(m.split("=", 1) for m in (args.map or []) if "=" in m)
+
+    try:
+        raw_files = resolve_raw_files(root, log_path, args.raw)
+    except (FileNotFoundError, ValueError) as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 3
+
+    print(f"Log    : {log_path.name}")
+    print(f"Target : {target}")
+    print(f"Axis/tags: {tags}")
+    print(f"Raw    : {', '.join(p.name for p in raw_files)}")
+    print(f"Mode   : {'APPLY (write to disk)' if args.apply else 'DRY-RUN (preview)'}")
+    print()
+
+    records: list[RawRecord] = []
+    for p in raw_files:
+        try:
+            part = read_raw(p, overrides)
+        except ValueError as exc:
+            print(f"[FATAL] {p.name}: {exc}", file=sys.stderr)
+            return 3
+        print(f"  {p.name}: parsed {len(part)} records")
+        records.extend(part)
+
+    if not records:
+        print("\nNo records were parsed.")
+        return 0
+
+    # Deduplication: compare against existing candidates first, then within the batch
+    existing = load_candidates(root)
+    seen_docs = {norm_doc(c.doc_number) for c in existing if c.doc_number}
+    used_ids = {c.id for c in existing}
+
+    fresh: list[RawRecord] = []
+    dup_existing = dup_batch = 0
+    for r in records:
+        key = norm_doc(r.doc_number)
+        if not key:
+            continue
+        if key in seen_docs:
+            if key in {norm_doc(x.doc_number) for x in fresh}:
+                dup_batch += 1
+            else:
+                dup_existing += 1
+            continue
+        seen_docs.add(key)
+        fresh.append(r)
+
+    if args.limit:
+        fresh = fresh[: args.limit]
+
+    print()
+    print(f"New records {len(fresh)}; duplicates skipped: {dup_existing} against existing candidates, {dup_batch} within the batch")
+    print()
+
+    # 组装
+    log_db = str((log_data or {}).get("db") or "")
+    source_db = DB_ENUM.get(log_db.lower(), "Other")
+    raw_ref = f"../02_search_logs/raw/{raw_files[0].name}"
+    source_log = f"../02_search_logs/{log_path.name}"
+    created: list[tuple[str, dict[str, Any]]] = []
+    for r in fresh:
+        cid = next_id(KIND_PREFIX[args.kind], used_ids)
+        created.append(
+            (
+                cid,
+                build_candidate(
+                    r, cid, args.kind, target, tags, raw_ref, source_log, source_db
+                ),
+            )
+        )
+
+    for cid, cand in created[: args.show]:
+        print(f"  {cid}  {cand['year']}  {cand['url_or_doc_number']:<20}  {cand['title'][:56]}")
+    if len(created) > args.show:
+        print(f"  … {len(created) - args.show} more omitted")
+
+    if not args.apply:
+        print()
+        print("Not written. Add --apply once confirmed")
+        print("⚠️ After writing, review manually: relevance (defaults to 3), novelty_check, role, summary_zh")
+        return 0
+
+    out_dir = root / "03_candidates"
+    now = args.now or ""
+    for cid, cand in created:
+        cand["logged_at"] = now
+        p = out_dir / f"{cid}-{norm_doc(cand['url_or_doc_number']).lower()}.json"
+        p.write_text(
+            json.dumps(cand, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+        )
+
+    print()
+    print(f"Wrote {len(created)} candidate files to 03_candidates/")
+    print("Next: python -m patentkit.validate && python -m patentkit.gates")
+    return 0
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.ingest",
+        description="Raw response → candidate list skeleton",
+    )
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--log", required=True, help="log file name under 02_search_logs/")
+    ap.add_argument("--raw", type=Path, default=None, help="raw file (defaults to the log's raw_export)")
+    ap.add_argument("--kind", choices=["patent", "paper"], default="patent")
+    ap.add_argument(
+        "--tag",
+        action="append",
+        help="candidate tags (repeatable); for cross axes give the component axes explicitly; defaults to [axis@target]",
+    )
+    ap.add_argument(
+        "--map",
+        action="append",
+        metavar="FIELD=COLUMN",
+        help="CSV column-name override, e.g. --map doc_number='Publication Number'",
+    )
+    ap.add_argument("--limit", type=int, default=0, help="process only the first N records")
+    ap.add_argument("--show", type=int, default=20, help="number of records to show in the preview")
+    ap.add_argument("--apply", action="store_true", help="write to disk (preview only by default)")
+    ap.add_argument(
+        "--now",
+        default="",
+        help="value written to logged_at (ISO8601 with time zone); when empty it is treated as pending and validate reports V015",
+    )
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    return run(build_parser().parse_args(argv))
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
