+            if role not in valid_roles:
+                report.errors.append(
+                    f"row {i} role='{role}' is not registered in the glossary ({sorted(valid_roles)})"
+                )
+            else:
+                new["role"] = role
+
+        nov = raw["novelty_check"]
+        if nov:
+            if nov not in valid_novelty:
+                report.errors.append(
+                    f"row {i} novelty_check='{nov}' is not registered ({sorted(valid_novelty)})"
+                )
+            else:
+                new["novelty_check"] = nov
+
+        note = raw["review_note"]
+        if note:
+            new["review_note"] = note
+
+        if not new:
+            continue
+
+        changed = {k: v for k, v in new.items() if cand.data.get(k) != v}
+
+        # Record a review timestamp. Written in two cases:
+        #   a) there is a substantive change — this shows something really changed
+        #   b) never marked reviewed before — even "scored 3, same as the default" must leave a trace,
+        #      otherwise this entry is forever treated as "not judged" and will be exported again next time.
+        if changed or not (cand.data.get("reviewed_at") or "").strip():
+            new["reviewed_at"] = now_iso
+            changed = {k: v for k, v in new.items() if cand.data.get(k) != v}
+
+        if changed:
+            pending.append((cand, changed))
+
+    # ── Any error means nothing is written (fail means write nothing; this must genuinely hold) ──
+    if report.errors:
+        report.aborted = True
+        report.changed = 0
+        return report
+
+    report.changed = len(pending)
+    # 先构建并校验所有完整记录，dry-run 也报告同样的结构错误。
+    updates = []
+    for cand, changed in pending:
+        data = dict(cand.data)
+        data.update(changed)
+        # 旧 CSV 不补造身份或确认；有署名时保留可复用依据，但仍需显式 confirm。
+        basis = (cand.data.get("assessment") or {}).get("basis") or {}
+        data["assessment"] = {"actor": "human" if by.strip() else "unknown", "by": by,
+                              "at": now_iso, "basis": basis, "fingerprint": None}
+        if by.strip():
+            data["assessment"]["fingerprint"] = assessment.fingerprint(Candidate(data, cand.path), root)
+        data = assessment.with_history(cand, data, "csv:human" if by.strip() else "csv:unknown")
+        try:
+            assessment.validate_data(data)
+        except ValueError as exc:
+            report.errors.append(f"{cand.id}: {exc}")
+        updates.append((cand.path, cand.data, data))
+    if report.errors:
+        report.aborted = True
+        report.changed = 0
+        return report
+    if dry_run:
+        return report
+    assessment.commit_batch(updates, True)
+    report.written = len(updates)
+
+    return report
+
+
+# ── CLI ───────────────────────────────────────────────────────────────
+
+
+def _add_common(ap: argparse.ArgumentParser) -> None:
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--target", default="")
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.review",
+        description="Manual relevance review: export worksheet / write back determinations",
+    )
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    p_exp = sub.add_parser("export", help="export an editable CSV worksheet")
+    _add_common(p_exp)
+    p_exp.add_argument("--axis", default="", help="export only one axis, e.g. N1")
+    p_exp.add_argument("--with-abstract", action="store_true", help="export only entries that have an abstract")
+    p_exp.add_argument("--unreviewed", action="store_true", help="export only entries not yet determined (relevance=3)")
+    p_exp.add_argument(
+        "--min-relevance",
+        type=int,
+        default=0,
+        metavar="N",
+        help="export only already-judged entries with relevance≥N (for picking near prior art, e.g. --min-relevance 4)",
+    )
+    p_exp.add_argument(
+        "--role",
+        default="",
+        help="export only candidates with a given role, e.g. --role near_prior_art (for the G-S-03 per-document novelty tier)",
+    )
+    p_exp.add_argument(
+        "--with-topics",
+        action="store_true",
+        help=(
+            "add `hit_group_count` / `topic_hits` columns and sort by hit count — "
+            "navigation for picking near prior art, **not a determination** (see patentkit/topics.py)"
+        ),
+    )
+    p_exp.add_argument("--limit", type=int, default=0)
+    p_exp.add_argument("--out", type=Path, required=True, help="output CSV path")
+    p_exp.add_argument("--format", choices=("csv", "json"), default="csv", help="JSON exports explicit candidate IDs, current fingerprints and basis placeholders")
+
+    p_app = sub.add_parser("apply", help="write determinations back to the candidate JSON")
+    _add_common(p_app)
+    p_app.add_argument("sheet", type=Path, help="CSV with the determinations filled in")
+    p_app.add_argument("--apply", action="store_true", help="actually write to disk (dry-run by default)")
+    p_app.add_argument("--by", default="", help="explicit human reviewer identity; no identity is inferred from legacy sheets")
+
+    for command in ("assess", "confirm", "migrate-assessments"):
+        parser = sub.add_parser(command, help="source-independent judgment protocol; dry-run by default")
+        _add_common(parser)
+        parser.add_argument("--apply", action="store_true")
+        if command != "migrate-assessments":
+            parser.add_argument("sheet", type=Path, help="UTF-8 JSON array with explicit candidate IDs and expected_fingerprint")
+            parser.add_argument("--by", required=True, help="recorded actor identity; confirm is human-only")
+        if command == "assess":
+            parser.add_argument("--actor", choices=("ai", "human"), required=True)
+
+    p_prog = sub.add_parser("progress", help="judged / unjudged statistics per axis")
+    _add_common(p_prog)
+    return ap
+
+
+def run(args: argparse.Namespace) -> int:
+    root = (args.root or workspace_or_exit()).resolve()
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    if args.cmd in {"assess", "confirm", "migrate-assessments"}:
+        try:
+            if args.cmd == "migrate-assessments":
+                result = assessment.migrate_workspace(root, apply=args.apply)
+            else:
+                path = args.sheet if args.sheet.is_absolute() else root / args.sheet
+                rows = json.loads(path.read_text(encoding="utf-8"))
+                func = assessment.assess_batch if args.cmd == "assess" else assessment.confirm_batch
+                extra = {"actor": args.actor} if args.cmd == "assess" else {}
+                result = func(root, rows, by=args.by, target=args.target, apply=args.apply, **extra)
+            print(json.dumps(result, ensure_ascii=False))
+            return 0
+        except (ValueError, OSError) as exc:
+            print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False))
+            return 1
+
+    if args.cmd == "export":
+        harvested = harvest_abstracts(root)
+        cands = select_candidates(
+            root,
+            term,
+            target=args.target,
+            axis=args.axis,
+            with_abstract=args.with_abstract,
+            unreviewed_only=args.unreviewed,
+            min_relevance=args.min_relevance,
+            role=args.role,
+            limit=args.limit,
+            harvested=harvested,
+        )
+        if not cands:
+            print("No candidates matched.")
+            return 0
+        if args.with_topics:
+            # Sort by technical-element hit count: more matched groups first, then relevance
+            tgt = args.target or term.active_target
+            cands.sort(
+                key=lambda c: (
+                    -topics.hit_groups(
+                        topics.strip_markup(f"{c.title} {abstract_for(c, harvested)}"),
+                        tgt,
+                    )[0],
+                    -c.relevance,
+                    c.tags[0] if c.tags else "",
+                    c.id,
+                )
+            )
+        out = args.out if args.out.is_absolute() else (root / args.out)
+        if args.format == "json":
+            rows = [{"candidate_id": c.id, "expected_fingerprint": assessment.fingerprint(c, root),
+                     "relevance_problem": None, "relevance_means": None,
+                     "role": c.data.get("role", "pool"), "novelty_check": c.data.get("novelty_check", "untouched"),
+                     "review_note": "", "basis": {}} for c in cands]
+            out.parent.mkdir(parents=True, exist_ok=True)
+            out.write_text(json.dumps(rows, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+            print(f"JSON assessment worksheet written: {out}")
+            return 0
+        write_worksheet(
+            cands,
+            harvested,
+            out,
+            target=args.target or term.active_target,
+            with_topics=args.with_topics,
+        )
+        with_abs = sum(1 for c in cands if abstract_for(c, harvested))
+        print(f"Worksheet written: {out.relative_to(root).as_posix()}")
+        print(f"  Candidates: {len(cands)} ({with_abs} with an abstract)")
+        if args.with_topics:
+            n_groups = len(topics.concepts_for(args.target or term.active_target))
+            print("  ⚠️ Added the `hit_group_count` / `topic_hits` columns and sorted by hit count — this is **navigation, not determination**:")
+            print(f"     Fewer hits != irrelevant (short Chinese abstracts and reworded terminology both cause missed hits). {n_groups} technical-element groups in total.")
+        else:
+            print(f"  Columns: {', '.join(COLUMNS)}")
+        print()
+        print("How to fill in: write only in the five determination columns.")
+        print("  · relevance_problem — technical problem relevance 1–5 (how much its problem overlaps with this invention's)")
+        print("  · relevance_means   — technical means relevance 1–5 (how much its means overlap with this invention's)")
+        print("      ↳ relevance = min(relevance_problem, relevance_means); **only ≥4 counts toward G-S-02**")
+        print("      ↳ Both dimensions must qualify — a differing problem cannot be rescued by similar means")
+        print("  · role              — near_prior_art / pool / family / excluded (may be left blank; used for G-S-03)")
+        print("  · novelty_check     — untouched / partial / covered / blocking (may be left blank)")
+        print("  · review_note       — state “which feature was disclosed”, not “it feels related”")
+        print("  · A row with all determination columns empty = skipped; no value is reset")
+        print("  · Filling only one dimension is also accepted (treated as a single-dimension determination)")
+        print()
+        print("Write back: python -m patentkit.review apply <this file> [--apply]")
+        print()
+        print("ℹ️ After editing in Excel, **just save directly** — on Chinese Windows, Excel saves the CSV")
+        print("   as GBK and wipes the BOM; this tool detects the encoding automatically when reading, so no Save As is needed.")
+        return 0
+
+    if args.cmd == "apply":
+        sheet = args.sheet if args.sheet.is_absolute() else (root / args.sheet)
+        rep = apply_worksheet(root, term, sheet, dry_run=not args.apply, by=args.by, target=args.target)
+        print(f"Worksheet: {args.sheet}")
+        if rep.encoding:
+            note = (
+                " (Excel saved it as GBK — detected automatically, no action needed)"
+                if rep.encoding.startswith("gb")
+                else ""
+            )
+            print(f"  Encoding detected: {rep.encoding} {note}")
+
+        if rep.errors:
+            # Any error means not a single byte was written — this must be stated clearly,
+            # otherwise the user may think part of it was changed
+            print(f"  ❌ Aborted: **not a single byte was written**")
+            print(f"  {len(rep.errors)} errors:")
+            for e in rep.errors[:12]:
+                if len(rep.errors) > 12:
+                    pass
+                print(f"    · {e}")
+            if len(rep.errors) > 12:
+                print(f"    … {len(rep.errors) - 12} more")
+            print()
+            print("  Fix the rows the worksheet reports as errors and re-run. **Rows already judged are not lost** —")
+            print("  the determinations all live in the worksheet; writing is idempotent, so a re-run only fills in what has not yet been written.")
+            return 1
+
+        if rep.unknown:
+            print(f"  ⚠️ {len(rep.unknown)} unknown candidate IDs (skipped): {rep.unknown[:8]}")
+
+        if not args.apply:
+            print(f"  Would change {rep.changed} entries · {rep.skipped} blank rows skipped")
+            print()
+            print("Not written. Add --apply once confirmed")
+        else:
+            print(f"  Wrote {rep.written} entries · {rep.skipped} blank rows skipped")
+            print()
+            print("Next: python -m patentkit.validate --strict && python -m patentkit.gates")
+        return 0
+
+    if args.cmd == "progress":
+        rows = review_progress(root, term, args.target or term.active_target)
+        print(f"{'Axis':<6}{'Total':>6}{'Judged':>7}{'of 3':>7}{'Unjudged':>9}{'≥4':>6}")
+        for r in rows:
+            print(
+                f"{r['axis']:<6}{r['total']:>6}{r['judged']:>7}"
+                f"{r['judged_as_3']:>7}"
+                f"{r['total'] - r['judged']:>9}{r['ge4']:>6}"
+            )
+        print()
+        print("Judged requires a current supported assessment with a known actor; legacy scores alone do not qualify.")
+        print("The ≥4 column uses the same eligibility rule as G-S-02; source evidence levels are shown by gates.")
+        print("Export the unjudged ones: python -m patentkit review export --unreviewed --with-abstract ...")
+        return 0
+
+    return 64
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    return run(build_parser().parse_args(argv))
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
