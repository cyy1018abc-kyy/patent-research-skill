+
+def read_reference(name: str, ws: str | Path | None = None) -> str:
+    """Read one methodology reference document. name is a key from list_references()."""
+    rel = REFERENCES.get(name)
+    if rel is None:
+        raise KeyError(f"unknown reference document '{name}'; available: {', '.join(sorted(REFERENCES))}")
+
+    root = workspace(ws)
+    path = root / rel
+    if not path.is_file():
+        raise FileNotFoundError(f"reference document does not exist: {rel}")
+    return path.read_text(encoding="utf-8")
