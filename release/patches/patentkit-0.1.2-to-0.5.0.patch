+"""Auto-generate INDEX.md — so the index cannot drift (fixes C2).
+
+Scans every Markdown file in the repo, reads its YAML frontmatter (falling back to the first
+H1 as the title when absent), groups by top-level directory, and generates an index table.
+
+Convention: generated blocks are wrapped in GENERATED fences; manual annotations outside the
+fences are never overwritten. Dry-run by default; only `--write` writes to disk.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+
+import yaml
+
+from .paths import workspace_or_exit
+
+GEN_BEGIN = "<!-- BEGIN GENERATED: index -->"
+GEN_END = "<!-- END GENERATED: index -->"
+
+FRONTMATTER_RE = re.compile(r"\A---\s*\n(.*?)\n---\s*\n", re.DOTALL)
+H1_RE = re.compile(r"^#\s+(?P<title>.+?)\s*$", re.MULTILINE)
+
+#: Directories skipped during scanning (besides this list, **any directory starting with a dot is also skipped**)
+SKIP_DIRS = {
+    ".git",
+    ".github",
+    "patentkit",  # code package: not part of the content index
+    "patentkit.egg-info",  # artifact of pip install -e .
+    "dist",  # build artifacts
+    "build",  # build artifacts
+    "tests",
+    "__pycache__",
+    ".venv",
+    "raw",
+    "withdrawn",
+    "evidence",  # captured evidence bundles: raw material, not content docs
+}
+
+#: The generated artifact itself must not appear in the index
+SKIP_FILES = {"INDEX.md"}
+
+
+def should_skip(rel_parts: tuple[str, ...]) -> bool:
+    """Decide whether the **directory part** of a path should be skipped.
+
+    Directories starting with a dot are always skipped — this covers .pytest_cache /
+    .mypy_cache / .ruff_cache and any hidden directory future tools may generate. The explicit
+    list is just an extra safeguard.
+    """
+    for part in rel_parts:
+        if part in SKIP_DIRS or part.startswith("."):
+            return True
+    return False
+
+
+@dataclass
+class DocMeta:
+    path: Path
+    rel: str
+    group: str
+    stage: str
+    role: str
+    title: str
+    generated: bool
+
+    def to_dict(self) -> dict:
+        return {
+            "path": self.rel,
+            "group": self.group,
+            "stage": self.stage,
+            "role": self.role,
+            "title": self.title,
+            "generated": self.generated,
+        }
+
+
+def parse_doc(path: Path, root: Path) -> DocMeta:
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError:
+        text = ""
+
+    front: dict = {}
+    m = FRONTMATTER_RE.match(text)
+    if m:
+        try:
+            loaded = yaml.safe_load(m.group(1))
+            if isinstance(loaded, dict):
+                front = loaded
+        except yaml.YAMLError:
+            front = {}
+
+    title = str(front.get("title") or "")
+    if not title:
+        h1 = H1_RE.search(text)
+        title = h1.group("title").strip() if h1 else path.stem
+
+    rel = path.relative_to(root).as_posix()
+    parts = rel.split("/")
+    group = parts[0] if len(parts) > 1 else "(root directory)"
+
+    return DocMeta(
+        path=path,
+        rel=rel,
+        group=group,
+        stage=str(front.get("stage") or ""),
+        role=str(front.get("role") or ""),
+        title=title,
+        generated=bool(front.get("generated", False)),
+    )
+
+
+def collect(root: Path) -> list[DocMeta]:
+    docs: list[DocMeta] = []
+    for path in sorted(root.rglob("*.md")):
+        rel = path.relative_to(root)
+        if should_skip(rel.parts[:-1]):
+            continue
+        if rel.as_posix() in SKIP_FILES:
+            continue
+        docs.append(parse_doc(path, root))
+    return docs
+
+
+def render(docs: list[DocMeta], generated_at: str) -> str:
+    lines = [GEN_BEGIN, ""]
+    lines.append("## Content index (auto-generated)")
+    lines.append("")
+    lines.append(f"> Generated by `python -m patentkit.index --write` at {generated_at}")
+    lines.append("> **Do not edit this block by hand** — changes will be overwritten by the next generation.")
+    lines.append("")
+
+    groups: dict[str, list[DocMeta]] = {}
+    for doc in docs:
+        groups.setdefault(doc.group, []).append(doc)
+
+    def group_key(name: str) -> tuple[int, str]:
+        if name == "(root directory)":
+            return (-1, name)
+        m = re.match(r"^(\d+)", name)
+        return (int(m.group(1)) if m else 999, name)
+
+    for name in sorted(groups, key=group_key):
+        lines.append(f"### {name}")
+        lines.append("")
+        lines.append("| File | Title | Stage | Role |")
+        lines.append("|---|---|---|---|")
+        for doc in sorted(groups[name], key=lambda d: d.rel):
+            link = f"[{Path(doc.rel).name}](<{doc.rel}>)"
+            lines.append(
+                f"| {link} | {doc.title} | {doc.stage or '—'} | {doc.role or '—'} |"
+            )
+        lines.append("")
+
+    lines.append("---")
+    lines.append("")
+    lines.append(f"{len(docs)} Markdown files in {len(groups)} groups.")
+    lines.append("")
+    lines.append(GEN_END)
+    return "\n".join(lines)
+
+
+def write(root: Path, block: str) -> tuple[Path, bool]:
+    path = root / "INDEX.md"
+    if not path.is_file():
+        path.write_text("# Content index\n\n" + block + "\n", encoding="utf-8")
+        return path, False
+    text = path.read_text(encoding="utf-8")
+    if GEN_BEGIN in text and GEN_END in text:
+        head, _, rest = text.partition(GEN_BEGIN)
+        _, _, tail = rest.partition(GEN_END)
+        path.write_text(head + block + tail, encoding="utf-8")
+        return path, True
+    path.write_text(text.rstrip() + "\n\n" + block + "\n", encoding="utf-8")
+    return path, False
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(prog="python -m patentkit.index", description="Generate INDEX.md")
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--write", action="store_true", help="write to disk (print only by default)")
+    ap.add_argument("--json", action="store_true")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+    docs = collect(root)
+    generated_at = datetime.now().astimezone().isoformat(timespec="seconds")
+    block = render(docs, generated_at)
+
+    if args.json:
+        import json as _json
+
+        print(_json.dumps([d.to_dict() for d in docs], ensure_ascii=False, indent=2))
+    else:
+        print(block)
+
+    if args.write:
+        path, replaced = write(root, block)
+        print(f"\n[WRITE] {path} ({'in-place replacement' if replaced else 'appended'})", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
