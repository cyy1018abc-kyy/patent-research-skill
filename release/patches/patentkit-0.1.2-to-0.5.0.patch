+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(buf.getvalue(), encoding="utf-8-sig")
+
+
+def review_progress(root: Path, term: Terminology, target: str) -> list[dict[str, Any]]:
+    """Judged / unjudged statistics per axis.
+
+    "Judged" is determined by `reviewed_at` or `relevance!=3` — see `is_reviewed()`.
+    """
+    counts: dict[str, dict[str, int]] = {}
+    for c in load_candidates(root):
+        if c.target != target:
+            continue
+        for tag in c.tags:
+            short, _, tgt = tag.partition("@")
+            if tgt != target:
+                continue
+            row = counts.setdefault(
+                short, {"total": 0, "judged": 0, "ge4": 0, "judged_as_3": 0}
+            )
+            row["total"] += 1
+            if is_reviewed(c):
+                row["judged"] += 1
+                if c.relevance == 3:
+                    row["judged_as_3"] += 1
+            if assessment.eligible_axis(c, root, tag):
+                row["ge4"] += 1
+    return [{"axis": k, **v} for k, v in sorted(counts.items())]
+
