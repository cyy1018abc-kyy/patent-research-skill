+"""The version number must have exactly one source.
+
+**Why this test group exists**: the repo once had `0.1.0` in `pyproject.toml` and `1.0.0` in
+`patentkit/__init__.py` at the same time — the installed package, what `import patentkit` sees,
+and the compatibility floor recorded in the release manifest could all differ. The version number
+is the anchor of "identity"; conflicting versions mean there is no anchor.
+
+The current convention:
+  * the only literal lives in `patentkit/__init__.py` as `__version__`;
+  * `pyproject.toml` reads it via `dynamic = ["version"]` and hard-codes no number;
+  * the release builder (`tools/build_skill_release.py`) also takes the compatibility floor from it;
+  * the installed metadata (if any) must match it — otherwise the editable install needs to be refreshed.
+"""
+
+from __future__ import annotations
+
+import importlib.metadata
+import importlib.util
+import pathlib
+import re
+import tomllib
+
+import pytest
+
+import patentkit
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+PYPROJECT = ROOT / "pyproject.toml"
+BUILD_SCRIPT = ROOT / "tools" / "build_skill_release.py"
+
+#: Semantic version (MAJOR.MINOR.PATCH; suffixes such as -rc/-dev are allowed)
+SEMVER_RE = re.compile(r"^\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$")
+
+
+def _pyproject() -> dict:
+    return tomllib.loads(PYPROJECT.read_text(encoding="utf-8"))
+
+
+def test_version_is_valid_semver():
+    assert SEMVER_RE.match(patentkit.__version__), (
+        f"__version__ = {patentkit.__version__!r} is not a valid semantic version"
+    )
+
+
+def test_pyproject_does_not_hardcode_version():
+    """A version literal must not reappear in `[project]` — that is the source of version conflicts."""
+    project = _pyproject()["project"]
+    assert "version" not in project, (
+        'pyproject.toml [project] hard-codes version again; use dynamic = ["version"] instead'
+    )
+    assert "version" in project.get("dynamic", []), (
+        'pyproject.toml [project].dynamic must include "version"'
+    )
+
+
+def test_pyproject_reads_version_from_package():
+    """The dynamic version must point at `patentkit.__version__` (not some other file/variable)."""
+    dynamic = _pyproject()["tool"]["setuptools"]["dynamic"]
+    assert dynamic["version"]["attr"] == "patentkit.__version__", (
+        f"dynamic version points at {dynamic['version']!r}; it should point at patentkit.__version__"
+    )
+
+
+def test_installed_metadata_matches_package_version():
+    """The installed metadata must match the in-package version (they diverge when an editable install is stale)."""
+    try:
+        installed = importlib.metadata.version("patentkit")
+    except importlib.metadata.PackageNotFoundError:  # pragma: no cover - not an installed environment
+        pytest.skip("patentkit is not installed (running from source); CI installs via requirements and does not hit this assertion")
+    assert installed == patentkit.__version__, (
+        f"installed metadata {installed} != in-package __version__ {patentkit.__version__}; "
+        "rerun `pip install -e .` to refresh the metadata"
+    )
+
+
+@pytest.mark.skipif(not BUILD_SCRIPT.is_file(), reason="release builder lives in the skill repository")
+def test_release_builder_uses_package_version():
+    """The compatibility floor in the release manifest must come from the package version, never an unknown or stale value."""
+    spec = importlib.util.spec_from_file_location("build_skill_release_testcopy", BUILD_SCRIPT)
+    assert spec and spec.loader
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    assert mod.patentkit_dist_version() == patentkit.__version__, (
+        "tools/build_skill_release.py:patentkit_dist_version() is inconsistent with patentkit.__version__"
+    )
