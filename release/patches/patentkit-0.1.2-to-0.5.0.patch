+++ b/tests/test_04_release_features.py
@@ -0,0 +1,285 @@
+"""New-in-0.4.0 modules: revise / queryplan / chain.
+
+Each test pins the safety property the module was built for: revise applies only declared
+unique hits and catches unlogged edits, queryplan only appends to the query library and plans
+from real log/gate state, chain is a read-only view whose citation marks agree with V034.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+import yaml
+
+from patentkit import chain, cli, queryplan, revise, validate as validate_mod
+
+
+# ── fixtures ──────────────────────────────────────────────────────────
+
+REGISTRY = """\
+target: TGT-0000
+drafts:
+  - role: claims
+    path: 07_drafting/claims.md
+    sha256: null
+    status: missing
+"""
+
+CLAIMS = "1. 一种装置，其膜厚度为 0.33-0.45 mm。\n2. 根据权利要求1的装置。\n"
+
+
+@pytest.fixture
+def drafting(repo):
+    """A workspace with one registered draft and a fresh manuscript registry."""
+    (repo.root / "07_drafting" / "claims.md").write_text(CLAIMS, encoding="utf-8", newline="")
+    (repo.root / "07_drafting" / "manuscript_registry.yml").write_text(
+        REGISTRY, encoding="utf-8", newline="")
+    return repo
+
+
+def write_patch(repo, **overrides) -> Path:
+    patch = {
+        "schema": 1,
+        "round": "R1",
+        "issue": "OA-X2",
+        "source": "office action",
+        "changes": [
+            {
+                "file": "07_drafting/claims.md",
+                "field": "权1 膜厚度范围",
+                "find": "0.33-0.45",
+                "replace": "0.35-0.42",
+                "revalidate": ["provenance", "confirmations"],
+            }
+        ],
+    }
+    patch.update(overrides)
+    path = repo.root / "07_drafting" / f"patch-{patch['round']}.yml"
+    path.write_text(yaml.safe_dump(patch, allow_unicode=True), encoding="utf-8")
+    return path
+
+
+# ── revise: apply ─────────────────────────────────────────────────────
+
+
+def test_revise_apply_is_atomic_and_ledgers(drafting):
+    rc = revise.main(["apply", str(write_patch(drafting)), "--root", str(drafting.root)])
+    assert rc == 0
+    text = (drafting.root / "07_drafting" / "claims.md").read_text(encoding="utf-8")
+    assert "0.35-0.42" in text and "0.33-0.45" not in text
+
+    ledger = revise.load_ledger(drafting.root)
+    entry = ledger["rounds"][0]
+    assert entry["round"] == "R1" and entry["revalidation_status"] == "pending"
+    ch = entry["changes"][0]
+    from patentkit.model import sha256_file
+    assert ch["sha256_after"] == sha256_file(drafting.root / "07_drafting" / "claims.md")
+
+    registry = yaml.safe_load(
+        (drafting.root / "07_drafting" / "manuscript_registry.yml").read_text(encoding="utf-8"))
+    assert registry["drafts"][0]["sha256"] == ch["sha256_after"]
+    assert registry["drafts"][0]["evidence_level"] == "attested"
+
+
+def test_revise_refuses_ambiguous_find_and_leaves_file_untouched(drafting):
+    (drafting.root / "07_drafting" / "claims.md").write_text(
+        "0.33-0.45 两次出现 0.33-0.45\n", encoding="utf-8", newline="")
+    patch = write_patch(drafting)
+    rc = revise.main(["apply", str(patch), "--root", str(drafting.root)])
+    assert rc == 2
+    assert "两次出现" in (drafting.root / "07_drafting" / "claims.md").read_text(encoding="utf-8")
+    assert not (drafting.root / revise.LEDGER_REL).exists()
+
+
+def test_revise_refuses_unregistered_manuscript(drafting):
+    (drafting.root / "07_drafting" / "extra.md").write_text("abc\n", encoding="utf-8", newline="")
+    patch = write_patch(drafting, changes=[{
+        "file": "07_drafting/extra.md", "field": "f", "find": "abc", "replace": "abd",
+    }])
+    assert revise.main(["apply", str(patch), "--root", str(drafting.root)]) == 2
+    assert (drafting.root / "07_drafting" / "extra.md").read_text(encoding="utf-8") == "abc\n"
+
+
+def test_revise_refuses_duplicate_round(drafting):
+    assert revise.main(["apply", str(write_patch(drafting)), "--root", str(drafting.root)]) == 0
+    patch = write_patch(drafting)  # same round R1
+    assert revise.main(["apply", str(patch), "--root", str(drafting.root)]) == 2
+    assert len(revise.load_ledger(drafting.root)["rounds"]) == 1
+
+
+# ── revise: status / close / integrity ────────────────────────────────
+
+
+def test_revise_status_catches_unlogged_edit(drafting):
+    assert revise.main(["apply", str(write_patch(drafting)), "--root", str(drafting.root)]) == 0
+    # 模拟"改了没登记"：绕过 revise 直接改文件
+    path = drafting.root / "07_drafting" / "claims.md"
+    path.write_text("偷偷改了\n", encoding="utf-8", newline="")
+    assert revise.main(["status", "--root", str(drafting.root)]) == 1
+    # validate 侧：V036 warn（strict 时升级为失败）
+    findings = drafting.validate()
+    v036 = [f for f in findings if f.code == "V036"]
+    assert len(v036) == 1 and v036[0].level == "warn"
+
+
+def test_revise_v035_on_broken_ledger(drafting):
+    (drafting.root / revise.LEDGER_REL).write_text("just a string\n", encoding="utf-8")
+    findings = drafting.validate()
+    v035 = [f for f in findings if f.code == "V035"]
+    assert len(v035) == 1 and v035[0].level == "error"
+    assert not [f for f in findings if f.code == "V036"]
+
+
+def test_revise_close_requires_passing_integrity_then_marks_done(drafting):
+    assert revise.main(["apply", str(write_patch(drafting)), "--root", str(drafting.root)]) == 0
+    # 篡改文件后 close 必须被拦
+    (drafting.root / "07_drafting" / "claims.md").write_text("x\n", encoding="utf-8", newline="")
+    assert revise.main(["close", "--round", "R1", "--root", str(drafting.root)]) == 1
+    ledger = revise.load_ledger(drafting.root)
+    assert ledger["rounds"][0]["revalidation_status"] == "pending"
+
+    # 恢复字节级一致的内容后才能关闭
+    (drafting.root / "07_drafting" / "claims.md").write_text(CLAIMS.replace("0.33-0.45", "0.35-0.42"),
+                                                            encoding="utf-8", newline="")
+    assert revise.main(["close", "--round", "R1", "--note", "validate+gates 全绿",
+                        "--root", str(drafting.root)]) == 0
+    ledger = revise.load_ledger(drafting.root)
+    assert ledger["rounds"][0]["revalidation_status"] == "done"
+    assert ledger["rounds"][0]["close_note"] == "validate+gates 全绿"
+
+
+def test_revise_escalates_after_three_rounds_on_same_issue(drafting):
+    import io
+    import contextlib
+
+    # 三轮连续改同一个数值范围（每轮 find 都是上一轮 replace 的结果，各只出现一次）
+    steps = [("0.33-0.45", "0.35-0.42"), ("0.35-0.42", "0.37-0.44"), ("0.37-0.44", "0.39-0.46")]
+    for n, (find, replace) in enumerate(steps, 1):
+        patch = write_patch(drafting, round=f"R{n}",
+                            changes=[{"file": "07_drafting/claims.md", "field": "权1 数值范围",
+                                      "find": find, "replace": replace}])
+        assert revise.main(["apply", str(patch), "--root", str(drafting.root)]) == 0
+
+    buf = io.StringIO()
+    with contextlib.redirect_stdout(buf):
+        rc = revise.main(["status", "--root", str(drafting.root)])
+    assert rc == 0
+    assert "升级" in buf.getvalue() and "3 轮" in buf.getvalue()
+
+
+# ── queryplan ─────────────────────────────────────────────────────────
+
+LIBRARY = """\
+version: 1
+updated: '2026-01-01'
+
+# ⚠️ 子查询只追加在末尾；绝不对既有条目重新编号——注释必须原样保留
+cnipa_batches:
+  N1@TGT-0000:
+    - { label: basic, abstract: 'interface and capability and routing' }
+    - { label: variant, abstract: 'capillary and routing and water' }
+  N2@TGT-0000:
+    - { label: basic, abstract: 'TBD: domain term and object term' }
+"""
+
+
+@pytest.fixture
+def library(repo):
+    (repo.root / "01_search_plan" / "query_library.yml").write_text(
+        LIBRARY, encoding="utf-8", newline="")
+    return repo
+
+
+def test_queryplan_reports_registered_vs_executed_and_buffer(library, capsys):
+    # 第二条子查询尚未执行（日志只有 qid=N1）
+    rc = queryplan.main(["--axis", "N1", "--json", "--root", str(library.root)])
+    data = json.loads(capsys.readouterr().out)
+    axis = data["axes"][0]
+    assert axis["registered_subqueries"] == 2 and axis["executed_subqueries"] == 1
+    assert axis["unexecuted_indices"] == [2]
+    assert axis["buffer"] == -10 and axis["counts"]["verified"] == 0
+    assert any("未执行" in s for s in axis["suggestions"])
+    assert rc == 0
+
+
+def test_queryplan_suggests_uncovered_concept_groups(library, capsys, monkeypatch):
+    from patentkit import topics as topics_mod
+    monkeypatch.setattr(topics_mod, "CONCEPTS_BY_TARGET", {
+        "TGT-0000": {"Novel aspect": ["新颖要素", "novel element", "特殊构件"]},
+    })
+    # 注册的子查询不含该组任何关键词 → 建议骨架出现
+    rc = queryplan.main(["--json", "--root", str(library.root)])
+    data = json.loads(capsys.readouterr().out)
+    assert data["uncovered_concept_groups"] == ["Novel aspect"]
+    suggested = data["suggested_subqueries"]["N1@TGT-0000"][0]
+    assert suggested["label"] == "auto-novel-aspect"
+    assert "新颖要素" in suggested["abstract"]
+
+
+def test_queryplan_apply_appends_without_touching_existing_lines(library, capsys, monkeypatch):
+    from patentkit import topics as topics_mod
+    monkeypatch.setattr(topics_mod, "CONCEPTS_BY_TARGET", {
+        "TGT-0000": {"Novel aspect": ["新颖要素", "novel element", "特殊构件"]},
+    })
+    before = (library.root / "01_search_plan" / "query_library.yml").read_text(encoding="utf-8")
+    rc = queryplan.main(["--apply", "--root", str(library.root)])
+    assert rc == 0
+    after = (library.root / "01_search_plan" / "query_library.yml").read_text(encoding="utf-8")
+    assert "# ⚠️ 子查询只追加在末尾" in after  # 注释保留（不能整文件重排）
+    for line in before.splitlines():
+        if line.strip() and not line.startswith("#"):
+            assert line in after  # 既有行逐行原样保留
+    assert "auto-novel-aspect" in after
+    # 幂等性：无建议时 --apply 不写坏文件（概念组已被登记子查询覆盖 → 无建议）
+    monkeypatch.setattr(topics_mod, "CONCEPTS_BY_TARGET", {})
+    rc = queryplan.main(["--apply", "--root", str(library.root)])
+    assert rc == 0
+    after2 = (library.root / "01_search_plan" / "query_library.yml").read_text(encoding="utf-8")
+    assert after2 == after
+
+
+def test_queryplan_fails_closed_without_batches(library, capsys):
+    (library.root / "01_search_plan" / "query_library.yml").write_text(
+        "version: 1\n", encoding="utf-8")
+    assert queryplan.main(["--root", str(library.root)]) == 2
+    assert queryplan.main(["--axis", "N9", "--root", str(library.root)]) == 2
+
+
+# ── chain ─────────────────────────────────────────────────────────────
+
+
+def test_chain_renders_full_chain_and_flags_out_of_ledger_citations(repo, tmp_path):
+    repo.write_run("2026-01-02_run2.md", "P-001 与 US 1234567 B2 的对比\n")
+    (repo.root / "05_novelty_conclusions" / "conclusion.md").write_text(
+        "P-001 披露了 N1 的核心手段。\n", encoding="utf-8")
+    (repo.root / "05_novelty_conclusions" / "invented.md").write_text(
+        "P-907 披露了 N2 的手段。\n", encoding="utf-8")
+    out = tmp_path / "chain.html"
+    assert chain.main(["TGT-0000", "--root", str(repo.root), "--out", str(out)]) == 0
+    html = out.read_text(encoding="utf-8")
+    for marker in ("证据链全景", "检索日志", "候选池", "D 列与同族", "判定 runs",
+                   "证据账本", "五门验收", "P-001", "US 1234567 B2"):
+        assert marker in html, marker
+    assert "✗ 引用了账本外的编号" in html  # invented.md 的 P-907
+    assert "无外链" in html and "<script" not in html.lower()
+
+
+def test_chain_is_read_only(repo, tmp_path):
+    before = sorted(str(p) for p in repo.root.rglob("*") if p.is_file())
+    out_dir = tmp_path.parent / (tmp_path.name + "-out")
+    out_dir.mkdir(parents=True, exist_ok=True)
+    out = out_dir / "chain.html"
+    chain.main(["TGT-0000", "--root", str(repo.root), "--out", str(out)])
+    after = sorted(str(p) for p in repo.root.rglob("*") if p.is_file())
+    assert before == after
+
+
+# ── CLI registration ──────────────────────────────────────────────────
+
+
+def test_new_commands_are_registered_and_listed():
+    for cmd in ("queryplan", "revise", "chain"):
+        assert cmd in cli.PASSTHROUGH
+        assert cmd in cli.USAGE
