+"""citations.bib synchronizer — auto-generates BibTeX for candidates that lack entries.
+
+The candidate list is the **master** and the `.bib` is **derived**: when a candidate changes,
+the bib is generated to follow, not the other way round.
+(V004/V005 in `tools.validate` validate this step in both directions.)
+
+Dry-run by default; only `--apply` writes to disk. Entries are appended to
+`06_citation_management/citations.bib` in per-target sections, without touching existing entries.
+
+Usage
+-----
+    python -m patentkit.bibsync                    # preview what is missing
+    python -m patentkit.bibsync --apply            # append generated entries
+    python -m patentkit.bibsync --target TGT-0001  # process only one target
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from datetime import datetime
+from pathlib import Path
+
+from .model import Candidate, load_candidates
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+from .validate import BIB_ENTRY_RE, is_template_bib
+
+BIB_REL = Path("06_citation_management") / "citations.bib"
+
+#: Special characters that need escaping in BibTeX
+_ESCAPES = {
+    "&": r"\&",
+    "%": r"\%",
+    "$": r"\$",
+    "#": r"\#",
+    "_": r"\_",
+    "{": r"\{",
+    "}": r"\}",
+    "\\": r"\textbackslash{}",
+}
+
+
+def bib_escape(value: str) -> str:
+    """Escape BibTeX special characters, so that & _ % in a title cannot break the .bib file."""
+    out = []
+    for ch in value or "":
+        out.append(_ESCAPES.get(ch, ch))
+    return "".join(out)
+
+
+def existing_keys(bib_dir: Path) -> set[str]:
+    keys: set[str] = set()
+    if not bib_dir.is_dir():
+        return keys
+    for p in sorted(bib_dir.glob("*.bib")):
+        try:
+            text = p.read_text(encoding="utf-8")
+        except OSError:
+            continue
+        if is_template_bib(p, text):
+            continue
+        keys.update(m.group(2) for m in BIB_ENTRY_RE.finditer(text))
+    return keys
+
+
+def render_entry(cand: Candidate) -> str:
+    data = cand.data
+    key = cand.bibtex_key or ""
+    kind = cand.kind
+    entry_type = "@article" if kind == "paper" else "@misc"
+    title = bib_escape(cand.title)
+
+    people = [str(a) for a in (data.get("authors_or_applicants") or [])]
+    # Every branch returns a value that is **already fully braced**; call sites must not add
+    # another layer (otherwise you get triple braces)
+    if len(people) == 1:
+        author = "{{" + bib_escape(people[0]) + "}}"  # double braces for institutional authors
+    elif people:
+        author = "{" + " and ".join(bib_escape(p) for p in people) + "}"
+    else:
+        author = "{Unknown}"
+
+    note_bits = [
+        f"target={cand.target}",
+        f"tags={','.join(cand.tags) or '-'}",
+        f"relevance={cand.relevance}",
+        f"role={data.get('role')}",
+        f"evidence={data.get('evidence_level')}",
+    ]
+
+    lines = [f"{entry_type}{{{key},"]
+    lines.append(f"  author = {author},")
+    lines.append(f"  title  = {{{title}}},")
+    if kind != "paper":
+        lines.append("  type   = {patent},")
+        lines.append(f"  number = {{{bib_escape(cand.doc_number)}}},")
+    lines.append(f"  year   = {{{data.get('year', '')}}},")
+    if kind != "paper":
+        lines.append(f"  url    = {{https://patents.google.com/patent/{cand.doc_number}}},")
+    elif cand.doc_number.startswith("10."):
+        lines.append(f"  doi    = {{{bib_escape(cand.doc_number)}}},")
+    else:
+        lines.append(f"  url    = {{{bib_escape(cand.doc_number)}}},")
+    lines.append("  note   = {" + "; ".join(note_bits) + "}")
+    lines.append("}")
+    return "\n".join(lines)
+
+
+def run(args: argparse.Namespace) -> int:
+    root = (args.root or workspace_or_exit()).resolve()
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    bib_path = root / BIB_REL
+    have = existing_keys(root / "06_citation_management")
+
+    cands = load_candidates(root)
+    if args.target:
+        cands = [c for c in cands if c.target == args.target]
+
+    missing = [c for c in cands if c.bibtex_key and c.bibtex_key not in have]
+    no_key = [c for c in cands if not c.bibtex_key]
+
+    print(f"Repository : {root.name}")
+    print(f"Existing keys: {len(have)}")
+    print(f"Candidates : {len(cands)} ({len(no_key)} missing the bibtex_key field)")
+    print(f"To generate: {len(missing)}")
+    print()
+
+    if not missing:
+        print("Nothing to change.")
+        return 0
+
+    order = {"TGT-0000": 0, "TGT-0001": 1}
+    missing.sort(key=lambda c: (order.get(c.target, 9), c.id))
+
+    if args.show:
+        for c in missing[: args.show]:
+            print(f"  {c.id:<8} {c.bibtex_key:<28} {c.title[:52]}")
+        if len(missing) > args.show:
+            print(f"  … {len(missing) - args.show} more omitted")
+        print()
+
+    if not args.apply:
+        print("Not written. Add --apply once confirmed")
+        return 0
+
+    now = datetime.now().astimezone().date().isoformat()
+    blocks: list[str] = []
+    current_target = None
+    for c in missing:
+        if c.target != current_target:
+            current_target = c.target
+            tinfo = term.target_or_none(current_target)
+            heading = tinfo.title if tinfo else ""
+            blocks.append(
+                "\n".join(
+                    [
+                        "",
+                        "% " + "=" * 74,
+                        f"% {current_target} · {heading}",
+                        f"% Generated by tools.bibsync on {now} (the candidate list is the master; the .bib is derived)",
+                        "% " + "=" * 74,
+                    ]
+                )
+            )
+        blocks.append(render_entry(c))
+
+    bib_path.parent.mkdir(parents=True, exist_ok=True)
+    previous = bib_path.read_text(encoding="utf-8") if bib_path.is_file() else ""
+    separator = "" if previous.endswith("\n") else "\n"
+    bib_path.write_text(previous + separator + "\n".join(blocks) + "\n", encoding="utf-8")
+
+    print(f"Appended {len(missing)} entries to {BIB_REL.as_posix()}")
+    print("Next: python -m patentkit.validate")
+    return 0
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.bibsync", description="Generate missing BibTeX entries for candidates"
+    )
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--target", default=None, help="process only one target")
+    ap.add_argument("--show", type=int, default=25)
+    ap.add_argument("--apply", action="store_true")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    return run(build_parser().parse_args(argv))
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
