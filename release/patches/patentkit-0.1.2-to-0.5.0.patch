+# ── Write operations (returning the captured output) ──────────────────
+
+
+def _capture(func: Callable[[list[str]], int], argv: list[str]) -> dict[str, Any]:
+    """Run a CLI main(), capture stdout/stderr, and return a structured result.
+
+    Why capture output instead of rewriting: these modules are already mature and covered by tests;
+    rewriting them as "pure functions" has limited benefit and no small regression risk. Captured text +
+    exit code are enough for the MCP caller to judge success and read the details.
+    """
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        code = func(argv)
+    return {
+        "ok": code == 0,
+        "exit_code": code,
+        "stdout": out.getvalue().strip(),
+        "stderr": err.getvalue().strip(),
+    }
+
+
+def _root_args(root: Path) -> list[str]:
+    return ["--root", str(root)]
+
+
+def ingest(
+    ws: str | Path | None = None,
+    log: str = "",
+    raw: str | None = None,
+    kind: str = "patent",
+    tag: list[str] | None = None,
+    limit: int = 0,
+    now: str = "",
+    apply: bool = False,
+) -> dict[str, Any]:
+    """Raw response → candidate skeleton. Dry-run by default (apply=False only previews)."""
+    root = workspace(ws)
+    argv = [*_root_args(root), "--log", log, "--kind", kind]
+    if raw:
+        argv += ["--raw", str(raw)]
+    for t in tag or []:
+        argv += ["--tag", t]
+    if limit:
+        argv += ["--limit", str(limit)]
+    if now:
+        argv += ["--now", now]
+    if apply:
+        argv.append("--apply")
+    return _capture(ingest_mod.main, argv)
+
+
+def bibsync(
+    ws: str | Path | None = None, target: str | None = None, apply: bool = False
+) -> dict[str, Any]:
+    """Generate missing BibTeX entries for candidates (dry-run by default)."""
