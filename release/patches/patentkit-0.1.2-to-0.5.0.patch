+"""Dual-track (three-column) acceptance gate computation · G-S-01 .. G-S-05.
+
+The columns are **monotonic**, the further left the stricter:
+
+    verified (strictest)  counts verified evidence only
+    ≥attested             counts verified + attested
+    ≥asserted (all)       counts everything (including pure self-assertion)
+
+The determination (status) looks only at the strictest verified column — this is how the
+`asserted / verified` dual-track system works: historical results remain in the ≥asserted column,
+but they are not enough to make a gate PASS.
+
+The criteria for all five gates come from 00_methodology/search_framework.md; criteria corrections are in docs/upgrade_plan.md §5.3.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from dataclasses import dataclass, field
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Callable
+
+from .model import (
+    LEVEL_RANK,
+    Candidate,
+    EvidenceLevel,
+    Role,
+    SearchLog,
+    load_candidates,
+    load_logs,
+)
+from .paths import workspace_or_exit
+from .registry import Terminology, TerminologyError, load_registry, qualify
+from . import runs as runs_mod
+from .assessment import eligible_axis, confirmation_valid
+
+LEVEL_KEYS = ("verified", "attested", "asserted")
+LEVEL_LABELS = {
+    "verified": "verified (strictest)",
+    "attested": "≥attested",
+    "asserted": "≥asserted (all)",
+}
+
+GEN_BEGIN = "<!-- BEGIN GENERATED: gates -->"
+GEN_END = "<!-- END GENERATED: gates -->"
+
+TRACKER_REL = Path("05_novelty_conclusions") / "five_acceptance_gates_tracking.md"
+
+#: G-S-01 thresholds
+GS01_MIN_PATENTS = 200
+GS01_MIN_PAPERS = 200
+#: G-S-02 thresholds (per axis)
+GS02_MIN_PER_AXIS = 10
+#: G-S-03 threshold
+GS03_MIN_NEAR_PRIOR = 5
+
+
+@dataclass
+class GateResult:
+    gate_id: str
+    title: str
+    threshold: str
+    values: dict[str, str]
+    status: str  # PASS / FAIL / N/A
+    note: str = ""
+
+    @property
+    def passes(self) -> bool:
+        return self.status == "PASS"
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "gate_id": self.gate_id,
+            "title": self.title,
+            "threshold": self.threshold,
+            "values": self.values,
+            "status": self.status,
+            "note": self.note,
+        }
+
+
+@dataclass
+class GateReport:
+    results: list[GateResult]
+    target: str = ""
+    per_axis: dict[str, dict[str, int]] = field(default_factory=dict)
+    generated_at: str = ""
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "generated_at": self.generated_at,
+            "target": self.target,
+            "gates": [r.to_dict() for r in self.results],
+            "per_axis": self.per_axis,
+            "summary": {r.gate_id: r.status for r in self.results},
+        }
+
+
+# ── Generic counting ──────────────────────────────────────────────────
+
+
+def _count_by_level(
+    items: list[Candidate],
+    root: Path,
+    predicate: Callable[[Candidate], bool],
+) -> dict[str, int]:
+    """Counts for each of the three monotonic columns.
+
+    ⚠️ **`role=excluded` does not count**. The reason matches G-S-02/G-S-03/G-S-04:
+    `excluded` means "already removed (mis-mapping / false positive / duplicate / belongs to another target)";
+    once it has been determined that it does not belong in the pool, it should not count toward any gate's coverage.
+
+    G-S-01 earlier **lacked** this filter — so the "492 documents" mixed in 3 excluded ones, and the
+    gate number disagreed with the actually usable number of documents. Corrected 2026-10-20.
+    """
+    out = {k: 0 for k in LEVEL_KEYS}
+    for c in items:
+        if not predicate(c):
+            continue
+        if (c.data.get("role") or "") == "excluded":
+            continue
+        lvl = c.effective_level(root)
+        rank = LEVEL_RANK[lvl]
+        if rank >= LEVEL_RANK[EvidenceLevel.VERIFIED]:
+            out["verified"] += 1
+        if rank >= LEVEL_RANK[EvidenceLevel.ATTESTED]:
+            out["attested"] += 1
+        out["asserted"] += 1
+    return out
+
+
+def _fmt_counts(counts: dict[str, int], suffix: str = "") -> dict[str, str]:
+    return {k: f"{v}{suffix}" for k, v in counts.items()}
+
+
+def _status_from_bool(ok_verified: bool, has_verified_data: bool) -> str:
+    if not has_verified_data:
+        return "N/A"
+    return "PASS" if ok_verified else "FAIL"
+
+
+# ── G-S-01 ────────────────────────────────────────────────────────────
+
+
+def gate_gs01(cands: list[Candidate], root: Path) -> GateResult:
+    patents = _count_by_level(cands, root, lambda c: c.kind == "patent")
+    papers = _count_by_level(cands, root, lambda c: c.kind == "paper")
+
+    ok = (
+        patents["verified"] >= GS01_MIN_PATENTS
+        and papers["verified"] >= GS01_MIN_PAPERS
+    )
+    has_data = patents["verified"] > 0 or papers["verified"] > 0
+
+    return GateResult(
+        gate_id="G-S-01",
+        title="Stage 1 candidate list",
+        threshold=f"P≥{GS01_MIN_PATENTS} and L≥{GS01_MIN_PAPERS}",
+        values={
+            "verified": f"{patents['verified']}P / {papers['verified']}L",
+            "attested": f"{patents['attested']}P / {papers['attested']}L",
+            "asserted": f"{patents['asserted']}P / {papers['asserted']}L",
+        },
+        status=_status_from_bool(ok, has_data),
+        note="Only counts candidates of the current target (matching the target field); the self-assessed numbers"
+        " of a historical archived target do not belong to this target and must not be used as a basis for passing",
+    )
+
+
+# ── G-S-02 ────────────────────────────────────────────────────────────
+
+
+def gate_gs02(
+    cands: list[Candidate],
+    term: Terminology,
+    target: str,
+    root: Path,
+    inferred: frozenset[str],
+) -> tuple[GateResult, dict[str, dict[str, int]]]:
+    """G-S-02: ≥10 per axis.
+
+    The axis set comes from the glossary's axes for **that target** (qualified IDs `N1@TGT-0001`);
+    per_axis uses short axis names (N1) as keys for readability.
+    """
+    axes = term.axes_for(target)
+    short_ids = sorted(ax.short for ax in axes.values())
+    per_axis: dict[str, dict[str, int]] = {}
+
+    for short in short_ids:
+        qualified = qualify(short, target)
+
+        def pred(c: Candidate, qualified: str = qualified) -> bool:
+            # entries with role=excluded (mis-mapping / false positive / belongs to another target) do not count as a hit on any main axis
+            if c.effective_role(inferred) is Role.EXCLUDED:
+                return False
+            return qualified in c.tags and eligible_axis(c, root, qualified)
+
+        per_axis[short] = _count_by_level(cands, root, pred)
+
+    verified_min = min((per_axis[a]["verified"] for a in short_ids), default=0)
+    attested_min = min((per_axis[a]["attested"] for a in short_ids), default=0)
+    asserted_min = min((per_axis[a]["asserted"] for a in short_ids), default=0)
+
+    ok = bool(short_ids) and verified_min >= GS02_MIN_PER_AXIS
+    has_data = verified_min > 0
+
+    return (
+        GateResult(
+            gate_id="G-S-02",
+            title="Stage 2 N-axis deep dive",
+            threshold=f"≥{GS02_MIN_PER_AXIS} per axis",
+            values={
+                "verified": f"min axis {verified_min}",
+                "attested": f"min axis {attested_min}",
+                "asserted": f"min axis {asserted_min}",
+            },
+            status=_status_from_bool(ok, has_data),
+            note="Source level and supported assessment are separate: both relevance dimensions and per-axis original-text citations are required; AI assessments are allowed; excluded does not count",
+        ),
+        per_axis,
+    )
+
+
+# ── G-S-03 ────────────────────────────────────────────────────────────
+
+
+def gate_gs03(
+    cands: list[Candidate], root: Path, inferred: frozenset[str]
+) -> GateResult:
+    counts = _count_by_level(
+        cands, root, lambda c: c.effective_role(inferred) is Role.NEAR_PRIOR_ART and confirmation_valid(c, root)
+    )
+    ok = counts["verified"] >= GS03_MIN_NEAR_PRIOR
+    has_data = counts["verified"] > 0
+
+    return GateResult(
+        gate_id="G-S-03",
+        title="Stage 3 near prior art comparison",
+        threshold=f"≥{GS03_MIN_NEAR_PRIOR} documents",
+        values=_fmt_counts(counts, " docs"),
+        status=_status_from_bool(ok, has_data),
+        note="Counts near_prior_art only with a current supported assessment and an explicit human confirmation bound to its fingerprint",
+    )
+
+
+# ── G-S-04 ────────────────────────────────────────────────────────────
+
+
+def gate_gs04(
+    cands: list[Candidate], root: Path, inferred: frozenset[str]
+) -> GateResult:
+    target_roles = {Role.NEAR_PRIOR_ART, Role.FAMILY}
+    subjects = [c for c in cands if c.effective_role(inferred) in target_roles]
+
+    def complete(c: Candidate) -> bool:
+        raw = c.data
+        return isinstance(raw.get("family"), list) and isinstance(raw.get("cited_by"), list)
+
+    values: dict[str, str] = {}
+    all_ok = True
+    has_verified_data = False
+
+    for key, level in (
+        ("verified", EvidenceLevel.VERIFIED),
+        ("attested", EvidenceLevel.ATTESTED),
+        ("asserted", EvidenceLevel.ASSERTED),
+    ):
+        pool = [c for c in subjects if c.reaches(level, root)]
+        if not pool:
+            values[key] = "no data at this level"
+            if level is EvidenceLevel.VERIFIED:
+                all_ok = False
+            continue
+        ok_n = sum(1 for c in pool if complete(c))
+        pct = 100.0 * ok_n / len(pool)
+        values[key] = f"{ok_n}/{len(pool)} ({pct:.0f}%)"
+        if level is EvidenceLevel.VERIFIED:
+            has_verified_data = True
+            all_ok = ok_n == len(pool)
+
+    return GateResult(
+        gate_id="G-S-04",
+        title="Family + cited-by",
+        threshold="coverage 100%",
+        values=values,
+        status=_status_from_bool(all_ok, has_verified_data),
+        note="Criteria: for candidates with role∈{near_prior_art, family}, both family and cited_by must be arrays;"
+        " an empty array means \"searched, no hits\" (it cannot distinguish \"not searched\"; an explicit marker is recommended later)",
+    )
+
+
+# ── G-S-05 ────────────────────────────────────────────────────────────
+
+
+def gate_gs05(logs: list[SearchLog]) -> GateResult:
+    total = len(logs)
+    live_ok = sum(1 for log in logs if log.is_replayable())
+
+    if total == 0:
+        return GateResult(
+            gate_id="G-S-05",
+            title="Reviewable records",
+            threshold="replayability 100%",
+            values={k: "no logs" for k in LEVEL_KEYS},
+            status="N/A",
+            note="02_search_logs is empty",
+        )
+
+    pct = 100.0 * live_ok / total
+    values = {
+        # A log has no evidence_level of its own — its capture_mode is its level.
+        "verified": f"{live_ok}/{total} ({pct:.0f}%)",
+        "attested": f"{live_ok}/{total} ({pct:.0f}%)",
+        # Every log exists as a "record", so the asserted column is always 100%
+        "asserted": f"{total}/{total} (100%)",
+    }
+    return GateResult(
+        gate_id="G-S-05",
+        title="Reviewable records",
+        threshold="replayability 100%",
+        values=values,
+        status="PASS" if live_ok == total else "FAIL",
+        note="Criteria: capture_mode=live and the raw_export artifact exists and is non-empty;"
+        " retrospective logs only count toward the asserted column",
+    )
+
+
+# ── Aggregation ───────────────────────────────────────────────────────
+
+
+def compute_all(
+    root: Path,
+    term: Terminology | None = None,
+    target: str | None = None,
+) -> GateReport:
+    """Compute the 5 acceptance gates for one target.
+
+    **Multi-target filtering is the core responsibility of this function**: only candidates and logs
+    whose `target` field equals the target ID are counted. Without this filter, TGT-0000's historical
+    candidates would be counted into TGT-0001's gates — and those candidates searched for another
+    invention, which would make the gates show fictitious numbers.
+    """
+    if term is None:
+        term = load_registry(root)
+
+    target = target or term.active_target
+    if not target:
+        raise ValueError("no target specified, and the glossary has no active_target")
+
+    all_cands = load_candidates(root)
+    all_logs = load_logs(root)
+
+    cands = [c for c in all_cands if c.target == target]
+    logs = [log for log in all_logs if log.target == target]
+
+    run_index = runs_mod.load_runs(root)
+    inferred = runs_mod.infer_near_prior_ids(cands, run_index)
+
+    gs02, per_axis = gate_gs02(cands, term, target, root, inferred)
+
+    results = [
+        gate_gs01(cands, root),
+        gs02,
+        gate_gs03(cands, root, inferred),
+        gate_gs04(cands, root, inferred),
+        gate_gs05(logs),
+    ]
+
+    return GateReport(
+        results=results,
+        target=target,
+        per_axis=per_axis,
+        generated_at=datetime.now().astimezone().isoformat(timespec="seconds"),
+    )
+
+
+# ── Rendering ─────────────────────────────────────────────────────────
+
+
+def render_markdown(report: GateReport, term: Terminology | None = None) -> str:
+    lines: list[str] = []
+    lines.append(GEN_BEGIN)
+    lines.append("")
+    lines.append("### Acceptance gate status (auto-generated)")
+    lines.append("")
+    lines.append(f"> Generated by `python -m patentkit.gates --write` at {report.generated_at}")
+    tgt = term.target_or_none(report.target) if term else None
+    tgt_title = f" — {tgt.title}" if tgt and tgt.title else ""
+    lines.append(f"> **Target: `{report.target}`**{tgt_title}")
+    lines.append(">")
+    lines.append("> **This block only counts candidates and logs whose `target` field equals the target ID above.**")
+    lines.append("> **Do not edit this block by hand** — changes will be overwritten by the next generation. Put manual annotations outside this block.")
+    lines.append(">")
+    lines.append("> The three columns are monotonic: **the determination only trusts the strictest verified column**. Historical results remain in the ≥asserted column,")
+    lines.append("> but they are not enough to make a gate PASS. For the system description see `docs/upgrade_plan.md` §4.")
+    lines.append("")
+    lines.append(
+        "| Gate | Name | Threshold | verified (strictest) | ≥attested | ≥asserted (all) | Status |"
+    )
+    lines.append("|---|---|---|---|---|---|---|")
+    for r in report.results:
+        mark = {"PASS": "✅ PASS", "FAIL": "❌ FAIL", "N/A": "⬜ N/A"}.get(r.status, r.status)
+        lines.append(
+            f"| **{r.gate_id}** | {r.title} | {r.threshold} | "
+            f"{r.values['verified']} | {r.values['attested']} | {r.values['asserted']} | {mark} |"
+        )
+    lines.append("")
+
+    if report.per_axis:
+        lines.append("#### G-S-02 per-axis breakdown")
+        lines.append("")
+        lines.append("| Axis | Name | verified | ≥attested | ≥asserted |")
+        lines.append("|---|---|---|---|---|")
+        for axis in sorted(report.per_axis):
+            qualified = qualify(axis, report.target)
+            label = term.axis_label(qualified) if term else axis
+            name = label.split(" ", 1)[1] if " " in label else ""
+            v = report.per_axis[axis]
+            lines.append(f"| {axis} | {name} | {v['verified']} | {v['attested']} | {v['asserted']} |")
+        lines.append("")
+
+    lines.append("#### Criteria notes")
+    lines.append("")
+    for r in report.results:
+        if r.note:
+            lines.append(f"- **{r.gate_id}** — {r.note}")
+    lines.append("")
+    lines.append(GEN_END)
+    return "\n".join(lines)
+
+
+def write_tracker(root: Path, block: str) -> tuple[Path, bool]:
+    """Write the generated block into the 05 tracking table.
+
+    With a GENERATED fence → replacement in place; without → append to the end of the file
+    (without disturbing existing content).
+    Returns (path, whether it was an in-place replacement).
+    """
+    path = root / TRACKER_REL
+    if not path.is_file():
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(
+            "# 5 acceptance gates tracking (G-S-01..G-S-05)\n\n" + block + "\n",
+            encoding="utf-8",
+        )
+        return path, False
+
+    text = path.read_text(encoding="utf-8")
+    if GEN_BEGIN in text and GEN_END in text:
+        head, _, rest = text.partition(GEN_BEGIN)
+        _, _, tail = rest.partition(GEN_END)
+        path.write_text(head + block + tail, encoding="utf-8")
+        return path, True
+
+    path.write_text(text.rstrip() + "\n\n" + block + "\n", encoding="utf-8")
+    return path, False
+
+
+# ── CLI ───────────────────────────────────────────────────────────────
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.gates",
+        description="Compute the G-S-01..G-S-05 three-column acceptance gate status",
+    )
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument(
+        "--target",
+        default=None,
+        help="target ID (defaults to the glossary active_target; essential with multiple targets)",
+    )
+    ap.add_argument("--json", action="store_true", help="output machine-readable JSON")
+    ap.add_argument("--write", action="store_true", help="write back to 05_novelty_conclusions/five_acceptance_gates_tracking.md")
+    ap.add_argument("--quiet", action="store_true", help="output only the status summary")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    report = compute_all(root, term, args.target)
+
+    if args.json:
+        print(json.dumps(report.to_dict(), ensure_ascii=False, indent=2))
+    else:
+        block = render_markdown(report, term)
+        if not args.quiet:
+            print(block)
+        else:
+            for r in report.results:
+                print(f"{r.gate_id}  {r.status:4}  verified={r.values['verified']}")
+
+    if args.write:
+        path, replaced = write_tracker(root, render_markdown(report, term))
+        action = "in-place replacement" if replaced else "appended"
+        print(f"\n[WRITE] {path} ({action})", file=sys.stderr)
+
+    # Return 2 when a gate has not PASSed, to distinguish it from validate's 1
+    return 0 if all(r.passes for r in report.results) else 2
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
