+"""Evidence-chain panorama — one offline HTML page per target: 检索日志 → 候选池 → D 列 → 判定 → 账本 → 结论 → 五门.
+
+Why this module exists
+----------------------
+Every individual stage already has a view (gates table, map, ledger, review progress), but the
+**chain** is only visible by cross-referencing several files. This module renders the whole chain
+for one target into a single self-contained HTML file in the same style as ``map``: no network,
+no CDN, no JavaScript — it must open offline inside an air-gapped environment and never leak data
+to a third party.
+
+Boundary (same as map): this is a summary view for humans to trace "conclusion → evidence →
+artifact → confirmation"; the examiner-verifiable form remains the claim chart, and this page
+states that it is not legal advice.
+
+Usage::
+
+    python -m patentkit chain TGT-0001
+"""
+
+from __future__ import annotations
+
+import argparse
+import html
+from datetime import datetime
+from pathlib import Path
+
+from . import gates as gates_mod
+from . import ledger as ledger_mod
+from . import runs as runs_mod
+from .assessment import confirmation_valid, state as assessment_state
+from .model import Role, load_candidates, load_logs
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+from .revise import load_ledger
+
+_CSS = """\
+body{font-family:"Microsoft YaHei",sans-serif;margin:2rem auto;max-width:64rem;color:#111}
+h1{font-size:1.4rem} h2{font-size:1.1rem;margin-top:2rem}
+table{border-collapse:collapse;width:100%} th,td{border:1px solid #999;padding:4px 8px;font-size:.9rem;text-align:left}
+.warn{color:#a00} .note{color:#555;font-size:.85rem}
+.pass{font-weight:700} .fail{font-weight:700;color:#a00} .na{color:#777}
+.ok{color:#070;font-weight:700} .bad{color:#a00;font-weight:700}
+.chain li{margin:.4rem 0}
+"""
+
+
+def _esc(s: object) -> str:
+    return html.escape(str(s), quote=True)
+
+
+def _run_files(root: Path) -> list[tuple[Path, list[str]]]:
+    """Run files (the carriers of manual judgment) and the candidate IDs each literally cites."""
+    d = root / "04_comparative_analysis" / "runs"
+    out: list[tuple[Path, list[str]]] = []
+    if not d.is_dir():
+        return out
+    for p in sorted(d.glob("*.md")):
+        try:
+            text = p.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            continue
+        out.append((p, sorted(set(runs_mod.ID_RE.findall(text)))))
+    return out
+
+
+def _conclusion_files(root: Path, known: set[str]) -> list[tuple[Path, list[str], bool]]:
+    """Conclusion files, the IDs they cite, and whether every citation is in the ledger (V034)."""
+    d = root / "05_novelty_conclusions"
+    out: list[tuple[Path, list[str], bool]] = []
+    if not d.is_dir():
