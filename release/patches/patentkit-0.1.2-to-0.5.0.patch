@@ -0,0 +1,356 @@
+"""Query planner — coverage planning and supplementary-search suggestions for the 3-record hard cap.
+
+Why this module exists
+----------------------
+The CNIPA publication site returns **at most 3 records per query**, and programmatic paging is
+measured to be ineffective — recall can only accumulate through multiple narrow sub-queries
+(``cnipa_batches`` in the query library). So "how well the novelty search went" depends not on a
+single good query, but on **whether the sub-query set is complete and every entry actually ran**.
+This module turns that into numbers:
+
+* per axis: registered sub-queries vs. actually executed (per logs), hits captured, candidates
+  ingested, G-S-02 verified counts and **buffer** (the fragility scale of 05-acceptance-gates.md);
+* gap list: unexecuted sub-queries, axes without logs, concept groups (topics.CONCEPTS_BY_TARGET)
+  whose **none** of the keywords appear in any registered sub-query — wording drift between the
+  pool and the query vocabulary is the most common cause of a "fully judged yet still FAILing" axis;
+* suggestions: deterministic skeletons — new sub-queries built from uncovered concept groups
+  (first two CJK keywords, ``auto-`` label). Append-only: the query library rule is
+  **append at the end, never renumber**, so historical logs keep matching.
+
+This is planning/navigation, **not a determination**: suggestions are query skeletons for a human
+to word-check before running; the tool never runs a network query by itself.
+
+Usage::
+
+    python -m patentkit queryplan                    # all axes of the active target
+    python -m patentkit queryplan --axis N1          # one axis
+    python -m patentkit queryplan --apply            # write auto-* suggestions into query_library.yml
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from . import gates as gates_mod
+from . import topics as topics_mod
+from .model import SearchLog, load_logs
+from .paths import workspace_or_exit
+from .registry import Terminology, TerminologyError, load_registry, qualify
+
+LIBRARY_REL = Path("01_search_plan") / "query_library.yml"
+GS02_MIN = gates_mod.GS02_MIN_PER_AXIS
+
+
+# ── Data assembly ─────────────────────────────────────────────────────
+
+
+def _load_library(root: Path) -> dict[str, Any]:
+    path = root / LIBRARY_REL
+    if not path.is_file():
+        return {}
+    data = yaml.safe_load(path.read_text(encoding="utf-8"))
+    return data if isinstance(data, dict) else {}
+
+
+def _axis_logs(logs: list[SearchLog], key: str, short: str) -> list[SearchLog]:
+    """Logs of one axis: query.axis is the qualified ID; query.id is `<short>` or `<short>-<n>`."""
+    return [
+        log
+        for log in logs
+        if log.axis == key
+        or log.axis == short
+        or str(log.query_id).partition("-")[0] == short
+    ]
+
+
+def _executed_indices(logs: list[SearchLog], short: str, count: int) -> set[int]:
+    """Which registered sub-query indices have a log. Sub-query 1 is also accepted as a bare
+    `<short>` qid (historical single-run logs); index n otherwise needs `<short>-<n>`."""
+    qids = {log.query_id for log in logs}
+    out: set[int] = set()
+    for i in range(1, count + 1):
+        if f"{short}-{i}" in qids or (i == 1 and short in qids):
+            out.add(i)
+    return out
+
+
+def _cjk_keywords(keywords: list[str]) -> list[str]:
+    """CJK-containing keywords first (CNIPA abstract search is Chinese-first); ASCII-only as fallback."""
+    cjk = [k for k in keywords if re.search(r"[\u4e00-\u9fff]", k)]
+    return cjk or list(keywords)
+
+
+def _uncovered_groups(batches: list[dict[str, Any]], target: str) -> dict[str, list[str]]:
+    """Concept groups (per topics) whose **no keyword** appears in any registered sub-query text."""
+    corpus = " ".join(
+        " ".join(str(v) for v in (b or {}).values() if isinstance(v, str))
+        + " ".join(" ".join(a) for a in (b or {}).get("applicant") or [] if isinstance(a, str))
+        for b in batches
+    ).lower()
+    out: dict[str, list[str]] = {}
+    for group, keywords in topics_mod.concepts_for(target).items():
+        if not any(kw.lower() in corpus for kw in keywords):
+            out[group] = _cjk_keywords(keywords)
+    return out
+
+
+def _suggest_subquery(label_slug: str, keywords: list[str]) -> dict[str, str]:
+    kws = [k for k in keywords[:2]] or ["TBD"]
+    return {"label": f"auto-{label_slug}", "abstract": " and ".join(kws)}
+
+
+def _slug(text: str) -> str:
+    keep = re.sub(r"[^0-9A-Za-z]+", "-", text).strip("-").lower()
+    return keep or "group"
+
+
+def plan_axis(
+    key: str,
+    short: str,
+    batches: list[dict[str, Any]],
+    logs: list[SearchLog],
+    counts: dict[str, int],
+) -> dict[str, Any]:
+    executed = _executed_indices(logs, short, len(batches))
+    live = sum(1 for log in logs if log.is_replayable())
+    complete = sum(1 for log in logs if log.result.get("complete") is True)
+    hits = sum(log.hit_count or 0 for log in logs)
+    verified = counts.get("verified", 0)
+    buffer = verified - GS02_MIN
+
+    if verified == 0:
+        buffer_state = "verified 尚无数据——先入库、先判定，再谈缓冲"
+    elif buffer < 0:
+        buffer_state = f"低于阈值（{verified}/{GS02_MIN}）——必须补检索"
+    elif buffer == 0:
+        buffer_state = "零缓冲：一次改判就翻 FAIL——必须补检索"
+    elif buffer <= 2:
+        buffer_state = f"缓冲 +{buffer}：脆弱——建议补至 +3"
+    else:
+        buffer_state = f"缓冲 +{buffer}：安全"
+
+    suggestions: list[str] = []
+    unexecuted = [i for i in range(1, len(batches) + 1) if i not in executed]
+    if unexecuted:
+        suggestions.append(f"子查询未执行 {unexecuted} —— fetch-cnipa --from-library --only {','.join(map(str, unexecuted))}")
+    if logs and live < len(logs):
+        suggestions.append(f"{len(logs) - live}/{len(logs)} 条日志不可复现（retrospective 或 raw 工件缺失）——G-S-05 只认 live + raw 工件")
+    if verified == 0 and not logs:
+        suggestions.append("该轴还没有任何检索日志——从已登记的子查询集开始（fetch-cnipa --from-library）")
+
+    return {
+        "axis": key,
+        "registered_subqueries": len(batches),
+        "executed_subqueries": len(executed),
+        "unexecuted_indices": unexecuted,
+        "logs": {"count": len(logs), "live": live, "complete": complete, "total_hits": hits},
+        "counts": counts,
+        "buffer": buffer,
+        "buffer_state": buffer_state,
+        "suggestions": suggestions,
+    }
+
+
+def build_plan(root: Path, term: Terminology, target: str, axis: str | None = None) -> dict[str, Any]:
+    lib = _load_library(root)
+    batches = lib.get("cnipa_batches") or {}
+    if not batches:
+        return {"ok": False, "error": f"the query library has no cnipa_batches section ({LIBRARY_REL.as_posix()})"}
+
+    report = gates_mod.compute_all(root, term, target)
+    logs = [log for log in load_logs(root) if log.target == target]
+
+    keys = sorted(batches) if axis is None else [axis if "@" in axis else qualify(axis, target)]
+    missing = [k for k in keys if k not in batches]
+    if missing:
+        return {"ok": False, "error": f"the query library has no cnipa_batches for these axes: {', '.join(missing)}",
+                "available": sorted(batches)}
+
+    axes_out = []
+    for key in keys:
+        short = key.split("@")[0]
+        axes_out.append(
+            plan_axis(key, short, batches[key], _axis_logs(logs, key, short), report.per_axis.get(short, {}))
+        )
+
+    # Cross-axis gap list: concept groups uncovered by the whole target's registered sub-queries
+    uncovered = _uncovered_groups([s for k in keys for s in batches[k]], target)
+    suggestions: dict[str, list[dict[str, str]]] = {}
+    for group, keywords in sorted(uncovered.items()):
+        for key in keys:
+            suggestions.setdefault(key, []).append(_suggest_subquery(_slug(group), keywords))
+
+    return {
+        "ok": True,
+        "workspace": str(root),
+        "target": target,
+        "generated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
+        "axes": axes_out,
+        "uncovered_concept_groups": sorted(uncovered),
+        "suggested_subqueries": suggestions,
+        "note": "planning/navigation, not a determination; the suggested sub-queries are skeletons — a human words them properly before running",
+    }
+
+
+# ── --apply: append-only insertion, comments preserved ────────────────
+
+
+def apply_suggestions(root: Path, plan: dict[str, Any]) -> tuple[Path, int]:
+    """Insert the suggested sub-queries into query_library.yml **as text** (safe_dump would reformat
+    the whole file and lose the comments — the comments are the query library's usage discipline).
+
+    Insertion point: after the last entry line of the target key's block (same indent); when the key
+    block does not exist, a new key block is appended at the end of the whole cnipa_batches section.
+    Returns (path, number of inserted entries).
+    """
+    path = root / LIBRARY_REL
+    text = path.read_text(encoding="utf-8")
+    lines = text.splitlines(keepends=True)
+    additions = plan.get("suggested_subqueries") or {}
+    if not additions:
+        return path, 0
+
+    inserted = 0
+    # Find the cnipa_batches section range
+    start = next(i for i, l in enumerate(lines) if l.startswith("cnipa_batches:"))
+    end = len(lines)
+    for i in range(start + 1, len(lines)):
+        if lines[i].strip() and not lines[i].startswith((" ", "#")):
+            end = i
+            break
+
+    for key, subs in sorted(additions.items()):
+        key_line = None
+        for i in range(start, end):
+            if lines[i].rstrip("\n") == f"  {key}:":
+                key_line = i
+                break
+        new_rows = [
+            f"    - {{ label: {s['label']}, abstract: '{s['abstract']}' }}  # tools:auto-suggestion\n"
+            for s in subs
+        ]
+        if key_line is not None:
+            # End of the key block = before the next `  <something>:` or within-section blank line/comment
+            block_end = end
+            for i in range(key_line + 1, end):
+                stripped = lines[i].rstrip("\n")
+                if stripped.strip() and not stripped.startswith(" ") and not stripped.startswith("#"):
+                    block_end = i
+                    break
+                if stripped.startswith("  ") and not stripped.startswith("    ") and stripped.rstrip().endswith(":"):
+                    block_end = i
+                    break
+            insert_at = block_end
+            while insert_at > key_line and not lines[insert_at - 1].strip():
+                insert_at -= 1
+        else:
+            # Append a new key block at the end of the section
+            block = [f"  {key}:\n"] + new_rows
+            lines[end:end] = block
+            inserted += len(subs)
+            continue
+        lines[insert_at:insert_at] = new_rows
+        inserted += len(subs)
+        end += len(new_rows)
+
+    path.write_text("".join(lines), encoding="utf-8", newline="")
+    return path, inserted
+
+
+# ── Rendering / CLI ───────────────────────────────────────────────────
+
+
+def render(plan: dict[str, Any]) -> str:
+    lines = [
+        f"Query plan — {plan['target']}（规划/导航，非判定；建议子查询需人工措辞后再跑）", ""
+    ]
+    for a in plan["axes"]:
+        short = a["axis"].split("@")[0]
+        lines.append(f"[{short}]  {a['axis']}")
+        lines.append(
+            f"    子查询   : 已登记 {a['registered_subqueries']} / 已执行 {a['executed_subqueries']}"
+            + (f"（未执行 {a['unexecuted_indices']}）" if a["unexecuted_indices"] else "")
+        )
+        lg = a["logs"]
+        lines.append(f"    日志     : {lg['count']} 条（live {lg['live']} / complete {lg['complete']}），累计报告命中 {lg['total_hits']}")
+        c = a["counts"]
+        lines.append(
+            f"    G-S-02   : verified {c.get('verified', 0)} / ≥attested {c.get('attested', 0)} / ≥asserted {c.get('asserted', 0)}"
+        )
+        lines.append(f"    缓冲     : {a['buffer_state']}")
+        for s in a["suggestions"]:
+            lines.append(f"    建议     : {s}")
+        lines.append("")
+    uncovered = plan.get("uncovered_concept_groups") or []
+    if uncovered:
+        lines.append("未覆盖技术要素组（任一关键词都未出现在已登记子查询中 — 措辞漂移是『判满仍 FAIL』的最常见原因）：")
+        for group in uncovered:
+            lines.append(f"  · {group}")
+        for key, subs in sorted((plan.get("suggested_subqueries") or {}).items()):
+            for s in subs:
+                lines.append(f"    → {key} 建议追加: {{ label: {s['label']}, abstract: '{s['abstract']}' }}")
+        lines.append("")
+    lines.append(f"追加建议进查询库：python -m patentkit queryplan --apply（只追加，不改既有条目序号）")
+    return "\n".join(lines)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.queryplan",
+        description="Per-axis search coverage planning: registered vs executed sub-queries, G-S-02 buffer, deterministic supplementary-query suggestions",
+    )
+    ap.add_argument("--axis", default=None, help="only plan one axis, e.g. N1 or N1@TGT-0001")
+    ap.add_argument("--target", default=None, help="target ID (defaults to the glossary active_target)")
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--apply", action="store_true",
+                    help="write auto-* suggested sub-queries into query_library.yml (append-only)")
+    ap.add_argument("--json", action="store_true")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+    target = args.target or term.active_target
+    if not target or target not in term.targets:
+        print(f"[FATAL] target not registered or no active target: {target}", file=sys.stderr)
+        return 2
+
+    plan = build_plan(root, term, target, args.axis)
+    if not plan.get("ok"):
+        print(f"[FATAL] {plan.get('error')}", file=sys.stderr)
+        if plan.get("available"):
+            print(f"  Available axes: {', '.join(plan['available'])}", file=sys.stderr)
+        return 2
+
+    if args.apply:
+        path, inserted = apply_suggestions(root, plan)
+        print(f"[WRITE] {path} (+{inserted} auto-* sub-queries; appended only — existing indices untouched)")
+        print("措辞检查后用 fetch-cnipa --from-library --only <n> 运行新条目")
+        return 0
+
+    if args.json:
+        print(json.dumps(plan, ensure_ascii=False, indent=2))
+    else:
+        print(render(plan))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
