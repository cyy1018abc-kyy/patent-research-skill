+"""0.4.0 改稿闭环回归：补丁原子性、改了没登记必被拦、未登记稿件不得入闭环。
+
+自包含，不依赖 tests/conftest；对应 references/13 的三条硬规则在内核侧的落点。"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import yaml
+
+from patentkit import revise, validate
+from patentkit.init import init_workspace
+from patentkit.model import sha256_file
+
+REGISTRY = """\
+target: TGT-0002
+drafts:
+  - role: claims
+    path: 07_drafting/claims.md
+    sha256: null
+    status: missing
+"""
+
+CLAIMS = "1. 一种装置，其膜厚度为 0.33-0.45 mm。\n2. 根据权利要求1的装置。\n"
+
+
+def _patch(root: Path, round_id: str = "R1") -> Path:
+    patch = {
+        "schema": 1,
+        "round": round_id,
+        "issue": "OA-X2",
+        "source": "office action",
+        "changes": [{"file": "07_drafting/claims.md", "field": "权1 数值范围",
+                     "find": "0.33-0.45", "replace": "0.35-0.42",
+                     "revalidate": ["provenance"]}],
+    }
+    path = root / "07_drafting" / f"patch-{round_id}.yml"
+    path.write_text(yaml.safe_dump(patch, allow_unicode=True), encoding="utf-8")
+    return path
+
+
+def _prep(tmp_path: Path):
+    root = tmp_path / "workspace"
+    init_workspace(root, "TGT-0002", "回归样例")
+    (root / "07_drafting" / "claims.md").write_text(CLAIMS, encoding="utf-8", newline="")
+    (root / "07_drafting" / "manuscript_registry.yml").write_text(
+        REGISTRY, encoding="utf-8", newline="")
+    return root
+
+
+def test_apply_is_atomic_and_rebinds_registry(tmp_path):
+    root = _prep(tmp_path)
+    assert revise.main(["apply", str(_patch(root)), "--root", str(root)]) == 0
+    text = (root / "07_drafting" / "claims.md").read_text(encoding="utf-8")
+    assert "0.35-0.42" in text
+    registry = yaml.safe_load(
+        (root / "07_drafting" / "manuscript_registry.yml").read_text(encoding="utf-8"))
+    assert registry["drafts"][0]["sha256"] == sha256_file(root / "07_drafting" / "claims.md")
+    assert registry["drafts"][0]["evidence_level"] == "attested"
+    ledger = revise.load_ledger(root)
+    assert ledger["rounds"][0]["revalidation_status"] == "pending"
+    # 干净闭环下 validate 无 V035/V036
+    codes = {f.code for f in validate.validate_all(root)}
+    assert "V035" not in codes and "V036" not in codes
+
+
+def test_unlogged_edit_is_reported_by_status_and_v036(tmp_path):
+    root = _prep(tmp_path)
+    assert revise.main(["apply", str(_patch(root)), "--root", str(root)]) == 0
+    (root / "07_drafting" / "claims.md").write_text("绕开工具直接改\n", encoding="utf-8", newline="")
+    assert revise.main(["status", "--root", str(root)]) == 1
+    # validate 侧 V036 为 warn（CLI --strict 时升级为 error 并 exit 1）
+    v036 = [f for f in validate.validate_all(root) if f.code == "V036"]
+    assert len(v036) == 1 and v036[0].level == "warn"
+
+
+def test_ambiguous_patch_refused_without_touching_bytes(tmp_path):
+    root = _prep(tmp_path)
+    before = (root / "07_drafting" / "claims.md").read_bytes()
+    patch = {
+        "schema": 1, "round": "R1", "issue": "OA-X2", "source": "office action",
+        "changes": [{"file": "07_drafting/claims.md", "field": "f",
+                     "find": "不存在的片段", "replace": "X"}],  # 0 次命中 → 拒绝
+    }
+    path = root / "07_drafting" / "patch-bad.yml"
+    path.write_text(yaml.safe_dump(patch, allow_unicode=True), encoding="utf-8")
+    assert revise.main(["apply", str(path), "--root", str(root)]) == 2
+    assert (root / "07_drafting" / "claims.md").read_bytes() == before
+    assert not (root / revise.LEDGER_REL).exists()
+
+
+def test_unregistered_manuscript_never_enters_the_loop(tmp_path):
+    root = _prep(tmp_path)
+    (root / "07_drafting" / "side.md").write_text("草稿\n", encoding="utf-8", newline="")
+    patch = {
+        "schema": 1, "round": "R1", "issue": "self", "source": "self review",
+        "changes": [{"file": "07_drafting/side.md", "field": "f",
+                     "find": "草稿", "replace": "改稿"}],
+    }
+    path = root / "07_drafting" / "patch-side.yml"
+    path.write_text(yaml.safe_dump(patch, allow_unicode=True), encoding="utf-8")
+    assert revise.main(["apply", str(path), "--root", str(root)]) == 2
+    assert (root / "07_drafting" / "side.md").read_text(encoding="utf-8") == "草稿\n"
