+"""Full consistency validation. Any error -> exit 1.
+
+Rule table
+----------
+V001 error  JSON parse failure / does not match candidates_schema.json
+V002 error  candidate id duplicated, or does not match ^[PL]-\\d{3,}$
+V003 error  file pointed to by source_log does not exist
+V004 error  bibtex_key not found in 06_citation_management/*.bib (placeholder keys of template files do not count)
+V005 warn   .bib entry has no matching candidate (reverse orphan) - template files exempt
+V006 error  log file name does not match <DB>_<YYYY-MM-DD>_<queryID>_<hits>.log.json
+V007 error  log query.id disagrees with the queryID segment of the file name
+V008 error  log result.hit_count disagrees with the hits segment of the file name
+V009 error  capture_mode=live but raw_export missing / file does not exist / is empty
+V010 warn   log db field disagrees with the DB segment of the file name (after normalization)
+V011 error  tags contain an axis ID that is not registered in the glossary
+V012 error  runs reference an unknown candidate ID
+V013 error  evidence_level=verified but evidence_ref missing / file does not exist
+V014 error  normalized publication numbers are identical - genuine duplicate entry
+V028 info   title + first applicant + year all identical - possibly a family member or double publication in the same year
+V015 error  logged_at is not an ISO8601 timestamp with timezone
+V016 warn   time_window endpoint is later than today
+V017 error  novelty_check=blocking, but the run containing this document says novelty_pass (conflicting statements)
+V018 warn   role=near_prior_art, but its document number never appears in any run
+V019 warn   pending migration: candidate lacks evidence_level or role (tool infers conservative values)
+V020 warn   pending migration: log lacks capture_mode (tool treats it as retrospective)
+V021 error  evidence_level=attested but evidence_ref or evidence_sha256 is missing
+V022 warn   a JSON file under 02_search_logs is not named *.log.json (it is never loaded - effectively silently lost)
+V023 warn   pending migration: tag is a v1 bare axis name (`N1`); qualify it to `N1@TGT-xxxx`
+V024 warn   pending migration: missing target field (filter key of the v2 multi-target gates); error if the value is not registered
+V025 error  qualified target of a tag disagrees with the candidate target field
+V026 warn   raw artifact record count < declared hit count (the export may contain only some pages)
+V027 error  draft registry structure is invalid
+V031 error  numerical provenance: statement without any A/B/C source
+V032 error  numerical provenance: invalid grade / missing ref+locator / ref points nowhere
+V033 warn   figure marks: spec and manuscript disagree (heuristic — confirm before editing)
+V034 error  a conclusion cites a candidate ID that is not in the evidence ledger
+V035 error  revision ledger exists but its structure is invalid (the chain is untrustworthy)
+V036 warn   file content changed after the last revision round (edit without a logged round)
+
+Design notes
+------------
+* All level/role resolution goes through model.Candidate's effective_* methods; nothing is recomputed here.
+* The "pending migration" rules (V019/V020) exist so the tool can run before Step-1a
+  without hiding the fact that the data has not been backfilled yet.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Iterable
+
+from . import runs as runs_mod
+from .model import Candidate, Finding, SearchLog, load_candidates, load_logs, read_json, resolve_ref
+from .paths import workspace_or_exit
+from .assessment import assessment_errors, confirmation_valid
+from .registry import (
+    BARE_AXIS_RE,
+    Terminology,
+    TerminologyError,
+    load_registry,
+    split_axis_id,
+)
+
+#: Log file-name convention: <DB>_<YYYY-MM-DD>_<queryID>_<hits>.log.json
+#: queryID may be `<axis>` or `<axis>-<sequence>` - the latter is for **multiple sub-queries on the same axis**
+#: (the CNIPA publication site returns only 3 records per query, so results must accumulate
+#: from several angles and the logs must not collide in name).
+LOG_NAME_RE = re.compile(
+    r"^(?P<db>[A-Za-z0-9_]+)_(?P<date>\d{4}-\d{2}-\d{2})_"
+    r"(?P<qid>[A-Za-z0-9-]+)_(?P<hits>\d+)\.log\.json$"
+)
+
+CANDIDATE_ID_RE = re.compile(r"^[PL]-\d{3,}$")
+BIB_ENTRY_RE = re.compile(r"@(\w+)\s*\{\s*([^,\s]+)\s*,", re.MULTILINE)
+#: Normalization keeps Latin and CJK characters - an early version kept only [0-9a-z],
+#: which blanked out Chinese titles and made the duplicate check useless for them.
+NON_ALNUM_RE = re.compile(r"[^0-9a-z\u4e00-\u9fff]+")
+
+#: Template marker of a .bib file: the file name contains `template`, or the file contains `% tools:template`
+BIB_TEMPLATE_MARKER_RE = re.compile(r"^\s*%\s*tools:template\b", re.MULTILINE)
+
+
+def is_template_bib(path: Path, text: str) -> bool:
+    """Tell whether a .bib file is only a template (placeholder keys, not real references).
+
+    Templates must be kept out of the key pool for two reasons:
+      1. placeholder keys obviously have no matching candidate -> a false V005
+      2. treating a placeholder key as valid would actually let bibtex_key="YYYY-AUTHORS-KEYWORDS" pass V004
+    """
+    if "template" in path.name.lower():
+        return True
+    return bool(BIB_TEMPLATE_MARKER_RE.search(text))
+
+
+
+def normalize_text(value: str) -> str:
+    return NON_ALNUM_RE.sub("", value.lower())
+
+
+# ── Individual rules ─────────────────────────────────────────────────
+
+
+def check_parsable(root: Path) -> list[Finding]:
+    """V001 (parse part): report unreadable JSON separately so later rules do not silently skip it."""
+    out: list[Finding] = []
+    for sub in ("03_candidates", "02_search_logs"):
+        d = root / sub
+        if not d.is_dir():
+            out.append(Finding("error", "V001", d, f"directory does not exist: {sub}"))
+            continue
+        for p in sorted(d.glob("*.json")):
+            _, err = read_json(p)
+            if err is not None:
+                out.append(Finding("error", "V001", p, err))
+    return out
+
+
+def check_schema(root: Path) -> list[Finding]:
+    """V001 (schema part)."""
+    schema_path = root / "03_candidates" / "candidates_schema.json"
+    if not schema_path.is_file():
+        return [Finding("error", "V001", schema_path, "schema file does not exist")]
+
+    schema, err = read_json(schema_path)
+    if err is not None or not isinstance(schema, dict):
+        return [Finding("error", "V001", schema_path, err or "schema is not an object")]
+
+    try:
+        from jsonschema import Draft7Validator
+    except ImportError:  # pragma: no cover
+        return [
+            Finding(
+                "warn",
+                "V001",
+                schema_path,
+                "jsonschema is not installed; skipping schema validation (pip install -r requirements.txt)",
+            )
+        ]
+
+    validator = Draft7Validator(schema)
+    out: list[Finding] = []
+    for p in sorted((root / "03_candidates").glob("*.json")):
+        if p.name.endswith("_schema.json"):
+            continue
+        data, rerr = read_json(p)
+        if rerr is not None:
+            continue  # already reported by check_parsable
+        for e in sorted(validator.iter_errors(data), key=lambda x: list(x.path)):
+            loc = "/".join(str(x) for x in e.path) or "<root>"
+            out.append(Finding("error", "V001", p, f"schema {loc}: {e.message}"))
+    return out
+
+
+def check_ids(candidates: list[Candidate]) -> list[Finding]:
+    """V002。"""
+    out: list[Finding] = []
+    seen: dict[str, Path] = {}
+    for c in candidates:
+        if not CANDIDATE_ID_RE.match(c.id):
+            out.append(
+                Finding("error", "V002", c.path, f"id '{c.id}' does not match ^[PL]-\\d{{3,}}$")
+            )
+            continue
+        if c.id in seen:
+            out.append(
+                Finding("error", "V002", c.path, f"id '{c.id}' duplicates {seen[c.id].name}")
+            )
+        else:
+            seen[c.id] = c.path
+    return out
+
+
+def check_evidence(candidates: list[Candidate], root: Path) -> list[Finding]:
+    """V013 / V019 / V021。"""
+    out: list[Finding] = []
+    for c in candidates:
+        if not c.has_evidence_level_field:
+            out.append(
+                Finding(
+                    "warn",
+                    "V019",
+                    c.path,
+                    "pending migration: missing evidence_level (tool treats it as asserted; run "
+                    "python -m patentkit.migrate to backfill)",
+                )
+            )
+        if not c.has_role_field:
+            out.append(
+                Finding(
+                    "warn",
+                    "V019",
+                    c.path,
+                    "pending migration: missing role (tool infers it from run references; run "
+                    "python -m patentkit.migrate to backfill)",
+                )
+            )
+
+        declared = c.declared_level.value
+        ref = c.data.get("evidence_ref")
+
+        if declared == "verified":
+            if not ref:
+                out.append(
+                    Finding("error", "V013", c.path, "evidence_level=verified but evidence_ref is empty")
+                )
+            else:
+                p = resolve_ref(c.path, str(ref))
+                if not p.is_file():
+                    out.append(
+                        Finding("error", "V013", c.path, f"file pointed to by evidence_ref does not exist: {ref}")
+                    )
+                elif p.stat().st_size == 0:
+                    out.append(
+                        Finding("error", "V013", c.path, f"file pointed to by evidence_ref is empty: {ref}")
+                    )
+
+        if declared == "attested":
+            if not ref:
+                out.append(
+                    Finding("error", "V021", c.path, "evidence_level=attested but evidence_ref is empty")
+                )
+            if not c.data.get("evidence_sha256"):
+                out.append(
+                    Finding(
+                        "error", "V021", c.path, "evidence_level=attested but evidence_sha256 is empty"
+                    )
+                )
+    return out
+
+
+def check_stray_logs(root: Path) -> list[Finding]:
+    """V022: JSON files under 02_search_logs that are not *.log.json are never loaded by load_logs.
+
+    This is a **silent-loss** trap: the file just sits there, looks like a log, and never enters
+    any validation or gate computation. It must be reported explicitly, otherwise "the log was
+    there but was not counted" is impossible to notice."""
+    out: list[Finding] = []
+    d = root / "02_search_logs"
+    if not d.is_dir():
+        return out
+    for p in sorted(d.glob("*.json")):
+        if p.name.endswith(".log.json"):
+            continue
+        out.append(
+            Finding(
+                "warn",
+                "V022",
+                p,
+                "not named *.log.json, so the tools never load it (naming convention: "
+                "02_search_logs/README.md:5-14)",
+            )
+        )
+    return out
+
+
+def check_export_completeness(root: Path, logs: list[SearchLog]) -> list[Finding]:
+    """V026: record count of raw artifacts vs the declared hit_count.
+
+    **Why this rule exists**: N1 declared 237 hits, while Espacenet's `Export -> CSV` only exported
+    the 20 records of the current page. It was only spotted by **comparing the 4th row of the CSV
+    by eye**, which showed "Results 1 to 20 displayed". With this rule, any future incomplete
+    export is caught on the spot by `validate`.
+
+    Only applies to parseable formats; unparseable ones produce an info finding and are skipped.
+    """
+    # Lazy import: ingest depends on model/paths/registry, not on validate, so there is no cycle;
+    # keeping the coupling inside the function avoids module-level pull.
+    from . import ingest as ingest_mod
+
+    out: list[Finding] = []
+    for log in logs:
+        if log.capture_mode.value != "live":
+            continue
+
+        try:
+            paths = ingest_mod.resolve_raw_files(root, log.path, None)
+        except (FileNotFoundError, ValueError):
+            continue  # missing artifacts are reported by V009
+
+        if not paths:
+            continue
+
+        total = 0
+        parsed_any = False
+        for p in paths:
+            try:
+                total += len(ingest_mod.read_raw(p, {}))
+                parsed_any = True
+            except ValueError:
+                continue  # unsupported format (e.g. CNIPA XML)
+            except Exception:  # noqa: BLE001 - a parse failure must not crash the whole validation run
+                continue
+
+        if not parsed_any:
+            out.append(
+                Finding(
+                    "info",
+                    "V026",
+                    log.path,
+                    f"none of the {len(paths)} raw artifact file(s) could be parsed; skipping export-completeness check",
+                )
+            )
+            continue
+
+        hits = log.hit_count
+        if hits is None or total >= hits:
+            continue
+
+        # A log may explicitly declare "not fully captured" (result.complete=false) - that is honest
+        # record-keeping, not concealment. V026 targets **concealed incompleteness** (the export was
+        # assumed complete but only the first page was exported). Treating the two differently is
+        # essential, otherwise a declared partial capture would make strict mode fail forever and
+        # push people to hide it.
+        declared_partial = log.data.get("result", {}).get("complete") is False
+        if declared_partial:
+            out.append(
+                Finding(
+                    "info",
+                    "V026",
+                    log.path,
+                    f"raw artifacts contain {total} record(s) < declared hits {hits}; "
+                    f"the log explicitly declares complete=false (partial capture, honestly recorded)",
+                )
+            )
+        else:
+            out.append(
+                Finding(
+                    "warn",
+                    "V026",
+                    log.path,
+                    f"raw artifacts contain only {total} record(s), but {hits} hits were declared"
+                    f"(short by {hits - total}) - very likely only some pages were exported; export the rest and re-run",
+                )
+            )
+    return out
+
+
+def check_draft_registry(root: Path) -> list[Finding]:
+    """V027: structural validation of the draft registry (07_drafting/manuscript_registry.yml).
+
+    Per decision Q1 the manuscript bodies stay outside the repo; the repo only holds the registry
+    and the sha256 bindings. This checks the structure of the registry itself and the **length** of
+    sha256 (it does not read the external files; missing files are not an error here).
+    """
+    path = root / "07_drafting" / "manuscript_registry.yml"
+    if not path.is_file():
+        return []
+
+    try:
+        import yaml
+
+        data = yaml.safe_load(path.read_text(encoding="utf-8"))
+    except Exception as exc:  # noqa: BLE001
+        return [Finding("error", "V027", path, f"YAML parse failed: {exc}")]
+
+    if not isinstance(data, dict):
+        return [Finding("error", "V027", path, "top level must be a mapping")]
+    if not data.get("target"):
+        return [Finding("error", "V027", path, "missing target field")]
+
+    drafts = data.get("drafts")
+    if not isinstance(drafts, list) or not drafts:
+        return [Finding("error", "V027", path, "drafts must be a non-empty list")]
+
+    out: list[Finding] = []
+    for i, d in enumerate(drafts):
+        if not isinstance(d, dict):
+            out.append(Finding("error", "V027", path, f"drafts[{i}] is not a mapping"))
+            continue
+        for field in ("role", "path"):
+            if not d.get(field):
+                out.append(Finding("error", "V027", path, f"drafts[{i}] is missing {field}"))
+        sha = d.get("sha256")
+        if sha is not None and not re.fullmatch(r"[0-9a-f]{64}", str(sha)):
+            out.append(
+                Finding(
+                    "error",
+                    "V027",
+                    path,
+                    f"drafts[{i}].sha256 is not 64 lowercase hex characters: {str(sha)[:20]}...",
+                )
+            )
+    return out
+
+
+def check_source_logs(candidates: list[Candidate]) -> list[Finding]:
+    """V003."""
+    out: list[Finding] = []
+    for c in candidates:
+        if not c.source_log:
+            out.append(Finding("error", "V003", c.path, "source_log is empty"))
+            continue
+        p = resolve_ref(c.path, c.source_log)
+        if not p.is_file():
+            out.append(
+                Finding("error", "V003", c.path, f"source_log does not exist: {c.source_log}")
+            )
+    return out
+
+
+def check_bibtex(root: Path, candidates: list[Candidate]) -> list[Finding]:
+    """V004 / V005.
+
+    The template .bib (citation-template.bib) is excluded from the key pool:
+      * its placeholder keys are not orphan references -> no V005
+      * candidates are still not allowed to point at placeholder keys -> V004 still fires
+    """
+    bib_dir = root / "06_citation_management"
+    keys: dict[str, Path] = {}
+    if bib_dir.is_dir():
+        for p in sorted(bib_dir.glob("*.bib")):
+            try:
+                text = p.read_text(encoding="utf-8")
+            except OSError:
+                continue
+            if is_template_bib(p, text):
+                continue
+            for m in BIB_ENTRY_RE.finditer(text):
+                keys.setdefault(m.group(2), p)
+
+    out: list[Finding] = []
+    for c in candidates:
+        key = c.bibtex_key
+        if not key:
+            out.append(Finding("warn", "V004", c.path, "missing bibtex_key field; cannot be aligned with 06 citation management"))
+            continue
+        if key not in keys:
+            out.append(
+                Finding("error", "V004", c.path, f"bibtex_key '{key}' is not found in 06_citation_management/*.bib")
+            )
+
+    used = {c.bibtex_key for c in candidates if c.bibtex_key}
+    for key, p in sorted(keys.items()):
+        if key not in used:
+            out.append(
+                Finding("warn", "V005", p, f".bib entry '{key}' has no matching candidate in 03_candidates (orphan)")
+            )
+    return out
+
+
+def check_terminology(term: Terminology, candidates: list[Candidate]) -> list[Finding]:
+    """V011 (unregistered) / V023 (v1 bare axis name pending migration).
+
+    They are reported separately because the remedies differ:
+      V023 -> just run `python -m patentkit.migrate`
+      V011 -> the value is genuinely wrong
+    """
+    out: list[Finding] = []
+    known = term.axis_ids
+    for c in candidates:
+        for tag in c.tags:
+            parts = split_axis_id(tag)
+            if parts and c.target and parts[1] != c.target:
+                # The candidate target changed but its tags did not - that would attach "a target-B axis to a target-A candidate"
+                out.append(
+                    Finding(
+                        "error",
+                        "V025",
+                        c.path,
+                        f"qualified target of tag '{tag}' disagrees with candidate target='{c.target}'",
+                    )
+                )
+                continue
+            if tag in known:
+                continue
+            if BARE_AXIS_RE.match(tag):
+                out.append(
+                    Finding(
+                        "warn",
+                        "V023",
+                        c.path,
+                        f"tag '{tag}' is a v1 bare axis name, ambiguous with multiple targets; "
+                        f"qualify it as '{tag}@{c.target or 'TGT-xxxx'}'; "
+                        f"run python -m patentkit.migrate to backfill",
+                    )
+                )
+            else:
+                out.append(
+                    Finding(
+                        "error",
+                        "V011",
+                        c.path,
+                        f"tag '{tag}' is not registered in the axes of 00_methodology/glossary.yml",
+                    )
+                )
+    return out
+
+
+def check_targets(
+    term: Terminology,
+    candidates: list[Candidate],
+    logs: list[SearchLog],
+) -> list[Finding]:
+    """V024: target field missing (pending migration) or not registered (error).
+
+    target is the filter key of the v2 multi-target gates - without it, historical candidates of
+    TGT-0000 would be counted into the gates of TGT-0001, which is exactly why this must be
+    intercepted explicitly.
+    """
+    out: list[Finding] = []
+    known = set(term.targets)
+
+    def check(path: Path, target: str, what: str) -> None:
+        if not target:
+            out.append(
+                Finding(
+                    "warn",
+                    "V024",
+                    path,
+                    f"{what}is missing the target field (filter key of the v2 multi-target gates); "
+                    f"run python -m patentkit.migrate to backfill",
+                )
+            )
+        elif target not in known:
+            out.append(
+                Finding(
+                    "error",
+                    "V024",
+                    path,
+                    f"target='{target}' of {what}is not registered in the targets section of 00_methodology/glossary.yml",
+                )
+            )
+
+    for c in candidates:
+        check(c.path, c.target, "candidate ")
+    for log in logs:
+        check(log.path, log.target, "search log ")
+    return out
+
