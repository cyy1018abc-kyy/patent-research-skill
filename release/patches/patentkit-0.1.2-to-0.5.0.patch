-def check_duplicates(candidates: list[Candidate]) -> list[Finding]:
-    """V014 (genuine duplicate) / V028 (suspected family member).
-
-    **Lesson from real data**: treating "same title" as a duplicate produced 14 false groups on
-    237 real candidates. The cause is that **multi-country family members** of one invention
-    (WO/US, CN application + grant, three SAMSUNG filings) naturally share a title while differing
-    in publication number; generic titles such as "Fuel cell" also collide en masse.
-
-    So detection is layered by semantics:
-      V014 error - identical normalized publication number: a genuine duplicate entry that must be fixed
-      V028 info  - title + first applicant + year all identical: possibly a family member or a double
-                   publication in the same year; worth a human look
-    """
-    out: list[Finding] = []
-    by_doc: dict[str, Path] = {}
-    by_sig: dict[tuple[str, str, int], Path] = {}
-
-    for c in candidates:
-        d = normalize_text(c.doc_number)
-        if len(d) >= 6:
-            if d in by_doc:
-                out.append(
-                    Finding(
-                        "error",
-                        "V014",
-                        c.path,
-                        f"publication number duplicates {by_doc[d].name} ({c.doc_number})",
-                    )
-                )
-            else:
-                by_doc[d] = c.path
-
-        t = normalize_text(c.title)
-        if len(t) >= 12:
-            authors = c.data.get("authors_or_applicants") or [""]
-            first = normalize_text(str(authors[0] if authors else ""))
-            year = c.data.get("year")
-            sig = (t, first, year if isinstance(year, int) else 0)
-            if sig in by_sig:
-                out.append(
-                    Finding(
-                        "info",
-                        "V028",
-                        c.path,
-                        f"title/applicant/year are identical to {by_sig[sig].name}"
-                        f" - possibly a family member or a double publication in the same year",
-                    )
-                )
-            else:
-                by_sig[sig] = c.path
-    return out
