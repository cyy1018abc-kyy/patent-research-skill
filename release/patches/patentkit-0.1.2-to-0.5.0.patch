+# ── apply ─────────────────────────────────────────────────────────────
+
+@dataclass
+class ApplyReport:
+    changed: int = 0
+    skipped: int = 0
+    unknown: list[str] = None  # type: ignore[assignment]
+    errors: list[str] = None  # type: ignore[assignment]
+    encoding: str = ""
+    #: **not a single byte was written** because errors were present
+    aborted: bool = False
+    #: number of files actually written (non-zero only after a successful write)
+    written: int = 0
+
+    def __post_init__(self) -> None:
+        if self.unknown is None:
+            self.unknown = []
+        if self.errors is None:
+            self.errors = []
+
+
+def _parse_int(value: str, row: int, col: str, report: ApplyReport) -> int | None:
+    raw = (value or "").strip()
+    if raw == "":
+        return None
+    if not raw.isdigit():
+        report.errors.append(f"row {row} {col}='{raw}' is not a number")
+        return None
+    n = int(raw)
+    if not RELEVANCE_MIN <= n <= RELEVANCE_MAX:
+        report.errors.append(f"row {row} {col}={n} is out of range (expected 1–5)")
+        return None
+    return n
+
+
+def read_sheet_text(path: Path) -> tuple[str, str]:
+    """Read the worksheet text, returning (text, actual encoding).
+
+    ⚠️ **Why it cannot simply be read as utf-8**
+    We export `utf-8-sig` (with BOM, so Excel opens Chinese correctly on double-click),
+    but on Chinese Windows Excel **converts CSV to GBK when saving**, wiping the BOM along the way.
+    The result is "the export opens fine, but saving it back raises UnicodeDecodeError".
+
+    Here the encoding is detected automatically by BOM and a trial order:
+    utf-8-sig → utf-16 (by BOM) → utf-8 → gb18030 (a superset of GBK).
+    Finally fall back to replace — **better to read in a little mojibake than to fail the whole apply**.
+    """
+    raw = path.read_bytes()
+    if raw[:3] == b"\xef\xbb\xbf":
+        return raw.decode("utf-8-sig"), "utf-8-sig"
+    if raw[:2] in (b"\xff\xfe", b"\xfe\xff"):
+        return raw.decode("utf-16"), "utf-16"
+    for enc in ("utf-8", "gb18030"):
+        try:
+            return raw.decode(enc), enc
+        except UnicodeDecodeError:
+            continue
+    return raw.decode("utf-8", errors="replace"), "utf-8(replace)"
+
+
+def apply_worksheet(
+    root: Path, term: Terminology, path: Path, *, dry_run: bool = True, by: str = "", target: str = ""
