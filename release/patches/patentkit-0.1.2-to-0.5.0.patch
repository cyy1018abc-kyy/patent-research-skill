+def configure_stdio() -> None:
+    """Pin stdout/stderr to UTF-8 (errors="replace") for CLI entry points.
+
+    Windows consoles encode with the OEM/ANSI code page (cp1252/GBK); printing table symbols
+    like `>=`'s real glyph or CJK text then raises UnicodeEncodeError and kills the command
+    (seen on GitHub Actions windows runners: review progress -> cp1252 -> crash). The skill
+    scripts solve this in scripts/_env.py; the kernel must not rely on callers doing it.
+    Importing the package must NOT mutate global streams — call this only inside main() entry
+    points. Streams replaced by capture (pytest capsys, StringIO) are skipped via getattr.
+    """
+    import sys as _sys
+
+    for stream in (_sys.stdout, _sys.stderr):
+        reconfigure = getattr(stream, "reconfigure", None)
+        if reconfigure is None:
+            continue
+        try:
+            reconfigure(encoding="utf-8", errors="replace")
+        except (ValueError, OSError):  # pragma: no cover - closed/odd streams
+            pass
+
+
 class WorkspaceNotFound(RuntimeError):
     """No workspace found by searching upward from the starting directory. The message includes actionable fixes."""
 
diff --git a/b/patentkit/provenance.py b/patentkit/provenance.py
new file mode 100644
index 0000000..9f13c8d
--- /dev/null
+++ b/patentkit/provenance.py
@@ -0,0 +1,264 @@
+"""Numerical-claim provenance: every number in a manuscript must trace to a source.
+
+Why this module exists
+----------------------
+A numerical range in a claim ("50-90%") is a legal limitation. If it cannot be traced back to
+either the inventors' own material, a retrieved document, or an explicitly marked example, the
+claim is built on air: at best the examination answer loses an argument, at worst the claim is
+invalidated by an undisclosed feature. Humans review numbers one by one and miss them; a
+deterministic scanner does not.
+
+The A/B/C grades (single source of truth — this module; references explain them):
+
+* **A — 自产材料** (in-house material): experiment records, design docs, embodiment data that
+  live inside the workspace. Requires an existing ``ref`` file + ``locator``.
+* **B — 文献/对比文件** (retrieved document): a candidate in ``03_candidates``. Requires the
+  candidate ID to exist; the locator should quote where the number appears.
+* **C — 实施例示例** (illustrative example): a number invented for the embodiment narrative.
+  Legal but must be *declared* — an undeclared C is exactly how fabricated data sneaks in.
+
+Workflow
+--------
+1. ``patentkit provenance scan --manuscript <file.md>`` → skeleton registry (dry-run to stdout,
+   ``--out`` writes ``07_drafting/numerical_provenance.yml``).
+2. Humans fill in ``sources`` for every entry (or mark the statement for deletion).
+3. ``patentkit provenance check`` → errors; ``validate`` integrates the same rules as
+   V031/V032 so CI and the acceptance gates see them too.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from .model import load_candidates
+from .paths import workspace_or_exit
+
+#: Where the registry lives inside a workspace
+REGISTRY_REL = Path("07_drafting") / "numerical_provenance.yml"
+
+#: Sentence splitters: CJK stops first, Latin stops second (a decimal point is not a stop)
+_SENT_SPLIT = re.compile(r"[。；;！？!?\n]+")
+
+#: A "numerical statement" sentence: a number that carries technical meaning.
+#: Requires a unit/range/percentage to avoid flagging bare list indices ("步骤3"),
+#: while still catching "3 mm", "50-90%", "≥1.5 MPa", "至少两台", "10°".
+_NUM_UNIT = re.compile(
+    r"\d+(?:\.\d+)?\s*(?:%"
+    r"|[-–~～]\s*\d+(?:\.\d+)?"
+    r"|(?:mm|cm|m|μm|nm|km|kg|g|mg|N|kN|MPa|kPa|Pa|kW|W|MW|V|mV|kV|A|mA|Ah|mAh|Hz|kHz|MHz|GHz|s|ms|μs|min|h|L|mL|°C|K|mol|ppm|V·|r/min|rpm|bar|torr|atm)\b"
+    r"|℃|°|度以上|度以下|以上|以下|个|台|层|次|倍|重量份|体积份|vol|wt"
+    r")",
+    re.IGNORECASE,
+)
+
+#: Number-of-items CJK pattern: "至少两台/三个/5层" — counted as numerical statements too
+_CJK_COUNT = re.compile(r"[一二三四五六七八九十两\d]+\s*(?:个|台|层|次|倍|组|套|路|通道)")
+
+GRADES = ("A", "B", "C")
+
+GRADE_LABELS = {
+    "A": "自产材料（实验记录/设计文档/自测数据，需 ref+locator 指向工作区内文件）",
+    "B": "文献/对比文件（03_candidates 中的候选，需 candidate id + locator）",
+    "C": "实施例示例（仅用于说明性实施例，必须显式声明，不得伪装成实测数据）",
+}
+
+
+def scan_text(text: str) -> list[str]:
+    """Extract numerical statements (deduplicated, order preserved) from manuscript text."""
+    seen: set[str] = set()
+    out: list[str] = []
+    for raw in _SENT_SPLIT.split(text):
+        sent = raw.strip().strip("，,、 \t")
+        if not sent or len(sent) < 4:
+            continue
+        if _NUM_UNIT.search(sent) or _CJK_COUNT.search(sent):
+            key = sent
+            if key not in seen:
+                seen.add(key)
+                out.append(sent)
+    return out
+
+
+def build_skeleton(statements: list[str], manuscript: str) -> dict[str, Any]:
+    """Skeleton registry: every statement pre-listed with empty sources (fail-closed)."""
+    return {
+        "schema_version": 1,
+        "generated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
+        "generated_from": manuscript,
+        "entries": [
+            {
+                "id": f"NUM-{i:03d}",
+                "statement": s,
+                "claim_ref": "",  # 权利要求编号/说明书段落号，人工填写
+                "sources": [],  # 人工填写：{grade: A|B|C, ref: ..., locator: ..., note: ...}
+            }
+            for i, s in enumerate(statements, start=1)
+        ],
+    }
+
+
+def load_registry(root: Path) -> dict[str, Any] | None:
+    """Load the registry; None when absent (provenance is opt-in per manuscript stage)."""
+    path = root / REGISTRY_REL
+    if not path.is_file():
+        return None
+    data = yaml.safe_load(path.read_text(encoding="utf-8"))
+    return data if isinstance(data, dict) else {}
+
+
+def check_registry(root: Path, registry: dict[str, Any] | None) -> list[tuple[str, str]]:
+    """Validate the registry. Returns (code, message) pairs; codes V031/V032.
+
+    Deterministic only: file existence, candidate existence, grade validity. Whether the quote
+    actually supports the number stays a human judgment — the tool refuses to fake it.
+    """
+    out: list[tuple[str, str]] = []
+    if registry is None:
+        return out
+
+    entries = registry.get("entries")
+    if not isinstance(entries, list):
+        return [("V031", "numerical_provenance.yml: entries must be a list")]
+
+    candidates = {c.id: c for c in load_candidates(root)}
+    seen_ids: set[str] = set()
+
+    for i, entry in enumerate(entries, start=1):
+        if not isinstance(entry, dict):
+            out.append(("V031", f"numerical_provenance.yml entry #{i}: must be a mapping"))
+            continue
+        eid = str(entry.get("id") or f"#{i}")
+        if eid in seen_ids:
+            out.append(("V031", f"{eid}: duplicate provenance id"))
+        seen_ids.add(eid)
+
+        statement = str(entry.get("statement") or "").strip()
+        if not statement:
+            out.append(("V031", f"{eid}: statement is empty"))
+
+        sources = entry.get("sources")
+        if not isinstance(sources, list) or not sources:
+            out.append(("V031", f"{eid}: no source — a numerical claim without provenance is built on air"))
+            continue
+
+        for src in sources:
+            if not isinstance(src, dict):
+                out.append(("V032", f"{eid}: source must be a mapping"))
+                continue
+            grade = src.get("grade")
+            if grade not in GRADES:
+                out.append(("V032", f"{eid}: grade must be one of A/B/C, got {grade!r}"))
+                continue
+            ref = str(src.get("ref") or "").strip()
+            locator = str(src.get("locator") or "").strip()
+            if not ref or not locator:
+                out.append(("V032", f"{eid}: grade {grade} requires ref + locator"))
+                continue
+            if grade == "A":
+                p = (root / ref).resolve()
+                if not p.is_relative_to(root.resolve()) or not p.is_file():
+                    out.append(("V032", f"{eid}: grade A ref does not exist in the workspace: {ref}"))
+            elif grade == "B":
+                cand = candidates.get(ref)
+                if cand is None:
+                    out.append(("V032", f"{eid}: grade B ref is not a known candidate ID: {ref}"))
+            else:  # C
+                note = str(src.get("note") or "").strip()
+                if not note:
+                    out.append(("V032", f"{eid}: grade C must declare itself an example via note"))
+
+    return out
+
+
+def render_report(registry: dict[str, Any], problems: list[tuple[str, str]]) -> str:
+    lines = ["数值声明溯源核对表 (numerical provenance)", ""]
+    by_grade: dict[str, int] = {}
+    for entry in registry.get("entries") or []:
+        for src in entry.get("sources") or []:
+            g = str(src.get("grade") or "?")
+            by_grade[g] = by_grade.get(g, 0) + 1
+    lines.append(f"条目: {len(registry.get('entries') or [])}  来源分布: {by_grade or '无'}")
+    lines.append("")
+    for entry in registry.get("entries") or []:
+        eid = entry.get("id", "?")
+        stmt = str(entry.get("statement") or "")
+        lines.append(f"[{eid}] {stmt}")
+        claim = str(entry.get("claim_ref") or "").strip()
+        lines.append(f"    claim_ref: {claim or '_(未填)_'}")
+        for src in entry.get("sources") or []:
+            lines.append(f"    [{src.get('grade')}] {src.get('ref')} @ {src.get('locator')}"
+                         f"{' — ' + str(src.get('note')) if src.get('note') else ''}")
+        if not entry.get("sources"):
+            lines.append("    ⚠️ 无来源 — 待补")
+        lines.append("")
+    if problems:
+        lines.append("问题:")
+        for code, msg in problems:
+            lines.append(f"  [{code}] {msg}")
+    return "\n".join(lines)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.provenance",
+        description="Numerical-claim provenance: scan manuscripts, validate the A/B/C source registry",
+    )
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    scan = sub.add_parser("scan", help="scan a manuscript and emit the skeleton registry")
+    scan.add_argument("--manuscript", type=Path, required=True, help="manuscript file (.md/.txt)")
+    scan.add_argument("--out", type=Path, default=None,
+                      help="write the skeleton to this YAML (default: stdout only)")
+
+    check = sub.add_parser("check", help="validate 07_drafting/numerical_provenance.yml")
+    check.add_argument("--root", type=Path, default=None)
+
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+
+    if args.cmd == "scan":
+        if not args.manuscript.is_file():
+            print(f"[FATAL] manuscript not found: {args.manuscript}", file=sys.stderr)
+            return 2
+        text = args.manuscript.read_text(encoding="utf-8")
+        skeleton = build_skeleton(scan_text(text), args.manuscript.name)
+        payload = yaml.safe_dump(skeleton, allow_unicode=True, sort_keys=False)
+        if args.out:
+            args.out.parent.mkdir(parents=True, exist_ok=True)
+            args.out.write_text(payload, encoding="utf-8")
+            print(f"[WRITE] {args.out} ({len(skeleton['entries'])} statements) — fill sources, then run provenance check")
+        else:
+            print(payload)
+            print(f"# {len(skeleton['entries'])} numerical statements; "
+                  f"pass --out 07_drafting/numerical_provenance.yml to persist the skeleton")
+        return 0
+
+    root = (args.root or workspace_or_exit()).resolve()
+    registry = load_registry(root)
+    if registry is None:
+        print(f"no registry at {REGISTRY_REL.as_posix()} — run `provenance scan` first (provenance is opt-in)")
+        return 0
+    problems = check_registry(root, registry)
+    print(render_report(registry, problems))
+    if problems:
+        print(f"\n{len(problems)} problem(s) — fix the registry, not the rule")
+        return 1
+    print("\n✅ every numerical statement traces to a declared source")
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
