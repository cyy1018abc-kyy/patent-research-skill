+# ── Harvesting full abstracts ─────────────────────────────────────────
+
+
+def harvest_abstracts(root: Path) -> dict[str, str]:
+    """Collect the **full abstracts** from the raw/ artifacts, keyed by publication number.
+
+    The candidate's own `summary_zh` is a 190-character truncated version, insufficient for judging relevance.
+    raw has the original text (284 characters on average for CNIPA); use that as the source of truth.
+    """
+    out: dict[str, str] = {}
+    raw_dir = root / "02_search_logs" / "raw"
+    if not raw_dir.is_dir():
+        return out
+
+    for p in sorted(raw_dir.glob("*.json")):
+        data, err = read_json(p)
+        if err is not None or not isinstance(data, dict):
+            continue
+        hits = data.get("hits")
+        if not isinstance(hits, list):
+            continue
+        for h in hits:
+            if not isinstance(h, dict):
+                continue
+            doc = str(h.get("pub_number") or "").strip()
+            abstract = str(h.get("abstract") or "").strip()
+            if doc and abstract and len(abstract) > len(out.get(doc, "")):
+                out[doc] = abstract
+    return out
+
+
+def abstract_for(cand: Candidate, harvested: dict[str, str]) -> str:
+    """Pick an abstract. Priority: raw original > backfilled abstract_raw > the candidate's own summary_zh.
+
+    - **raw** (captured from CNIPA) is the most trustworthy, is in Chinese, and is complete in length (284 characters on average).
+    - **abstract_raw** was later backfilled from Google Patents and may be in a foreign language.
+    - **summary_zh** is the summary from ingest, truncated to 190 characters; used only as a fallback.
+    """
+    key = cand.doc_number.replace(" ", "").upper()
+    if key in harvested:
+        return harvested[key]
+    fetched = (cand.data.get("abstract_raw") or "").strip()
+    if fetched:
+        return fetched
+    return cand.data.get("summary_zh") or ""
+
+
+def is_reviewed(cand: Candidate) -> bool:
+    """Whether this entry has been **manually judged**.
+
+    ⚠️ `relevance != 3` cannot be used to decide — 3 is both ingest's default value
+    and a possible genuine human score of 3. Only `reviewed_at` can distinguish them.
+    For historical data without a backfilled reviewed_at, fall back to the old criterion, so that
+    everything does not suddenly become "unjudged".
+    """
+    return not assessment.assessment_errors(cand, cand.path.parent.parent)
+
+
+# ── export ────────────────────────────────────────────────────────────
+
+
+def select_candidates(
+    root: Path,
+    term: Terminology,
+    *,
+    target: str = "",
+    axis: str = "",
+    with_abstract: bool = False,
+    unreviewed_only: bool = False,
+    min_relevance: int = 0,
+    role: str = "",
+    limit: int = 0,
+    harvested: dict[str, str] | None = None,
+) -> list[Candidate]:
+    target = target or term.active_target
+    harvested = harvested if harvested is not None else harvest_abstracts(root)
+
+    want_axis = axis
+    if want_axis and "@" not in want_axis:
+        want_axis = f"{want_axis}@{target}"
+
+    out: list[Candidate] = []
+    for c in load_candidates(root):
+        if target and c.target != target:
+            continue
+        if want_axis and want_axis not in c.tags:
+            continue
+        if role and (c.data.get("role") or "") != role:
+            continue
+        if with_abstract and not abstract_for(c, harvested):
+            continue
+        if min_relevance and c.relevance < min_relevance:
+            continue
+        if unreviewed_only and not is_reviewed(c):
+            pass  # keep only entries that really were not judged (entries scored 3 are already marked judged by reviewed_at)
+        elif unreviewed_only:
+            continue
+        out.append(c)
+
+    # Ordering: when min_relevance is given (for picking near prior art), sort by "axis → relevance descending → ID"
+    # so that the most relevant entries in each axis come first; otherwise keep the stable "axis → ID" order.
+    if min_relevance:
+        out.sort(
+            key=lambda c: (
+                c.tags[0] if c.tags else "",
+                -c.relevance,
+                c.id,
+            )
+        )
+    else:
+        out.sort(key=lambda c: (c.tags[0] if c.tags else "", c.id))
+    return out[:limit] if limit else out
+
+
+def write_worksheet(
+    cands: list[Candidate],
+    harvested: dict[str, str],
+    path: Path,
+    *,
+    target: str = "",
+    with_topics: bool = False,
+) -> None:
+    """Write the CSV worksheet.
+
+    With `with_topics=True`, two columns `hit_group_count` / `topic_hits` are inserted after `abstract_full`
+    — navigation aid for humans picking near prior art (**not a determination**, see the discipline notes in `topics.py`).
+    """
+    topic_cols = ["hit_group_count", "topic_hits"] if with_topics else []
+    fieldnames = READ_COLUMNS[:7] + topic_cols + READ_COLUMNS[7:] + JUDGE_COLUMNS
+
+    buf = io.StringIO()
+    w = csv.DictWriter(buf, fieldnames=fieldnames, lineterminator="\n")
+    w.writeheader()
+    for c in cands:
+        short = split_axis_id(c.tags[0])[0] if c.tags else ""
+        abstract = abstract_for(c, harvested)
+        row: dict[str, Any] = {
+            "axis": short,
+            "candidate_id": c.id,
+            "publication_number": c.doc_number,
+            "year": c.data.get("year", ""),
+            "applicant": " / ".join(c.data.get("authors_or_applicants") or []),
+            "title": c.title,
+            "abstract_full": abstract,
+            "current_relevance": c.relevance,
+            "current_role": c.data.get("role", ""),
+            "current_novelty_check": c.data.get("novelty_check", ""),
+            "expected_fingerprint": assessment.fingerprint(c, c.path.parent.parent),
+            # Determination columns are left blank for humans to fill in
+            **{k: "" for k in JUDGE_COLUMNS},
+        }
+        if with_topics:
