+"""0.3.0 交付安全回归：数值溯源 fail-closed、结论引用必须命中账本、附图标记仅告警、
+期限缺基础信息拒绝计算、导出数字与工作区一致。自包含，不依赖 tests/conftest。"""
+
+from __future__ import annotations
+
+from datetime import date
+from pathlib import Path
+
+import pytest
+import yaml
+
+from patentkit import deadlines, figures, provenance, validate
+from patentkit.init import init_workspace
+
+
+@pytest.fixture
+def ws(tmp_path):
+    root = tmp_path / "workspace"
+    init_workspace(root, "TGT-0002", "合成燃料电池测试")
+    return root
+
+
+def test_v031_unsourced_number_fails_closed(ws):
+    (ws / "07_drafting").mkdir(exist_ok=True)
+    registry = {"entries": [{"id": "NUM-001", "statement": "效率 90-95%", "sources": []}]}
+    (ws / provenance.REGISTRY_REL).write_text(yaml.safe_dump(registry, allow_unicode=True), encoding="utf-8")
+
+    findings = validate.validate_all(ws)
+    assert any(f.code == "V031" and f.is_error for f in findings)
+
+    registry["entries"][0]["sources"] = [
+        {"grade": "C", "ref": "embodiment-1", "locator": "para 0040", "note": "实施例示例值，非实测"}]
+    (ws / provenance.REGISTRY_REL).write_text(yaml.safe_dump(registry, allow_unicode=True), encoding="utf-8")
+    assert "V031" not in {f.code for f in validate.validate_all(ws)}
+
+
+def test_v032_grade_b_must_cite_known_candidate(ws):
+    (ws / "07_drafting").mkdir(exist_ok=True)
+    registry = {"entries": [{"id": "NUM-001", "statement": "效率 90%", "claim_ref": "claim 1",
+                             "sources": [{"grade": "B", "ref": "P-777", "locator": "abstract"}]}]}
+    (ws / provenance.REGISTRY_REL).write_text(yaml.safe_dump(registry, allow_unicode=True), encoding="utf-8")
+    assert "V032" in {f.code for f in validate.validate_all(ws)}
+
+
+def test_v034_conclusion_cannot_cite_invented_evidence(ws):
+    concl = ws / "05_novelty_conclusions" / "novelty.md"
+    concl.write_text("P-907 披露全部特征，新颖性不成立。\n", encoding="utf-8")
+    findings = [f for f in validate.validate_all(ws) if f.code == "V034"]
+    assert findings and findings[0].is_error and "P-907" in findings[0].message
+
+
+def test_v033_figure_mark_mismatch_is_warn_never_error(ws):
+    d = ws / "07_drafting" / "figures"
+    d.mkdir(parents=True, exist_ok=True)
+    (d / "FIG-1.figure.yml").write_text(yaml.safe_dump({
+        "figure": "FIG-1", "title": "框图",
+        "parts": [{"id": "10", "name": "电解槽"}, {"id": "77", "name": "未在正文出现"}],
+        "connections": [],
+    }, allow_unicode=True), encoding="utf-8")
+    (ws / "07_drafting").mkdir(exist_ok=True)
+    (ws / "07_drafting" / "spec.md").write_text("电解槽10 连接于管路。\n", encoding="utf-8")
+
+    findings = [f for f in validate.validate_all(ws) if f.code == "V033"]
+    assert findings and all(f.level == "warn" for f in findings)
+
+
+def test_deadlines_refuse_to_compute_without_base_date(ws, capsys):
+    path = ws / deadlines.LEDGER_REL
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(yaml.safe_dump({"entries": [
+        {"id": "DL-001", "target": "TGT-0002", "type": "oa_response", "base_date": "", "done": False}
+    ]}, allow_unicode=True), encoding="utf-8")
