+"""New-in-0.5.0 data-source presets: fetch-bigquery census skeleton + OPS XML ingest.
+
+The presets exist so the day a real search task arrives, the source can be enabled the same
+day under the data-sources contract. These tests pin the offline-safe properties: dry-run
+writes nothing, --run refuses without credentials, --fill only fills empty arrays from the
+archived artifact, and OPS XML (namespace-varying) parses into ingested, verified candidates.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+import yaml
+
+from patentkit import assessment, fetch_bigquery, ingest
+from patentkit.gates import compute_all
+from patentkit.ingest import parse_ops_xml, read_raw
+
+# ── fetch-bigquery：dry-run / 守卫 / 回填 ─────────────────────────────
+
+
+def _near_prior_confirmed(repo, cid="P-002"):
+    """一份已确认的近端对比候选（G-S-04 的普查对象）。用独立文献号避免与夹具 P-001 撞号；
+    conftest 的 write_candidate 落盘为 `<id>.json`（带 bibtex 后缀的命名只出现在 ingest 产物上）。"""
+    from conftest import assessed_candidate
+
+    assessed_candidate(repo, id=cid, role="near_prior_art", url_or_doc_number="US 7777777 B2",
+                       # evidence_ref 相对候选文件解析（model.resolve_ref），quotes 就在同级
+                       evidence_level="verified", evidence_ref="quotes/P-001.md")
+    path = repo.root / "03_candidates" / f"{cid}.json"
+    from patentkit.model import Candidate
+    c = Candidate(json.loads(path.read_text(encoding="utf-8")), path)
+    assessment.confirm_batch(
+        repo.root,
+        [{"candidate_id": cid, "expected_fingerprint": assessment.fingerprint(c, repo.root)}],
+        by="复核人", apply=True)
+    return path
+
+
+def test_fetch_bigquery_dry_run_lists_gaps_and_writes_nothing(repo, capsys):
+    path = _near_prior_confirmed(repo)
+    before = sorted(str(p) for p in repo.root.rglob("*") if p.is_file())
+    rc = fetch_bigquery.main(["--root", str(repo.root)])
+    out = capsys.readouterr().out
+    assert rc == 0
+    assert "dry-run" in out and "US 7777777 B2" in out
+    assert "patents-public-data" in out  # SQL 骨架
+    after = sorted(str(p) for p in repo.root.rglob("*") if p.is_file())
+    assert before == after, "dry-run 不得写任何文件"
+
+
+def test_fetch_bigquery_run_refuses_without_credentials(repo, monkeypatch):
+    monkeypatch.delenv("GOOGLE_APPLICATION_CREDENTIALS", raising=False)
+    assert fetch_bigquery.main(["--run", "--root", str(repo.root)]) == 2
+
+
+def test_fill_backfills_only_empty_arrays_and_gates_see_it(repo, tmp_path):
+    path = _near_prior_confirmed(repo)
+    raw = tmp_path / "bigquery_2026-01-05_GS04_1.jsonl"
+    raw.write_text(
+        json.dumps({
+            "publication_number": "US 7777777 B2",
+            "family_publications": ["EP 2000000 A1", "US 9999999 A"],
+            "cited_by_publications": ["US 8888888 A"],
+        }, sort_keys=True) + "\n", encoding="utf-8")
+
+    assert fetch_bigquery.main(["--fill", str(raw), "--root", str(repo.root)]) == 0  # dry-run
+    before = json.loads(path.read_text(encoding="utf-8"))
+    assert before["family"] == [] and before["cited_by"] == []
+
+    assert fetch_bigquery.main(["--fill", str(raw), "--apply", "--root", str(repo.root)]) == 0
+    after = json.loads(path.read_text(encoding="utf-8"))
+    assert after["family"] == ["EP 2000000 A1", "US 9999999 A"]
+    assert after["cited_by"] == ["US 8888888 A"]
+
+    # 已有值不被普查覆盖（普查只补空缺）
+    assert fetch_bigquery.main(["--fill", str(raw), "--apply", "--root", str(repo.root)]) == 0
+    assert json.loads(path.read_text(encoding="utf-8")) == after
+
+    # 门禁看到的是回填后的世界
+    report = compute_all(repo.root)
+    gs04 = next(g for g in report.results if g.gate_id == "G-S-04")
+    assert gs04.status == "PASS" and gs04.values["verified"].startswith("1/1")
+
+
+def test_fill_rejects_malformed_artifact(repo, tmp_path):
+    raw = tmp_path / "bad.jsonl"
+    raw.write_text('{"publication_number": "US 1234567 B2"}\n', encoding="utf-8")
+    with pytest.raises(ValueError):
+        fetch_bigquery.load_census_raw(raw)
+
+
+# ── OPS XML：解析 + read_raw 分发 + ingest 全链 ───────────────────────
+
+OPS_XML = """\
+<?xml version="1.0" encoding="UTF-8"?>
+<ops:world-patent-data xmlns:ops="http://ops.epo.org/3.2"
+                       xmlns:ex="http://www.epo.org/exchange">
+  <ops:exchange-documents>
+    <ops:exchange-document system="ops.1926.20" country="US" doc-number="10900050" kind="B2">
+      <ex:bibliographic-data>
+        <ex:publication-reference>
+          <ex:document-id document-id-type="docdb">
+            <ex:country>US</ex:country><ex:doc-number>10900050</ex:doc-number>
+            <ex:kind>B2</ex:kind><ex:date>20200501</ex:date>
+          </ex:document-id>
+        </ex:publication-reference>
+        <ex:invention-title lang="en">Fixture capillary device</ex:invention-title>
+        <ex:invention-title lang="zh">毛细排水装置</ex:invention-title>
+        <ex:parties><ex:applicants>
+          <ex:applicant data-format="docdb"><ex:applicant-name><ex:name>样例申请人</ex:name></ex:applicant-name></ex:applicant>
+        </ex:applicants></ex:parties>
+        <ex:abstract lang="en"><p>English abstract text.</p></ex:abstract>
+        <ex:abstract lang="zh"><p>一种利用毛细结构排水的装置。</p></ex:abstract>
+      </ex:bibliographic-data>
+    </ops:exchange-document>
+    <ops:exchange-document system="ops.1926.20" country="CN" doc-number="2050001" kind="U">
+      <ex:bibliographic-data>
+        <ex:publication-reference>
+          <ex:document-id document-id-type="docdb">
+            <ex:country>CN</ex:country><ex:doc-number>2050001</ex:doc-number>
+            <ex:kind>U</ex:kind><ex:date>20210101</ex:date>
+          </ex:document-id>
+        </ex:publication-reference>
+        <ex:invention-title lang="zh">实用新型样例</ex:invention-title>
+      </ex:bibliographic-data>
+    </ops:exchange-document>
+  </ops:exchange-documents>
+</ops:world-patent-data>
+"""
+
+
+def test_ops_xml_parses_with_lang_preference_and_applicants(tmp_path):
+    path = tmp_path / "ops_export.xml"
+    path.write_text(OPS_XML, encoding="utf-8")
+    records = parse_ops_xml(path)
+    assert [r.doc_number for r in records] == ["US 10900050 B2", "CN 2050001 U"]
+    assert records[0].title == "毛细排水装置"          # zh 优先
+    assert "毛细" in records[0].snippet                 # zh 摘要优先
+    assert records[0].applicants == ["样例申请人"]
+    assert records[0].date == "20200501"
+    assert read_raw(path, {}) == records               # read_raw 按 .xml 分发
+
+
+def test_ops_xml_ingests_as_verified_candidates(repo, tmp_path):
+    from conftest import make_log
+    raw = tmp_path / "ops_export.xml"
+    raw.write_text(OPS_XML, encoding="utf-8")
+    records = read_raw(raw, {})
+
+    log_name = "OPS_2026-01-06_N1_2.log.json"
+    log = make_log(db="OPS", target="TGT-0000",
+                   query={"id": "N1", "axis": "N1@TGT-0000"},
+                   result={"hit_count": 2, "raw_export": "raw/ops_export.xml", "complete": True})
+    repo.write_log(log, log_name)
+    (repo.root / "02_search_logs" / "raw" / "ops_export.xml").write_text(OPS_XML, encoding="utf-8")
+
+    # V004：ingest 会给候选配 bibtex 键，夹具 bib 用内核同款函数生成，保证逐键一致
+    from conftest import BASE_BIB
+    from patentkit.ingest import extract_year, make_bibtex_key
+    bib_lines = [
+        f"@patent{{{make_bibtex_key(r)},\n  title = {{{r.title}}},\n  year = {{{extract_year(r.date) or 1900}}}\n}}"
+        for r in records
+    ]
+    repo.write_bib(BASE_BIB + "\n".join(bib_lines) + "\n")
+
+    assert ingest.main([
+        "--log", log_name, "--raw", "02_search_logs/raw/ops_export.xml", "--kind", "patent",
+        "--tag", "N1@TGT-0000", "--now", "2026-01-06T00:00:00+00:00", "--apply",
+        "--root", str(repo.root),
+    ]) == 0
+
+    paths = sorted((repo.root / "03_candidates").glob("P-0*-*.json"))
+    assert len(paths) == 2
+    first = json.loads(paths[0].read_text(encoding="utf-8"))
+    assert first["url_or_doc_number"] == "US 10900050 B2"
+    assert first["evidence_level"] == "verified"      # raw 工件在库 → verified（契约第 1 条）
+    assert first["summary_zh"].startswith("一种利用毛细结构排水")
+    assert repo.validate() == []                       # 全链干净
