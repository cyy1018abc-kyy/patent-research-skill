+"""patentkit programmatic API — the **shared implementation** of the CLI and MCP.
+
+Design conventions
+------------------
+* Every function takes a `workspace` path (`None` = automatic upward discovery) and returns a **JSON-serializable** object.
+* Read-only functions **print nothing**; write operations return the captured output text + exit code.
+* Never calls `sys.exit` and never parses `argv` — presentation is left to the CLI / MCP.
+
+Why this layer exists
+---------------------
+If MCP tools, the CLI, and future adapters each parsed argv themselves, the interfaces would drift.
+Once they are unified in this module, adapters are just **thin mappings**:
+
+    MCP:  patent_validate(workspace)  -> api.validate(workspace)
+    CLI:  patentkit validate --strict -> api.validate(strict=True)
+
+Usage
+-----
+    from patentkit import api
+
+    api.status()
+    api.validate(strict=True)["summary"]
+    api.search_plan("N1")["en"]
+"""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import re
+from pathlib import Path
+from typing import Any, Callable
+
+import yaml
+
+from . import attest as attest_mod
+from . import bibsync as bibsync_mod
+from . import cnipa as cnipa_mod
+from . import gates as gates_mod
+from . import index as index_mod
+from . import ingest as ingest_mod
+from . import report as report_mod
+from . import runs as runs_mod
+from . import validate as validate_mod
+from .model import load_candidates, load_logs
+from . import assessment as assessment_mod
+from .paths import WorkspaceNotFound, find_workspace, is_workspace
+from .registry import TerminologyError, load_registry
+
+#: Readable methodology reference documents (for MCP resources).
+#: The names are routing keys shown to the LLM; keep them short and semantically clear.
+REFERENCES: dict[str, str] = {
+    "Search framework": "00_methodology/search_framework.md",
+    "Evidence level system": "00_methodology/glossary.yml",
+    "Main axis definitions": "01_search_plan/TGT-0001-main_axes.md",
+    "Search execution checklist": "01_search_plan/TGT-0001-search_execution_checklist.md",
+    "Query library": "01_search_plan/query_library.yml",
+    "Three-tier determination": "04_comparative_analysis/three_tier_determination_framework.md",
+    "Comparison matrix template": "04_comparative_analysis/comparison_matrix_template.md",
+    "Acceptance gate criteria": "05_novelty_conclusions/five_acceptance_gates_tracking.md",
+    "Drafting gate tracking": "05_novelty_conclusions/G-D_tracking.md",
+    "Feature atom table": "07_drafting/claims/feature_atom_table.md",
+    "Drafting rules": "07_drafting/README.md",
+    "Polishing checklist": "08_polishing/README.md",
+    "Candidate list documentation": "03_candidates/README.md",
+    "Search log conventions": "02_search_logs/README.md",
+    "Raw artifact conventions": "02_search_logs/raw/README.md",
+    "Upgrade plan": "docs/upgrade_plan.md",
+    "Plugin plan": "docs/plugin_plan.md",
+}
+
+#: Hard constraints — handed to the caller together with the search results (especially pure chat clients).
+#: The purpose is to prevent "self-assertion masquerading as evidence", the biggest disease this repo had.
+HARD_CONSTRAINTS: list[str] = [
+    "evidence_level describes source provenance only; AI scoring never downgrades a verified source.",
+    "G-S-02 allows supported AI assessments; G-S-03 additionally requires a current explicit human confirmation.",
+    "AI proposals cannot overwrite an existing human judgment, including an exclusion.",
+    "Without a raw/ artifact, verified may not be claimed — V009/V013 will stop it.",
+    "A gate PASS only trusts the verified column; asserted is historical record, not a basis for PASS.",
+    "When tools cannot be run (pure chat clients), the conclusion must be marked \"⚠️ Unverified by tool checks\".",
+    "Hit count (hit_count) != number of core documents; never conflate the two.",
+    "A query may use at most 3 AND sub-expressions; IPC is a post-filter and is not written into the main query.",
+]
+
+
+class WorkspaceError(RuntimeError):
+    """The workspace cannot be located or its structure is invalid."""
+
+
+#: Axis IDs of the form N1 / C2 / S1 / N1@TGT-0001. Used to detect the common misuse of "passing an axis ID as a path".
+_AXIS_LIKE_RE = re.compile(r"^[NCS]\d(@TGT-\d{4})?$")
+
+
+# ── Location ──────────────────────────────────────────────────────────
+
+
+def workspace(ws: str | Path | None = None) -> Path:
+    """Resolve the input into a workspace root. None means automatic upward discovery."""
+    if ws is not None:
+        root = Path(ws).resolve()
+        if not is_workspace(root):
+            hint = ""
+            if _AXIS_LIKE_RE.match(Path(ws).name):
+                hint = (
+                    f"\n  Hint: '{Path(ws).name}' looks like an **axis ID**, not a directory. "
+                    f"The workspace parameter expects a workspace path; pass axis IDs as axis=."
+                )
+            raise WorkspaceError(
+                f"{root} is not a patentkit workspace"
+                f" (missing workspace.yml and 00_methodology/glossary.yml){hint}"
+            )
+        return root
+
+    try:
+        return find_workspace()
+    except WorkspaceNotFound as exc:
+        # Unify into WorkspaceError; the message already carries actionable fixes (see paths.WorkspaceNotFound)
+        raise WorkspaceError(str(exc)) from None
+
+
+def targets(ws: str | Path | None = None) -> dict[str, Any]:
+    """List all targets registered in the workspace, together with the currently active target."""
+    root = workspace(ws)
+    term = load_registry(root)
+    cands = load_candidates(root)
+    logs = load_logs(root)
+
+    items = []
+    for tid, tinfo in term.targets.items():
+        items.append(
+            {
+                "id": tid,
+                "title": tinfo.title,
+                "status": tinfo.status,
+                "note": tinfo.note,
+                "draft_paths": list(tinfo.draft_paths),
+                "axes": sorted(term.axes_for(tid)),
+                "candidates": sum(1 for c in cands if c.target == tid),
+                "logs": sum(1 for log in logs if log.target == tid),
+            }
+        )
+    return {
+        "workspace": str(root),
+        "active_target": term.active_target,
+        "targets": items,
+    }
+
+
+# ── Validation and gates ──────────────────────────────────────────────
+
+
+def validate(ws: str | Path | None = None, strict: bool = False) -> dict[str, Any]:
+    """Run the V001–V028 consistency validation.
+
+    With strict=True, warnings also count as failure (the CI criterion).
+    """
+    root = workspace(ws)
+    term = load_registry(root)
+    findings = validate_mod.validate_all(root, term)
+    summary = validate_mod.summarize(findings)
+
+    ok = summary["errors"] == 0
+    if strict:
+        ok = ok and summary["warnings"] == 0
+
+    return {
+        "workspace": str(root),
+        "ok": ok,
+        "strict": strict,
+        "summary": summary,
+        "findings": [f.to_dict(root) for f in findings],
+    }
+
+
+def gates(ws: str | Path | None = None, target: str | None = None) -> dict[str, Any]:
+    """Compute the G-S-01..05 three-column acceptance gates."""
+    root = workspace(ws)
+    term = load_registry(root)
+    report = gates_mod.compute_all(root, term, target)
+    data = report.to_dict()
+    data["workspace"] = str(root)
+    data["all_pass"] = all(r.status == "PASS" for r in report.results)
+    return data
+
+
+def status(ws: str | Path | None = None) -> dict[str, Any]:
+    """Everything at a glance: targets, gates, validation, candidate distribution, and **what to do next**.
+
+    This is the most-used tool in MCP — it lets the caller get the whole picture at once instead of making five calls.
+    """
+    root = workspace(ws)
+    term = load_registry(root)
+    target = term.active_target
+
+    findings = validate_mod.validate_all(root, term)
+    vsum = validate_mod.summarize(findings)
+
+    cands = load_candidates(root)
+    logs = load_logs(root)
+    tgt_cands = [c for c in cands if c.target == target]
+    tgt_logs = [log for log in logs if log.target == target]
+
+    by_level: dict[str, int] = {}
+    by_role: dict[str, int] = {}
+    by_relevance: dict[int, int] = {}
+    for c in tgt_cands:
+        lvl = c.effective_level(root).value
+        by_level[lvl] = by_level.get(lvl, 0) + 1
+        role = str(c.data.get("role") or "?")
+        by_role[role] = by_role.get(role, 0) + 1
+        rel = c.data.get("relevance")
+        if isinstance(rel, int):
+            by_relevance[rel] = by_relevance.get(rel, 0) + 1
+
+    live_logs = [lg for lg in tgt_logs if lg.capture_mode.value == "live"]
+
+    return {
+        "workspace": str(root),
+        "active_target": target,
+        "target_title": term.targets[target].title if target in term.targets else "",
+        "candidates": {
+            "total": len(tgt_cands),
+            "by_evidence_level": dict(sorted(by_level.items())),
+            "by_role": dict(sorted(by_role.items())),
+            "by_relevance": dict(sorted(by_relevance.items())),
+            "with_relevance_ge4": sum(any(assessment_mod.eligible_axis(c, root, axis) for axis in c.tags) for c in tgt_cands),
+            "by_assessment_state": {state: sum(assessment_mod.state(c, root) == state for c in tgt_cands)
+                                    for state in ("unknown", "needs_review", "ai_assessed", "human_assessed", "human_confirmed")},
+        },
+        "logs": {
+            "total": len(tgt_logs),
+            "live": len(live_logs),
+            "retrospective": len(tgt_logs) - len(live_logs),
+        },
+        "validation": vsum,
+        "gates": gates_mod.compute_all(root, term, target).to_dict(),
+        "hints": _hints(root, term, target, tgt_cands, tgt_logs, vsum),
+        "hard_constraints": HARD_CONSTRAINTS,
+    }
+
+
+def _hints(
+    root: Path,
+    term: Any,
+    target: str,
+    cands: list[Any],
+    logs: list[Any],
+    vsum: dict[str, Any],
+) -> list[str]:
+    """Derive "what to do next" from the current data. Action guidance for the caller, not hard conclusions."""
+    hints: list[str] = []
+
+    if vsum["errors"]:
+        hints.append(
+            f"Fix the {vsum['errors']} errors first ({', '.join(sorted(vsum['by_code']))}) —"
+            f" gate numbers are not trustworthy while the data is inconsistent"
+        )
+
+    rel_ok = sum(1 for c in cands if (c.data.get("relevance") or 0) >= 4)
+    if cands and rel_ok == 0:
+        hints.append(
+            f"The relevance of all {len(cands)} candidates is the default value — G-S-02 counts only relevance≥4, "
+            f"so this axis currently counts 0. Add supported AI or human assessments with per-axis problem/means citations"
+        )
+
+    report = gates_mod.compute_all(root, term, target)
+    for r in report.results:
+        if r.status == "FAIL":
+            hints.append(f"{r.gate_id} has not passed ({r.threshold}): {r.note or 'see the values column'}")
+    gs02 = next((r for r in report.results if r.gate_id == "G-S-02"), None)
+    if gs02 is not None and gs02.status != "PASS":
+        hints.append(
+            "Run `python -m patentkit queryplan` — per-axis registered vs executed sub-queries, "
+            "G-S-02 buffer, and deterministic supplementary-query suggestions"
+        )
+
+    if not logs:
+        hints.append("No search logs yet — G-S-05 requires live logs + raw artifacts; run a search and archive it first")
+
+    return hints
+
+
+# ── Queries ───────────────────────────────────────────────────────────
+
+
+def _query_library(root: Path) -> dict[str, Any]:
+    path = root / "01_search_plan" / "query_library.yml"
+    if not path.is_file():
+        return {}
+    data = yaml.safe_load(path.read_text(encoding="utf-8"))
+    return data if isinstance(data, dict) else {}
+
+
+def search_plan(
+    ws: str | Path | None = None,
+    axis: str | None = None,
+    db: str | None = None,
+) -> dict[str, Any]:
+    """Fetch queries. axis may be `N1` or `N1@TGT-0001`; when omitted, all are returned.
+
+    With `db="espacenet"`, the **original text actually executed** is returned first (when archived),
+    otherwise the generic form is returned.
+    """
+    root = workspace(ws)
+    term = load_registry(root)
+    lib = _query_library(root)
+    queries = lib.get("queries") or {}
+
+    if not queries:
+        return {
+            "ok": False,
+            "error": "the workspace has no 01_search_plan/query_library.yml, or it has no queries",
+        }
+
+    if axis:
+        key = axis if "@" in axis else f"{axis}@{term.active_target}"
+        q = queries.get(key)
+        if q is None:
+            return {
+                "ok": False,
+                "error": f"query '{key}' not found",
+                "available": sorted(queries),
+            }
+        return {"ok": True, **_one_query(term, key, q, db)}
+
+    return {
+        "ok": True,
+        "workspace": str(root),
+        "defaults": lib.get("defaults") or {},
+        "queries": {k: _one_query(term, k, v, db) for k, v in sorted(queries.items())},
+    }
+
+
+def _one_query(term: Any, key: str, q: dict[str, Any], db: str | None) -> dict[str, Any]:
+    short, _, target = key.partition("@")
+    registered = key in term.axes
+    out: dict[str, Any] = {
+        "id": key,
+        "axis_short": short,
+        "target": target,
+        "registered_axis": registered,
+        "title_zh": q.get("title_zh", ""),
+        "title_en": q.get("title_en", ""),
+        "kind": q.get("kind", "primary"),
+        "claims": q.get("claims", []),
+        "ipc": q.get("ipc", []),
+        "cn": (q.get("cn") or "").strip(),
+        "en": (q.get("en") or "").strip(),
+        "status": q.get("status", "not_started"),
+        # An axis may have multiple logs (e.g. N1 has both Espacenet and CNIPA)
+        "logs": q.get("logs") or ([q["log"]] if q.get("log") else []),
+        "cnipa_query": q.get("cnipa_executed"),
+        "note": q.get("note", ""),
+    }
+
+    if q.get("composed_of"):
+        # Cross axis: do not give a single tag; give the component axes to use at ingest time
+        out["composed_of"] = q["composed_of"]
+        out["ingest_tags"] = [f"{a}@{target}" for a in q["composed_of"]]
+    elif registered:
+        out["ingest_tags"] = [key]
+    else:
+        out["ingest_tags"] = []
+
+    db_l = (db or "").lower()
+    if db_l == "cnipa":
+        ce = q.get("cnipa_executed")
+        if ce:
+            # The CNIPA publication site is **field-by-field form filling**, not a free Boolean expression —
+            # restore the fields into a fillable form
+            parts = [f"{k}={v}" for k, v in ce.items() if k != "note" and v]
+            out["query_for_db"] = " AND ".join(parts)
+            out["query_for_db_note"] = "CNIPA publication site \"advanced search\" is filled field by field; this form was actually executed"
+            if ce.get("note"):
+                out["execution_note"] = str(ce["note"]).strip()
+        else:
+            out["query_for_db"] = out["cn"]
+            out["query_for_db_note"] = "generic Chinese form; the publication site is filled field by field, so split it into the corresponding fields"
+    elif db_l in {"espacenet", "googlepatents"} and q.get("espacenet_executed"):
+        out["query_for_db"] = q["espacenet_executed"].strip()
+        out["query_for_db_note"] = "original text actually executed on that database (reproducible verbatim)"
+    else:
+        out["query_for_db"] = out["en"] or out["cn"]
+        out["query_for_db_note"] = "generic form; each database's syntax must be adapted using the §5 templates"
+
+    return out
+
+
+# ── Reference documents ───────────────────────────────────────────────
