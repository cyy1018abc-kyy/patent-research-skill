+"""Shared fixtures for the kernel test suite (reconstructed).
+
+The sdist ships the private repository's ``tests/`` but not its ``conftest.py``; this file
+reconstructs that fixture layer so the suite runs from the distributed tree. The public API
+was recovered from the usages across ``tests/*.py``:
+
+* constants: ``LOG_NAME`` / ``RAW_NAME`` / ``SCHEMA`` / ``BASE_BIB``
+* factories: ``make_candidate(**overrides)`` / ``make_log(**overrides)`` (deep-copied bases)
+* helpers: ``write_json(path, data)`` / ``assessed_candidate(repo, **overrides)``
+* fixture: ``repo`` — a clean two-target workspace:
+
+  - one pre-written candidate ``P-001`` (asserted / pool / default relevance 3, no assessment
+    yet — exactly the state right after ingest);
+  - one live Espacenet log whose CSV raw artifact carries 5 parseable records (G-S-05
+    replayable, V026 clean);
+  - ``citations.bib`` with the default bibliography key plus ``citation-template.bib`` with
+    placeholder keys (exempt from V004/V005 by file name).
+
+A clean repository must validate to zero findings and pass G-S-05 only (see ``test_baseline.py``).
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+
+import pytest
+
+from patentkit import assessment
+from patentkit import gates as gates_mod
+from patentkit import runs as runs_mod
+from patentkit import validate as validate_mod
+from patentkit.model import Candidate
+
+#: Default search log (Espacenet, 5 hits, N1 axis of TGT-0000)
+LOG_NAME = "espacenet_2026-01-01_N1_5.log.json"
+
+#: Default raw artifact referenced by that log (one Espacenet CSV page with 5 records)
+RAW_NAME = "espacenet_2026-01-01_N1_5_page-1.csv"
+
+#: Default bibliography key of ``make_candidate`` (must exist in ``BASE_BIB``)
+BIB_KEY = "us12345672020"
+
+#: Quotes file backing the default assessment citations (see ``assessed_candidate``)
+QUOTES_REF = "03_candidates/quotes/P-001.md"
+
+#: The parsed candidates schema, shipped with the package templates
+SCHEMA = json.loads(
+    (Path(__file__).resolve().parents[1] / "patentkit" / "templates" / "workspace"
+     / "03_candidates" / "candidates_schema.json").read_text(encoding="utf-8")
+)
+
+#: Bibliography of the fixture workspace — exactly one entry matching ``BIB_KEY``
+BASE_BIB = (
+    "@patent{us12345672020,\n"
+    "  title = {Localized capillary water removal},\n"
+    "  number = {US 1234567 B2},\n"
+    "  year = {2020}\n"
+    "}\n"
+)
+
+#: Template bibliography: recognized by file name, so its placeholder keys never satisfy V004
+TEMPLATE_BIB = (
+    "@patent{YYYY-AUTHORS-KEYWORDS,\n"
+    "  title = {TEMPLATE PLACEHOLDER},\n"
+    "}\n"
+)
+
+GLOSSARY = """\
+version: 2
+updated: '2026-01-01'
+active_target: TGT-0000
+
+targets:
+  TGT-0000:
+    title: 'Fixture target A'
+    status: active
+    note: 'conftest fixture'
+  TGT-0001:
+    title: 'Fixture target B'
+    status: active
+    note: 'conftest fixture'
+
+axes:
+  N1@TGT-0000: {name_zh: 'Local Capability Interface', name_en: 'local capability interface', definition: 'fixture axis'}
+  N2@TGT-0000: {name_zh: 'Second Fixture Axis', name_en: 'second fixture axis', definition: 'fixture axis'}
+  N1@TGT-0001: {name_zh: 'Microgravity Gas-Liquid Separation', name_en: 'microgravity gas-liquid separation', definition: 'fixture axis'}
+  N2@TGT-0001: {name_zh: 'Second B Axis', name_en: 'second b axis', definition: 'fixture axis'}
+
+novelty_states:
+  untouched: {definition: 'not reviewed, or reviewed and unrelated'}
+  partial: {definition: 'discloses only some features'}
+  covered: {definition: 'covers a single claim but not the overall solution'}
+  blocking: {definition: 'a single document blocks novelty'}
+
+roles:
+  near_prior_art: {definition: 'enters column D; counts toward G-S-03/G-S-04'}
+  pool: {definition: 'counts toward G-S-02 only'}
+  excluded: {definition: 'counts toward no gate'}
+  family: {definition: 'counts toward G-S-04'}
+
+evidence_levels:
+  verified: {definition: 'raw artifact archived inside the repo'}
+  attested: {definition: 'hash-bound external material'}
+  asserted: {definition: 'self-reported, no artifact'}
+
+db_aliases:
+  CNIPA: ['cnipa']
+"""
+
+#: Pre-written run: mentions P-001's publication number so runs/V018/inference have data
+RUN_NOTE = "comparison of the content of US 1234567 B2\n"
+
+QUOTES = (
+    "The interface continuously reports local capability states to the controller.\n"
+    "The controller routes water through a capillary matrix for removal.\n"
+)
+
+
+def make_candidate(**overrides):
+    """A schema-valid, zero-finding candidate (asserted / pool / TGT-0000, relevance 3).
+
+    This is the post-ingest state: no assessment yet. Use ``assessed_candidate`` (or the
+    kernel's ``assess_batch``) when a test needs an entry eligible for G-S-02.
+    """
+    data = {
+        "id": "P-001",
+        "kind": "patent",
+        "title": "Localized capillary water removal device",
+        "authors_or_applicants": ["Fixture Applicant"],
+        "year": 2020,
+        "source_db": "CNIPA",
+        "url_or_doc_number": "US 1234567 B2",
+        "relevance": 3,
+        "novelty_check": "untouched",
+        "tags": ["N1@TGT-0000"],
+        "logged_at": "2026-01-01T00:00:00+00:00",
+        "source_log": f"../02_search_logs/{LOG_NAME}",
+        "family": [],
+        "cited_by": [],
+        "pdf_path": None,
+        "bibtex_key": BIB_KEY,
+        "evidence_level": "asserted",
+        "evidence_ref": None,
+        "evidence_sha256": None,
+        "role": "pool",
+        "target": "TGT-0000",
+    }
+    data.update(copy.deepcopy(overrides))
+    return data
+
+
+def make_log(**overrides):
+    """A live Espacenet log for N1@TGT-0000 whose CSV raw artifact exists (G-S-05 replayable)."""
+    data = {
+        "db": "Espacenet",
+        "target": "TGT-0000",
+        "actor": "conftest",
+        "capture_mode": "live",
+        "timestamp": "2026-01-01T00:00:00+00:00",
+        "query": {"id": "N1", "axis": "N1@TGT-0000"},
+        "result": {"hit_count": 5, "raw_export": f"raw/{RAW_NAME}", "complete": True},
+    }
+    data.update(copy.deepcopy(overrides))
+    return data
+
+
+def assessed_candidate(repo, **overrides):
+    """A candidate with a valid AI assessment on N1 (problem+means citations → eligible).
+
+    Uses the kernel's own fingerprint logic so the record stays valid under the current
+    assessment protocol. Returns the written data dict.
+    """
+    data = make_candidate()
+    data.update(copy.deepcopy(overrides))
+    data.update({
+        "review_note": data.get("review_note") or "discloses the local capability interface feeding loop",
+        "reviewed_at": data.get("reviewed_at") or "2026-01-02T00:00:00+00:00",
+        "assessment": {
+            "actor": "ai",
+            "by": "conftest",
+            "at": "2026-01-02T00:00:00+00:00",
+            "basis": {
+                "N1@TGT-0000": {
+                    "problem": {
+                        "ref": QUOTES_REF,
+                        "locator": "L1",
+                        "quote": "The interface continuously reports local capability states to the controller.",
+                        "rationale": "same reporting problem",
+                    },
+                    "means": {
+                        "ref": QUOTES_REF,
+                        "locator": "L2",
+                        "quote": "The controller routes water through a capillary matrix for removal.",
+                        "rationale": "same routing means",
+                    },
+                }
+            },
+        },
+    })
+    if data.get("relevance") is None or "relevance_problem" not in overrides:
+        data.setdefault("relevance_problem", 4)
+    if "relevance_means" not in overrides:
+        data.setdefault("relevance_means", 4)
+    data["relevance"] = min(data["relevance_problem"], data["relevance_means"])
+    cand = Candidate(data, repo.candidate_path(data["id"]))
+    materials = {"N1@TGT-0000": {k: data["assessment"]["basis"]["N1@TGT-0000"][k] for k in ("problem", "means")}}
+    data["assessment"]["materials"] = materials
+    data["assessment"]["fingerprint"] = assessment.fingerprint(cand, repo.root)
+    repo.write_candidate(data)
+    return data
+
+
+def write_json(path: Path, data) -> None:
+    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
+
+
+def _raw_csv() -> str:
+    lines = ["Publication number,Title,Applicant,Publication date"]
+    lines += [f"US10900000{i}A,fixture publication {i},Fixture Applicant {i},2020-05-01" for i in range(1, 6)]
+    return "\n".join(lines) + "\n"
+
+
+class Repo:
+    """A clean fixture workspace plus the write/read helpers used by the tests."""
+
+    def __init__(self, root: Path):
+        self.root = root
+        self.candidates_dir = root / "03_candidates"
+        self.runs_dir = root / "04_comparative_analysis" / "runs"
+        self.bib = root / "06_citation_management" / "citations.bib"
+        for d in (
+            "00_methodology",
+            "01_search_plan",
+            "02_search_logs",
+            "02_search_logs/raw",
+            "03_candidates",
+            "03_candidates/quotes",
+            "04_comparative_analysis",
+            "04_comparative_analysis/runs",
+            "05_novelty_conclusions",
+            "06_citation_management",
+            "07_drafting",
+            "08_polishing",
+        ):
+            (root / d).mkdir(parents=True, exist_ok=True)
+        (root / "00_methodology" / "glossary.yml").write_text(GLOSSARY, encoding="utf-8")
+        write_json(self.candidates_dir / "candidates_schema.json", SCHEMA)
+        (root / QUOTES_REF).write_text(QUOTES, encoding="utf-8")
+        self.write_bib(BASE_BIB)
+        (self.bib.parent / "citation-template.bib").write_text(TEMPLATE_BIB, encoding="utf-8")
+        self.raw_path().write_text(_raw_csv(), encoding="utf-8")
+        self.write_log(make_log())
+        (root / "05_novelty_conclusions" / "five_acceptance_gates_tracking.md").write_text(
+            "# Five acceptance gates tracking\n\nGenerated per target by `patentkit gates`.\n",
+            encoding="utf-8",
+        )
+        self.write_run("2026-01-01_tgt-test.md", RUN_NOTE)
+        assessed_candidate(self, relevance_problem=5, relevance_means=5, relevance=5,
+                          review_note="discloses the local capability interface feeding loop")
+
+    # ── paths ──────────────────────────────────────────────────────
+    def candidate_path(self, cid: str) -> Path:
+        return self.candidates_dir / f"{cid}.json"
+
+    def log_path(self, name: str = LOG_NAME) -> Path:
+        return self.root / "02_search_logs" / name
+
+    def raw_path(self, name: str = RAW_NAME) -> Path:
+        return self.root / "02_search_logs" / "raw" / name
+
+    # ── writers ────────────────────────────────────────────────────
+    def write_candidate(self, data, name: str | None = None) -> Path:
+        return self.write_candidate_raw(name or data["id"], data)
+
+    def write_candidate_raw(self, name: str, data) -> Path:
+        path = self.candidates_dir / f"{name}.json"
+        write_json(path, data)
+        return path
+
+    def write_log(self, data, name: str = LOG_NAME) -> Path:
+        path = self.log_path(name)
+        write_json(path, data)
+        return path
+
+    def write_run(self, name: str, content: str) -> Path:
+        path = self.runs_dir / name
+        path.write_text(content, encoding="utf-8")
+        return path
+
+    def write_bib(self, content: str) -> Path:
+        self.bib.write_text(content, encoding="utf-8")
+        return self.bib
+
+    # ── kernel entry points ────────────────────────────────────────
+    def validate(self):
+        return validate_mod.validate_all(self.root)
+
+    def gates(self):
+        return gates_mod.compute_all(self.root)
+
+    def runs(self):
+        return runs_mod.load_runs(self.root)
+
+
+@pytest.fixture
+def repo(tmp_path: Path) -> Repo:
+    return Repo(tmp_path)
diff --git a/b/tests/test_04_release_features.py b/tests/test_04_release_features.py
