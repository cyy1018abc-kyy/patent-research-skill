+def check_logs(root: Path, term: Terminology, logs: list[SearchLog]) -> list[Finding]:
+    """V006-V010 / V016 / V020."""
+    out: list[Finding] = []
+
+    for log in logs:
+        m = LOG_NAME_RE.match(log.path.name)
+        if not m:
+            out.append(
+                Finding(
+                    "error",
+                    "V006",
+                    log.path,
+                    "file name does not match <DB>_<YYYY-MM-DD>_<queryID>_<hits>.log.json",
+                )
+            )
+        else:
+            qid = m.group("qid")
+            # query.id uses the **qualified** ID (N1@TGT-0000); the file name uses only the short axis
+            # name (N1) for readability, while the authoritative target lives in the log's target
+            # field. That is why we compare the short form here.
+            #
+            # The queryID in the file name may be `<axis>-<sequence>`: the CNIPA publication site
+            # returns only 3 records per query, so one axis accumulates several sub-queries and the
+            # sequence keeps their logs from colliding in name.
+            base_qid, _, seq = qid.partition("-")
+            raw_qid = log.query_id
+            parts = split_axis_id(raw_qid) if raw_qid else None
+            cmp_qid = parts[0] if parts else raw_qid
+            if raw_qid and base_qid != cmp_qid:
+                out.append(
+                    Finding(
+                        "error",
+                        "V007",
+                        log.path,
+                        f"axis-name part '{base_qid}' of file-name queryID='{qid}'"
+                        f" disagrees with axis name '{cmp_qid}' of query.id='{raw_qid}'",
+                    )
+                )
+            if seq and not seq.isdigit():
+                out.append(
+                    Finding(
+                        "error",
+                        "V007",
+                        log.path,
+                        f"sequence part of file-name queryID='{qid}' must be numeric, got '{seq}'",
+                    )
+                )
+            hits = int(m.group("hits"))
+            if log.hit_count is not None and hits != log.hit_count:
+                out.append(
+                    Finding(
+                        "error",
+                        "V008",
+                        log.path,
+                        f"file-name hits={hits} disagrees with result.hit_count={log.hit_count}",
+                    )
+                )
+
+            file_db = term.normalize_db(m.group("db"))
+            field_db = term.normalize_db(log.db)
+            if file_db != field_db:
+                out.append(
+                    Finding(
+                        "warn",
+                        "V010",
+                        log.path,
+                        f"file-name DB='{m.group('db')}' disagrees with db field='{log.db}' after normalization",
+                    )
+                )
+
+        if not log.has_capture_mode:
+            out.append(
+                Finding(
+                    "warn",
+                    "V020",
+                    log.path,
+                    "pending migration: missing capture_mode (tool treats it as retrospective; run "
+                    "python -m patentkit.migrate to backfill)",
+                )
+            )
+
+        # V009: declared live but no usable raw artifact
+        if log.capture_mode.value == "live":
+            p = log.raw_export_path()
+            if not log.raw_export:
+                out.append(
+                    Finding("error", "V009", log.path, "capture_mode=live but raw_export is empty")
+                )
+            elif p is None or not p.is_file():
+                out.append(
+                    Finding(
+                        "error",
+                        "V009",
+                        log.path,
+                        f"capture_mode=live but raw artifact does not exist: {log.raw_export}",
+                    )
+                )
+            elif p.stat().st_size == 0:
+                out.append(
+                    Finding("error", "V009", log.path, f"raw artifact is empty: {log.raw_export}")
+                )
+
+        # V015: ISO8601 with a timezone
+        ts = log.data.get("timestamp")
+        if not isinstance(ts, str) or not ts:
+            out.append(Finding("error", "V015", log.path, "missing timestamp"))
+        else:
+            try:
+                parsed = datetime.fromisoformat(ts.replace("Z", "+00:00"))
+                if parsed.tzinfo is None:
+                    out.append(
+                        Finding("error", "V015", log.path, f"timestamp has no timezone: {ts}")
+                    )
+            except ValueError:
+                out.append(
+                    Finding("error", "V015", log.path, f"timestamp is not ISO8601: {ts}")
+                )
+
+        # V016: time-window endpoints must not be in the future
+        window = log.query.get("time_window")
+        if isinstance(window, list) and len(window) == 2:
+            try:
+                end = datetime.fromisoformat(str(window[1])).date()
+                if end > datetime.now().astimezone().date():
+                    out.append(
+                        Finding(
+                            "warn",
+                            "V016",
+                            log.path,
+                            f"time-window end {window[1]} is later than today",
+                        )
+                    )
+            except ValueError:
+                pass
+
+    return out
+
+
+def check_dates(candidates: list[Candidate]) -> list[Finding]:
+    """V015 (candidate logged_at)."""
+    out: list[Finding] = []
+    for c in candidates:
+        ts = c.data.get("logged_at")
+        if not isinstance(ts, str) or not ts:
+            out.append(Finding("error", "V015", c.path, "missing logged_at"))
+            continue
+        try:
+            parsed = datetime.fromisoformat(ts.replace("Z", "+00:00"))
+        except ValueError:
+            out.append(Finding("error", "V015", c.path, f"logged_at is not ISO8601: {ts}"))
+            continue
+        if parsed.tzinfo is None:
+            out.append(Finding("error", "V015", c.path, f"logged_at has no timezone: {ts}"))
+    return out
+
+
+def check_runs(
+    runs: runs_mod.RunIndex,
+    candidates: list[Candidate],
+    inferred: frozenset[str],
+) -> list[Finding]:
+    """V012 / V017 / V018."""
+    out: list[Finding] = []
+    known = {c.id for c in candidates}
+
+    for path in runs.files:
+        text = runs.texts.get(path, "")
+        for cid in sorted(set(runs_mod.ID_RE.findall(text))):
+            if cid not in known:
+                out.append(
+                    Finding("error", "V012", path, f"references unknown candidate ID '{cid}'")
+                )
+
+    for c in candidates:
+        role = c.effective_role(inferred)
+        if role.value == "near_prior_art" and not c.declared_role:
+            # Inferred: hint that an explicit field should be added (V019 already reports it; this adds the semantic hint)
+            pass
+        if c.declared_role and c.declared_role.value == "near_prior_art":
+            if not (runs.mentions_id(c.id) or runs.matches_doc(c.doc_number)):
+                out.append(
+                    Finding(
+                        "warn",
+                        "V018",
+                        c.path,
+                        f"role=near_prior_art, but '{c.doc_number}' never appears in any 04/runs/*.md",
+                    )
+                )
+
+        # V017: blocking conflicts with the run conclusion
+        if c.novelty_check == "blocking" and runs.matches_doc(c.doc_number):
+            for path, text in runs.texts.items():
+                if "novelty_pass" not in text:
+                    continue
+                if runs.run_with(c.doc_number) == path:
+                    out.append(
+                        Finding(
+                            "error",
+                            "V017",
+                            path,
+                            f"{c.id} is marked blocking in the candidate list, but this run concludes novelty_pass (conflicting statements)",
+                        )
+                    )
+                    break
+
+    return out
+
+
+def check_duplicates(candidates: list[Candidate]) -> list[Finding]:
+    """V014 (genuine duplicate) / V028 (suspected family member).
+
+    **Lesson from real data**: treating "same title" as a duplicate produced 14 false groups on
+    237 real candidates. The cause is that **multi-country family members** of one invention
+    (WO/US, CN application + grant, three SAMSUNG filings) naturally share a title while differing
+    in publication number; generic titles such as "Fuel cell" also collide en masse.
+
+    So detection is layered by semantics:
+      V014 error - identical normalized publication number: a genuine duplicate entry that must be fixed
+      V028 info  - title + first applicant + year all identical: possibly a family member or a double
+                   publication in the same year; worth a human look
+    """
+    out: list[Finding] = []
+    by_doc: dict[str, Path] = {}
+    by_sig: dict[tuple[str, str, int], Path] = {}
+
+    for c in candidates:
+        d = normalize_text(c.doc_number)
+        if len(d) >= 6:
+            if d in by_doc:
+                out.append(
+                    Finding(
+                        "error",
+                        "V014",
+                        c.path,
+                        f"publication number duplicates {by_doc[d].name} ({c.doc_number})",
+                    )
+                )
+            else:
+                by_doc[d] = c.path
+
+        t = normalize_text(c.title)
+        if len(t) >= 12:
+            authors = c.data.get("authors_or_applicants") or [""]
+            first = normalize_text(str(authors[0] if authors else ""))
+            year = c.data.get("year")
+            sig = (t, first, year if isinstance(year, int) else 0)
+            if sig in by_sig:
+                out.append(
+                    Finding(
+                        "info",
+                        "V028",
+                        c.path,
+                        f"title/applicant/year are identical to {by_sig[sig].name}"
+                        f" - possibly a family member or a double publication in the same year",
+                    )
+                )
+            else:
+                by_sig[sig] = c.path
+    return out
+
+
+# ── Entry points ─────────────────────────────────────────────────────
+
+
+def check_assessments(candidates: list[Candidate], root: Path) -> list[Finding]:
+    """V029：缺失/无效判断；V030：人工确认对应的实质内容已变化。"""
+    findings = []
+    for cand in candidates:
+        record = cand.data.get("assessment")
+        if record is not None and not isinstance(record, dict):
+            findings.append(Finding("error", "V029", cand.path, "assessment must be an object"))
+        elif isinstance(record, dict) and record.get("actor") in ("ai", "human"):
+            for error in assessment_errors(cand, root):
+                findings.append(Finding("error", "V029", cand.path, error))
+        elif cand.relevance >= 4 or cand.data.get("role") == "near_prior_art" or cand.data.get("reviewed_at"):
+            findings.append(Finding("warn", "V029", cand.path, "Judgment origin unknown; re-assess without changing source evidence_level"))
+        if cand.data.get("human_confirmation") and not confirmation_valid(cand, root):
+            findings.append(Finding("warn", "V030", cand.path, "Human confirmation is stale or unsupported; excluded from G-S-03 until reconfirmed"))
+    return findings
+
+
+def validate_all(
+    root: Path,
+    term: Terminology | None = None,
+    today: datetime | None = None,
+) -> list[Finding]:
+    """Run all rules. The today parameter exists for test injection (V016)."""
+    del today  # V016 currently uses now directly; the parameter is kept to keep the test interface stable
+    if term is None:
+        term = load_registry(root)
+
+    candidates = load_candidates(root)
+    logs = load_logs(root)
+    run_index = runs_mod.load_runs(root)
+    inferred = runs_mod.infer_near_prior_ids(candidates, run_index)
+
+    findings: list[Finding] = []
+    findings += check_parsable(root)
+    findings += check_schema(root)
+    findings += check_ids(candidates)
+    findings += check_evidence(candidates, root)
+    findings += check_assessments(candidates, root)
+    findings += check_source_logs(candidates)
+    findings += check_stray_logs(root)
+    findings += check_bibtex(root, candidates)
+    findings += check_terminology(term, candidates)
+    findings += check_targets(term, candidates, logs)
+    findings += check_export_completeness(root, logs)
+    findings += check_draft_registry(root)
+    findings += check_logs(root, term, logs)
+    findings += check_dates(candidates)
+    findings += check_runs(run_index, candidates, inferred)
+    findings += check_duplicates(candidates)
+    findings += check_provenance(root)
+    findings += check_figures(root)
+    findings += check_conclusion_citations(root, candidates)
+    findings += check_revision_ledger(root)
+    return findings
+
+
+def check_provenance(root: Path) -> list[Finding]:
+    """V031/V032: the numerical-claim provenance registry (opt-in via 07_drafting/numerical_provenance.yml).
+
+    The registry is optional (provenance applies once drafting starts); once it exists, every
+    statement must trace to a declared source — the rules live in patentkit.provenance, this
+    wrapper only adapts them to Finding (no second rule set)."""
+    from . import provenance as provenance_mod
+
+    if provenance_mod.load_registry(root) is None:
+        return []
+    path = root / provenance_mod.REGISTRY_REL
+    return [
+        Finding("error", code, path, msg)
+        for code, msg in provenance_mod.check_registry(root, provenance_mod.load_registry(root))
+    ]
+
+
+def check_figures(root: Path) -> list[Finding]:
+    """V033 (warn): figure-spec marks vs manuscript marks.
+
+    Text extraction is heuristic, so mismatches warn — the rule never auto-deletes a mark;
+    a human confirms against the actual drawing before anything is edited."""
+    from . import figures as figures_mod
+
+    figures_dir = root / figures_mod.FIGURES_DIR
+    return [
+        Finding(
+            "warn",
+            "V033",
+            figures_dir / f"{f['figure']}.figure.yml" if f["figure"] != "*" else figures_dir,
+            f"{f['problem']}: {', '.join(f['marks'])}",
+        )
+        for f in figures_mod.check_marks(root)
+    ]
+
+
+def check_conclusion_citations(root: Path, candidates: list[Candidate]) -> list[Finding]:
+    """V034: conclusions may only cite evidence that exists in the ledger.
+
+    An invented citation ("P-907 discloses...") is the most dangerous fabrication: it survives
+    copy-paste into deliverables. Deterministic token match over 05_novelty_conclusions/*.md."""
+    known = {c.id for c in candidates}
+    out: list[Finding] = []
+    d = root / "05_novelty_conclusions"
+    if not d.is_dir():
+        return out
+    for p in sorted(d.glob("*.md")):
+        try:
+            text = p.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            continue
+        for cid in sorted(set(runs_mod.ID_RE.findall(text))):
+            if cid not in known:
+                out.append(
+                    Finding(
+                        "error",
+                        "V034",
+                        p,
+                        f"cites candidate ID '{cid}' that is not in the evidence ledger — "
+                        f"verify the number or add the document first (patentkit ledger)",
+                    )
+                )
+    return out
+
+
+def check_revision_ledger(root: Path) -> list[Finding]:
+    """V035/V036: the revision ledger (opt-in via 07_drafting/revision_ledger.yml).
+
+    The rules live in patentkit.revise (single rule authority); this wrapper only adapts them
+    to Findings. V036 stays a warn here for consistency with V033's heuristics — `validate
+    --strict` (CI) escalates it, and `revise status` is the hard gate that exits 1."""
+    from . import revise as revise_mod
+
+    return [
+        Finding(level, code, path, msg)
+        for level, code, path, msg in revise_mod.check_ledger(root)
+    ]
+
+
+def summarize(findings: Iterable[Finding]) -> dict[str, Any]:
+    findings = list(findings)
+    errors = [f for f in findings if f.level == "error"]
+    warns = [f for f in findings if f.level == "warn"]
+    by_code: dict[str, int] = {}
+    for f in findings:
+        by_code[f.code] = by_code.get(f.code, 0) + 1
+    return {
+        "total": len(findings),
+        "errors": len(errors),
+        "warnings": len(warns),
+        "by_code": dict(sorted(by_code.items())),
+    }
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.validate",
+        description="Validate consistency of 03_candidates / 02_search_logs / 06_citation_management",
+    )
+    ap.add_argument("--root", type=Path, default=None, help="repository root (auto-detected by default)")
+    ap.add_argument("--json", action="store_true", help="output machine-readable JSON")
+    ap.add_argument(
+        "--strict",
+        action="store_true",
+        help="treat warn as error (used by CI)",
+    )
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    findings = validate_all(root, term)
+    stats = summarize(findings)
+
+    if args.json:
+        print(
+            json.dumps(
+                {
+                    "root": str(root),
+                    "summary": stats,
+                    "findings": [f.to_dict(root) for f in findings],
+                },
+                ensure_ascii=False,
+                indent=2,
+            )
+        )
+    else:
+        for f in findings:
+            print(f)
+        print()
+        print(
+            f"total {stats['total']}: error {stats['errors']} / warn {stats['warnings']}"
+        )
+        if stats["by_code"]:
+            print("by rule: " + "  ".join(f"{k}x{v}" for k, v in stats["by_code"].items()))
+
+    failing = stats["errors"] + (stats["warnings"] if args.strict else 0)
+    return 1 if failing else 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
