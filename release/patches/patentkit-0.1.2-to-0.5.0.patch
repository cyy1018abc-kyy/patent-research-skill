+
+def test_text_line_citation_and_invalid_pointer(ws):
+    from patentkit import assessment as a
+    p = ws / "02_search_logs/raw/body.txt"
+    p.write_text("合成正文\n负载前馈与流量反馈控制\n", encoding="utf-8")
+    cite = {"ref": "02_search_logs/raw/body.txt", "locator": "L2", "quote": "流量反馈", "rationale": "控制手段相同"}
+    assert a.passage(ws, cite) == "负载前馈与流量反馈控制"
+    for locator in ("L0", "L4", "L2-L1"):
+        with pytest.raises(ValueError):
+            a.passage(ws, {**cite, "locator": locator})
+    with pytest.raises(ValueError):
+        a.passage(ws, {**cite, "ref": "02_search_logs/raw/source.json", "locator": "/abstract/missing"})
+
+
+def test_cli_json_export_assess_confirm_and_scripts(ws, tmp_path):
+    import subprocess
+    import sys
+    from patentkit import assessment as a
+    env = {**__import__("os").environ, "PYTHONIOENCODING": "utf-8"}
+    def run(*args):
+        return subprocess.run([sys.executable, "-m", "patentkit", "review", *args, "--root", str(ws)], capture_output=True, text=True, encoding="utf-8", env=env, timeout=30)
+    export = run("export", "--format", "json", "--out", "assessment.json")
+    assert export.returncode == 0, export.stderr
+    rows = json.loads((ws / "assessment.json").read_text(encoding="utf-8"))
+    assert rows[0]["expected_fingerprint"] == a.fingerprint(candidate(ws), ws)
+    write_json(ws / "assessment.json", [row(ws)])
+    assert run("assess", "assessment.json", "--actor", "ai", "--by", "测试模型", "--apply").returncode == 0
+    write_json(ws / "confirm.json", [{"candidate_id": "P-900", "expected_fingerprint": a.fingerprint(candidate(ws), ws)}])
+    assert run("confirm", "confirm.json", "--by", "测试复核人", "--apply").returncode == 0
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "1 docs"
+
+
+def test_legacy_csv_edit_preserves_history_and_cannot_reconfirm(ws, tmp_path):
+    import csv
+    from patentkit import review
+    from patentkit.registry import load_registry
+    assess(ws)
+    confirm(ws)
+    path = tmp_path / "edit.csv"
+    with path.open("w", encoding="utf-8", newline="") as stream:
+        writer = csv.DictWriter(stream, fieldnames=["candidate_id", "review_note"])
+        writer.writeheader()
+        writer.writerow({"candidate_id": "P-900", "review_note": "人工修改判断依据"})
+    result = review.apply_worksheet(ws, load_registry(ws), path, dry_run=False, by="新的人工审阅者")
+    assert result.written == 1
+    assert candidate(ws).data["assessment"]["actor"] == "human"
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "0 docs"
+    assert len(candidate(ws).data["review_history"]) == 3
+
+
+def test_repeating_same_assessment_and_confirmation_is_idempotent(ws):
+    assess(ws)
+    confirm(ws)
+    assert confirm(ws)["changed"] == 0
+    # 相同判断的时间戳变化不属于实质变更。
+    c = candidate(ws)
+    c.data["assessment"]["at"] = "2026-10-23T12:00:00+08:00"
+    write_json(c.path, c.data)
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "1 docs"
+
+
+@pytest.mark.parametrize("changes", [{"review_note": "超" * 301}, {"feature_mapping": "错误类型"}, {"role": []}])
+def test_schema_invalid_edit_fails_before_write(ws, changes):
+    from patentkit import assessment as a
+    before = candidate(ws).path.read_bytes()
+    with pytest.raises(ValueError):
+        a.assess_batch(ws, [row(ws, **changes)], actor="ai", by="模型", apply=True)
+    assert candidate(ws).path.read_bytes() == before
