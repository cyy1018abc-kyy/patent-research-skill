+    rows = deadlines.evaluate(ws, today=date(2026, 10, 25))
+    assert rows[0]["due"] is None and rows[0]["status"] == "incomplete"
+    assert deadlines.main(["check", "--root", str(ws)]) == 1
+
+
+def test_export_docx_numbers_come_from_the_workspace(ws, tmp_path):
+    docx = pytest.importorskip("docx")
+    from patentkit import export as export_mod
+
+    out = tmp_path / "r.docx"
+    assert export_mod.main(["TGT-0002", "--root", str(ws), "--out", str(out)]) == 0
+    document = docx.Document(str(out))
+    text = "\n".join(p.text for p in document.paragraphs)
+    assert "TGT-0002" in text and "不构成法律意见" in text
+    cells = [c.text for t in document.tables for r in t.rows for c in r.cells]
+    assert any("G-S-01" in c for c in cells)  # 五门表随工作区状态转写
