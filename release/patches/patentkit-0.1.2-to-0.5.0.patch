+"""runs.py — run file index and patent number normalization."""
+
+from __future__ import annotations
+
+import pytest
+
+from conftest import make_candidate
+from patentkit import runs as runs_mod
+from patentkit.runs import (
+    RunIndex,
+    core_doc,
+    infer_near_prior_ids,
+    load_runs,
+    normalize_doc,
+)
+
+
+@pytest.mark.parametrize(
+    "raw,expected",
+    [
+        ("US 8,282,045 B2", "US8282045B2"),
+        ("RU 2360332 C2", "RU2360332C2"),
+        ("FR 09 00836", "FR0900836"),
+        ("FR 09 00836 A", "FR0900836A"),
+        ("CN123456789A", "CN123456789A"),
+        ("10.1016/j.apenergy.2025.126187", "101016JAPENERGY2025126187"),
+    ],
+)
+def test_normalize_doc(raw, expected):
+    assert normalize_doc(raw) == expected
+
+
+def test_matches_doc_exact(repo):
+    assert repo.runs().matches_doc("US 1234567 B2")
+
+
+def test_matches_doc_tolerates_kind_code_suffix(repo):
+    """FR0900836 and FR0900836A should be treated as the same document."""
+    idx = RunIndex(
+        files=(),
+        ids=frozenset(),
+        doc_numbers=frozenset({"FR0900836"}),
+        texts={},
+    )
+    assert idx.matches_doc("FR 09 00836 A")
+
+
+def test_matches_doc_rejects_short_tokens(repo):
+    idx = RunIndex(files=(), ids=frozenset(), doc_numbers=frozenset({"US12"}), texts={})
+    assert not idx.matches_doc("US 12")
+
+
+@pytest.mark.parametrize(
+    "raw,expected",
+    [
+        ("US 8,282,045 B2", "US8282045"),
+        ("FR 09 00836 A", "FR0900836"),
+        ("RU 2360332 C2", "RU2360332"),
+        ("US 1234567", "US1234567"),
+        ("CN123456789A", "CN123456789"),
+        ("10.1016/j.apenergy.2025.126187", "101016JAPENERGY2025126187"),
+    ],
+)
+def test_core_doc_strips_kind_code(raw, expected):
+    assert core_doc(raw) == expected
+
+
+def test_matches_doc_does_not_confuse_similar_numbers():
+    """Regression: prefix/suffix matching was once used, so 'US1234567' falsely matched 'US12345678B2' (two different patents)."""
+    idx = RunIndex(
+        files=(),
+        ids=frozenset(),
+        doc_numbers=frozenset({"US12345678B2"}),
+        texts={},
+    )
+    assert not idx.matches_doc("US 1234567 B2")
+
+
+def test_matches_doc_positive_with_kind_code():
+    idx = RunIndex(
+        files=(),
+        ids=frozenset(),
+        doc_numbers=frozenset({"US1234567B2"}),
+        texts={},
+    )
+    assert idx.matches_doc("US 1234567 B2")
+
+
+def test_matches_doc_tolerates_missing_kind_code():
+    """The run writes 'US 8,282,045' (no kind code) while the candidate writes 'US 8,282,045 B2' — it should match."""
+    idx = RunIndex(
+        files=(),
+        ids=frozenset(),
+        doc_numbers=frozenset({"US8282045"}),
+        texts={},
+    )
+    assert idx.matches_doc("US 8,282,045 B2")
+
+
+def test_matches_doc_negative(repo):
+    assert not repo.runs().matches_doc("US 9999999 B2")
+
+
+def test_mentions_id(repo):
+    repo.write_run("2026-01-02_x.md", "# Run\n\nsee the conclusion for P-007\n")
+    assert repo.runs().mentions_id("P-007")
+    assert not repo.runs().mentions_id("P-008")
+
+
+def test_load_runs_extracts_doc_numbers(repo):
+    idx = load_runs(repo.root)
+    assert "US1234567B2" in idx.doc_numbers
+
+
+def test_infer_includes_matching_candidate(repo):
+    # inference additionally requires novelty_check != untouched (mis-mapped entries are excluded)
+    cands = [cand_from(make_candidate(novelty_check="partial"))]
+    cands[0].data["url_or_doc_number"] = "US 1234567 B2"
+    assert infer_near_prior_ids(cands, repo.runs()) == frozenset({"P-001"})
+
+
+def test_infer_excludes_untouched(repo):
+    """Mis-mapped / false-positive entries (novelty_check=untouched) must not be inferred as near prior art."""
+    cand = make_candidate(novelty_check="untouched")
+    cand["url_or_doc_number"] = "US 1234567 B2"
+    assert infer_near_prior_ids([cand_from(cand)], repo.runs()) == frozenset()
+
+
+def test_run_with_returns_path(repo):
+    path = repo.runs().run_with("US 1234567 B2")
+    assert path is not None
+    assert path.name == "2026-01-01_tgt-test.md"
+
+
+def test_id_regex_finds_candidate_ids(repo):
+    repo.write_run("2026-01-02_y.md", "see P-001 and L-012, plus P-2 (invalid)\n")
+    assert runs_mod.ID_RE.findall(repo.runs().texts[repo.runs_dir / "2026-01-02_y.md"]) == [
+        "P-001",
+        "L-012",
+    ]
+
+
+def cand_from(data: dict):
+    from patentkit.model import Candidate
+    from pathlib import Path
+
+    return Candidate(data=data, path=Path("/tmp") / "03_candidates" / f"{data['id']}.json")
