+"""bibsync.py — generate the missing BibTeX entries for candidates."""
+
+from __future__ import annotations
+
+import json
+
+from conftest import make_candidate
+from patentkit import bibsync
+
+
+def run_sync(repo, *extra: str) -> int:
+    return bibsync.main(["--root", str(repo.root), *extra])
+
+
+def bib_text(repo) -> str:
+    return repo.bib.read_text(encoding="utf-8")
+
+
+# ── Detection ─────────────────────────────────────────────────────────
+
+
+def test_reports_missing_key(repo, capsys):
+    repo.write_candidate(make_candidate(bibtex_key="brand_new_key"))
+    assert run_sync(repo) == 0
+    out = capsys.readouterr().out
+    assert "To generate: 1" in out
+    assert "Not written" in out
+
+
+def test_dry_run_writes_nothing(repo, capsys):
+    repo.write_candidate(make_candidate(bibtex_key="brand_new_key"))
+    before = bib_text(repo)
+    run_sync(repo)
+    capsys.readouterr()
+    assert bib_text(repo) == before
+
+
+def test_no_change_when_all_present(repo, capsys):
+    assert run_sync(repo, "--apply") == 0
+    assert "Nothing to change." in capsys.readouterr().out
+
+
+def test_template_keys_not_counted_as_existing(repo, capsys):
+    """Placeholder keys in the template do not count as existing — otherwise generation is skipped."""
+    repo.write_candidate(make_candidate(bibtex_key="YYYY-AUTHORS-KEYWORDS"))
+    run_sync(repo)
+    assert "To generate: 1" in capsys.readouterr().out
+
+
+# ── Generation ────────────────────────────────────────────────────────
+
+
+def test_apply_appends_entry(repo, capsys):
+    repo.write_candidate(make_candidate(bibtex_key="brand_new_key"))
+    run_sync(repo, "--apply")
+    capsys.readouterr()
+
+    text = bib_text(repo)
+    assert "@misc{brand_new_key," in text
+    assert "Localized capillary water removal device" in text  # the fixture default title
+    assert "US 1234567 B2" in text
+
+
+def test_corporate_author_double_braces(repo, capsys):
+    """A single applicant must be {  {Name}  }, never triple braces."""
+    repo.write_candidate(make_candidate(bibtex_key="brand_new_key"))
+    run_sync(repo, "--apply")
+    capsys.readouterr()
+
+    line = [ln for ln in bib_text(repo).splitlines() if "brand_new_key" in ln][0]
+    assert line.startswith("@misc{brand_new_key")
+    authors = [ln for ln in bib_text(repo).splitlines() if ln.strip().startswith("author = {{Fixture Applicant")]
+    assert authors, bib_text(repo)[-500:]
+    assert "{{{" not in bib_text(repo).split("@misc{brand_new_key,")[1].split("}")[0]
+
+
+def test_multiple_authors_joined(repo, capsys):
+    cand = make_candidate(
+        bibtex_key="multi_key",
+        authors_or_applicants=["Alice A", "Bob B"],
+        kind="paper",
+    )
+    repo.write_candidate(cand)
+    run_sync(repo, "--apply")
+    capsys.readouterr()
+
+    section = bib_text(repo).split("@article{multi_key,")[1]
+    assert "author = {Alice A and Bob B}," in section
+
+
+def test_special_chars_escaped(repo, capsys):
+    """The & _ % characters in the title must be escaped, otherwise the .bib breaks."""
+    cand = make_candidate(
+        bibtex_key="escape_key",
+        title="Fuel_cell & water 100% removal",
+    )
+    repo.write_candidate(cand)
+    run_sync(repo, "--apply")
+    capsys.readouterr()
+
+    section = bib_text(repo).split("@misc{escape_key,")[1]
+    assert r"Fuel\_cell \& water 100\% removal" in section
+
+
+def test_paper_uses_doi_when_doi_like(repo, capsys):
+    cand = make_candidate(
+        bibtex_key="doi_key",
+        kind="paper",
+        url_or_doc_number="10.1016/j.jpowsour.2020.123456",
+    )
+    repo.write_candidate(cand)
+    run_sync(repo, "--apply")
+    capsys.readouterr()
+
+    section = bib_text(repo).split("@article{doi_key,")[1]
+    assert "doi    = {10.1016/j.jpowsour.2020.123456}" in section
+    assert "@article" in bib_text(repo)
+
+
+def test_target_filter(repo, capsys):
+    repo.write_candidate(
+        make_candidate(bibtex_key="other_key", target="TGT-0001", tags=["N1@TGT-0001"])
+    )
+    run_sync(repo, "--target", "TGT-0000")
+    assert "To generate: 0" in capsys.readouterr().out
+
+
+def test_idempotent(repo, capsys):
+    repo.write_candidate(make_candidate(bibtex_key="brand_new_key"))
+    run_sync(repo, "--apply")
+    capsys.readouterr()
+
+    run_sync(repo, "--apply")
+    assert "Nothing to change." in capsys.readouterr().out
+    assert bib_text(repo).count("@misc{brand_new_key,") == 1
+
+
+def test_candidate_without_key_reported(repo, capsys):
+    repo.write_candidate(make_candidate(bibtex_key=None))
+    run_sync(repo)
+    out = capsys.readouterr().out
+    assert "1 missing the bibtex_key field" in out
+
+
+def test_generated_entries_make_validate_clean(repo, capsys):
+    """Add one candidate (leaving the fixture's original in place); after syncing .bib, validate should be completely clean."""
+    repo.write_candidate_raw(
+        "P-002",
+        make_candidate(
+            id="P-002",
+            bibtex_key="brand_new_key",
+            title="A brand new patent about microgravity separation",
+            url_or_doc_number="US 9999999 B2",
+            logged_at="2026-01-01T00:00:00+08:00",
+        ),
+    )
+    run_sync(repo, "--apply")
+    capsys.readouterr()
+
+    findings = repo.validate()
+    assert findings == [], "\n".join(str(f) for f in findings)
