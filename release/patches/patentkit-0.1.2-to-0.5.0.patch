+    # ── 五门 ──
+    parts.append("<h2>⑦ 五门验收（verified 列判定）</h2><table><tr><th>门</th><th>判据</th><th>verified</th><th>状态</th></tr>")
+    for g in report.results:
+        cls = "pass" if g.status == "PASS" else ("fail" if g.status == "FAIL" else "na")
+        parts.append(
+            f"<tr><td>{_esc(g.gate_id)}</td><td>{_esc(g.threshold)}</td>"
+            f"<td>{_esc(g.values.get('verified', '-'))}</td><td class='{cls}'>{_esc(g.status)}</td></tr>"
+        )
+    parts.append("</table>")
+
+    # ── 改稿台账（若已进入撰写） ──
+    rows = _revision_rows(root)
+    if rows:
+        parts.append("<h2>⑧ 改稿台账（最近轮次，链条延伸到撰写侧）</h2><table><tr><th>轮次</th><th>问题</th><th>改动数</th><th>重验状态</th></tr>")
