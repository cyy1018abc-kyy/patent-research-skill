+#: Worksheet columns. The first part is read-only; the rest (the judge fields) is filled in by humans.
+READ_COLUMNS = [
+    "axis",
+    "candidate_id",
+    "publication_number",
+    "year",
+    "applicant",
+    "title",
+    "abstract_full",
+    "current_relevance",
+    "current_role",
+    "current_novelty_check",
+    "expected_fingerprint",
+]
