-def check_export_completeness(root: Path, logs: list[SearchLog]) -> list[Finding]:
-    """V026: record count of raw artifacts vs the declared hit_count.
-
-    **Why this rule exists**: N1 declared 237 hits, while Espacenet's `Export -> CSV` only exported
-    the 20 records of the current page. It was only spotted by **comparing the 4th row of the CSV
-    by eye**, which showed "Results 1 to 20 displayed". With this rule, any future incomplete
-    export is caught on the spot by `validate`.
-
-    Only applies to parseable formats; unparseable ones produce an info finding and are skipped.
-    """
-    # Lazy import: ingest depends on model/paths/registry, not on validate, so there is no cycle;
-    # keeping the coupling inside the function avoids module-level pull.
-    from . import ingest as ingest_mod
-
-    out: list[Finding] = []
-    for log in logs:
-        if log.capture_mode.value != "live":
-            continue
-
-        try:
-            paths = ingest_mod.resolve_raw_files(root, log.path, None)
-        except (FileNotFoundError, ValueError):
-            continue  # missing artifacts are reported by V009
-
-        if not paths:
-            continue
-
-        total = 0
-        parsed_any = False
-        for p in paths:
-            try:
-                total += len(ingest_mod.read_raw(p, {}))
-                parsed_any = True
-            except ValueError:
-                continue  # unsupported format (e.g. CNIPA XML)
-            except Exception:  # noqa: BLE001 - a parse failure must not crash the whole validation run
-                continue
-
-        if not parsed_any:
-            out.append(
-                Finding(
-                    "info",
-                    "V026",
-                    log.path,
-                    f"none of the {len(paths)} raw artifact file(s) could be parsed; skipping export-completeness check",
-                )
-            )
-            continue
-
-        hits = log.hit_count
-        if hits is None or total >= hits:
-            continue
-
-        # A log may explicitly declare "not fully captured" (result.complete=false) - that is honest
-        # record-keeping, not concealment. V026 targets **concealed incompleteness** (the export was
-        # assumed complete but only the first page was exported). Treating the two differently is
-        # essential, otherwise a declared partial capture would make strict mode fail forever and
-        # push people to hide it.
-        declared_partial = log.data.get("result", {}).get("complete") is False
-        if declared_partial:
-            out.append(
-                Finding(
-                    "info",
-                    "V026",
-                    log.path,
-                    f"raw artifacts contain {total} record(s) < declared hits {hits}; "
-                    f"the log explicitly declares complete=false (partial capture, honestly recorded)",
-                )
-            )
-        else:
-            out.append(
-                Finding(
-                    "warn",
-                    "V026",
-                    log.path,
-                    f"raw artifacts contain only {total} record(s), but {hits} hits were declared"
-                    f"(short by {hits - total}) - very likely only some pages were exported; export the rest and re-run",
-                )
-            )
-    return out
-
