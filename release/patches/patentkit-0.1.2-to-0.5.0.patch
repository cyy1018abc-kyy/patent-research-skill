@@ -0,0 +1,495 @@
+"""Revision loop (multi-round revision closed loop) — the kernel-side enforcement of 13-revision-loop.md.
+
+Three hard rules (references/13), made structural here
+------------------------------------------------------
+1. **One patch solves one registered problem only**: a patch file (YAML) declares round / issue /
+   source, and each change must carry a field-level locator; incidental edits have no patch entry,
+   and the tool only applies the declared find→replace.
+2. **Substantive changes invalidating confirmations is by design**: after apply, the tool records the
+   required re-validation (revalidate) in the ledger and prints a "re-confirm" reminder; the old
+   human confirmation is invalidated by the content fingerprint change (assessment protocol).
+3. **Edit-then-log is forbidden**: apply is the only write path — the ledger is written **in the same
+   transaction** as the file modification, and records sha256 before/after; `revise status` compares
+   the ledger's post-round sha256 against the current file byte-by-byte, and any unlogged modification
+   is reported (V036 in validate). This provides the answer to attest --check drift's "who changed it,
+   when, and why".
+
+Patch file format (all fields are required unless stated otherwise)::
+
+    schema: 1
+    round: R4                      # must not duplicate a round already in the ledger
+    issue: OA-X2                   # problem identifier (office-action entry number / self-review topic)
+    source: office action          # problem origin, one line of free text
+    changes:
+      - file: 07_drafting/claims.md  # relative to the workspace; must be registered in manuscript_registry.yml
+        field: claim 2 numeric range # human-readable field/paragraph locator
+        find: "0.33-0.45"            # must appear **exactly once** in the target file
+        replace: "0.35-0.42"
+        revalidate: [provenance, confirmations]  # optional; subset of the enum below
+
+    The values of revalidate are only advisory (provenance / figures / confirmations / deadlines); validate
+    and gates are always mandatory and are not listed.
+
+Usage::
+
+    python -m patentkit revise apply patch-R4.yml   # atomic application: all find hits must be unique
+    python -m patentkit revise status               # round table + ledger-chain integrity check
+    python -m patentkit revise close --round R4 --note "validate+gates+provenance all green"
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from .attest import dump_draft_registry, load_draft_registry
+from .model import sha256_file
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+
+LEDGER_REL = Path("07_drafting") / "revision_ledger.yml"
+REGISTRY_REL = Path("07_drafting") / "manuscript_registry.yml"
+
+#: revalidate enum values (advisory; validate+gates are always mandatory and are not listed)
+REVALIDATE_VALUES = ("provenance", "figures", "confirmations", "deadlines")
+#: Issue-escalation threshold: reaching N rounds for the same issue → stop revising, escalate to the inventor/agent
+ISSUE_ROUND_LIMIT = 3
+
+
+class PatchError(ValueError):
+    """Structural or semantic patch error (message is already user-readable)."""
+
+
+# ── Ledger read/write ─────────────────────────────────────────────────
+
+
+def load_ledger(root: Path) -> dict[str, Any]:
+    """Returns the ledger data; an absent file yields an empty skeleton. A parse failure raises ValueError."""
+    path = root / LEDGER_REL
+    if not path.is_file():
+        return {"schema": 1, "rounds": []}
+    data = yaml.safe_load(path.read_text(encoding="utf-8"))
+    if not isinstance(data, dict) or not isinstance(data.get("rounds"), list):
+        raise ValueError(f"{LEDGER_REL.as_posix()}: top level must be a mapping containing a rounds list")
+    for i, r in enumerate(data["rounds"]):
+        if not isinstance(r, dict):
+            raise ValueError(f"{LEDGER_REL.as_posix()}: rounds[{i}] is not a mapping")
+        for key in ("round", "issue", "changes"):
+            if not r.get(key):
+                raise ValueError(f"{LEDGER_REL.as_posix()}: rounds[{i}] is missing {key}")
+        if not isinstance(r["changes"], list):
+            raise ValueError(f"{LEDGER_REL.as_posix()}: rounds[{i}].changes must be a list")
+    return data
+
+
+def dump_ledger(root: Path, data: dict[str, Any]) -> None:
+    path = root / LEDGER_REL
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        yaml.safe_dump(data, allow_unicode=True, sort_keys=False, width=100),
+        encoding="utf-8",
+        newline="\n",
+    )
+
+
+def _next_round(data: dict[str, Any]) -> str:
+    n = 0
+    for r in data.get("rounds") or []:
+        raw = str(r.get("round") or "")
+        if raw.startswith("R") and raw[1:].isdigit():
+            n = max(n, int(raw[1:]))
+    return f"R{n + 1}"
+
+
+# ── Patch validation (read-only) ──────────────────────────────────────
+
+
+def _registered_paths(registry: dict[str, Any]) -> dict[Path, dict[str, Any]]:
+    out: dict[Path, dict[str, Any]] = {}
+    for d in registry.get("drafts") or []:
+        if isinstance(d, dict) and d.get("path"):
+            out[Path(str(d["path"]))] = d
+    return out
+
+
+def validate_patch(root: Path, patch: dict[str, Any], ledger: dict[str, Any],
+                   registry: dict[str, Any]) -> list[tuple[Path, str, str]]:
+    """Validate patch structure and semantic feasibility, without writing anything.
+
+    Returns the list of (file, old_text, new_text) to apply. Any problem raises PatchError.
+    """
+    if not isinstance(patch, dict):
+        raise PatchError("the patch top level must be a mapping")
+    if patch.get("schema") != 1:
+        raise PatchError(f"patch schema must be 1, got {patch.get('schema')!r}")
+    for key in ("round", "issue", "source"):
+        if not str(patch.get(key) or "").strip():
+            raise PatchError(f"patch is missing {key}")
+    round_id = str(patch["round"])
+    known_rounds = {str(r.get("round")) for r in ledger.get("rounds") or []}
+    if round_id in known_rounds:
+        raise PatchError(f"round {round_id} already exists in the ledger (the next round should be {_next_round(ledger)})")
+
+    changes = patch.get("changes")
+    if not isinstance(changes, list) or not changes:
+        raise PatchError("changes must be a non-empty list — a no-op patch has no audit value")
+
+    registered = _registered_paths(registry)
+    by_resolved: dict[Path, dict[str, Any]] = {
+        (root / p).resolve(): d for p, d in registered.items()
+    } if registered else {}
+    if not registered:
+        raise PatchError(
+            f"{REGISTRY_REL.as_posix()} has no registered drafts — a manuscript outside the registry is outside the "
+            "closed-loop discipline; register it with attest before revising"
+        )
+
+    plan: list[tuple[Path, str, str]] = []
+    for i, ch in enumerate(changes):
+        if not isinstance(ch, dict):
+            raise PatchError(f"changes[{i}] is not a mapping")
+        for key in ("file", "field", "find", "replace"):
+            if ch.get(key) is None or str(ch.get(key)) == "" and key != "replace":
+                raise PatchError(f"changes[{i}] is missing {key}")
+        if not isinstance(ch.get("find"), str) or not isinstance(ch.get("replace"), str):
+            raise PatchError(f"changes[{i}].find/replace must be strings (empty replace = delete)")
+        revalidate = ch.get("revalidate") or []
+        if not isinstance(revalidate, list) or any(v not in REVALIDATE_VALUES for v in revalidate):
+            raise PatchError(f"changes[{i}].revalidate may only contain: {', '.join(REVALIDATE_VALUES)}")
+
+        raw = Path(str(ch["file"]))
+        target = (root / raw).resolve() if not raw.is_absolute() else raw.resolve()
+        try:
+            target.relative_to(root)
+        except ValueError:
+            raise PatchError(f"changes[{i}].file is outside the workspace: {ch['file']}")
+        entry = by_resolved.get(target)
+        if entry is None:
+            raise PatchError(
+                f"changes[{i}].file {ch['file']} is not registered in manuscript_registry.yml — "
+                "an unregistered manuscript may not enter the closed loop (register it with attest first)"
+            )
+        if not target.is_file():
+            raise PatchError(f"changes[{i}].file does not exist: {target}")
+
+        # Line endings must be preserved byte-for-byte (sha256 counts on the bytes); newline='' disables translation.
+        with target.open("r", encoding="utf-8", newline="") as fh:
+            text = fh.read()
+        hits = text.count(ch["find"])
+        if hits == 0:
+            raise PatchError(f"changes[{i}] ({ch['field']}): find text not found in {ch['file']} — the manuscript may have changed, regenerate the patch")
+        if hits > 1:
+            raise PatchError(f"changes[{i}] ({ch['field']}): find text appears {hits} times in {ch['file']} — expand its context to make it unique")
+        plan.append((target, text, text.replace(ch["find"], ch["replace"], 1)))
+    return plan
+
+
+# ── apply ─────────────────────────────────────────────────────────────
+
+
+def apply_patch(root: Path, patch_path: Path, as_json: bool) -> int:
+    try:
+        patch = yaml.safe_load(patch_path.read_text(encoding="utf-8"))
+        ledger = load_ledger(root)
+        registry = load_draft_registry(root / REGISTRY_REL)
+        plan = validate_patch(root, patch, ledger, registry)
+    except (OSError, ValueError, PatchError) as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    now = datetime.now().astimezone().isoformat(timespec="seconds")
+    round_id = str(patch["round"])
+
+    # Same-transaction writing: files → registry → ledger; any disk error leaves the ledger unwritten (no half round).
+    by_resolved = {(root / Path(str(d["path"]))).resolve(): d for d in registry.get("drafts") or []
+                   if isinstance(d, dict) and d.get("path")}
+    applied: list[dict[str, Any]] = []
+    try:
+        for (target, old_text, new_text), ch in zip(plan, patch["changes"]):
+            sha_before = sha256_file(target)
+            with target.open("w", encoding="utf-8", newline="") as fh:
+                fh.write(new_text)
+            sha_after = sha256_file(target)
+            applied.append({
+                "file": target.relative_to(root).as_posix(),
+                "field": str(ch["field"]),
+                "find": ch["find"],
+                "replace": ch["replace"],
+                "revalidate": list(ch.get("revalidate") or []),
+                "sha256_before": sha_before,
+                "sha256_after": sha_after,
+            })
+            entry = by_resolved.get(target)
+            if entry is not None:
+                entry["sha256"] = sha_after
+                entry["status"] = "current"
+                entry["evidence_level"] = "attested"
+                entry["checked_at"] = now
+        registry["last_attested_at"] = now
+        registry["updated"] = now[:10]
+        dump_draft_registry(root / REGISTRY_REL, registry)
+        ledger.setdefault("schema", 1)
+        ledger["rounds"] = ledger.get("rounds") or []
+        ledger["rounds"].append({
+            "round": round_id,
+            "applied_at": now,
+            "issue": str(patch["issue"]),
+            "source": str(patch["source"]),
+            "revalidation_status": "pending",
+            "changes": applied,
+        })
+        ledger["updated"] = now[:10]
+        dump_ledger(root, ledger)
+    except OSError as exc:
+        print(f"[FATAL] write failed ({exc}) — the ledger was not written; please check file states with revise status",
+              file=sys.stderr)
+        return 2
+
+    revalidate = sorted({v for a in applied for v in a["revalidate"]})
+    if as_json:
+        print(json.dumps({"ok": True, "round": round_id, "changes": applied,
+                          "revalidate": revalidate, "ledger": LEDGER_REL.as_posix()},
+                         ensure_ascii=False, indent=2))
+        return 0
+
+    print(f"Round {round_id} applied ({patch['issue']} · {patch['source']}):")
+    for a in applied:
+        print(f"  · {a['file']} — {a['field']}")
+        print(f"      {a['find']!r} → {a['replace']!r}")
+        print(f"      sha256 {str(a['sha256_before'])[:12]}… → {str(a['sha256_after'])[:12]}…")
+    print(f"Ledger     : {LEDGER_REL.as_posix()} (+1 round, revalidation_status=pending)")
+    print(f"Manuscript registry: re-bound {len(applied)} files (attested)")
+    print()
+    print("Required re-validation (the two at the top are always mandatory):")
+    print("  · python -m patentkit validate --strict")
+    print("  · python -m patentkit gates")
+    for item in revalidate:
+        if item == "provenance":
+            print("  · python -m patentkit provenance check   (numeric changes)")
+        elif item == "figures":
+            print("  · python -m patentkit figures check      (figure-mark changes)")
+        elif item == "confirmations":
+            print("  · affected near prior art must be re-assessed and re-human-confirmed (fingerprints have changed; invalidation is by design)")
+        elif item == "deadlines":
+            print("  · python -m patentkit deadlines check    (deadline-related changes)")
+    print(f"After re-validation passes: python -m patentkit revise close --round {round_id}")
+    return 0
+
+
+# ── status / close ────────────────────────────────────────────────────
+
+
+def _integrity(root: Path, ledger: dict[str, Any]) -> tuple[list[str], list[str]]:
+    """Ledger-chain integrity: latest round per file, sha256_after must equal the current file's bytes."""
+    errors: list[str] = []
+    warnings: list[str] = []
+    latest: dict[str, dict[str, Any]] = {}
+    for r in ledger.get("rounds") or []:
+        for ch in r.get("changes") or []:
+            latest[str(ch.get("file"))] = ch
+    registry = None
+    reg_path = root / REGISTRY_REL
+    if reg_path.is_file():
+        try:
+            registry = load_draft_registry(reg_path)
+        except (OSError, ValueError):
+            registry = None
+    reg_by_path = {str(d.get("path")): d for d in (registry or {}).get("drafts") or []
+                   if isinstance(d, dict) and d.get("path")}
+
+    for rel, ch in sorted(latest.items()):
+        p = root / rel
+        actual = sha256_file(p) if p.is_file() else None
+        after = ch.get("sha256_after")
+        if actual is None:
+            errors.append(f"{rel}: the file does not exist, but the ledger has a post-round sha256 for it — it was deleted/moved, which does not count as a revision")
+        elif actual != after:
+            errors.append(
+                f"{rel}: the current sha256 does not match the ledger's post-round value — the content was changed **without logging a round** "
+                f"(backfill a round with revise apply, or revert the change)"
+            )
+        entry = reg_by_path.get(rel)
+        if entry and entry.get("sha256") and entry["sha256"] != after:
+            warnings.append(
+                f"{rel}: manuscript_registry sha256 disagrees with the ledger's post-round value — the registry was re-bound outside a round (attest --apply)"
+            )
+    return errors, warnings
+
+
+def _issue_rounds(ledger: dict[str, Any]) -> dict[str, list[str]]:
+    out: dict[str, list[str]] = {}
+    for r in ledger.get("rounds") or []:
+        out.setdefault(str(r.get("issue")), []).append(str(r.get("round")))
+    return out
+
+
+def run_status(root: Path, as_json: bool) -> int:
+    try:
+        ledger = load_ledger(root)
+    except ValueError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    errors, warnings = _integrity(root, ledger)
+    rounds = ledger.get("rounds") or []
+    pending = [r for r in rounds if r.get("revalidation_status") == "pending"]
+    escalated = {i: rs for i, rs in _issue_rounds(ledger).items() if len(rs) >= ISSUE_ROUND_LIMIT}
+
+    if as_json:
+        print(json.dumps({
+            "ledger": LEDGER_REL.as_posix(),
+            "rounds": [{"round": r.get("round"), "issue": r.get("issue"), "source": r.get("source"),
+                        "revalidation_status": r.get("revalidation_status"),
+                        "changes": len(r.get("changes") or [])} for r in rounds],
+            "pending_revalidation": [r.get("round") for r in pending],
+            "escalated_issues": {i: len(rs) for i, rs in escalated.items()},
+            "integrity_errors": errors,
+            "integrity_warnings": warnings,
+        }, ensure_ascii=False, indent=2))
+        return 1 if errors else 0
+
+    print(f"Revision ledger : {LEDGER_REL.as_posix()} ({len(rounds)} rounds)")
+    if not rounds:
+        print("  (empty — use revise apply <patch.yml> for the first revision; format shown in the module docstring)")
+    for r in rounds:
+        mark = "✅ done" if r.get("revalidation_status") == "done" else "⏳ pending"
+        print(f"  {r.get('round')}  {mark}  {r.get('issue')}  ({r.get('source')}; {len(r.get('changes') or [])} changes)")
+    if pending:
+        print(f"\n⏳ {len(pending)} rounds pending re-validation: after validate --strict + gates (and revalidate items) pass,")
+        print("   close with revise close --round <round>; conclusions from pending rounds should not be delivered.")
+    for issue, rs in escalated.items():
+        print(f"\n🚨 问题 {issue} 已累计 {len(rs)} 轮（{', '.join(rs)}）——到达轮数上限：停下改稿，"
+              "把问题升级给发明人/代理师，不要用反复改稿掩盖材料缺失")
+    if warnings:
+        print()
+        for w in warnings:
+            print(f"⚠️ {w}")
+    if errors:
+        print()
+        for e in errors:
+            print(f"❗ {e}")
+        print("\nThe ledger chain is broken: answer 'who changed it, when, and why' first, then run attest --apply to re-bind")
+        return 1
+    print("\nLedger chain integrity: post-round sha256 is byte-identical to current files")
+    return 0
+
+
+def run_close(root: Path, round_id: str, note: str, as_json: bool) -> int:
+    try:
+        ledger = load_ledger(root)
+    except ValueError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+    entry = next((r for r in ledger.get("rounds") or [] if str(r.get("round")) == round_id), None)
+    if entry is None:
+        known = ", ".join(str(r.get("round")) for r in ledger.get("rounds") or []) or "(no rounds)"
+        print(f"[FATAL] round {round_id} does not exist in the ledger; existing: {known}", file=sys.stderr)
+        return 2
+    if entry.get("revalidation_status") == "done":
+        print(f"Round {round_id} is already closed; no changes made")
+        return 0
+
+    # Only allow closing after the integrity check passes — a broken chain means the closure is self-deception.
+    errors, _ = _integrity(root, ledger)
+    if errors:
+        for e in errors:
+            print(f"❗ {e}", file=sys.stderr)
+        print("[FATAL] ledger chain is broken; close the round after handling it (see revise status)", file=sys.stderr)
+        return 1
+
+    now = datetime.now().astimezone().isoformat(timespec="seconds")
+    entry["revalidation_status"] = "done"
+    entry["closed_at"] = now
+    if note:
+        entry["close_note"] = str(note)
+    ledger["updated"] = now[:10]
+    dump_ledger(root, ledger)
+    if as_json:
+        print(json.dumps({"ok": True, "round": round_id, "closed_at": now}, ensure_ascii=False))
+    else:
+        print(f"Round {round_id} closed ({now})" + (f" — {note}" if note else ""))
+    return 0
+
+
+# ── validate integration (V035 / V036) ────────────────────────────────
+
+
+def check_ledger(root: Path) -> list[tuple[str, str, Path, str]]:
+    """Returns (level, code, path, message); validate.py adapts these into Findings.
+
+    V035 error: the ledger exists but its structure is invalid (the chain is already untrustworthy);
+    V036 warn : post-round sha256 mismatch with current files — content changed without a logged round.
+    validate does not re-check the registry cross-check (it belongs to the attest --check duty); single rule, single responsibility.
+    """
+    path = root / LEDGER_REL
+    if not path.is_file():
+        return []
+    try:
+        ledger = load_ledger(root)
+    except ValueError as exc:
+        return [("error", "V035", path, str(exc))]
+    out: list[tuple[str, str, Path, str]] = []
+    errors, _warnings = _integrity(root, ledger)
+    for msg in errors:
+        rel = msg.split(":", 1)[0]
+        out.append(("warn", "V036", root / rel, msg.split(":", 1)[1].strip()))
+    return out
+
+
+# ── CLI ───────────────────────────────────────────────────────────────
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.revise",
+        description="Revision loop: structured local patch + revision ledger + post-round integrity check (see references/13)",
+    )
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    ap_apply = sub.add_parser("apply", help="apply a patch file (atomic: all find hits must be unique)")
+    ap_apply.add_argument("patch", type=Path, help="patch YAML file (format in the module docstring)")
+    ap_apply.add_argument("--root", type=Path, default=None)
+    ap_apply.add_argument("--json", action="store_true")
+
+    ap_status = sub.add_parser("status", help="round table + ledger-chain integrity check (exit 1 on unlogged modification)")
+    ap_status.add_argument("--root", type=Path, default=None)
+    ap_status.add_argument("--json", action="store_true")
+
+    ap_close = sub.add_parser("close", help="after re-validation passes, close a round (revalidation_status=done)")
+    ap_close.add_argument("--round", required=True, help="round number, e.g. R4")
+    ap_close.add_argument("--note", default="", help="re-validation evidence, one line")
+    ap_close.add_argument("--root", type=Path, default=None)
+    ap_close.add_argument("--json", action="store_true")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+    try:
+        load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    as_json = getattr(args, "json", False)
+    if args.cmd == "apply":
+        return apply_patch(root, args.patch, as_json)
+    if args.cmd == "status":
+        return run_status(root, as_json)
+    if args.cmd == "close":
+        return run_close(root, args.round, args.note, as_json)
+    return 64
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
