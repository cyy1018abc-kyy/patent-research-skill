new file mode 100644
index 0000000..9fd0166
--- /dev/null
+++ b/patentkit/export.py
@@ -0,0 +1,220 @@
+"""Export the novelty-search report as a .docx deliverable (kernel 0.3.0).
+
+Why this module exists
+----------------------
+The comparison run, the gates and the candidate list already live in the workspace as data; the
+delivered report was retyped by hand from them, and every retyping is a chance to diverge from
+the evidence chain (a number that no longer matches the gates, a D-document listed without its
+evidence level). This module renders the **workspace state** into an editable Word document:
+zero hand-typed numbers, and the "⚠️ Unverified by tool checks" discipline travels with the file.
+
+python-docx is an **optional** dependency (``pip install patentkit[docx]``): the kernel stays
+light for clients that never export. Missing dependency → exit code 3 with the install hint,
+matching the skill scripts' convention.
+
+Everything the document states comes from the workspace: gates read from ``gates.compute_all``,
+column D from the candidates with their effective evidence level and assessment state. Where a
+section needs human judgment (three-tier conclusion), the document carries an explicit
+_(待人工填写)_ placeholder — it never invents a conclusion.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from datetime import datetime
+from pathlib import Path
+
+from . import gates as gates_mod
+from . import provenance as provenance_mod
+from . import runs as runs_mod
+from .assessment import state as assessment_state
+from .model import Role, load_candidates, load_logs
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+
+#: Optional-dependency exit code (same convention as the skill scripts)
+EXIT_MISSING_DEP = 3
+
+
+def _require_docx():
+    try:
+        import docx  # noqa: F401
+    except ImportError as exc:  # pragma: no cover - exercised via CLI in CI with the extra
+        print(
+            "[FATAL] python-docx is not installed — export-docx is an optional feature.\n"
+            "  fix: pip install \"patentkit[docx]\"  (or pip install python-docx)",
+            file=sys.stderr,
+        )
+        raise SystemExit(EXIT_MISSING_DEP) from exc
+    from docx import Document
+    from docx.shared import Pt
+    return Document, Pt
+
+
+def build_document(root: Path, target_id: str, term) -> "object":
+    """Build the report Document. Pure read of workspace state; no CLI coupling."""
+    Document, Pt = _require_docx()
+
+    report = gates_mod.compute_all(root, term, target_id)
+    cands = [c for c in load_candidates(root) if c.target == target_id]
+    logs = [log for log in load_logs(root) if log.target == target_id]
+    runs = runs_mod.load_runs(root)
+    inferred = runs_mod.infer_near_prior_ids(cands, runs)
+    d_list = sorted(
+        (c for c in cands if c.effective_role(inferred) is Role.NEAR_PRIOR_ART),
+        key=lambda c: c.id,
+    )
+
+    doc = Document()
+    style = doc.styles["Normal"]
+    style.font.name = "DengXian"
+    style.font.size = Pt(10.5)
+
+    # ── 封面 ──
+    title = term.targets.get(target_id)
+    doc.add_heading(f"专利查新检索报告（底稿）— {target_id}", level=0)
+    doc.add_paragraph(
+        f"目标：{target_id} — {title.title if title else '（标题见 workspace.yml）'}\n"
+        f"生成时间：{datetime.now().astimezone().isoformat(timespec='seconds')}\n"
+        f"生成工具：patentkit export-docx（数据全部读取自工作区，未经手工转写）"
+    )
+    note = doc.add_paragraph()
+    run = note.add_run(
+        "声明：本报告是检索与自检底稿，不构成法律意见，也不预测授权前景；"
+        "三层级判定与新颖性/创造性结论须由人工填写并复核。"
+    )
+    run.italic = True
+
+    # ── 1 检索概况 ──
+    doc.add_heading("一、检索概况", level=1)
+    by_level: dict[str, int] = {}
+    for c in cands:
+        lv = c.effective_level(root).value
+        by_level[lv] = by_level.get(lv, 0) + 1
+    doc.add_paragraph(
+        f"检索日志：{len(logs)} 条（live {sum(1 for l in logs if l.capture_mode.value == 'live')} / "
+        f"retrospective {sum(1 for l in logs if l.capture_mode.value != 'live')}）。\n"
+        f"候选文献：{len(cands)} 篇 — 证据分级 {by_level or '无'}。"
+        "hit 数是数据库全库命中面，不等于已采集文献数（见 SKILL 硬约束）。"
+    )
+
+    # ── 2 验收门 ──
+    doc.add_heading("二、验收门状态（G-S，以 verified 列为准）", level=1)
+    table = doc.add_table(rows=1, cols=4)
+    table.style = "Table Grid"
+    hdr = table.rows[0].cells
+    for i, h in enumerate(("门", "判据", "verified 列", "状态")):
+        hdr[i].text = h
+    for g in report.results:
+        row = table.add_row().cells
+        row[0].text = g.gate_id
+        row[1].text = g.threshold
+        row[2].text = str(g.values.get("verified", "-"))
+        row[3].text = g.status
+    doc.add_paragraph(
+        "门 FAIL 的含义是「检索尚不充分」，应补检索/补判定，而不是放宽阈值（硬约束 7）。"
+    )
+
+    # ── 3 D 列对比文献 ──
+    doc.add_heading("三、近似在先技术（D 列）", level=1)
+    if d_list:
+        t2 = doc.add_table(rows=1, cols=6)
+        t2.style = "Table Grid"
+        hdr = t2.rows[0].cells
+        for i, h in enumerate(("D", "文献号", "候选 ID", "证据分级", "判定状态", "novelty_check")):
+            hdr[i].text = h
+        for i, c in enumerate(d_list, start=1):
+            row = t2.add_row().cells
+            row[0].text = f"D{i}"
+            row[1].text = c.doc_number
+            row[2].text = c.id
+            row[3].text = c.effective_level(root).value
+            row[4].text = assessment_state(c, root)
+            row[5].text = c.novelty_check
+    else:
+        doc.add_paragraph("（暂无 role=near_prior_art 的候选）")
+    doc.add_paragraph(
+        "来源分级与判定相互独立：verified 只说明原文工件在工作区内，不保证判断正确；"
+        "G-S-03 只认可绑定当前指纹的人工确认。"
+    )
+
+    # ── 4 三层级判定（人工填写） ──
+    doc.add_heading("四、三层级判定（人工填写）", level=1)
+    for tier, prompt in (
+        ("4.1 单篇新颖性", "是否存在单篇 D 文献覆盖全部 N 轴特征？（成立/存疑/不成立 + 逐条理由）"),
+        ("4.2 结合创造性", "结合组、结合动机是否明确、有无反向教导？（成立/存疑/不成立 + 逐条理由）"),
+        ("4.3 技术效果", "有益效果、量化指标、是否由 D 列显而易见？（反驳成立/未成立）"),
+    ):
+        doc.add_heading(tier, level=2)
+        doc.add_paragraph(f"_{prompt}_")
+
+    # ── 5 数值溯源（若启用） ──
+    registry = provenance_mod.load_registry(root)
+    if registry and registry.get("entries"):
+        doc.add_heading("五、数值声明溯源（A/B/C）", level=1)
+        t3 = doc.add_table(rows=1, cols=3)
+        t3.style = "Table Grid"
+        hdr = t3.rows[0].cells
+        for i, h in enumerate(("编号", "数值声明", "来源分级")):
+            hdr[i].text = h
+        for entry in registry["entries"]:
+            row = t3.add_row().cells
+            grades = ", ".join(str(s.get("grade")) for s in entry.get("sources") or []) or "⚠️ 未溯源"
+            row[0].text = str(entry.get("id") or "")
+            row[1].text = str(entry.get("statement") or "")
+            row[2].text = grades
+
+    doc.add_heading("附：证据分级口径", level=1)
+    doc.add_paragraph(
+        "verified=raw 工件已归档于工作区；attested=外部哈希绑定材料；asserted=自述，无工件。"
+        "工具不可用时结论必须以「⚠️ 未经工具核验」开头。"
+    )
+    return doc
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit export-docx",
+        description="Render the workspace state into an editable .docx novelty-search report",
+    )
+    ap.add_argument("target_id", nargs="?", default=None, help="target ID, e.g. TGT-0001 (default: active)")
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--out", type=Path, default=None,
+                    help="output .docx (default: 04_comparative_analysis/<date>_<target>_report.docx)")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    target = args.target_id or term.active_target
+    if target not in term.targets:
+        print(f"[FATAL] target not registered in the glossary: {target}", file=sys.stderr)
+        return 2
+
+    doc = build_document(root, target, term)
+
+    out = args.out or (
+        root / "04_comparative_analysis"
+        / f"{datetime.now().astimezone().date().isoformat()}_{target}_report.docx"
+    )
+    out.parent.mkdir(parents=True, exist_ok=True)
+    doc.save(str(out))
+    print(f"[WRITE] {out}")
+    print("内容全部来自工作区数据；三层级判定与结论段落需人工填写后再交付")
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
diff --git a/b/patentkit/fetch_bigquery.py b/patentkit/fetch_bigquery.py
new file mode 100644
index 0000000..214c62a
--- /dev/null
+++ b/patentkit/fetch_bigquery.py
@@ -0,0 +1,331 @@
+"""BigQuery 同族/引证普查（G-S-04 专用）——数据源半成品预置。
+
+为什么是"半成品"
+----------------
+CNIPA epub 每查询 3 条的上限决定了同族/引证普查（G-S-04）只能靠全量数据源完成；
+`data-sources.md` 的决策是**条件接入**：出现真实检索任务时才启用，但脚本、SQL、
+归档与回填路径**今天就位**——真实任务来的当天只需注册 GCP 并 `--run`。
+本模块默认 **dry-run**：不联网、不写盘，只产出"任务就绪包"（文档清单 + SQL +
+费用预估模板）。联网部分受 `docs/data-sources.md` 接入契约约束（五条验收标准）。
+
+三种形态
+--------
+1. **dry-run（默认）**：列出 near_prior_art / family 候选的文献号与缺口（family 或
+   cited_by 为空数组/缺失），渲染普查 SQL 与费用模板，零写入。
+2. **`--run`**：需要 `google-cloud-bigquery` 与 GCP 凭据（`GOOGLE_APPLICATION_
+   CREDENTIALS`）。先以 dry-run 查询取 bytes_billed 出费用预估，确认后执行并把结果
+   落 `02_search_logs/raw/bigquery_<date>_GS04_<hits>.jsonl` + 同名 `.log.json`
+   （capture_mode=live、complete 如实声明）——契约第 1/2 条。
+3. **`--fill <raw> [--apply]`**：从**已归档**的普查工件回填候选的 family/cited_by
+   （按归一化文献号匹配，artifact 是唯一权威来源）；dry-run 默认，`--apply` 才写。
+
+诚实边界
+--------
+* SQL 基于 `patents-public-data.patents.publications` 的公开形态编写；BigQuery 公共
+  数据集 schema 会演进，**真实 `--run` 前必须对着当时的 schema 复核列名**（dry-run
+  输出里已标注）。
+* 费用按 Google Cloud 按量挂牌价模板估算（默认 $5/TB 量级），实际以官方价格页与
+  dry-run 查询返回的 bytes_billed 为准。
+* 本模块不构成"已接入"——只有 `--run` 在真实凭据下走过一遍并按契约登记
+  `docs/policy-log.md` 后，这个源才算接入。
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+from .model import Candidate, load_candidates
+from .paths import workspace_or_exit
+from .registry import Terminology, TerminologyError, load_registry
+from .runs import core_doc
+
+DB = "BQ"
+QID = "GS04"
+COST_PER_TB_USD = 5.0  # Google Cloud 按量挂牌价量级；实际以官方价格页为准
+
+SQL_TEMPLATE = """\
+-- G-S-04 census: INPADOC family + cited-by for the target's D-list/family docs.
+-- ⚠️ Skeleton SQL — re-validate column names against the CURRENT
+--    patents-public-data.patents.publications schema before a real --run.
+DECLARE docs ARRAY<STRING> DEFAULT @doc_numbers;
+
+SELECT
+  pub.publication_number,
+  pub.family_id,
+  ARRAY(
+    SELECT DISTINCT sibling.publication_number
+    FROM `patents-public-data.patents.publications` AS sibling
+    WHERE sibling.family_id = pub.family_id
+      AND sibling.publication_number != pub.publication_number
+  ) AS family_publications,
+  ARRAY(
+    SELECT DISTINCT c.publication_number
+    FROM `patents-public-data.patents.publications` AS citing,
+         UNNEST(citing.citation) AS c
+    WHERE c.publication_number = pub.publication_number
+  ) AS cited_by_publications
+FROM `patents-public-data.patents.publications` AS pub
+WHERE pub.publication_number IN UNNEST(docs);
+"""
+
+
+def _census_targets(cands: list[Candidate], root: Path, target: str) -> list[dict[str, Any]]:
+    """G-S-04 的普查对象：near_prior_art / family 角色、家族或引证有缺口的候选。"""
+    from . import runs as runs_mod
+    from .model import Role
+
+    run_index = runs_mod.load_runs(root)
+    inferred = runs_mod.infer_near_prior_ids(cands, run_index)
+    out = []
+    for c in sorted(cands, key=lambda c: c.id):
+        if c.target != target or not c.doc_number:
+            continue
+        if c.effective_role(inferred) not in (Role.NEAR_PRIOR_ART, Role.FAMILY):
+            continue
+        family, cited = c.family, c.cited_by
+        out.append({
+            "id": c.id,
+            "doc_number": c.doc_number,
+            "has_family": bool(family),
+            "has_cited_by": bool(cited),
+            "gap": not (family and cited),
+        })
+    return out
+
+
+def build_plan(root: Path, term: Terminology, target: str) -> dict[str, Any]:
+    cands = [c for c in load_candidates(root) if c.target == target]
+    docs = _census_targets(cands, root, target)
+    gaps = [d for d in docs if d["gap"]]
+    return {
+        "ok": True,
+        "mode": "dry-run",
+        "target": target,
+        "census_targets": docs,
+        "gap_count": len(gaps),
+        "doc_numbers": sorted({d["doc_number"] for d in docs}),
+        "sql": SQL_TEMPLATE,
+        "cost_template": {
+            "note": "实际费用 = bytes_billed × 单价；bytes_billed 只能由带凭据的 dry-run 查询返回",
+            "usd_per_tb": COST_PER_TB_USD,
+            "estimated_bytes_billed": "TBD（--run 时先跑 dry-run 查询取值）",
+        },
+        "archive_plan": {
+            "raw": f"02_search_logs/raw/bigquery_{_today()}_{QID}_<hits>.jsonl",
+            "log": f"02_search_logs/BQ_{_today()}_{QID}_<hits>.log.json",
+        },
+        "note": "默认 dry-run 零写入；--run 需 GCP 凭据；--fill 从已归档工件回填（见模块 docstring）",
+    }
+
+
+def _today() -> str:
+    return datetime.now().astimezone().date().isoformat()
+
+
+# ── --run：联网执行（需要库 + GCP 凭据；两者缺一给出可诊断错误） ────────
+
+
+def _archive(root: Path, target: str, actor: str, rows: list[dict[str, Any]],
+             complete: bool) -> tuple[Path, Path]:
+    """按接入契约落盘：raw JSONL + 同名 log（capture_mode=live，complete 如实声明）。"""
+    from .model import sha256_file  # noqa: F401  (keep import shape stable for patch review)
+
+    day = _today()
+    raw_rel = f"raw/bigquery_{day}_{QID}_{len(rows)}.jsonl"
+    log_rel = f"BQ_{day}_{QID}_{len(rows)}.log.json"
+    raw_path = root / "02_search_logs" / raw_rel
+    raw_path.parent.mkdir(parents=True, exist_ok=True)
+    raw_path.write_text(
+        "".join(json.dumps(r, ensure_ascii=False, sort_keys=True) + "\n" for r in rows),
+        encoding="utf-8", newline="\n")
+    log = {
+        "db": DB,
+        "target": target,
+        "actor": actor or "bigquery-census",
+        "capture_mode": "live",
+        "timestamp": datetime.now().astimezone().isoformat(timespec="seconds"),
+        "query": {
+            "id": QID,
+            "axis": "",
+            "text": "G-S-04 family/cited_by census (BigQuery patents-public-data)",
+        },
+        "result": {
+            "hit_count": len(rows),
+            "raw_export": raw_rel,
+            "complete": bool(complete),
+        },
+    }
+    log_path = root / "02_search_logs" / log_rel
+    log_path.write_text(json.dumps(log, ensure_ascii=False, indent=2) + "\n",
+                        encoding="utf-8", newline="\n")
+    return raw_path, log_path
+
+
+def run_census(root: Path, term: Terminology, target: str, actor: str,
+               assume_yes: bool = False) -> int:
+    try:
+        from google.cloud import bigquery
+    except ImportError:
+        print("[FATAL] google-cloud-bigquery 未安装：pip install google-cloud-bigquery",
+              file=sys.stderr)
+        return 2
+    if not os.environ.get("GOOGLE_APPLICATION_CREDENTIALS"):
+        print("[FATAL] 未设置 GOOGLE_APPLICATION_CREDENTIALS——接入契约要求凭据与配额"
+              "归真实任务管理，本工具不会静默用别人/别的项目的配额。"
+              "dry-run 计划可用 `fetch-bigquery`（默认）随时打印备案。", file=sys.stderr)
+        return 2
+
+    plan = build_plan(root, term, target)
+    docs = plan["doc_numbers"]
+    if not docs:
+        print("没有普查对象（near_prior_art / family 缺口为空）——先人工确认 D 列再普查")
+        return 0
+    sql = SQL_TEMPLATE.replace("@doc_numbers", f"@doc_numbers /* {', '.join(docs)} */")
+
+    client = bigquery.Client()
+    # 契约第 2 条：先 dry-run 查询拿 bytes_billed，出费用预估，经确认才真正执行。
+    dry = client.query(sql, job_config=bigquery.QueryJobConfig(dry_run=True, use_query_cache=False))
+    est_usd = dry.total_bytes_billed / 2**40 * COST_PER_TB_USD
+    print(f"dry-run bytes_billed: {dry.total_bytes_billed:,} B → 预估 ${est_usd:.2f}"
+          f"（按 ${COST_PER_TB_USD}/TB 挂牌价量级，实际以官方价格页为准）")
+    if not assume_yes:
+        answer = input(f"对 {len(docs)} 个文献号执行普查？(yes/no) ")
+        if answer.strip().lower() not in ("y", "yes"):
+            print("已取消；未执行、未写入")
+            return 1
+    rows = [dict(r) for r in client.query(sql, job_config=bigquery.QueryJobConfig(
+        query_parameters=[bigquery.ArrayQueryParameter("doc_numbers", "STRING", docs)]))]
+    complete = len(rows) == len(docs)
+    raw_path, log_path = _archive(root, target, actor, rows, complete)
+    print(f"[WRITE] {raw_path}（{len(rows)} 行，complete={complete}）")
+    print(f"[WRITE] {log_path}")
+    print("下一步：python -m patentkit fetch-bigquery --fill "
+          f"{raw_path.relative_to(root).as_posix()} --apply")
+    return 0
+
+
+# ── --fill：从已归档普查工件回填（离线、确定性、可测） ───────────────────
+
+
+def load_census_raw(path: Path) -> list[dict[str, Any]]:
+    rows: list[dict[str, Any]] = []
+    for i, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            row = json.loads(line)
+        except json.JSONDecodeError as exc:
+            raise ValueError(f"{path.name}:{i}: JSONL parse failed: {exc}")
+        for key in ("publication_number", "family_publications", "cited_by_publications"):
+            if key not in row:
+                raise ValueError(f"{path.name}:{i}: missing {key}")
+        if not isinstance(row["family_publications"], list) or not isinstance(row["cited_by_publications"], list):
+            raise ValueError(f"{path.name}:{i}: family/cited_by must be arrays（空数组=查过无命中，保留）")
+        rows.append(row)
+    return rows
+
+
+def fill_candidates(root: Path, raw_path: Path, apply: bool) -> int:
+    rows = load_census_raw(raw_path)
+    by_core: dict[str, dict[str, Any]] = {core_doc(r["publication_number"]): r for r in rows}
+    cands = load_candidates(root)
+    updated: list[str] = []
+    for c in cands:
+        row = by_core.get(core_doc(c.doc_number)) if c.doc_number else None
+        if row is None:
+            continue
+        if not c.family and row["family_publications"]:
+            c.data["family"] = sorted(row["family_publications"])
+            changed = True
+        else:
+            changed = False
+        if not c.cited_by and row["cited_by_publications"]:
+            c.data["cited_by"] = sorted(row["cited_by_publications"])
+            changed = True
+        if changed:
+            updated.append(f"{c.id}（family {len(c.data['family'])} / cited_by {len(c.data['cited_by'])}）")
+            if apply:
+                c.path.write_text(
+                    json.dumps(c.data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+    print(f"普查工件 : {raw_path.name}（{len(rows)} 行）")
+    if updated:
+        for u in updated:
+            print(f"  · 回填 {u}")
+    else:
+        print("  · 无可回填缺口（family/cited_by 已有值的候选不动——普查不覆盖人工数据）")
+    if not apply:
+        print("未写入。加 --apply 落盘（只补空缺，不覆盖已有值）")
+        return 0
+    print(f"已写入 {len(updated)} 个候选；来源即该 raw 工件（可独立复放，契约第 1 条）")
+    print("下一步：python -m patentkit check（V 系列会复核数组与目标一致性）")
+    return 0
+
+
+# ── CLI ───────────────────────────────────────────────────────────────
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.fetch_bigquery",
+        description="G-S-04 census skeleton via BigQuery public data (dry-run by default; "
+                    "see docs/data-sources.md 接入契约)",
+    )
+    ap.add_argument("--target", default=None, help="target ID (defaults to glossary active_target)")
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--run", action="store_true",
+                    help="run against BigQuery (requires google-cloud-bigquery + GCP credentials)")
+    ap.add_argument("--fill", type=Path, default=None, metavar="RAW",
+                    help="fill family/cited_by from an archived census .jsonl artifact")
+    ap.add_argument("--apply", action="store_true", help="with --fill: write candidates (dry-run by default)")
+    ap.add_argument("--actor", default="", help="actor recorded in the search log (--run)")
+    ap.add_argument("--json", action="store_true", help="dry-run plan as JSON")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+    target = args.target or term.active_target
+    if not target or target not in term.targets:
+        print(f"[FATAL] target not registered or no active target: {target}", file=sys.stderr)
+        return 2
+
+    if args.fill:
+        return fill_candidates(root, args.fill, args.apply)
+    if args.run:
+        return run_census(root, term, target, args.actor)
+
+    plan = build_plan(root, term, target)
+    if args.json:
+        print(json.dumps(plan, ensure_ascii=False, indent=2))
+        return 0
+    print(f"G-S-04 普查计划 — {target}（dry-run，零写入）")
+    print(f"普查对象 : {len(plan['census_targets'])}（有缺口 {plan['gap_count']}）")
+    for d in plan["census_targets"]:
+        mark = "⚠ 缺口" if d["gap"] else "完整"
+        print(f"  {d['id']:<8}{d['doc_number']:<20}{mark}"
+              f"（family {'有' if d['has_family'] else '无'} / cited_by {'有' if d['has_cited_by'] else '无'}）")
+    print(f"\nSQL（真实 --run 前必须对照当时 schema 复核）：\n{plan['sql']}")
+    print(f"费用模板 : {plan['cost_template']}")
+    print(f"归档计划 : {plan['archive_plan']}")
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    sys.exit(main())
