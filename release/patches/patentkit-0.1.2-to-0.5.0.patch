index 0000000..7d6c263
--- /dev/null
+++ b/tests/test_new_features.py
@@ -0,0 +1,250 @@
+"""New-in-0.3.0 modules: provenance / figures / export-docx / deadlines / map / layout / ledger.
+
+Each test pins the safety property the module was built for, not just shape:
+provenance fails closed on unsourced numbers, figure marks only warn, conclusions cannot cite
+invented evidence, the docx carries the workspace numbers verbatim, deadlines refuse to compute
+without a base date, map/layout/ledger are read-only views.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from datetime import date
+from pathlib import Path
+
+import pytest
+import yaml
+
+from patentkit import deadlines, figures, layout, ledger, map as map_mod, provenance
+from patentkit import validate as validate_mod
+
+
+# ── provenance ────────────────────────────────────────────────────────
+
+
+def test_scan_finds_units_ranges_and_cjk_counts():
+    text = (
+        "电解槽的工作温度为 80-95℃。\n"
+        "分离效率达到 99.2% 以上；该膜厚度为 3 mm。\n"
+        "步骤3重复至少两次。\n"
+        "如图1所示。"
+    )
+    got = provenance.scan_text(text)
+    joined = " | ".join(got)
+    assert any("80-95" in s for s in got)
+    assert any("99.2%" in s for s in got)
+    assert any("3 mm" in s for s in got)
+    assert any("至少两" in s for s in got)
+    assert "如图1" not in joined  # 图N 不是数值声明
+    assert len(set(got)) == len(got)
+
+
+def test_scan_skeleton_is_fail_closed(repo):
+    sk = provenance.build_skeleton(provenance.scan_text("温度为 50-90%。"), "claims.md")
+    assert sk["entries"][0]["sources"] == []
+    assert sk["entries"][0]["id"] == "NUM-001"
+
+
+def test_provenance_check_grades(repo, tmp_path):
+    data = repo.root / "00_methodology" / "experiment_notes.md"
+    data.write_text("实测效率 92.4%，见第 3 行。\n实测效率 92.4%\n", encoding="utf-8")
+
+    good = {
+        "entries": [
+            {"id": "NUM-001", "statement": "效率为 92.4%", "claim_ref": "claim 1",
+             "sources": [
+                 {"grade": "A", "ref": "00_methodology/experiment_notes.md", "locator": "L2"},
+                 {"grade": "B", "ref": "P-001", "locator": "abstract, parametric range"},
+             ]},
+            {"id": "NUM-002", "statement": "示例厚度 5 mm", "claim_ref": "spec [0031]",
+             "sources": [{"grade": "C", "ref": "embodiment-2", "locator": "para 0031",
+                          "note": "实施例示例值，非实测"}]},
+        ]
+    }
+    (repo.root / "07_drafting").mkdir(exist_ok=True)
+    (repo.root / provenance.REGISTRY_REL).write_text(
+        yaml.safe_dump(good, allow_unicode=True), encoding="utf-8"
+    )
+    assert provenance.check_registry(repo.root, good) == []
+
+    bad = json.loads(json.dumps(good))  # deep copy
+    bad["entries"][0]["sources"] = []                                   # V031
+    bad["entries"][1]["sources"] = [{"grade": "B", "ref": "P-999", "locator": "x"}]  # V032 unknown candidate
+    problems = provenance.check_registry(repo.root, bad)
+    codes = {c for c, _ in problems}
+    assert "V031" in codes and "V032" in codes
+
+
+def test_validate_integrates_provenance_rules(repo):
+    (repo.root / "07_drafting").mkdir(exist_ok=True)
+    registry = {"entries": [{"id": "NUM-001", "statement": "温度 50-90%", "sources": []}]}
+    (repo.root / provenance.REGISTRY_REL).write_text(
+        yaml.safe_dump(registry, allow_unicode=True), encoding="utf-8"
+    )
+    codes = {f.code for f in repo.validate()}
+    assert "V031" in codes
+
+    (repo.root / provenance.REGISTRY_REL).unlink()
+    assert "V031" not in {f.code for f in repo.validate()}  # opt-in: no registry, no rule
+
+
+# ── figures ───────────────────────────────────────────────────────────
+
+
+def _write_spec(repo, parts, name="FIG-1"):
+    d = repo.root / figures.FIGURES_DIR
+    d.mkdir(parents=True, exist_ok=True)
+    spec = {"figure": name, "title": "系统框图", "parts": parts, "connections": []}
+    (d / f"{name}.figure.yml").write_text(yaml.safe_dump(spec, allow_unicode=True), encoding="utf-8")
+    return spec
+
+
+def test_figure_marks_bidirectional_check(repo):
+    (repo.root / "07_drafting").mkdir(exist_ok=True)
+    ms = repo.root / "07_drafting" / "spec.md"
+    ms.write_text("电解槽10 与分离器20 相连；膜组件31 设于槽内。\n", encoding="utf-8")
+
+    _write_spec(repo, [{"id": "10", "name": "电解槽"}, {"id": "20", "name": "分离器"},
+                       {"id": "31", "name": "膜组件"}])
+    assert figures.check_marks(repo.root) == []
+
+    _write_spec(repo, [{"id": "10", "name": "电解槽"}, {"id": "20", "name": "分离器"},
+                       {"id": "99", "name": "不存在于正文的部件"}])  # 31 在正文却不在 spec；99 在 spec 不在正文
+    problems = figures.check_marks(repo.root)
+    assert problems and all(p["code"] == "V033" for p in problems)
+    joined = json.dumps(problems, ensure_ascii=False)
+    assert "99" in joined and "31" in joined
+
+
+def test_validate_reports_v033_as_warning_only(repo):
+    (repo.root / "07_drafting").mkdir(exist_ok=True)
+    (repo.root / "07_drafting" / "spec.md").write_text("电解槽10。\n", encoding="utf-8")
+    _write_spec(repo, [{"id": "10", "name": "电解槽"}, {"id": "55", "name": "未提及"}])
+    findings = [f for f in repo.validate() if f.code == "V033"]
+    assert findings and findings[0].level == "warn"
+
+
+def test_figures_render_svg_is_deterministic_and_offline(repo):
+    _write_spec(repo, [{"id": "10", "name": "电解槽"}, {"id": "20", "name": "分离器"}])
+    _write_spec(repo, [{"id": "10", "name": "电解槽"}, {"id": "20", "name": "分离器"}], name="FIG-2")
+    spec = figures.load_specs(repo.root)["FIG-1"]
+    svg1, svg2 = figures.render_svg(spec), figures.render_svg(spec)
+    assert svg1 == svg2
+    assert svg1.startswith("<svg") and "http" not in svg1.replace(
+        "http://www.w3.org/2000/svg", "")  # 只有命名空间，无外链
+
+
+# ── evidence ledger + V034 ────────────────────────────────────────────
+
+
+def test_ledger_rows_and_render(repo):
+    from conftest import assessed_candidate
+    from patentkit import assessment as assessment_mod
+    from patentkit.model import Candidate
+
+    data = assessed_candidate(repo, role="near_prior_art")
+    cand = Candidate(data, repo.candidate_path(data["id"]))
+    fp = assessment_mod.fingerprint(cand, repo.root)
+    assessment_mod.confirm_batch(repo.root, [{"candidate_id": "P-001", "expected_fingerprint": fp}],
+                                 by="human-reviewer", apply=True)
+
+    rows = ledger.build_entries(repo.root, None, "TGT-0000")
+    row = next(r for r in rows if r["id"] == "P-001")
+    assert row["role"] == "near_prior_art"
+    assert row["human_confirmed"] is True
+    assert "P-001" in ledger.render(rows, "TGT-0000")
+
+
+def test_v034_rejects_conclusions_citing_unknown_evidence(repo):
+    concl = repo.root / "05_novelty_conclusions" / "novelty.md"
+    concl.write_text("结论：P-907 披露了 N1 轴的全部特征。\n", encoding="utf-8")
+    findings = [f for f in repo.validate() if f.code == "V034"]
+    assert findings and "P-907" in findings[0].message
+
+    concl.write_text("结论：P-001 相关性有限。\n", encoding="utf-8")
+    assert "V034" not in {f.code for f in repo.validate()}
+
+
+# ── export-docx ───────────────────────────────────────────────────────
+
+
+def test_export_docx_carries_workspace_numbers(repo, tmp_path):
+    docx = pytest.importorskip("docx")
+    from patentkit import export as export_mod
+
+    out = tmp_path / "report.docx"
+    assert export_mod.main(["TGT-0000", "--root", str(repo.root), "--out", str(out)]) == 0
+    document = docx.Document(str(out))
+    text = "\n".join(p.text for p in document.paragraphs) + "\n" + "\n".join(
+        c.text for t in document.tables for r in t.rows for c in r.cells
+    )
+    assert "TGT-0000" in text
+    assert "G-S-01" in text and "G-S-05" in text
+    assert "US 1234567 B2" not in text  # P-001 是 pool，不出现在 D 列
+    assert "不构成法律意见" in text  # 边界声明随文件走
+    gates_row = [c.text for t in document.tables for r in t.rows for c in r.cells]
+    assert any("0P / 0L" in c for c in gates_row)  # verified 列原样转写（P-001 是 asserted）
+
+
+# ── deadlines ─────────────────────────────────────────────────────────
+
+
+def test_deadlines_compute_and_fail_closed(repo):
+    ledger_path = repo.root / deadlines.LEDGER_REL
+    ledger_path.parent.mkdir(parents=True, exist_ok=True)
+    ledger_path.write_text(yaml.safe_dump({
+        "entries": [
+            {"id": "DL-001", "target": "TGT-0000", "type": "application_fee",
+             "base_date": "2026-10-01", "done": False},
+            {"id": "DL-002", "target": "TGT-0000", "type": "oa_response",
+             "base_date": "2026-01-01", "done": False},
+            {"id": "DL-003", "target": "TGT-0000", "type": "custom",
+             "base_date": "", "done": False},  # 缺 base_date → incomplete
+            {"id": "DL-004", "target": "TGT-0000", "type": "custom",
+             "base_date": "2026-11-05", "months": 0, "done": False},  # 当日到期 → due-soon
+        ]
+    }, allow_unicode=True), encoding="utf-8")
+
+    rows = deadlines.evaluate(repo.root, today=date(2026, 10, 25))
+    by_id = {r["id"]: r for r in rows}
+    assert by_id["DL-001"]["due"] == "2026-12-01"     # 申请日+2个月
+    assert by_id["DL-001"]["status"] == "ok"          # 还有 37 天
+    assert by_id["DL-002"]["status"] == "overdue"     # 2026-05-01 已过
+    assert by_id["DL-003"]["status"] == "incomplete"  # 拒绝无依据计算
+    assert by_id["DL-004"]["status"] == "due-soon"    # 2026-11-05，14 天窗口内
+    assert deadlines.main(["check", "--root", str(repo.root)]) == 1
+
+    by_id["DL-002"]["done"] = True  # 已办理不再报警：重新落盘验证
+    entries = yaml.safe_load(ledger_path.read_text(encoding="utf-8"))
+    entries["entries"][1]["done"] = True
+    ledger_path.write_text(yaml.safe_dump(entries, allow_unicode=True), encoding="utf-8")
+    rows2 = deadlines.evaluate(repo.root, today=date(2026, 10, 25))
+    assert {r["id"] for r in rows2} == {"DL-001", "DL-003", "DL-004"}
+
+
+def test_add_months_clamps_to_month_end():
+    assert deadlines.add_months(date(2026, 1, 31), 1) == date(2026, 2, 28)
+    assert deadlines.add_months(date(2026, 10, 15), 36) == date(2029, 10, 15)
+
+
+# ── map / layout: read-only views ─────────────────────────────────────
+
+
+def test_map_html_is_self_contained(repo, tmp_path):
+    out = tmp_path / "m.html"
+    assert map_mod.main(["TGT-0000", "--root", str(repo.root), "--out", str(out)]) == 0
+    html = out.read_text(encoding="utf-8")
+    assert html.startswith("<html") or "<html" in html
+    assert "G-S-01" in html
+    for banned in ("http://", "https://", "<script"):
+        assert banned not in html, banned  # 离线、无脚本
+
+
+def test_layout_overview_and_thin_data_refusal(repo):
+    payload = layout.collect(repo.root, __import__("patentkit.registry", fromlist=["load_registry"]).load_registry(repo.root))
+    ids = [r["target"] for r in payload]
+    assert set(ids) == {"TGT-0000", "TGT-0001"}
+    assert "暂不建议指定主件" in layout.suggest_primary(payload)  # verified=0 → 拒绝排名
+    text = layout.render(payload)
+    assert "TGT-0000" in text and "空轴" in text
