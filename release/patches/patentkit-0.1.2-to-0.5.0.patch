+            cls = "" if r["status"] == "done" else " class='warn'"
+            parts.append(
+                f"<tr><td>{_esc(r['round'])}</td><td>{_esc(r['issue'])}</td>"
+                f"<td>{_esc(r['changes'])}</td><td{cls}>{_esc(r['status'])}</td></tr>"
+            )
