+# ── Candidate and run overview ────────────────────────────────────────
+
+
+def candidates(
+    ws: str | Path | None = None,
+    target: str | None = None,
+    min_relevance: int = 0,
+    limit: int = 50,
+) -> dict[str, Any]:
+    """List candidates (filterable by target and minimum relevance)."""
+    root = workspace(ws)
+    term = load_registry(root)
+    target = target or term.active_target
+
+    items = []
+    for c in load_candidates(root):
+        if target and c.target != target:
+            continue
+        rel = c.data.get("relevance") or 0
+        if rel < min_relevance:
+            continue
+        items.append(
+            {
+                "id": c.id,
+                "title": c.title,
+                "doc_number": c.doc_number,
+                "year": c.data.get("year"),
+                "target": c.target,
+                "tags": c.tags,
+                "relevance": rel,
+                "role": c.data.get("role"),
+                "novelty_check": c.data.get("novelty_check"),
+                "evidence_level": c.effective_level(root).value,
+                "assessment_state": assessment_mod.state(c, root),
+                "assessment_fingerprint": assessment_mod.fingerprint(c, root),
+                "assessment": c.data.get("assessment"),
+                "human_confirmation": c.data.get("human_confirmation"),
+                "path": c.path.relative_to(root).as_posix(),
+            }
+        )
+
+    items.sort(key=lambda x: (-x["relevance"], x["id"]))
+    total = len(items)
+    return {
+        "workspace": str(root),
+        "target": target,
+        "total_matching": total,
+        "returned": min(total, limit),
+        "items": items[:limit],
+    }
+
+
+def runs(ws: str | Path | None = None) -> dict[str, Any]:
+    """List the comparison records under 04_comparative_analysis/runs/, and the candidates they determined or mentioned."""
+    root = workspace(ws)
+    index = runs_mod.load_runs(root)
+    return {
+        "workspace": str(root),
+        "count": len(index.files),
+        "files": [p.relative_to(root).as_posix() for p in index.files],
+        "mentioned_candidate_ids": sorted(index.ids),
+        "mentioned_doc_numbers": sorted(index.doc_numbers),
+    }
