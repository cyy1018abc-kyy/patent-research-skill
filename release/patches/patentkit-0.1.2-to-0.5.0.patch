+"""Figure marks: bidirectional consistency between figure specs and the manuscript.
+
+Why this module exists
+----------------------
+Chinese patent figures are black-white line drawings whose parts carry numeric reference signs
+(10, 20, 31…). Two failure modes recur in practice:
+
+1. the specification mentions mark **32** but the figure only has 30 and 31 — the examiner
+   objects under 细则 (clarity); and
+2. a part drawn in the figure is never described — the reader cannot map drawing to text.
+
+Both are mechanical bookkeeping, exactly what a tool should pin down. The **verifiable** direction
+is: every mark in a figure spec must appear in the manuscript, and every reference-sign-like
+number attached to a component name in the manuscript must exist in the spec of the figure the
+manuscript cites. Text heuristics are honest about being heuristics: mismatches surface as
+**warnings (V033)**, never errors, because only a human knows whether "步骤3" is a step number
+or a part mark.
+
+Drawing: ``figures draw`` renders a spec to a standalone **SVG** block diagram (boxes, arrows,
+reference signs). SVG is vector, dependency-free, and convertible to the 300-DPI black-white
+raster that cponline upload requires; regenerating a JPEG here would pull matplotlib into the
+kernel for no added fidelity.
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import sys
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from .paths import workspace_or_exit
+
+#: Figure specs live here: 07_drafting/figures/*.figure.yml
+FIGURES_DIR = Path("07_drafting") / "figures"
+
+#: Manuscript files scanned for marks (order-independent)
+MANUSCRIPT_GLOBS = ("07_drafting/*.md", "07_drafting/*.txt")
+
+#: A reference sign in text: a component name (CJK run) immediately followed by its number,
+#: e.g. "电解槽10"、"分离器20". Plain bare numbers ("步骤3", "图1") are deliberately NOT matched.
+_TEXT_MARK = re.compile(r"[\u4e00-\u9fff]{1,12}(\d{1,3})(?![0-9A-Za-z%.])")
+
+#: Figure self-reference like "图1" is not a part mark
+_NOISE = re.compile(r"^图\d+$")
+
+
+def load_specs(root: Path) -> dict[str, dict[str, Any]]:
+    """Load every *.figure.yml under 07_drafting/figures/, keyed by figure id."""
+    out: dict[str, dict[str, Any]] = {}
+    d = root / FIGURES_DIR
+    if not d.is_dir():
+        return out
+    for p in sorted(d.glob("*.figure.yml")):
+        try:
+            data = yaml.safe_load(p.read_text(encoding="utf-8"))
+        except yaml.YAMLError:
+            continue
+        if isinstance(data, dict) and data.get("figure"):
+            out[str(data["figure"])] = data
+    return out
+
+
+def manuscript_text(root: Path) -> str:
+    chunks: list[str] = []
+    for pattern in MANUSCRIPT_GLOBS:
+        for p in sorted((root / pattern.split("/")[0]).glob(pattern.split("/", 1)[1])):
+            if p.is_file():
+                try:
+                    chunks.append(p.read_text(encoding="utf-8"))
+                except OSError:
+                    continue
+    return "\n".join(chunks)
+
+
+def spec_marks(spec: dict[str, Any]) -> set[str]:
+    """Reference signs declared by the spec (parts[].id)."""
+    marks: set[str] = set()
+    for part in spec.get("parts") or []:
+        if isinstance(part, dict) and part.get("id") is not None:
+            marks.add(str(part["id"]))
+    return marks
+
+
+def text_marks(text: str) -> set[str]:
+    """Reference-sign-like numbers found in the manuscript (heuristic; CJK-anchored)."""
+    out: set[str] = set()
+    for m in _TEXT_MARK.finditer(text):
+        token = m.group(1)
+        if not _NOISE.match(token):
+            out.add(token)
+    return out
+
+
+def check_marks(root: Path) -> list[dict[str, Any]]:
+    """Bidirectional mark check. Each finding is a dict (warn-level by contract)."""
+    specs = load_specs(root)
+    text = manuscript_text(root)
+    found: list[dict[str, Any]] = []
+
+    if not specs:
+        return found
+
+    declared_all: set[str] = set()
+    for fig, spec in sorted(specs.items()):
+        marks = spec_marks(spec)
+        declared_all |= marks
+        missing_in_text = sorted(m for m in marks if not re.search(rf"(?<![0-9]){re.escape(m)}(?![0-9])", text))
+        if missing_in_text:
+            found.append({
+                "code": "V033",
+                "figure": fig,
+                "problem": "marks declared in the figure but never appearing in the manuscript",
+                "marks": missing_in_text,
+            })
+
+    in_text_only = sorted(text_marks(text) - declared_all)
+    if in_text_only:
+        found.append({
+            "code": "V033",
+            "figure": "*",
+            "problem": "component-like marks in the manuscript not declared by any figure spec",
+            "marks": in_text_only,
+        })
+    return found
+
+
+# ── SVG block diagram ────────────────────────────────────────────────
+
+_BOX_W, _BOX_H, _GAP_X, _GAP_Y = 180, 56, 60, 70
+
+
+def _esc(s: str) -> str:
+    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
+
+
+def render_svg(spec: dict[str, Any]) -> str:
+    """Render a spec to a black-white SVG block diagram.
+
+    Layout: parts flow left→right in rows of three; connections draw straight arrows between
+    part centers with their labels. Deterministic — same spec, same bytes.
+    """
+    parts = [p for p in (spec.get("parts") or []) if isinstance(p, dict)]
+    per_row = 3
+    rows = (len(parts) + per_row - 1) // per_row if parts else 1
+    width = per_row * (_BOX_W + _GAP_X) + _GAP_X
+    height = rows * (_BOX_H + _GAP_Y) + _GAP_Y + 40
+
+    centers: dict[str, tuple[float, float]] = {}
+    body: list[str] = []
+    for i, part in enumerate(parts):
+        r, c = divmod(i, per_row)
+        x = _GAP_X + c * (_BOX_W + _GAP_X)
+        y = _GAP_Y + r * (_BOX_H + _GAP_Y)
+        cx, cy = x + _BOX_W / 2, y + _BOX_H / 2
+        pid = str(part.get("id") or "")
+        centers[pid] = (cx, cy)
+        body.append(
+            f'<rect x="{x}" y="{y}" width="{_BOX_W}" height="{_BOX_H}" fill="white" stroke="black" stroke-width="2"/>'
+        )
+        label = _esc(str(part.get("name") or pid))
+        body.append(
+            f'<text x="{cx}" y="{cy - 4}" text-anchor="middle" font-family="sans-serif" font-size="14" fill="black">{label}</text>'
+        )
+        if pid:
+            body.append(
+                f'<text x="{cx}" y="{cy + 16}" text-anchor="middle" font-family="sans-serif" font-size="13" fill="black">{_esc(pid)}</text>'
+            )
+
+    for conn in spec.get("connections") or []:
+        if not isinstance(conn, dict):
+            continue
+        a, b = str(conn.get("from") or ""), str(conn.get("to") or "")
+        if a not in centers or b not in centers:
+            continue
+        x1, y1 = centers[a]
+        x2, y2 = centers[b]
+        body.append(
+            f'<line x1="{x1}" y1="{y1}" x2="{x2}" y2="{y2}" stroke="black" stroke-width="2"/>'
+        )
+        body.append(
+            f'<polygon points="{x2},{y2} {x2 - 8},{y2 - 5} {x2 - 8},{y2 + 5}" fill="black" transform="rotate({0} {x2} {y2})"/>'
+        )
+        if conn.get("label"):
+            mx, my = (x1 + x2) / 2, (y1 + y2) / 2 - 6
+            body.append(
+                f'<text x="{mx}" y="{my}" text-anchor="middle" font-family="sans-serif" font-size="12" fill="black">{_esc(str(conn["label"]))}</text>'
+            )
+
+    title = _esc(str(spec.get("title") or spec.get("figure") or ""))
+    head = (
+        f'<text x="{width / 2}" y="28" text-anchor="middle" font-family="sans-serif" '
+        f'font-size="16" font-weight="bold" fill="black">{title}</text>'
+    )
+    return (
+        f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" '
+        f'viewBox="0 0 {width} {height}">\n'
+        '<rect width="100%" height="100%" fill="white"/>\n' + head + "\n" + "\n".join(body) + "\n</svg>\n"
+    )
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit.figures",
+        description="Figure mark consistency (V033) and SVG block-diagram rendering",
+    )
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    check = sub.add_parser("check", help="bidirectional mark check across figure specs and manuscripts")
+    check.add_argument("--root", type=Path, default=None)
+
+    draw = sub.add_parser("draw", help="render one figure spec to a standalone SVG")
+    draw.add_argument("figure", help="figure id, e.g. FIG-1 (must exist in 07_drafting/figures/)")
+    draw.add_argument("--root", type=Path, default=None)
+    draw.add_argument("--out", type=Path, default=None, help="output .svg (default: beside the spec)")
+
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+
+    if args.cmd == "check":
+        root = (args.root or workspace_or_exit()).resolve()
+        findings = check_marks(root)
+        if not findings:
+            print("✅ no figure specs, or every declared mark appears in the manuscript")
+            return 0
+        for f in findings:
+            marks = ", ".join(f["marks"])
+            print(f"[{f['code']}] {f['figure']}: {f['problem']}: {marks}")
+        print("\nmark mismatches are warnings — confirm with the figure before editing; "
+              "the rule never auto-deletes a mark")
+        return 1
+
+    root = (args.root or workspace_or_exit()).resolve()
+    specs = load_specs(root)
+    spec = specs.get(args.figure)
+    if spec is None:
+        print(f"[FATAL] figure spec not found: {args.figure} (available: {sorted(specs) or 'none'})",
+              file=sys.stderr)
+        return 2
+    svg = render_svg(spec)
+    out = args.out or (root / FIGURES_DIR / f"{args.figure}.svg")
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(svg, encoding="utf-8")
+    print(f"[WRITE] {out}")
+    print("SVG is vector and offline; convert to the 300-DPI black-white raster required by "
+          "cponline at submission time (e.g. any local converter) — the kernel stays dependency-free")
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
