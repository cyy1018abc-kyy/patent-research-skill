@@ -0,0 +1,353 @@
+"""来源与判断分离的独立行为回归，不依赖发布包遗漏的上游 conftest。"""
+
+import copy
+import json
+from pathlib import Path
+
+import pytest
+
+from patentkit import api
+from patentkit.init import init_workspace
+from patentkit.model import load_candidates
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+@pytest.fixture
+def ws(tmp_path):
+    root = tmp_path / "workspace"
+    init_workspace(root, "TGT-0002", "合成燃料电池测试")
+    raw = root / "02_search_logs/raw/source.json"
+    abstract = "解决阴极供氧滞后问题。采用负载前馈与流量反馈控制。"
+    write_json(raw, {"author": "示例作者", "abstract": abstract,
+                     "hits": [{"pub_number": "SYNTHETIC-900", "title": "合成供氧控制文献", "abstract": abstract}]})
+    log = root / "02_search_logs/cnipa_2026-01-01_N1-1_1.log.json"
+    write_json(log, {
+        "target": "TGT-0002", "db": "cnipa", "actor": "synthetic-test",
+        "capture_mode": "live", "query": {"id": "N1@TGT-0002", "axis": "N1"},
+        "result": {"hit_count": 1, "raw_export": "raw/source.json", "complete": True},
+        "timestamp": "2026-01-01T00:00:00+08:00",
+    })
+    data = {
+        "id": "P-900", "kind": "patent", "title": "合成供氧控制文献",
+        "authors_or_applicants": ["示例作者"], "year": 2026, "source_db": "CNIPA",
+        "url_or_doc_number": "SYNTHETIC-900", "relevance": 4,
+        "relevance_problem": 4, "relevance_means": 4,
+        "novelty_check": "partial", "tags": ["N1@TGT-0002"],
+        "logged_at": "2026-01-01T00:00:00+08:00",
+        "source_log": "../02_search_logs/cnipa_2026-01-01_N1-1_1.log.json",
+        "evidence_level": "verified", "evidence_ref": "../02_search_logs/raw/source.json",
+        "role": "near_prior_art", "target": "TGT-0002", "review_note": "旧记录缺少判定身份",
+        "family": [], "cited_by": [], "bibtex_key": "synthetic900",
+    }
+    write_json(root / "03_candidates/P-900.json", data)
+    (root / "06_citation_management/synthetic.bib").write_text("@misc{synthetic900,\n title={Synthetic test only}\n}\n", encoding="utf-8")
+    return root
+
+
+def candidate(root):
+    return load_candidates(root)[0]
+
+
+def gates(root):
+    return {g["gate_id"]: g for g in api.gates(root)["gates"]}
+
+
+def row(root, **changes):
+    from patentkit import assessment as a
+    cite = {"ref": "02_search_logs/raw/source.json", "locator": "/abstract"}
+    value = {
+        "candidate_id": "P-900", "expected_fingerprint": a.fingerprint(candidate(root), root),
+        "relevance_problem": 4, "relevance_means": 4, "role": "near_prior_art",
+        "novelty_check": "partial", "review_note": "同为阴极供氧动态响应问题，主要手段为前馈反馈控制。",
+        "basis": {"N1@TGT-0002": {
+            "problem": {**cite, "quote": "解决阴极供氧滞后问题", "rationale": "技术问题相同"},
+            "means": {**cite, "quote": "采用负载前馈与流量反馈控制", "rationale": "主要控制手段相同"},
+        }},
+    }
+    value.update(changes)
+    return value
+
+
+def assess(root, actor="ai", **changes):
+    from patentkit import assessment as a
+    return a.assess_batch(root, [row(root, **changes)], actor=actor, by="测试判定者", apply=True)
+
+
+def confirm(root):
+    from patentkit import assessment as a
+    return a.confirm_batch(root, [{"candidate_id": "P-900", "expected_fingerprint": a.fingerprint(candidate(root), root)}], by="测试复核人", apply=True)
+
+
+def test_legacy_role_and_scores_do_not_imply_review(ws):
+    assert gates(ws)["G-S-01"]["values"]["verified"] == "1P / 0L"
+    assert gates(ws)["G-S-02"]["values"]["verified"] == "min axis 0"
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "0 docs"
+
+
+def test_grounded_ai_counts_axis_but_not_near_prior_art(ws):
+    assess(ws)
+    report = api.gates(ws)
+    assert report["per_axis"]["N1"]["verified"] == 1
+    assert report["per_axis"]["N2"]["verified"] == 0
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "0 docs"
+    assert candidate(ws).data["evidence_level"] == "verified"
+
+
+def test_human_confirmation_enables_gs03(ws):
+    assess(ws)
+    confirm(ws)
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "1 docs"
+    assert candidate(ws).data["human_confirmation"]["by"] == "测试复核人"
+
+
+@pytest.mark.parametrize("field,value", [("relevance_means", 2), ("review_note", "新的判定理由"), ("role", "pool"), ("tags", ["N2@TGT-0002"])])
+def test_substantive_edit_invalidates_confirmation(ws, field, value):
+    assess(ws)
+    confirm(ws)
+    c = candidate(ws)
+    c.data[field] = value
+    write_json(c.path, c.data)
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "0 docs"
+    assert candidate(ws).data["human_confirmation"]
+
+
+def test_supporting_passage_change_invalidates_confirmation(ws):
+    assess(ws)
+    confirm(ws)
+    p = ws / "02_search_logs/raw/source.json"
+    data = json.loads(p.read_text(encoding="utf-8"))
+    data["abstract"] += "具体适用条件发生变化。"
+    write_json(p, data)
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "0 docs"
+
+
+def test_unrelated_metadata_edit_keeps_confirmation(ws):
+    assess(ws)
+    confirm(ws)
+    c = candidate(ws)
+    c.data["authors_or_applicants"] = ["修正作者拼写"]
+    write_json(c.path, c.data)
+    p = ws / "02_search_logs/raw/source.json"
+    data = json.loads(p.read_text(encoding="utf-8"))
+    data["author"] = "修正作者拼写"
+    write_json(p, data)
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "1 docs"
+
+
+def test_ai_cannot_overwrite_human_exclusion(ws):
+    assess(ws, actor="human", relevance_problem=2, relevance_means=2, role="excluded")
+    assess(ws)
+    c = candidate(ws)
+    assert c.data["relevance"] == 2
+    assert c.data["role"] == "excluded"
+    assert len(c.data["assessment_proposals"]) == 1
+
+
+def test_ai_cannot_overwrite_confirmed_ai_decision(ws):
+    assess(ws)
+    confirm(ws)
+    assess(ws, relevance_problem=5, relevance_means=5)
+    assert candidate(ws).data["relevance"] == 4
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "1 docs"
+
+
+@pytest.mark.parametrize("mutation", ["missing_means", "invented_quote", "outside_workspace", "unknown_axis", "missing_score"])
+def test_bad_assessment_does_not_write(ws, mutation):
+    from patentkit import assessment as a
+    r = row(ws)
+    if mutation == "missing_means":
+        del r["basis"]["N1@TGT-0002"]["means"]
+    elif mutation == "invented_quote":
+        r["basis"]["N1@TGT-0002"]["means"]["quote"] = "虚构的控制手段"
+    elif mutation == "outside_workspace":
+        r["basis"]["N1@TGT-0002"]["means"]["ref"] = "../secret.txt"
+    elif mutation == "unknown_axis":
+        r["basis"]["N9@TGT-0002"] = r["basis"].pop("N1@TGT-0002")
+    else:
+        del r["relevance_means"]
+    before = candidate(ws).path.read_bytes()
+    with pytest.raises(ValueError):
+        a.assess_batch(ws, [r], actor="ai", by="测试", apply=True)
+    assert candidate(ws).path.read_bytes() == before
+
+
+def test_confirm_batch_is_fail_closed_and_rejects_duplicates(ws):
+    from patentkit import assessment as a
+    assess(ws)
+    good = {"candidate_id": "P-900", "expected_fingerprint": a.fingerprint(candidate(ws), ws)}
+    before = candidate(ws).path.read_bytes()
+    for rows in ([good, {"candidate_id": "P-999", "expected_fingerprint": "x"}], [good, good], [{**good, "expected_fingerprint": "old"}]):
+        with pytest.raises(ValueError):
+            a.confirm_batch(ws, rows, by="复核人", apply=True)
+        assert candidate(ws).path.read_bytes() == before
+
+
+def test_migration_preserves_source_and_does_not_invent_confirmation(ws):
+    from patentkit import assessment as a
+    before = candidate(ws).path.read_bytes()
+    a.migrate_workspace(ws)
+    assert candidate(ws).path.read_bytes() == before
+    a.migrate_workspace(ws, apply=True)
+    c = candidate(ws)
+    assert c.data["evidence_level"] == "verified"
+    assert not c.data.get("human_confirmation")
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "0 docs"
+    assert a.migrate_workspace(ws, apply=True)["changed"] == 0
+
+
+def test_legacy_csv_cannot_implicitly_confirm_near_prior_art(ws, tmp_path):
+    import csv
+    from patentkit import review
+    from patentkit.registry import load_registry
+    path = tmp_path / "review.csv"
+    with path.open("w", encoding="utf-8", newline="") as stream:
+        writer = csv.DictWriter(stream, fieldnames=["candidate_id", "role", "review_note"])
+        writer.writeheader()
+        writer.writerow({"candidate_id": "P-900", "role": "near_prior_art", "review_note": "CSV 人工建议"})
+    review.apply_worksheet(ws, load_registry(ws), path, dry_run=False)
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "0 docs"
+
+
+def test_schema_accepts_new_records_and_validation_reports_stale(ws):
+    from patentkit import assessment as a
+    from patentkit.validate import check_schema, check_assessments
+    a.migrate_workspace(ws, apply=True)
+    assess(ws)
+    confirm(ws)
+    assert check_schema(ws) == []
+    assert check_assessments(load_candidates(ws), ws) == []
+    c = candidate(ws)
+    c.data["review_note"] = "判断发生变化"
+    write_json(c.path, c.data)
+    assert any(f.code == "V030" for f in check_assessments(load_candidates(ws), ws))
+
+
+def test_actual_batch_confirmation_and_history(ws):
+    from patentkit import assessment as a
+    data = copy.deepcopy(candidate(ws).data)
+    data.update(id="P-901", url_or_doc_number="SYNTHETIC-901")
+    write_json(ws / "03_candidates/P-901.json", data)
+    second = row(ws)
+    second["candidate_id"] = "P-901"
+    second["expected_fingerprint"] = a.fingerprint(load_candidates(ws)[1], ws)
+    a.assess_batch(ws, [row(ws), second], actor="ai", by="测试模型", apply=True)
+    rows = [{"candidate_id": c.id, "expected_fingerprint": a.fingerprint(c, ws)} for c in load_candidates(ws)]
+    a.confirm_batch(ws, rows, by="测试复核人", apply=True)
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "2 docs"
+    assert all(len(c.data["review_history"]) == 2 for c in load_candidates(ws))
+
+
+def test_asserted_source_is_not_promoted_by_human_confirmation(ws):
+    c = candidate(ws)
+    c.data["evidence_level"] = "asserted"
+    write_json(c.path, c.data)
+    assess(ws)
+    confirm(ws)
+    assert gates(ws)["G-S-03"]["values"]["verified"] == "0 docs"
+    assert gates(ws)["G-S-03"]["values"]["asserted"] == "1 docs"
+    assert candidate(ws).data["evidence_level"] == "asserted"
+
+
+def test_failed_write_rolls_back_all_candidates(ws, monkeypatch):
+    from patentkit import assessment as a
+    first = candidate(ws)
+    second_path = ws / "03_candidates/P-901.json"
+    second = {**first.data, "id": "P-901"}
+    write_json(second_path, second)
+    before = {p: p.read_bytes() for p in (first.path, second_path)}
+    original_replace = a.os.replace
+    calls = 0
+    def fail_second(src, dst):
+        nonlocal calls
+        calls += 1
+        if calls == 2:
+            raise OSError("模拟第二个文件替换失败")
+        return original_replace(src, dst)
+    monkeypatch.setattr(a.os, "replace", fail_second)
+    with pytest.raises(OSError):
+        a.commit_batch([(first.path, first.data, {**first.data, "role": "pool"}),
+                        (second_path, second, {**second, "role": "pool"})], True)
+    assert all(p.read_bytes() == value for p, value in before.items())
+    assert not list(first.path.parent.glob(".assessment-*.tmp"))
+
+
+def test_cross_target_and_empty_batches_do_not_write(ws):
+    from patentkit import assessment as a
+    before = candidate(ws).path.read_bytes()
+    with pytest.raises(ValueError):
+        a.assess_batch(ws, [row(ws)], actor="ai", by="模型", target="TGT-9999", apply=True)
+    with pytest.raises(ValueError):
+        a.confirm_batch(ws, [], by="复核人", apply=True)
+    assert candidate(ws).path.read_bytes() == before
