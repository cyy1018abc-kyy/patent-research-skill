@@ -0,0 +1,184 @@
+"""Statutory-deadline ledger: a local tracker, never a legal adviser.
+
+Why this module exists
+----------------------
+After filing, three clocks start running (application fee, examination request, OA responses).
+Missing one kills the application regardless of its quality. The tool keeps a **local ledger**
+(``09_deadlines/deadlines.yml``) that lists entries, computes due dates from the statutory
+period presets and flags overdue / due-soon items.
+
+Hard boundary: the presets are the *commonly cited* statutory periods and the ledger is a
+reminder, not a source of law — the entry note always says the official document (通知书/受理通知)
+prevails. The module refuses to compute anything for an entry without a base_date.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from datetime import date, datetime, timedelta
+from pathlib import Path
+from typing import Any
+
+import yaml
+
+from .paths import workspace_or_exit
+
+LEDGER_REL = Path("09_deadlines") / "deadlines.yml"
+
+#: Statutory-period presets (months/days added to the base date of the triggering event).
+#: base_on names which event the clock starts from; note cites the common reference.
+PRESETS: dict[str, dict[str, Any]] = {
+    "application_fee": {
+        "label": "申请费缴纳", "base_on": "申请日", "months": 2,
+        "note": "申请日起 2 个月内缴纳申请费（含印刷费）；以受理通知书为准",
+    },
+    "exam_request": {
+        "label": "实质审查请求", "base_on": "申请日", "months": 36,
+        "note": "申请日起 3 年内提出实质审查请求并缴纳实审费；以受理通知书为准",
+    },
+    "oa_response": {
+        "label": "审查意见答复", "base_on": "发文日", "months": 4,
+        "note": "第一次审查意见通常 4 个月内答复，再次答复通常 2 个月；以通知书发文日为准（推定送达规则见政策雷达参考）",
+    },
+    "annuity": {
+        "label": "年费", "base_on": "申请日", "months": 12,
+        "note": "年费按申请日周年计算，滞纳金窗口以缴费通知为准",
+    },
+}
+
+#: Days ahead to flag as "due soon"
+DUE_SOON_DAYS = 14
+
+TEMPLATE = """\
+# 期限台账：以官方发文/通知书为准，本文件只是提醒清单，不构成法律意见。
+schema_version: 1
+entries: []
+# 条目结构（复制使用）：
+# - id: DL-001
+#   target: TGT-0002
+#   type: application_fee     # application_fee | exam_request | oa_response | annuity | custom
+#   base_date: 2026-10-01     # 触发事件日期（申请日/发文日）
+#   months: 2                 # custom 必填；预设类型可省略（自动取 PRESETS）
+#   note: 受理通知书发文日 2026-09-30
+#   done: false               # 已办理置 true，不再计入未完成
+"""
+
+
+def load_ledger(root: Path) -> dict[str, Any] | None:
+    path = root / LEDGER_REL
+    if not path.is_file():
+        return None
+    data = yaml.safe_load(path.read_text(encoding="utf-8"))
+    return data if isinstance(data, dict) else {}
+
+
+def add_months(base: date, months: int) -> date:
+    """Calendar-month addition clamped to the month end (2026-01-31 +1m → 2026-02-28)."""
+    month_index = base.month - 1 + months
+    year = base.year + month_index // 12
+    month = month_index % 12 + 1
+    day = min(base.day, [31, 29 if year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) else 28,
+                         31, 30, 31, 30, 31, 31, 30, 31, 30, 31][month - 1])
+    return date(year, month, day)
+
+
+def due_date(entry: dict[str, Any], today: date) -> date | None:
+    etype = str(entry.get("type") or "custom")
+    preset = PRESETS.get(etype, {})
+    months = entry.get("months")
+    months = preset.get("months") if months is None else months
+    if months is None:
+        return None
+    raw = str(entry.get("base_date") or "")
+    try:
+        base = date.fromisoformat(raw)
+    except ValueError:
+        return None
+    return add_months(base, int(months))
+
+
+def evaluate(root: Path, today: date | None = None) -> list[dict[str, Any]]:
+    """Load the ledger and annotate each open entry with due/status."""
+    today = today or datetime.now().astimezone().date()
+    ledger = load_ledger(root) or {}
+    out: list[dict[str, Any]] = []
+    for entry in ledger.get("entries") or []:
+        if not isinstance(entry, dict) or entry.get("done"):
+            continue
+        due = due_date(entry, today)
+        item = dict(entry)
+        item["due"] = due.isoformat() if due else None
+        if due is None:
+            item["status"] = "incomplete" if not entry.get("base_date") else "unknown-period"
+        elif due < today:
+            item["status"] = "overdue"
+        elif due <= today + timedelta(days=DUE_SOON_DAYS):
+            item["status"] = "due-soon"
+        else:
+            item["status"] = "ok"
+        item["label"] = PRESETS.get(str(entry.get("type")), {}).get("label", str(entry.get("type") or "custom"))
+        out.append(item)
+    return sorted(out, key=lambda e: (e.get("due") or "9999-12-31", str(e.get("id"))))
+
+
+def render(entries: list[dict[str, Any]]) -> str:
+    if not entries:
+        return "期限台账为空（09_deadlines/deadlines.yml 不存在或没有未完成条目）"
+    lines = ["期限台账（以官方发文为准；本清单不构成法律意见）", ""]
+    for e in entries:
+        lines.append(
+            f"[{e['status']:>10}] {e.get('id', '?')} · {e.get('target', '-')} · {e.get('label')} · "
+            f"base {e.get('base_date', '?')} → due {e.get('due') or '（缺 base_date/period，无法计算）'}"
+        )
+        if e.get("note"):
+            lines.append(f"             {e['note']}")
+    problems = [e for e in entries if e["status"] in ("overdue", "incomplete", "unknown-period")]
+    if problems:
+        lines.append("")
+        lines.append(f"⚠️ {len(problems)} 条需要立即处理（逾期或缺基础信息）")
+    return "\n".join(lines)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit deadlines",
+        description="Post-filing statutory-deadline ledger (list / check / init template)",
+    )
+    sub = ap.add_subparsers(dest="cmd")
+    sub.add_parser("list", help="list open entries with computed due dates (default)")
+    check = sub.add_parser("check", help="exit 1 when anything is overdue/incomplete")
+    check.add_argument("--root", type=Path, default=None)
+    init = sub.add_parser("init", help="write the empty ledger template if absent")
+    init.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--root", type=Path, default=None)
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+
+    if args.cmd == "init":
+        path = root / LEDGER_REL
+        if path.is_file():
+            print(f"already exists: {path}")
+            return 0
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(TEMPLATE, encoding="utf-8")
+        print(f"[WRITE] {path} — 填写 entries 后运行 patentkit deadlines")
+        return 0
+
+    entries = evaluate(root)
+    print(render(entries))
+    if args.cmd == "check":
+        bad = [e for e in entries if e["status"] in ("overdue", "incomplete", "unknown-period")]
+        return 1 if bad else 0
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
