index 0000000..ca87d66
--- /dev/null
+++ b/patentkit/ledger.py
@@ -0,0 +1,106 @@
+"""The evidence ledger: every judgment-citable fact in one auditable table.
+
+Why this module exists
+----------------------
+A conclusion like "D3 discloses the 50-90% range" is only as good as the chain
+**conclusion → cited evidence → archived artifact → assessment/confirmation**. That chain exists
+in the workspace but is scattered across candidates JSON, run files and confirmation records.
+The ledger renders it in one place: for each citable candidate — id, document number, effective
+evidence level, the artifact it points at (evidence_ref), the assessment state, and the current
+human-confirmation fingerprint.
+
+``validate`` enforces the other half (V034): a conclusion file citing a candidate ID that is not
+in the ledger is an error — an invented citation must fail the build, not survive to delivery.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from . import runs as runs_mod
+from .assessment import state as assessment_state, confirmation_valid
+from .model import Role, load_candidates
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+
+
+def build_entries(root: Path, term, target_id: str) -> list[dict]:
+    """Ledger rows for one target, sorted by role weight then id."""
+    cands = [c for c in load_candidates(root) if c.target == target_id]
+    runs = runs_mod.load_runs(root)
+    inferred = runs_mod.infer_near_prior_ids(cands, runs)
+    weight = {Role.NEAR_PRIOR_ART: 0, Role.FAMILY: 1, Role.POOL: 2, Role.EXCLUDED: 3}
+    rows = []
+    for c in sorted(cands, key=lambda c: (weight.get(c.effective_role(inferred), 9), c.id)):
+        role = c.effective_role(inferred)
+        rows.append({
+            "id": c.id,
+            "doc_number": c.doc_number,
+            "role": role.value,
+            "evidence_level": c.effective_level(root).value,
+            "evidence_ref": c.data.get("evidence_ref"),
+            "assessment_state": assessment_state(c, root),
+            "human_confirmed": confirmation_valid(c, root),
+        })
+    return rows
+
+
+def render(rows: list[dict], target_id: str) -> str:
+    lines = [f"证据账本 — {target_id}（结论可引用的证据清单；引用不在账本中的编号会被 V034 拦截）", ""]
+    if not rows:
+        lines.append("（该目标暂无候选）")
+        return "\n".join(lines)
+    lines.append(f"{'ID':<8}{'文献号':<18}{'角色':<16}{'分级':<10}{'判定状态':<18}{'人工确认'}")
+    lines.append("-" * 84)
+    for r in rows:
+        mark = "✅" if r["human_confirmed"] else "—"
+        lines.append(
+            f"{r['id']:<8}{r['doc_number']:<18}{r['role']:<16}{r['evidence_level']:<10}"
+            f"{r['assessment_state']:<18}{mark}"
+        )
+        if r["evidence_ref"]:
+            lines.append(f"{'':<8}└─ artifact: {r['evidence_ref']}")
+    lines.append("")
+    lines.append("判定状态 unknown/needs_review 的条目不得作为 G-S-02/G-S-03 的依据；"
+                 "分级为来源属性，与判断质量无关")
+    return "\n".join(lines)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit ledger",
+        description="Evidence ledger: the citable-fact table behind every conclusion",
+    )
+    ap.add_argument("target_id", nargs="?", default=None, help="target ID (default: active)")
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--json", action="store_true")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+    target = args.target_id or term.active_target
+    if target not in term.targets:
+        print(f"[FATAL] target not registered: {target}", file=sys.stderr)
+        return 2
+    rows = build_entries(root, term, target)
+    if args.json:
+        print(json.dumps({"target": target, "entries": rows}, ensure_ascii=False, indent=2))
+    else:
+        print(render(rows, target))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
