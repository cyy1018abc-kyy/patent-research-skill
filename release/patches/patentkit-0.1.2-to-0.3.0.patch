@@ -0,0 +1,220 @@
+"""Export the novelty-search report as a .docx deliverable (kernel 0.3.0).
+
+Why this module exists
+----------------------
+The comparison run, the gates and the candidate list already live in the workspace as data; the
+delivered report was retyped by hand from them, and every retyping is a chance to diverge from
+the evidence chain (a number that no longer matches the gates, a D-document listed without its
+evidence level). This module renders the **workspace state** into an editable Word document:
+zero hand-typed numbers, and the "⚠️ Unverified by tool checks" discipline travels with the file.
+
+python-docx is an **optional** dependency (``pip install patentkit[docx]``): the kernel stays
+light for clients that never export. Missing dependency → exit code 3 with the install hint,
+matching the skill scripts' convention.
+
+Everything the document states comes from the workspace: gates read from ``gates.compute_all``,
+column D from the candidates with their effective evidence level and assessment state. Where a
+section needs human judgment (three-tier conclusion), the document carries an explicit
+_(待人工填写)_ placeholder — it never invents a conclusion.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from datetime import datetime
+from pathlib import Path
+
+from . import gates as gates_mod
+from . import provenance as provenance_mod
+from . import runs as runs_mod
+from .assessment import state as assessment_state
+from .model import Role, load_candidates, load_logs
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+
+#: Optional-dependency exit code (same convention as the skill scripts)
+EXIT_MISSING_DEP = 3
+
+
+def _require_docx():
+    try:
+        import docx  # noqa: F401
+    except ImportError as exc:  # pragma: no cover - exercised via CLI in CI with the extra
+        print(
+            "[FATAL] python-docx is not installed — export-docx is an optional feature.\n"
+            "  fix: pip install \"patentkit[docx]\"  (or pip install python-docx)",
+            file=sys.stderr,
+        )
+        raise SystemExit(EXIT_MISSING_DEP) from exc
+    from docx import Document
+    from docx.shared import Pt
+    return Document, Pt
+
+
+def build_document(root: Path, target_id: str, term) -> "object":
+    """Build the report Document. Pure read of workspace state; no CLI coupling."""
+    Document, Pt = _require_docx()
+
+    report = gates_mod.compute_all(root, term, target_id)
+    cands = [c for c in load_candidates(root) if c.target == target_id]
+    logs = [log for log in load_logs(root) if log.target == target_id]
+    runs = runs_mod.load_runs(root)
+    inferred = runs_mod.infer_near_prior_ids(cands, runs)
+    d_list = sorted(
+        (c for c in cands if c.effective_role(inferred) is Role.NEAR_PRIOR_ART),
+        key=lambda c: c.id,
+    )
+
+    doc = Document()
+    style = doc.styles["Normal"]
+    style.font.name = "DengXian"
+    style.font.size = Pt(10.5)
+
+    # ── 封面 ──
+    title = term.targets.get(target_id)
+    doc.add_heading(f"专利查新检索报告（底稿）— {target_id}", level=0)
+    doc.add_paragraph(
+        f"目标：{target_id} — {title.title if title else '（标题见 workspace.yml）'}\n"
+        f"生成时间：{datetime.now().astimezone().isoformat(timespec='seconds')}\n"
+        f"生成工具：patentkit export-docx（数据全部读取自工作区，未经手工转写）"
+    )
+    note = doc.add_paragraph()
+    run = note.add_run(
+        "声明：本报告是检索与自检底稿，不构成法律意见，也不预测授权前景；"
+        "三层级判定与新颖性/创造性结论须由人工填写并复核。"
+    )
+    run.italic = True
+
+    # ── 1 检索概况 ──
+    doc.add_heading("一、检索概况", level=1)
+    by_level: dict[str, int] = {}
+    for c in cands:
+        lv = c.effective_level(root).value
+        by_level[lv] = by_level.get(lv, 0) + 1
+    doc.add_paragraph(
+        f"检索日志：{len(logs)} 条（live {sum(1 for l in logs if l.capture_mode.value == 'live')} / "
+        f"retrospective {sum(1 for l in logs if l.capture_mode.value != 'live')}）。\n"
+        f"候选文献：{len(cands)} 篇 — 证据分级 {by_level or '无'}。"
+        "hit 数是数据库全库命中面，不等于已采集文献数（见 SKILL 硬约束）。"
+    )
+
+    # ── 2 验收门 ──
+    doc.add_heading("二、验收门状态（G-S，以 verified 列为准）", level=1)
+    table = doc.add_table(rows=1, cols=4)
+    table.style = "Table Grid"
+    hdr = table.rows[0].cells
+    for i, h in enumerate(("门", "判据", "verified 列", "状态")):
+        hdr[i].text = h
+    for g in report.results:
+        row = table.add_row().cells
+        row[0].text = g.gate_id
+        row[1].text = g.threshold
+        row[2].text = str(g.values.get("verified", "-"))
+        row[3].text = g.status
+    doc.add_paragraph(
+        "门 FAIL 的含义是「检索尚不充分」，应补检索/补判定，而不是放宽阈值（硬约束 7）。"
+    )
+
+    # ── 3 D 列对比文献 ──
+    doc.add_heading("三、近似在先技术（D 列）", level=1)
+    if d_list:
+        t2 = doc.add_table(rows=1, cols=6)
+        t2.style = "Table Grid"
+        hdr = t2.rows[0].cells
+        for i, h in enumerate(("D", "文献号", "候选 ID", "证据分级", "判定状态", "novelty_check")):
+            hdr[i].text = h
+        for i, c in enumerate(d_list, start=1):
+            row = t2.add_row().cells
+            row[0].text = f"D{i}"
+            row[1].text = c.doc_number
+            row[2].text = c.id
+            row[3].text = c.effective_level(root).value
+            row[4].text = assessment_state(c, root)
+            row[5].text = c.novelty_check
+    else:
+        doc.add_paragraph("（暂无 role=near_prior_art 的候选）")
+    doc.add_paragraph(
+        "来源分级与判定相互独立：verified 只说明原文工件在工作区内，不保证判断正确；"
+        "G-S-03 只认可绑定当前指纹的人工确认。"
+    )
+
+    # ── 4 三层级判定（人工填写） ──
+    doc.add_heading("四、三层级判定（人工填写）", level=1)
+    for tier, prompt in (
+        ("4.1 单篇新颖性", "是否存在单篇 D 文献覆盖全部 N 轴特征？（成立/存疑/不成立 + 逐条理由）"),
+        ("4.2 结合创造性", "结合组、结合动机是否明确、有无反向教导？（成立/存疑/不成立 + 逐条理由）"),
+        ("4.3 技术效果", "有益效果、量化指标、是否由 D 列显而易见？（反驳成立/未成立）"),
+    ):
+        doc.add_heading(tier, level=2)
+        doc.add_paragraph(f"_{prompt}_")
+
+    # ── 5 数值溯源（若启用） ──
+    registry = provenance_mod.load_registry(root)
+    if registry and registry.get("entries"):
+        doc.add_heading("五、数值声明溯源（A/B/C）", level=1)
+        t3 = doc.add_table(rows=1, cols=3)
+        t3.style = "Table Grid"
+        hdr = t3.rows[0].cells
+        for i, h in enumerate(("编号", "数值声明", "来源分级")):
+            hdr[i].text = h
+        for entry in registry["entries"]:
+            row = t3.add_row().cells
+            grades = ", ".join(str(s.get("grade")) for s in entry.get("sources") or []) or "⚠️ 未溯源"
+            row[0].text = str(entry.get("id") or "")
+            row[1].text = str(entry.get("statement") or "")
+            row[2].text = grades
+
+    doc.add_heading("附：证据分级口径", level=1)
+    doc.add_paragraph(
+        "verified=raw 工件已归档于工作区；attested=外部哈希绑定材料；asserted=自述，无工件。"
+        "工具不可用时结论必须以「⚠️ 未经工具核验」开头。"
+    )
+    return doc
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit export-docx",
+        description="Render the workspace state into an editable .docx novelty-search report",
+    )
+    ap.add_argument("target_id", nargs="?", default=None, help="target ID, e.g. TGT-0001 (default: active)")
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--out", type=Path, default=None,
+                    help="output .docx (default: 04_comparative_analysis/<date>_<target>_report.docx)")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    target = args.target_id or term.active_target
+    if target not in term.targets:
+        print(f"[FATAL] target not registered in the glossary: {target}", file=sys.stderr)
+        return 2
+
+    doc = build_document(root, target, term)
+
+    out = args.out or (
+        root / "04_comparative_analysis"
+        / f"{datetime.now().astimezone().date().isoformat()}_{target}_report.docx"
+    )
+    out.parent.mkdir(parents=True, exist_ok=True)
+    doc.save(str(out))
+    print(f"[WRITE] {out}")
+    print("内容全部来自工作区数据；三层级判定与结论段落需人工填写后再交付")
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
