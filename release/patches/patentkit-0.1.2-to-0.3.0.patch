+from __future__ import annotations
+
+from datetime import date
+from pathlib import Path
+
+import pytest
+import yaml
+
+from patentkit import deadlines, figures, provenance, validate
+from patentkit.init import init_workspace
+
+
+@pytest.fixture
+def ws(tmp_path):
+    root = tmp_path / "workspace"
+    init_workspace(root, "TGT-0002", "合成燃料电池测试")
