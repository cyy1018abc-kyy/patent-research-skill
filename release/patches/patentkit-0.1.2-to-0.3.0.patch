new file mode 100644
index 0000000..e23c186
--- /dev/null
+++ b/patentkit/layout.py
@@ -0,0 +1,129 @@
+"""Cross-target layout view: the "1+N" portfolio at a glance.
+
+Why this module exists
+----------------------
+The workspace already supports multiple targets, but every command silos into one target. When
+planning a 1+N layout (one primary filing plus N defensive filings around it) the questions are
+cross-target: which target has the deepest verified evidence, which axes of which target are
+still hollow, which targets are ripe to draft and which are still searching.
+
+This module answers exactly those questions **from existing data** (targets, candidates, gates)
+and suggests which target looks like the "1". A suggestion is a suggestion: it never writes,
+never re-tags, and says plainly when the data is too thin to rank.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from . import gates as gates_mod
+from .model import load_candidates
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+
+
+def collect(root: Path, term) -> list[dict]:
+    """One summary row per registered target (active or archived — archived rows are marked)."""
+    all_cands = load_candidates(root)
+    rows: list[dict] = []
+    for tid, target in term.targets.items():
+        cands = [c for c in all_cands if c.target == tid]
+        by_level = {"verified": 0, "attested": 0, "asserted": 0}
+        by_role: dict[str, int] = {}
+        for c in cands:
+            lv = c.effective_level(root).value
+            by_level[lv] = by_level.get(lv, 0) + 1
+            by_role[c.data.get("role") or "?"] = by_role.get(c.data.get("role") or "?", 0) + 1
+        report = gates_mod.compute_all(root, term, tid)
+        passed = sum(1 for g in report.results if g.status == "PASS")
+        axes = term.axes_for(tid)
+        hollow = sorted(a for a, v in (report.per_axis or {}).items() if v.get("verified", 0) == 0)
+        rows.append({
+            "target": tid,
+            "title": target.title,
+            "status": target.status,
+            "candidates": len(cands),
+            "by_level": by_level,
+            "by_role": by_role,
+            "axes": len(axes),
+            "hollow_axes": hollow,
+            "gates_passed": f"{passed}/5",
+            "gs02_verified_min": report.per_axis and min(
+                (v.get("verified", 0) for v in report.per_axis.values()), default=0
+            ) or 0,
+        })
+    return rows
+
+
+def suggest_primary(rows: list[dict]) -> str:
+    """Rank by (verified count, G-S-02 verified min); refuse to crown a thin field."""
+    ranked = sorted(
+        rows, key=lambda r: (r["by_level"].get("verified", 0), r["gs02_verified_min"] or 0), reverse=True
+    )
+    if not ranked:
+        return "没有已注册目标"
+    top = ranked[0]
+    if top["by_level"].get("verified", 0) == 0:
+        return "verified 证据都为 0 — 数据不足，暂不建议指定主件（继续补检索）"
+    others = ", ".join(r["target"] for r in ranked[1:]) or "无"
+    return (
+        f"主件候选：{top['target']}（verified {top['by_level']['verified']} 篇，"
+        f"G-S-02 verified 最小轴 {top['gs02_verified_min']}）；其余目标可作为 N 件：{others}。"
+        "建议仅为排序提示，定稿前须人工确认技术布局价值"
+    )
+
+
+def render(rows: list[dict]) -> str:
+    if not rows:
+        return "没有已注册目标（glossary targets 为空）"
+    lines = ["1+N 布局总览（跨目标只读视图）", ""]
+    for r in rows:
+        lines.append(
+            f"{r['target']} — {r['title'] or '(无标题)'} [{r['status']}]"
+        )
+        lines.append(
+            f"    候选 {r['candidates']}（{r['by_level']}）· 角色 {r['by_role'] or '无'} · "
+            f"轴 {r['axes']}（空轴 {len(r['hollow_axes'])}{':' + ','.join(r['hollow_axes']) if r['hollow_axes'] else ''}）· "
+            f"通过门 {r['gates_passed']}"
+        )
+    lines.append("")
+    lines.append("→ " + suggest_primary(rows))
+    lines.append("")
+    lines.append("空轴 = 该轴 verified 计数为 0；先补检索再谈布局")
+    return "\n".join(lines)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit layout",
+        description="Cross-target 1+N portfolio overview (read-only)",
+    )
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--json", action="store_true")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+    rows = collect(root, term)
+    if args.json:
+        payload = {"rows": rows, "suggestion": suggest_primary(rows)}
+        print(json.dumps(payload, ensure_ascii=False, indent=2))
+    else:
+        print(render(rows))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
