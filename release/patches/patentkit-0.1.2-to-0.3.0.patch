new file mode 100644
index 0000000..1cedf41
--- /dev/null
+++ b/patentkit/map.py
@@ -0,0 +1,159 @@
+"""Static local HTML overview of the comparison state ("patent map", baseline).
+
+Why this module exists
+----------------------
+The blank comparison matrix is a markdown table; humans read coverage far better as a chart.
+This module renders the **workspace state only** into one self-contained HTML file: per-axis
+coverage bars (three evidence columns), the D-listing with assessment states, and the gate
+summary. No network, no CDN, no JavaScript dependencies — the file must open offline inside an
+air-gapped environment and must never leak data to a third-party CDN.
+
+Boundary (kept from the run skeleton): this is a summary view. The form an examiner can verify
+item by item remains the claim chart; the HTML says so at the top.
+"""
+
+from __future__ import annotations
+
+import argparse
+import html
+from datetime import datetime
+from pathlib import Path
+
+from . import gates as gates_mod
+from . import runs as runs_mod
+from .assessment import state as assessment_state
+from .model import Role, load_candidates
+from .paths import workspace_or_exit
+from .registry import TerminologyError, load_registry
+
+_CSS = """\
+body{font-family:"Microsoft YaHei",sans-serif;margin:2rem auto;max-width:60rem;color:#111}
+h1{font-size:1.4rem} h2{font-size:1.1rem;margin-top:2rem}
+table{border-collapse:collapse;width:100%} th,td{border:1px solid #999;padding:4px 8px;font-size:.9rem;text-align:left}
+.bar{background:#eee;position:relative;height:1.2rem}
+.bar>span{position:absolute;top:0;bottom:0;left:0;background:#333;color:#fff;font-size:.75rem;
+padding:.15rem .4rem;white-space:nowrap}
+.warn{color:#a00} .note{color:#555;font-size:.85rem}
+.pass{font-weight:700} .fail{font-weight:700;color:#a00} .na{color:#777}
+"""
+
+
+def _esc(s: object) -> str:
+    return html.escape(str(s), quote=True)
+
+
+def build_html(root: Path, target_id: str, term) -> str:
+    report = gates_mod.compute_all(root, term, target_id)
+    cands = [c for c in load_candidates(root) if c.target == target_id]
+    runs = runs_mod.load_runs(root)
+    inferred = runs_mod.infer_near_prior_ids(cands, runs)
+    d_list = sorted(
+        (c for c in cands if c.effective_role(inferred) is Role.NEAR_PRIOR_ART),
+        key=lambda c: c.id,
+    )
+    axes = sorted(term.axes_for(target_id))
+    per_axis = report.per_axis
+
+    parts: list[str] = []
+    parts.append("<html lang='zh-CN'><head><meta charset='utf-8'>")
+    parts.append(f"<title>对比地图 — {target_id}</title><style>{_CSS}</style></head><body>")
+    t = term.targets.get(target_id)
+    parts.append(f"<h1>对比地图（汇总视图）— {target_id} {_esc(t.title if t else '')}</h1>")
+    parts.append(
+        "<p class='note'>生成时间 " + datetime.now().astimezone().isoformat(timespec="seconds")
+        + " · 数据全部来自工作区 · 这是汇总视图，可逐项核验的形态是 claim chart；"
+          "本页面不构成法律意见。</p>"
+    )
+
+    # ── gates ──
+    parts.append("<h2>验收门（verified 列）</h2><table><tr><th>门</th><th>判据</th><th>verified</th><th>状态</th></tr>")
+    for g in report.results:
+        cls = "pass" if g.status == "PASS" else ("fail" if g.status == "FAIL" else "na")
+        parts.append(
+            f"<tr><td>{_esc(g.gate_id)}</td><td>{_esc(g.threshold)}</td>"
+            f"<td>{_esc(g.values.get('verified', '-'))}</td><td class='{cls}'>{_esc(g.status)}</td></tr>"
+        )
+    parts.append("</table>")
+
+    # ── per-axis coverage bars ──
+    parts.append("<h2>N 轴覆盖（三列证据计数）</h2>")
+    if per_axis:
+        max_n = max((max(v.values()) for v in per_axis.values() if v), default=1) or 1
+        parts.append("<table><tr><th>轴</th><th style='width:70%'>覆盖（verified/attested/asserted）</th></tr>")
+        for axis in axes:
+            v = per_axis.get(axis.split("@")[0], {})
+            label = term.axis_label(axis)
+            cells = []
+            for key, color in (("verified", "#333"), ("attested", "#777"), ("asserted", "#aaa")):
+                n = v.get(key, 0)
+                w = int(100 * n / max_n)
+                cells.append(
+                    f"<div class='bar' title='{key}={n}'><span style='width:{w}%;background:{color}'>{key} {n}</span></div>"
+                )
+            parts.append(f"<tr><td>{_esc(label)}</td><td>{''.join(cells)}</td></tr>")
+        parts.append("</table>")
+    else:
+        parts.append("<p class='note'>（该目标暂无轴计数）</p>")
+
+    # ── D listing ──
+    parts.append("<h2>D 列（近似在先技术）</h2>")
+    if d_list:
+        parts.append("<table><tr><th>D</th><th>文献号</th><th>ID</th><th>证据分级</th><th>判定状态</th><th>novelty</th></tr>")
+        for i, c in enumerate(d_list, start=1):
+            state = assessment_state(c, root)
+            cls = " class='warn'" if state in ("unknown", "needs_review") else ""
+            parts.append(
+                f"<tr><td>D{i}</td><td>{_esc(c.doc_number)}</td><td>{_esc(c.id)}</td>"
+                f"<td>{_esc(c.effective_level(root).value)}</td><td{cls}>{_esc(state)}</td>"
+                f"<td>{_esc(c.novelty_check)}</td></tr>"
+            )
+        parts.append("</table>")
+    else:
+        parts.append("<p class='note'>（暂无 near_prior_art）</p>")
+
+    parts.append("</body></html>")
+    return "\n".join(parts)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit map",
+        description="Render a self-contained offline HTML overview of the comparison state",
+    )
+    ap.add_argument("target_id", nargs="?", default=None, help="target ID (default: active)")
+    ap.add_argument("--root", type=Path, default=None)
+    ap.add_argument("--out", type=Path, default=None,
+                    help="output .html (default: 04_comparative_analysis/<date>_<target>_map.html)")
+    return ap
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .paths import configure_stdio
+
+    configure_stdio()
+    args = build_parser().parse_args(argv)
+    root = (args.root or workspace_or_exit()).resolve()
+    try:
+        term = load_registry(root)
+    except TerminologyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+    target = args.target_id or term.active_target
+    if target not in term.targets:
+        print(f"[FATAL] target not registered: {target}", file=sys.stderr)
+        return 2
+
+    payload = build_html(root, target, term)
+    out = args.out or (
+        root / "04_comparative_analysis"
+        / f"{datetime.now().astimezone().date().isoformat()}_{target}_map.html"
+    )
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(payload, encoding="utf-8")
+    print(f"[WRITE] {out}")
+    print("离线静态页面：无外链、无脚本依赖；含真实检索数据，请勿外发")
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
