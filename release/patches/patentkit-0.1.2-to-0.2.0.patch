+"""Unified entry point: ``python -m patentkit <subcommand>`` or ``patentkit <subcommand>``.
+
+Two categories
+--------------
+* **Pass-through** (validate/gates/migrate/index/report/ingest/bibsync/attest) —
+  forwarded directly to each module's own `main()`; behavior identical to the historical commands.
+* **API** (status/doctor/search-plan) — goes through `patentkit.api`,
+  renders human-readable text by default, or structured JSON with `--json` (for scripts / MCP reuse).
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+
+from . import api
+from . import attest as attest_mod
+from . import backfill as backfill_mod
+from . import bibsync as bibsync_mod
+from . import cnipa as cnipa_mod
+from . import doi_abstract as doi_abstract_mod
+from . import fetch_crossref as fetch_crossref_mod
+from . import gates as gates_mod
+from . import index as index_mod
+from . import init as init_mod
+from . import ingest as ingest_mod
+from . import migrate as migrate_mod
+from . import report as report_mod
+from . import review as review_mod
+from . import validate as validate_mod
+
+USAGE = """\
+python -m patentkit <subcommand> [options]
+
+Workspace selection: status / doctor / search-plan accept --workspace <path> (--root also works)
+
+Workspace
+  status        Everything at a glance: target, gates, validation, candidate distribution, next-step suggestions
+  doctor        Self-check: whether the workspace parses, whether dependencies are complete, whether results can be computed
+  search-plan   Fetch queries (--axis N1 [--db espacenet] [--json])
+  init          Initialize a new workspace from a template (--target TGT-0002 --title <title>)
+
+Search
+  fetch-cnipa   Fetch CNIPA publication/grant search results into raw/ + log (really goes online)
+  fetch-crossref Fetch Crossref literature (fills in the literature side of G-S-01) into raw/ + log
+  backfill      Backfill patent abstracts from Google Patents by publication number (incremental, resumable)
+  backfill-doi  Backfill literature abstracts from OpenAlex / Semantic Scholar by DOI
+
+Validation and gates
+  validate      Consistency validation (V001-V030); exits 1 on any error
+  gates         G-S-01..05 three-column acceptance gates; exits 2 when not all gates PASS
+  check         = validate --strict + gates --quiet (CI entry point)
+
+Data pipeline
+  review        Assessment and human confirmation (export / assess / confirm / migrate-assessments / progress)
+  ingest        Raw response → candidate skeleton (dry-run by default; only --apply writes to disk)
+  bibsync       Generate missing BibTeX entries for candidates (dry-run by default)
+  attest        Manuscript sha256 binding (--check exits 1 on drift / --apply re-binds)
+  report        Generate the 04_comparative_analysis/runs/ report skeleton
+  index         Generate INDEX.md (--write writes to disk)
+  migrate       Step-1a data migration (dry-run by default; only --apply writes to disk)
+
+AI adapter
+  mcp           Start the MCP service (stdio) for Cursor / Claude Code / Cline
+
+Examples
+  python -m patentkit status
+  python -m patentkit init D:\\patents\\new_project --target TGT-0002 --title "Invention title"
+  python -m patentkit search-plan --axis N1 --db espacenet
+  python -m patentkit fetch-cnipa --axis N1 --abstract "fuel cell and gas-liquid separation" --class H01M8
+  python -m patentkit fetch-crossref --axis N1 --query "PEM fuel cell water management" --apply
+  python -m patentkit backfill-doi --ids L-201,L-216
+  python -m patentkit review export --min-relevance 4 --with-topics --out worksheet.csv
+  python -m patentkit validate --strict
+  python -m patentkit check
+  python -m patentkit mcp
+"""
+
+#: Pass-through subcommands → module main
+PASSTHROUGH = {
+    "validate": validate_mod.main,
+    "gates": gates_mod.main,
+    "migrate": migrate_mod.main,
+    "index": index_mod.main,
+    "report": report_mod.main,
+    "ingest": ingest_mod.main,
+    "bibsync": bibsync_mod.main,
+    "attest": attest_mod.main,
+    "review": review_mod.main,
+    "backfill": backfill_mod.main,
+    "fetch-crossref": fetch_crossref_mod.main,
+    "backfill-doi": doi_abstract_mod.main,
+}
+
+#: Subcommands with dedicated handling (not pass-through).
+#:
+#: ⚠️ Together with `PASSTHROUGH`, this list constitutes the **complete** set of subcommands;
+#: `test_cli_help.py` verifies that the help text lists every one of them —
+#: there was once a case where "fetch-crossref / backfill-doi were newly added but the help text was still old",
+#: so users consulting `--help` had no idea those commands existed. Misleading help text is worse than none.
+SPECIAL_COMMANDS = (
+    "status",
+    "doctor",
+    "search-plan",
+    "init",
+    "fetch-cnipa",
+    "check",
+    "mcp",
+)
+
+#: All available subcommands
+ALL_COMMANDS = tuple(PASSTHROUGH) + SPECIAL_COMMANDS
+
+
+# ── Rendering ─────────────────────────────────────────────────────────
+
+_STATUS_MARK = {"PASS": "PASS", "FAIL": "FAIL", "N/A": " N/A"}
+
+
+def render_status(d: dict) -> str:
+    lines: list[str] = []
+    lines.append(f"Workspace  : {d['workspace']}")
+    lines.append(f"Active target : {d['active_target']}")
+    if d.get("target_title"):
+        lines.append(f"           {d['target_title']}")
+    lines.append("")
+
+    c = d["candidates"]
+    lines.append(f"Candidates : {c['total']}")
+    lines.append(f"  Evidence level : {c['by_evidence_level'] or 'none'}")
+    lines.append(f"  Role           : {c['by_role'] or 'none'}")
+    lines.append(f"  relevance      : {c['by_relevance'] or 'none'}")
+    if c["total"] and c["with_relevance_ge4"] == 0:
+        lines.append("  ⚠️ all are the default relevance — G-S-02 counts only ≥4, so this axis currently counts 0")
+    lines.append("")
+
+    lg = d["logs"]
+    lines.append(f"Search logs: {lg['total']} (live {lg['live']} / retrospective {lg['retrospective']})")
+    lines.append("")
+
+    v = d["validation"]
+    lines.append(f"Validation : error {v['errors']} / warn {v['warnings']} / total {v['total']}")
+    if v["by_code"]:
+        lines.append(f"  By rule    : {v['by_code']}")
+    lines.append("")
+
+    lines.append("Acceptance gates:")
+    for g in d["gates"]["gates"]:
+        mark = _STATUS_MARK.get(g["status"], g["status"])
+        lines.append(f"  [{mark}] {g['gate_id']}  {g['threshold']}")
+        lines.append(f"          verified={g['values'].get('verified', '-')}")
+    lines.append("")
+
+    hints = d.get("hints") or []
+    if hints:
+        lines.append("Next steps:")
+        for h in hints:
+            lines.append(f"  · {h}")
+        lines.append("")
+
+    lines.append("Hard constraints:")
+    for c2 in d.get("hard_constraints", []):
+        lines.append(f"  · {c2}")
+    return "\n".join(lines)
+
+
+def render_doctor(d: dict) -> str:
+    lines = [f"Self-check result: {'passed' if d['ok'] else '**problems found**'}", ""]
+    for c in d["checks"]:
+        mark = "OK  " if c["ok"] else "FAIL"
+        detail = f"  {c['detail']}" if c["detail"] else ""
+        lines.append(f"  [{mark}] {c['name']}{detail}")
+    return "\n".join(lines)
+
+
+def render_search_plan(d: dict) -> str:
+    if not d.get("ok"):
+        return f"Failed to fetch queries: {d.get('error')}"
+
+    def one(q: dict) -> list[str]:
+        out = [
+            f"{q['id']}  ·  {q['title_zh']} / {q['title_en']}",
+            f"  Status : {q['status']}",
+            f"  Claims : {q['claims'] or '-'}",
+            f"  IPC    : {', '.join(q['ipc']) or '-'}",
+        ]
+        if not q["registered_axis"]:
+            out.append(f"  Cross axis: composed of {q.get('composed_of')} → ingest tags {q.get('ingest_tags')}")
+        if q.get("note"):
+            out.append(f"  Note   : {q['note']}")
+        out.append(f"  Chinese form : {q['cn'] or '-'}")
+        out.append(f"  English form : {q['en'] or '-'}")
+        out.append(f"  Practical form : {q['query_for_db']}  ({q['query_for_db_note']})")
+        out.append("")
+        return out
+
+    lines: list[str] = []
+    if "queries" in d:
+        for key in sorted(d["queries"]):
+            lines += one(d["queries"][key])
+    else:
+        lines += one(d)
+    return "\n".join(lines).rstrip()
+
+
+# ── Dispatch ──────────────────────────────────────────────────────────
+
+
+def _arg_value(argv: list[str], flag: str) -> str | None:
+    if flag in argv:
+        i = argv.index(flag)
+        if i + 1 < len(argv):
+            return argv[i + 1]
+    for item in argv:
+        if item.startswith(flag + "="):
+            return item.split("=", 1)[1]
+    return None
+
+
+def _ws_arg(argv: list[str]) -> str | None:
+    """Workspace argument: `--workspace` is the official name, `--root` the historical alias.
+
+    Both are accepted: the next steps printed by `init` use `--root`, so accepting only `--workspace`
+    would make `--root` be **silently ignored** and fall back to the current directory — looking at
+    data in the wrong workspace is more dangerous than an outright error.
+    """
+    return _arg_value(argv, "--workspace") or _arg_value(argv, "--root")
+
+
+def main(argv: list[str] | None = None) -> int:
+    argv = list(sys.argv[1:] if argv is None else argv)
+
+    if not argv or argv[0] in {"-h", "--help", "help"}:
+        print(USAGE)
+        return 0
+
+    command, rest = argv[0], argv[1:]
+    as_json = "--json" in rest
+
+    if command == "fetch-cnipa":
+        return _cmd_fetch_cnipa(rest)
+
+    # `init` must be dispatched **before workspace resolution** — it creates the workspace itself;
+    # going through `api.*` below (which calls find_workspace internally) would report "workspace.yml not found" in an empty directory.
+    if command == "init":
+        return init_mod.main(rest)
+
+    try:
+        if command == "status":
+            _cmd_status(api.status(_ws_arg(rest)), as_json)
+            return 0
+
+        if command == "doctor":
+            data = api.doctor(_ws_arg(rest))
+            print(json.dumps(data, ensure_ascii=False, indent=2) if as_json else render_doctor(data))
+            return 0
+
+        if command == "search-plan":
+            data = api.search_plan(
+                ws=_ws_arg(rest),
+                axis=_arg_value(rest, "--axis") or (_positional(rest) or None),
+                db=_arg_value(rest, "--db"),
+            )
+            print(json.dumps(data, ensure_ascii=False, indent=2) if as_json else render_search_plan(data))
+            return 0 if data.get("ok") else 1
+
+        if command == "mcp":
+            from .mcp_server import main as mcp_main
+
+            return mcp_main(rest)
+
+    except api.WorkspaceError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+    except KeyError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    if command == "check":
+        # validate blocks (data inconsistency must be stopped); gates do not block (a gate not passing is business state)
+        rc = validate_mod.main([*rest, "--strict"])
+        gate_rc = gates_mod.main([*rest, "--quiet"])
+        return rc or gate_rc
+
+    handler = PASSTHROUGH.get(command)
+    if handler is None:
+        print(f"Unknown subcommand: {command}\n", file=sys.stderr)
+        print(USAGE, file=sys.stderr)
+        return 64
+
+    return handler(rest)
+
+
+def _cmd_fetch_cnipa(argv: list[str]) -> int:
+    """`fetch-cnipa` — fetch CNIPA search results and archive them."""
+    import argparse
+
+    ap = argparse.ArgumentParser(
+        prog="python -m patentkit fetch-cnipa",
+        description="Fetch CNIPA publication/grant search results into raw/ + log (really goes online)",
+    )
+    ap.add_argument("--workspace", default=None)
+    ap.add_argument("--axis", required=True, help="axis ID, e.g. N1 or N1@TGT-0001")
+    ap.add_argument("--target", default="")
+    ap.add_argument("--abstract", default="", help="abstract query; use only and/or/not, surrounded by spaces")
+    ap.add_argument("--title", default="")
+    ap.add_argument("--class", dest="class_code", default="", help="IPC/LOC prefix, e.g. H01M8")
+    ap.add_argument("--inventor", default="")
+    ap.add_argument("--applicant", action="append", default=[])
+    ap.add_argument("--type", dest="patent_type", default="all",
+                    help="invention | utility_model | design | all")
+    ap.add_argument("--max-pages", type=int, default=1, help="maximum number of pages to page through (3 records per page)")
+    ap.add_argument("--complete", action="store_true", help="page through the total number of pages reported by the site")
+    ap.add_argument("--headless", action="store_true",
+                    help="headless mode (headed by default — headless is almost always blocked by the WAF)")
+    ap.add_argument("--waf-wait", type=int, default=cnipa_mod.DEFAULT_WAF_WAIT_SEC)
+    ap.add_argument("--actor", default="")
+    ap.add_argument("--tool", default=None, help="path to cnipa_search.py (located automatically by default)")
+    ap.add_argument("--no-write", action="store_true", help="fetch only, do not archive")
+    ap.add_argument(
+        "--from-library",
+        action="store_true",
+        help="run the **set of sub-queries** (cnipa_batches) registered for this axis in the query library, writing one log each",
+    )
+    ap.add_argument(
+        "--delay-sec",
+        type=float,
+        default=None,
+        help=f"interval in seconds between adjacent queries in batch mode (default {cnipa_mod.DEFAULT_BATCH_DELAY_SEC:g})",
+    )
+    ap.add_argument(
+        "--only",
+        default=None,
+        metavar="N[,M...]",
+        help="run only these sub-queries (1-based), e.g. to re-run one that the WAF rejected",
+    )
+    ap.add_argument("--json", action="store_true")
+    args = ap.parse_args(argv)
+
+    if args.from_library:
+        return _run_cnipa_batch(args)
+
+    try:
+        data = api.fetch_cnipa(
+            ws=args.workspace,
+            axis=args.axis,
+            target=args.target,
+            abstract=args.abstract,
+            title=args.title,
+            class_code=args.class_code,
+            inventor=args.inventor,
+            applicant=args.applicant,
+            patent_type=args.patent_type,
+            max_pages=args.max_pages,
+            complete=args.complete,
+            headed=not args.headless,
+            waf_wait=args.waf_wait,
+            actor=args.actor,
+            tool=args.tool,
+            write=not args.no_write,
+        )
+    except api.WorkspaceError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    if args.json:
+        print(json.dumps(data, ensure_ascii=False, indent=2))
+        return 0 if data.get("ok") else 1
+
+    if not data.get("ok"):
+        print(f"[FATAL] {data.get('error')}", file=sys.stderr)
+        return 1
+
+    print(f"Axis       : {data['axis']}")
+    print(f"Query      : {data['query_text']}")
+    print(f"Total hits : {data['hit_total']} (reported by the site)")
+    print(f"Captured this run: {data['captured_count']} records / {data['effective_pages']} pages with data")
+    print(f"Page attempts: {data['pages_attempted']} (self-reported by the upstream tool)")
+    if data.get("warning"):
+        print(f"⚠️  {data['warning']}")
+    print(f"Complete   : {'yes' if data['complete'] else 'no — honestly recorded in the log'}")
+    if data.get("note"):
+        print(f"Paging     : {data['note']}")
+    if data.get("incomplete"):
+        print(f"Hint       : {data['incomplete']}")
+    print()
+    for h in data.get("hits_preview", []):
+        print(f"  {h['pub_number']:<16} {h['publication_date'] or '':<12} {(h['title'] or '')[:52]}")
+    if data["captured_count"] > len(data.get("hits_preview", [])):
+        print(f"  … {data['captured_count'] - len(data['hits_preview'])} more in the raw artifact")
+    print()
+    if data.get("written"):
+        print(f"Log        : {data['log']}")
+        print(f"Raw artifact: {data['raw']}")
+        print(f"Next step  : {data['next']}")
+    else:
+        print("Not archived (--no-write)")
+    return 0
+
+
+def _parse_only(value: str | None) -> list[int] | None:
+    """Parse `--only 1,3`. Returns None for no restriction; raises ValueError on invalid format."""
+    if not value:
+        return None
+    out: list[int] = []
+    # NOTE: data literal, intentionally untranslated: the full-width comma is accepted as input
+    # from Chinese-language users and must stay byte-identical.
+    for chunk in value.replace("，", ",").split(","):
+        chunk = chunk.strip()
+        if not chunk:
+            continue
+        if not chunk.isdigit():
+            raise ValueError(f"--only accepts numeric indices only, got '{chunk}'")
+        out.append(int(chunk))
+    return out or None
+
+
+def _run_cnipa_batch(args) -> int:
+    """`fetch-cnipa --from-library` — run the whole set of sub-queries registered for the axis."""
+    try:
+        plan = api.cnipa_batch_plan(ws=args.workspace, axis=args.axis)
+    except api.WorkspaceError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    if not plan.get("ok"):
+        print(f"[FATAL] {plan.get('error')}", file=sys.stderr)
+        if plan.get("available"):
+            print(f"  Available axes: {', '.join(plan['available'])}", file=sys.stderr)
+        return 2
+
+    axis = plan["axis"]
+    try:
+        only = _parse_only(getattr(args, "only", None))
+    except ValueError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+    if only is not None:
+        bad = [n for n in only if not 1 <= n <= plan["count"]]
+        if bad:
+            print(
+                f"[FATAL] --only index out of range: {bad} ({axis} has {plan['count']} entries)",
+                file=sys.stderr,
+            )
+            return 2
+
+    delay = (
+        cnipa_mod.DEFAULT_BATCH_DELAY_SEC if args.delay_sec is None else args.delay_sec
+    )
+    print(f"Axis       : {axis}")
+    selected = f" (running only {only})" if only else ""
+    print(
+        f"Sub-queries: {len(only) if only else plan['count']}{selected}"
+        f" (from cnipa_batches in 01_search_plan/query_library.yml)"
+    )
+    print(f"Interval   : {delay:g}s each — measured consecutive requests trigger the CNIPA WAF")
+    n_run = len(only) if only else plan["count"]
+    print(f"Estimated time: about {delay * max(0, n_run - 1) / 60:.1f} minutes + fetch time")
+    print()
+
+    def progress(msg: str) -> None:
+        print(msg, flush=True)
+
+    try:
+        data = api.fetch_cnipa_batch(
+            ws=args.workspace,
+            axis=args.axis,
+            target=args.target,
+            delay_sec=delay,
+            max_pages=args.max_pages,
+            actor=args.actor,
+            write=not args.no_write,
+            only=only,
+        )
+    except api.WorkspaceError as exc:
+        print(f"[FATAL] {exc}", file=sys.stderr)
+        return 2
+
+    if args.json:
+        print(json.dumps(data, ensure_ascii=False, indent=2))
+    else:
+        print()
+        print("─" * 62)
+        print(f"Planned {data['planned']} · succeeded {data['succeeded']} · failed {data['failed']}")
+        print(f"Captured {data['captured']} records, {data['unique_docs']} after deduplication")
+        if data.get("stopped_early"):
+            print(f"⛔ {data['stopped_early']}")
+        if data.get("unique_pub_numbers"):
+            print()
+            print("Publication numbers:")
+            for pub in data["unique_pub_numbers"]:
+                print(f"  {pub}")
+        if data.get("next"):
+            print()
+            print(f"Next: {data['next']}")
+
+    return 0 if data.get("succeeded") else 1
+
+
+def _cmd_status(data: dict, as_json: bool) -> None:
+    print(json.dumps(data, ensure_ascii=False, indent=2) if as_json else render_status(data))
+
+
+def _positional(argv: list[str]) -> str | None:
+    """Return the first non-option argument (and not the value of some option)."""
+    takes_value = {"--workspace", "--axis", "--db", "--root"}
+    skip_next = False
+    for item in argv:
+        if skip_next:
+            skip_next = False
+            continue
+        if item in takes_value:
+            skip_next = True
+            continue
+        if item.startswith("-"):
+            continue
+        return item
+    return None
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
