+
+
+def row(root, **changes):
+    from patentkit import assessment as a
+    cite = {"ref": "02_search_logs/raw/source.json", "locator": "/abstract"}
+    value = {
+        "candidate_id": "P-900", "expected_fingerprint": a.fingerprint(candidate(root), root),
+        "relevance_problem": 4, "relevance_means": 4, "role": "near_prior_art",
