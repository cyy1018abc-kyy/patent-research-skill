* text=auto
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# raw 工件（普查 JSONL 等）是被哈希绑定的证据：任何平台检出/应用补丁都必须字节保真。
*.jsonl -text
# 补丁空白上下文属于格式内容，原始行尾必须保留以匹配源文件。
release/patches/*.patch -text whitespace=-blank-at-eol

# 基准夹具含 sha256 绑定文件（claims.md / raw 工件）与逐字节语料一致性比对，
# 禁止行尾转换（3.4.0 的 *.jsonl -text 同理）。
benchmarks/** -text
